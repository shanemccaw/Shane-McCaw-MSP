# Shane's Life — real environment. Copy to .env and fill in real values.
# NEVER commit a filled-in .env.

# Real Postgres connection string.
#
# This is the SAME real database the ShanesSurvival WPF app uses — one app, one login, one
# Postgres (design contract Section 1). Shane's Life's own migrations start at 013 and extend
# ShanesSurvival's real 001-012; pointing this anywhere else gives you a half-app with no Money
# underneath it, and src/migrate.mjs will refuse to run rather than let that happen quietly.
#
# The real database name is whatever the WPF app is actually configured with, in
#   %AppData%\ShanesSurvival\settings.json  ->  PostgresConnectionString
# On Shane's machine today that is `finances`, NOT `shanessurvival` — the `shanessurvival`
# database on this box is an empty leftover from following the README's example literally, and
# has none of migrations 002-012 applied (Git #3107). Read the settings file rather than
# assuming either name.
#
#   local dev: postgresql://postgres:<password>@localhost:5432/finances
#   Replit:    provided automatically as DATABASE_URL by Replit's Postgres add-on
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/finances

# Set to "require" when the database is remote (Replit/Neon). Leave unset for local.
PGSSLMODE=

# Port to listen on. Replit provides this; locally defaults to 5000.
PORT=5000

# Public origin of the deployed app, used to build shareable links and the MCP URL.
#
# Load-bearing for passkeys as well: the WebAuthn Relying Party ID is this URL's hostname, and a
# passkey registered against one RP ID cannot be used against another. Changing this after a
# passkey is enrolled invalidates it.
# e.g. https://shanes-life.replit.app  (no trailing slash)
PUBLIC_ORIGIN=http://localhost:5000

# Set to "production" on the real deployment. Controls Secure cookies + error detail.
NODE_ENV=development

# Max upload size for a single capture attachment (photo/voice), in bytes.
MAX_UPLOAD_BYTES=12000000

# 32 bytes of base64 randomness, for the bill-payment vault's AES-256-GCM encryption
# (migration 017). The key lives OUTSIDE the database on purpose, so a database dump on its own
# decrypts nothing. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# REQUIRED for the Money -> Vault room (Git #3150). Without it the vault refuses to encrypt or
# decrypt anything and says so out loud -- it never falls back to storing a readable value. Lose
# this key and the stored entries are unrecoverable, which is the point: back it up somewhere
# that is not the database.
SL_VAULT_KEY=

# Real Web Push (Git #3160). One P-256 key pair identifies this app to push services (Apple's
# for Safari, Google's for Chrome/Android). Generate once with:
#   node bin/generate-vapid-keys.mjs
# and paste the two lines it prints below. Without these, /api/push/vapid-public-key returns
# null and the app quietly has no real OS-notification push -- the in-app tray still works, it
# just never fires a push. Do NOT regenerate on a live deployment: every already-subscribed
# browser has the OLD public key baked into its subscription and will need to re-subscribe.
SL_VAPID_PUBLIC_KEY=
SL_VAPID_PRIVATE_KEY=
# The real contact email a push service's abuse team can reach if this app's pushes misbehave.
# Required by the Web Push spec (RFC 8292); most push services don't enforce it strictly, but
# it's a real courtesy, not a formality to skip.
SL_VAPID_SUBJECT_EMAIL=shane@shanemccawconsulting.com

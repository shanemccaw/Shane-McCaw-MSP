<Project Sdk="Microsoft.NET.Sdk">

  <!-- Git #3689 — kept diagnostic. Standalone probe process; never launches or drives BuildConsole.
       Compiles the REAL KeyedSlotCardHost.cs from BuildConsole so the measured code is the shipped code.
       No PackageReferences: builds from the installed .NET 8 SDK alone, nothing downloaded. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\desktop\BuildConsole\Controls\KeyedSlotCardHost.cs" Link="KeyedSlotCardHost.cs" />
  </ItemGroup>

</Project>

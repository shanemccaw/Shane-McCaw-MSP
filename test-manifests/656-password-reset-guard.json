{
  "issue": 882,
  "feature": "Password-reset-before-purchase guard (#656 regression)",
  "baseUrl": "{{DEPLOY_URL}}",

  "apiTests": [
    {
      "name": "forgot-password refuses to issue a link for a passwordless account with no client_services entitlement",
      "method": "POST",
      "path": "/api/auth/forgot-password",
      "headers": { "Content-Type": "application/json" },
      "body": { "email": "prospect@tenant5.test" },
      "expect": { "status": 200, "json": { "ok": true } }
    },
    {
      "name": "forgot-password gives the same generic ok response for an unknown email (no account-existence leak)",
      "method": "POST",
      "path": "/api/auth/forgot-password",
      "headers": { "Content-Type": "application/json" },
      "body": { "email": "no-such-account-{{TEST_RUN_ID}}@tenant5.test" },
      "expect": { "status": 200, "json": { "ok": true } }
    }
  ],

  "uiSteps": []
}

{
  "issue": 889,
  "feature": "Copilot Readiness Documents screen (money path 4/6) — reach after a scan, ready/pending counter reflects real generation state, open/preview a document",
  "baseUrl": "{{DEPLOY_URL}}",

  "apiTests": [
    {
      "name": "assessment status is the real payload the Documents screen's data hook (useCopilotJourney) polls to decide the copilot gate/readiness score behind the rail",
      "method": "GET",
      "path": "/api/portal/assessment/status",
      "headers": { "Authorization": "Bearer {{TEST_PORTAL_BEARER}}" },
      "expect": { "status": 200, "jsonPath": "$.copilotGate", "exists": true }
    }
  ],

  "uiSteps": [
    { "action": "goto", "target": "/login" },
    { "action": "input", "selector": "#email", "value": "{{TEST_PORTAL_EMAIL}}" },
    { "action": "input", "selector": "#password", "value": "{{TEST_PORTAL_PASSWORD}}" },
    {
      "action": "click",
      "selector": "[data-testid='login-submit']",
      "captureResponse": {
        "urlPattern": "/api/auth/login",
        "expect": { "status": 200, "jsonPath": "$.accessToken", "exists": true }
      }
    },

    { "action": "goto", "target": "/copilot-readiness/documents" },

    { "action": "expect", "selector": "[data-testid='document-reading-pane']", "state": "visible" },

    {
      "name": "the ready/pending counter is drawn from the same generation state the rail's rows are built from (JOURNEY_LIVE_DOCUMENT_SPINE, Git #643) — 'N of N ready' with a real number, never a stuck 0 of 0",
      "action": "expect",
      "selector": "[data-testid='documents-ready-counter']",
      "state": "visible",
      "textContains": "ready"
    },

    { "action": "expect", "selector": "[data-testid='document-row-0']", "state": "visible" },
    { "action": "expect", "selector": "[data-testid='document-row-1']", "state": "visible" },

    {
      "name": "opening a different report from the rail actually switches the reader — the header title and reading pane both update, not just the row's active state",
      "action": "click",
      "selector": "[data-testid='document-row-1']"
    },
    { "action": "expect", "selector": "[data-testid='active-document-title']", "state": "visible" },
    { "action": "expect", "selector": "[data-testid='document-reading-pane']", "state": "visible" }
  ]
}

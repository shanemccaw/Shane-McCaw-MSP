{
  "issue": 929,
  "feature": "App-testable subset of #133: Zoho CRM lead sync field verification",
  "baseUrl": "{{DEPLOY_URL}}",
  "lastVerifiedAgainstCommit": "11f652014257f0eebb287ebfb192052fed8392c7",

  "zohoTests": [
    {
      "method": "POST",
      "path": "/api/quiz/home-lead-capture",
      "headers": { "Content-Type": "application/json" },
      "body": {
        "name": "Zoho FieldProbe",
        "email": "zohotests-929-probe@shanemccaw.consulting",
        "company": "Zoho Field Verification Co",
        "score": 42,
        "band": "Developing",
        "pillars": [
          { "name": "Identity", "value": 50 },
          { "name": "Data", "value": 50 },
          { "name": "Devices", "value": 50 },
          { "name": "Apps", "value": 50 },
          { "name": "Infrastructure", "value": 50 },
          { "name": "Threat Protection", "value": 50 }
        ]
      },
      "expect": { "status": 200, "jsonPath": "$.success", "value": true }
    },
    {
      "method": "GET",
      "path": "/zoho/crm/leads/lookup/by-email?email=zohotests-929-probe@shanemccaw.consulting",
      "poll": { "intervalMs": 20000, "timeoutMs": 360000 },
      "expect": { "status": 200, "jsonPath": "$.found", "value": true }
    },
    {
      "method": "GET",
      "path": "/zoho/crm/leads/lookup/by-email?email=zohotests-929-probe@shanemccaw.consulting",
      "expect": { "status": 200, "jsonPath": "$.record.Email", "value": "zohotests-929-probe@shanemccaw.consulting" }
    },
    {
      "method": "GET",
      "path": "/zoho/crm/leads/lookup/by-email?email=zohotests-929-probe@shanemccaw.consulting",
      "expect": { "status": 200, "jsonPath": "$.record.First_Name", "value": "Zoho" }
    },
    {
      "method": "GET",
      "path": "/zoho/crm/leads/lookup/by-email?email=zohotests-929-probe@shanemccaw.consulting",
      "expect": { "status": 200, "jsonPath": "$.record.Last_Name", "value": "FieldProbe" }
    },
    {
      "method": "GET",
      "path": "/zoho/crm/leads/lookup/by-email?email=zohotests-929-probe@shanemccaw.consulting",
      "expect": { "status": 200, "jsonPath": "$.record.Lead_Source", "value": "quiz" }
    }
  ]
}

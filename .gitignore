# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Generated runtime artifacts
data/uploads/documents/*.pdf

# Prompt paste files (auto-created by Replit when pasting into chat)
attached_assets/*.txt
artifacts/shane-mccaw-consulting/public/sitemap.xml

# Git #790 — build-queue-watcher.ps1's own config holds the same ingest
# token the extension's Options page does; only the .example template ships.
scripts/build-queue-watcher.config.json

# Git #958 — RunManifestAsync's per-run ManifestRunResult JSON dump
# (test-results/{issue}-{timestamp}.json), written locally by BuildConsole
# on every run; ephemeral output, never meant to be committed.
test-results/

# BuildConsole local activity and output logs
.logs/
*.log

#local dev
.env
.env.local
.env.*.local
node_modules/
dist/
uploads/

# Session scratch / throwaway work (per-issue investigation scripts, draft
# issue comments + commit messages, isolated-build diffs, git-plumbing temp
# files). These pile up as untracked debris from many concurrent Claude Code
# sessions and never belong in git.
.scratch/
scripts/_tmp/
scripts/_tmp_*
/tmp_*
*.stackdump
# Captured shaneapp:// tool-result envelope dumps (ephemeral, per-invocation).
desktop/BuildConsole/shaneapp-*.result.json

# Git #1812 — local-only running log from check-dev-app-registration-drift.mjs.
scripts/azure/app-registration-drift.log

# Scratch bundles produced by artifacts/api-server/run-script.mjs (Git #1797)
artifacts/api-server/.run-script-*/

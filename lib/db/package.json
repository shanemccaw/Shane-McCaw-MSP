{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./rbac": "./src/rbac/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.generate.config.ts && tsx ../../scripts/src/update-schema-hash.ts",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "test": "vitest run",
    "check-rbac-integrity": "tsx ./src/rbac/integrity-check.ts",
    "check-rbac-parity": "tsx ./src/rbac/parity-check.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.9"
  }
}

<Window x:Class="ShaneBuilder.AlertLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alert Lab"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="296"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Deactivated="Window_Deactivated">

    <!-- Git #2201 — readme-phase2.md Step 11: "Bell in the topbar opens the Alert Lab: fire any
         alert or celebration on demand (this is also the QA harness), plus recent history." -->
    <Border Background="{StaticResource Brush.Bg.Panel}"
            BorderBrush="{StaticResource Brush.Border.Card}" BorderThickness="1"
            CornerRadius="9" Padding="8" MaxHeight="560">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Root">
                <TextBlock Text="ALERTS" FontSize="9.5" FontWeight="Bold" Margin="4,2,0,4"
                           Foreground="{StaticResource Brush.Text.Muted}"/>
                <StackPanel x:Name="AlertsPanel"/>

                <TextBlock Text="CELEBRATIONS" FontSize="9.5" FontWeight="Bold" Margin="4,12,0,4"
                           Foreground="{StaticResource Brush.Text.Muted}"/>
                <StackPanel x:Name="PartiesPanel"/>

                <TextBlock Text="HISTORY" FontSize="9.5" FontWeight="Bold" Margin="4,12,0,4"
                           Foreground="{StaticResource Brush.Text.Muted}"/>
                <StackPanel x:Name="HistoryPanel"/>
                <TextBlock x:Name="HistoryEmptyText" Text="Nothing fired yet." FontSize="10.5" Margin="6,2,0,4"
                           Foreground="{StaticResource Brush.Text.Dim}" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>

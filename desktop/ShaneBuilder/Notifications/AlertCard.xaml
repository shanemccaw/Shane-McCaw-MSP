<UserControl x:Class="ShaneBuilder.AlertCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Right" IsHitTestVisible="True">

    <!-- Git #2201 — readme-phase2.md Step 11, Channel 1. "Each card: 3px left rail in its severity
         colour, title, timestamp line, the actual evidence line in mono, then the resolution."
         352px wide per the mockup's computeAlerts cardStyle; restyled against this app's own
         Brush.Bg.Card/Brush.Text.* tokens rather than the mockup's raw hex, same convention
         ToastCard.xaml already set (Git #2174). -->
    <UserControl.Resources>
        <Style x:Key="AlertCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Heading}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AlertActionButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardRoot"
            Margin="0,0,0,8" Width="352"
            Background="{StaticResource Brush.Bg.Card}"
            BorderBrush="{StaticResource Brush.Border.Card}"
            BorderThickness="1"
            CornerRadius="9">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="EnterTransform" X="26"/>
        </Border.RenderTransform>

        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SeverityRail" Grid.Column="0" CornerRadius="9,0,0,9" Background="{StaticResource Brush.Toast.Info}"/>

            <StackPanel Grid.Column="1" Margin="10,10,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IconText" Grid.Column="0" Text="&#x26A0;" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,7,0"
                               Foreground="{StaticResource Brush.Toast.Info}"/>
                    <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="12.5" FontWeight="Bold"
                               TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Heading}"/>
                    <Button x:Name="BtnClose" Grid.Column="2" Content="&#x2715;"
                            Style="{StaticResource AlertCloseButton}" FontSize="10" Padding="6,4"
                            VerticalAlignment="Top" ToolTip="Dismiss" Click="BtnClose_Click"/>
                </Grid>

                <TextBlock x:Name="MetaText" FontSize="10" Margin="0,2,0,0"
                           Foreground="{StaticResource Brush.Text.Muted}"/>

                <Border Margin="0,8,0,8" Padding="9,7" CornerRadius="6"
                        Background="{StaticResource Brush.Bg.Window}"
                        BorderBrush="{StaticResource Brush.Border.Card}" BorderThickness="1">
                    <TextBlock x:Name="EvidenceText" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"
                               Foreground="{StaticResource Brush.Text.Primary}"/>
                </Border>

                <!-- Inline reply — WantsReply alerts (Claude is waiting on you) only -->
                <StackPanel x:Name="ReplyPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,4">
                    <TextBox x:Name="ReplyBox" Width="252" Height="26" Padding="6,4" FontSize="11"
                             Background="{StaticResource Brush.Bg.Window}"
                             Foreground="{StaticResource Brush.Text.Primary}"
                             BorderBrush="{StaticResource Brush.Border.Card}" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             KeyDown="ReplyBox_KeyDown"/>
                    <Button x:Name="BtnSendReply" Content="Send" Margin="6,0,0,0" Width="60"
                            Style="{StaticResource AlertActionButton}" Click="BtnSendReply_Click"/>
                </StackPanel>

                <StackPanel x:Name="ActionsPanel" Orientation="Horizontal">
                    <Button x:Name="BtnPrimary" Style="{StaticResource AlertActionButton}"
                            Width="auto" MinWidth="120" Click="BtnPrimary_Click"/>
                    <Button x:Name="BtnSecondary" Style="{StaticResource AlertActionButton}"
                            Margin="6,0,0,0" Background="Transparent"
                            Foreground="{StaticResource Brush.Text.Muted}" Click="BtnSecondary_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

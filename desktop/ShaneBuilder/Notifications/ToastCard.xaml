<UserControl x:Class="ShaneBuilder.ToastCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Right">

    <!-- One notification card in the ToastHostWindow stack, restyled (Git #2174) against the #2147
         token dictionary: Brush.Bg.Card body, thin Brush.Border.Card outline, a soft drop shadow, and
         a coloured left accent bar + icon whose colour carries the kind (Brush.Toast.Info/Success/
         Warning/Error). Set up in code-behind (ToastCard.xaml.cs). -->
    <UserControl.Resources>
        <!-- Minimal close-button style, scoped to this card — ShaneBuilder has no shared button style
             system yet (unlike BuildConsole's global IconButton), so this stays local rather than
             reaching for a style that doesn't exist. -->
        <Style x:Key="ToastCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Heading}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardRoot"
            Margin="0,0,0,10"
            MinWidth="320" MaxWidth="400"
            Background="{StaticResource Brush.Bg.Card}"
            BorderBrush="{StaticResource Brush.Border.Card}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- left accent bar -->
                <ColumnDefinition Width="Auto"/>  <!-- kind icon -->
                <ColumnDefinition Width="*"/>     <!-- title + message -->
                <ColumnDefinition Width="Auto"/>  <!-- close -->
            </Grid.ColumnDefinitions>

            <!-- Coloured left accent bar (kind colour, set in code-behind) -->
            <Border x:Name="AccentBar" Grid.Column="0"
                    Width="4"
                    CornerRadius="8,0,0,8"
                    Background="{StaticResource Brush.Toast.Info}"/>

            <!-- Kind icon (glyph + colour set in code-behind) -->
            <TextBlock x:Name="IconText" Grid.Column="1"
                       Text="&#x2139;"
                       FontFamily="Segoe UI Symbol, Segoe UI"
                       FontSize="15" FontWeight="Bold"
                       Margin="12,11,0,0"
                       VerticalAlignment="Top"
                       Foreground="{StaticResource Brush.Toast.Info}"/>

            <!-- Title + message -->
            <StackPanel Grid.Column="2" Margin="10,10,8,11">
                <TextBlock x:Name="TitleText"
                           FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Text.Heading}"/>
                <TextBlock x:Name="MessageText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           Foreground="{StaticResource Brush.Text.Muted}"/>
            </StackPanel>

            <!-- Dismiss (the toast also auto-dismisses on its own, unless persistent) -->
            <Button x:Name="BtnClose" Grid.Column="3"
                    Content="&#x2715;"
                    Style="{StaticResource ToastCloseButton}"
                    FontSize="10"
                    Padding="6,4"
                    VerticalAlignment="Top"
                    Margin="0,6,6,0"
                    ToolTip="Dismiss"
                    Click="BtnClose_Click"/>
        </Grid>
    </Border>
</UserControl>

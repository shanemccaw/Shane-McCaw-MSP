<Window x:Class="ShaneBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:ShaneBuilder"
        mc:Ignorable="d"
        Title="ShaneBuilder"
        Height="800" Width="1280"
        MinHeight="480" MinWidth="800"
        WindowState="Maximized"
        Background="{StaticResource Brush.Bg.Window}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <!-- WindowChrome keeps real OS window behavior (drag-to-move, edge resize,
         Aero snap, double-click-to-maximize) on a WindowStyle="None" window,
         same mechanism as BuildConsole's MainWindow.xaml. CaptionHeight matches
         the title bar's own 44px height below (per wpf-handoff/README.md's
         "Title bar — fixed 44px height" spec); everything interactive inside
         that height is marked IsHitTestVisibleInChrome so WindowChrome treats
         it as a real click instead of a window-drag gesture. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Bg.Chip}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButtonClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Alert.Critical}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Heading}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left icon rail toggle (Chats / Epics / Git / Next Up), per
             wpf-handoff Shell Skeleton v2.html's rail tiles: 32x32,
             6px corner radius, tinted background + accent border when
             the panel it drives is the active one. -->
        <Style x:Key="RailToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Bg.Chip}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Bg.Chip}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Heading}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapse/expand caret used by both the left panel header and the
             Build Queue panel header — 20x20, per the queue-panel retract
             control in the mockup. -->
        <Style x:Key="PanelCollapseButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Chip}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="{StaticResource Brush.Border.Default}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Heading}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark theme for right-click context menus — real Windows
             ContextMenu/MenuItem controls render with the light system
             theme by default, which would look jarring against everything
             else in this app. Implicit styles (no x:Key) so every
             ContextMenu built anywhere (tabs, build cards, build set
             headers) picks this up automatically. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Popover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="6" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.Sans}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.11.5}"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2,1" Padding="9,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <ContentPresenter ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Bg.Chip}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Destructive">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Alert.Danger.Bg}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Destructive"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Alert.Danger.Border}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Dim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="6,4" Background="{StaticResource Brush.Border.Default}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root Grid — the DockPanel below is the whole app shell; the Command
         Palette overlay is a sibling layered on top of it (added after in
         document order), so it can cover literally everything including the
         title/status bars, not just the document host. -->
    <Grid x:Name="RootGrid">
    <DockPanel>
        <!-- ══════════════════════════════════════════════════════════════
             TITLE BAR — 44px, per wpf-handoff/README.md
             ══════════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource Brush.Bg.Panel}"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border.Default}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Workspace box (Step 9, wpf-handoff/readme-phase2.md) —
                         replaces what was an empty square left of the app
                         name. A 4-pip grid of live workspace colours plus a
                         badge counting dismissed ("stashed") workspace sets;
                         clicking opens a panel to fold/unfold/restore each.
                         Hidden entirely when nothing is stashed — an empty
                         box would just be visual noise the mockup doesn't
                         call for.
                         A ToggleButton bound straight to the Popup's IsOpen,
                         not a Button + code-behind toggle — a StaysOpen=False
                         Popup opened from a plain Button.Click flashes open
                         and immediately self-dismisses, because that same
                         mouse-up is seen as an "outside click." Binding
                         IsOpen to IsChecked sidesteps that WPF quirk
                         entirely. Sized to match the other topbar icon
                         buttons (28x24) rather than the original 20x20 —
                         too small to reliably hit. -->
                    <ToggleButton x:Name="BtnWorkspaceBox" Width="36" Height="32" Margin="12,0,0,0"
                                  Visibility="Collapsed" Style="{StaticResource RailToggle}"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  ToolTip="Dismissed workspaces">
                        <Grid x:Name="WorkspaceBoxPipsGrid" Width="20" Height="20"/>
                    </ToggleButton>
                    <Popup x:Name="WorkspaceBoxPopup" PlacementTarget="{Binding ElementName=BtnWorkspaceBox}"
                           IsOpen="{Binding IsChecked, ElementName=BtnWorkspaceBox, Mode=TwoWay}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource Brush.Bg.Panel}" BorderBrush="{StaticResource Brush.Border.Popover}"
                                BorderThickness="1" CornerRadius="8" Padding="6" MinWidth="230"
                                Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="6" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel x:Name="WorkspaceBoxPanelList"/>
                        </Border>
                    </Popup>

                    <TextBlock Text="ShaneBuilder"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Heading}"
                               FontFamily="{StaticResource FontFamily.Sans}"
                               FontSize="{StaticResource FontSize.13}"
                               FontWeight="{StaticResource FontWeight.SemiBold}"/>

                    <!-- Focus nudge pill — per README: shows the day's chosen
                         objective epic, growing wider through 6 escalating
                         "quiet" stages, using Brush.FocusNudge.<Stage>.* from
                         Colors.xaml section 8 (an exact match to the mockup's
                         own LEVELS table). No real "quiet timer" exists yet
                         (that needs the Home tab's not-yet-wired Today's
                         Objectives), so clicking the pill cycles the stage —
                         same demo behavior the mockup's own onCycle uses. The
                         objective itself is honestly this project's own real
                         epic (#1202 ShaneBuilder), not invented data. -->
                    <Border x:Name="NudgePill" Margin="10,0,0,0" Height="26" CornerRadius="6"
                            Padding="8,0,10,0" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseLeftButtonDown="NudgePill_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle x:Name="NudgeDot" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NudgeLabel" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontFamily.Monospace}"
                                       FontSize="{StaticResource FontSize.9.5}"
                                       FontWeight="{StaticResource FontWeight.Bold}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="NudgeMessageHost" Orientation="Horizontal" Visibility="Collapsed"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NudgeMessageText" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontFamily="{StaticResource FontFamily.Sans}"
                                   FontSize="{StaticResource FontSize.10.5}"
                                   FontWeight="{StaticResource FontWeight.SemiBold}"/>
                        <Border Background="{StaticResource Brush.Bg.Chip}" BorderBrush="{StaticResource Brush.Border.Hover}"
                                BorderThickness="1" CornerRadius="6" Padding="10,3" Cursor="Hand"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                MouseLeftButtonDown="NudgeJumpBack_Click">
                            <TextBlock Text="Jump back →"
                                       Foreground="{StaticResource Brush.Text.Heading}"
                                       FontFamily="{StaticResource FontFamily.Sans}"
                                       FontSize="{StaticResource FontSize.10.5}"
                                       FontWeight="{StaticResource FontWeight.Bold}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Search trigger — per README's title bar spec ("a search
                     trigger center/right"). Click, or Ctrl+K anywhere in the
                     app, opens the Command Palette below. -->
                <Border Grid.Column="0" HorizontalAlignment="Center" Width="260" Height="24"
                        CornerRadius="6" Background="{StaticResource Brush.Bg.Window}"
                        BorderBrush="{StaticResource Brush.Border.Hover}" BorderThickness="1"
                        Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        MouseLeftButtonDown="SearchTrigger_Click">
                    <StackPanel Orientation="Horizontal" Margin="9,0">
                        <TextBlock Text="&#xE721;" Margin="0,0,7,0" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Muted}"/>
                        <TextBlock Text="Search epics, tabs, builds…" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                   Foreground="{StaticResource Brush.Text.Muted}"/>
                        <TextBlock Text="Ctrl K" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="{StaticResource FontFamily.Monospace}" FontSize="9"
                                   Foreground="{StaticResource Brush.Text.Dim}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Quick access toggle chips + actions — per README's title
                         bar spec ("small toggle chips: account / location /
                         conservation mode") and the mockup's topbarToggles /
                         topbarQuickActions (lines 59-73). Account/Location/
                         Conservation/Drain have no real backing concept in
                         ShaneBuilder yet, so they're local demo toggles (same
                         honest pattern as the nudge pill and Active/Paused
                         pill); the camera button is real (captures the window
                         to the clipboard) and Git Pull is an honest stub —
                         there's no repo integration wired up here. -->
                    <Border Margin="0,0,10,0" Padding="4,3" CornerRadius="7"
                            Background="{StaticResource Brush.Bg.Window}" BorderBrush="{StaticResource Brush.Border.Card}" BorderThickness="1"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel x:Name="QuickAccessToolbar" Orientation="Horizontal"/>
                    </Border>

                    <!-- Git #2210 — desktop screen-clipping tool, ported from BuildConsole (Git #1866).
                         Draw a region anywhere on the desktop; the clip goes to the clipboard AND to
                         disk. Also fires on PrintScreen (BtnScreenClip.ToolTip is updated from
                         code-behind to say whether the global hotkey was claimed by Windows' Snipping
                         Tool). Distinct from the QuickAccessToolbar's "Screenshot Tool" button above,
                         which only captures the whole ShaneBuilder window to the clipboard. -->
                    <Button x:Name="BtnScreenClip" Style="{StaticResource CaptionButton}"
                            ToolTip="Screen clip (PrintScreen) - drag a region to the clipboard and disk"
                            Click="ScreenClip_Click">
                        <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>

                    <!-- Git #2201 — Alert Lab bell (readme-phase2.md Step 11): "Bell in the topbar
                         opens the Alert Lab: fire any alert or celebration on demand (this is also
                         the QA harness), plus recent history. Badge = live card count." -->
                    <Button x:Name="BtnAlertBell" Style="{StaticResource CaptionButton}"
                            ToolTip="Alert Lab" Click="BtnAlertBell_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            <Border x:Name="BellBadge" Visibility="Collapsed"
                                    Width="14" Height="14" CornerRadius="7"
                                    Background="{StaticResource Brush.Epic.Gate}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0">
                                <TextBlock x:Name="BellBadgeText" FontSize="8.5" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                        <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             STATUS BAR — 23px, per README's spec: flat segments, thin
             separators, monospace counts, a resize-grip glyph bottom-right.
             Segments are built in code-behind (RenderStatusBar) from the
             real _queueItems counts — hover a segment for a flyout listing
             its matching builds. background/border match Shell Skeleton
             v2.html line 1184 exactly (#1c2128 = Brush.Bg.Chip).
             ══════════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Height="23" Background="{StaticResource Brush.Bg.Chip}"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border.Default}">
            <DockPanel>
                <Border DockPanel.Dock="Right" Width="16" Padding="0,0,3,2">
                    <Canvas Width="9" Height="9" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <Rectangle Canvas.Left="6" Canvas.Top="0" Width="1.5" Height="1.5" Fill="{StaticResource Brush.Text.Dim}"/>
                        <Rectangle Canvas.Left="3" Canvas.Top="3" Width="1.5" Height="1.5" Fill="{StaticResource Brush.Text.Dim}"/>
                        <Rectangle Canvas.Left="6" Canvas.Top="3" Width="1.5" Height="1.5" Fill="{StaticResource Brush.Text.Dim}"/>
                        <Rectangle Canvas.Left="0" Canvas.Top="6" Width="1.5" Height="1.5" Fill="{StaticResource Brush.Text.Dim}"/>
                        <Rectangle Canvas.Left="3" Canvas.Top="6" Width="1.5" Height="1.5" Fill="{StaticResource Brush.Text.Dim}"/>
                        <Rectangle Canvas.Left="6" Canvas.Top="6" Width="1.5" Height="1.5" Fill="{StaticResource Brush.Text.Dim}"/>
                    </Canvas>
                </Border>
                <!-- Git #2176 — real live-connectivity proof: a genuine GitHub Search API open-issue
                     count and a genuine local Postgres bt_build_queue row count, fetched once at
                     startup. "connecting…" until both settle; never fixture data. -->
                <Border DockPanel.Dock="Right" Padding="10,0,10,0" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,1,0">
                    <TextBlock x:Name="ConnHealthStatus" Text="connecting…"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontFamily.Monospace}"
                               FontSize="{StaticResource FontSize.11}"
                               Foreground="{StaticResource Brush.Text.Dim}"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StatusBarHost" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             APP SCAFFOLDING — icon rail | left panel | document host | queue
             Widths/backgrounds match wpf-handoff Shell Skeleton v2.html's
             leftPanelStyle / mainContentColumnStyle / queuePanelStyle.
             Content inside each zone is a placeholder — built out per
             component next, not part of this scaffolding pass.
             ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="DocumentHostColumn" Width="*"/>
                <ColumnDefinition x:Name="BuildDetailColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left icon rail — 52px, per mockup line 78 -->
            <Border Grid.Column="0" Width="52" Background="{StaticResource Brush.Bg.Window}"
                    BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border.Default}">
                <!-- Real Lucide vector icons (Themes/Icons.xaml) instead of Segoe
                     MDL2 glyphs — Shane's pared-down rail list, in his given order:
                     Chat, Git, Next Up, Batter Up, Build Console, Build Watch,
                     UI Testing, Shot Vault, with Settings pinned at the bottom. -->
                <DockPanel Margin="0,12">
                    <Button x:Name="BtnRailSettings" DockPanel.Dock="Bottom" Style="{StaticResource CaptionButton}"
                            Width="32" Height="32" Margin="0,0,0,4" ToolTip="Settings"
                            HorizontalAlignment="Center" Click="BtnRailSettings_Click">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.Settings}"
                              Stroke="{StaticResource Brush.Text.Muted}"/>
                    </Button>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                        <ToggleButton x:Name="BtnRailChat" Style="{StaticResource RailToggle}" Margin="0,0,0,8"
                                      ToolTip="Chat" Click="RailToggle_Click" Tag="Chat">
                            <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.Chat}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnRailGit" Style="{StaticResource RailToggle}" Margin="0,0,0,8"
                                      ToolTip="Git" Click="RailToggle_Click" Tag="Git">
                            <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.Git}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnRailNextUp" Style="{StaticResource RailToggle}" Margin="0,0,0,8"
                                      ToolTip="Next Up" Click="RailToggle_Click" Tag="NextUp">
                            <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.NextUp}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnRailBatterUp" Style="{StaticResource RailToggle}" Margin="0,0,0,8"
                                      ToolTip="Batter Up" Click="RailToggle_Click" Tag="BatterUp">
                            <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.BatterUp}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnRailBuildConsole" Style="{StaticResource RailToggle}" Margin="0,0,0,8"
                                      ToolTip="Build Console" Click="RailToggle_Click" Tag="BuildConsole">
                            <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.BuildConsole}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnRailBuildWatch" Style="{StaticResource RailToggle}" Margin="0,0,0,8"
                                      ToolTip="Build Watch" Click="RailToggle_Click" Tag="BuildWatch">
                            <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.BuildWatch}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnRailUiTesting" Style="{StaticResource RailToggle}" Margin="0,0,0,8"
                                      ToolTip="UI Testing" Click="RailToggle_Click" Tag="UiTesting">
                            <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.UiTesting}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnRailShotVault" Style="{StaticResource RailToggle}"
                                      ToolTip="Shot Vault" Click="RailToggle_Click" Tag="ShotVault">
                            <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.ShotVault}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Left collapsible panel — 280px open / 0px collapsed, per
                 mockup's leftPanelStyle (line 2377) -->
            <Border x:Name="LeftPanel" Grid.Column="1" Width="0" Background="{StaticResource Brush.Bg.Panel}"
                    BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border.Default}"
                    ClipToBounds="True">
                <DockPanel Width="280">
                    <Border DockPanel.Dock="Top" Height="36" Padding="0,0,8,0" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource Brush.Border.Default}">
                        <DockPanel VerticalAlignment="Center">
                            <!-- Collapse icon on the panel's outer edge (right side, away
                                 from the rail) — closes it without needing to re-click the
                                 same rail icon that opened it. -->
                            <Button x:Name="BtnCollapseLeftPanel" DockPanel.Dock="Right"
                                    Style="{StaticResource PanelCollapseButton}"
                                    ToolTip="Collapse panel" Click="BtnCollapseLeftPanel_Click">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                            </Button>
                            <!-- Git #2320 (Feature #2318 item 2) — New Chat button at the top
                                 of the Chats panel. Only shown while the Chats panel is the
                                 visible left-panel source (Visibility bound in RailToggle_Click
                                 alongside ChatsPanelBody). Opens a fresh claude.ai tab today —
                                 #2321 builds the real anchor-disclosure flow this button hands
                                 off into via OpenNewChatFlow(). -->
                            <Button x:Name="BtnNewChat" DockPanel.Dock="Right"
                                    Style="{StaticResource PanelCollapseButton}"
                                    Width="Auto" Height="20" Padding="8,2" Margin="0,0,6,0"
                                    ToolTip="Start a new chat"
                                    Click="BtnNewChat_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontFamily="{StaticResource FontFamily.Sans}"
                                               FontSize="11" FontWeight="{StaticResource FontWeight.Bold}"
                                               Margin="0,0,4,0" Foreground="{StaticResource Brush.Accent.IssueNum}"/>
                                    <TextBlock Text="New Chat" FontFamily="{StaticResource FontFamily.Sans}"
                                               FontSize="9.5" Foreground="{StaticResource Brush.Accent.IssueNum}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="LeftPanelTitle" Text="CHATS" Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       FontFamily="{StaticResource FontFamily.Sans}"
                                       FontSize="{StaticResource FontSize.11}"
                                       FontWeight="{StaticResource FontWeight.SemiBold}"/>
                        </DockPanel>
                    </Border>
                    <!-- Per-source panel bodies, per mockup's isLeftChats /
                         isLeftGit / isLeftNextUp / isLeftEpics blocks
                         (Shell Skeleton v2.html lines 93-244). Each is a real
                         empty state rather than the mockup's demo rows — no
                         chat/epic/Git session data exists to read yet, and
                         fabricating specific chat names or issue numbers here
                         would be exactly the invented-data trap the rest of
                         this codebase is built to avoid. RailToggle_Click
                         swaps which one is visible.
                    -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Git #2325 (Feature #2318 item 9) — real chat rows (was a static
                             placeholder). One row per open chat tab, each with a real
                             DOM-derived context-size badge (ChatContextMeterScript) and an
                             Archive action; an ARCHIVED section below lists chats archived this
                             way with Reopen/Delete. Built in code-behind
                             (MainWindow.ChatsPanel.cs). -->
                        <StackPanel x:Name="ChatsPanelBody" Margin="8,8,8,12">
                            <TextBlock x:Name="ChatsPanelStatus" Margin="6,4,6,10"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Text.Dim}"
                                       FontFamily="{StaticResource FontFamily.Sans}"
                                       FontSize="{StaticResource FontSize.10.5}"/>
                            <StackPanel x:Name="ChatsPanelOpenRows"/>
                            <TextBlock x:Name="ChatsPanelArchivedHeader" Margin="6,14,6,6"
                                       Text="ARCHIVED"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource Brush.Text.Dim}"
                                       FontFamily="{StaticResource FontFamily.Sans}"
                                       FontSize="{StaticResource FontSize.10.5}"
                                       FontWeight="{StaticResource FontWeight.SemiBold}"/>
                            <StackPanel x:Name="ChatsPanelArchivedRows"/>
                        </StackPanel>

                        <!-- Shared placeholder for the 4 rail panels that don't have
                             real content or a design yet (Build Console / Build Watch /
                             UI Testing / Shot Vault) — text is set per panel in
                             RailToggle_Click rather than duplicating this block 4 times.
                             Batter Up moved out to its own real BatterUpPanelBody below
                             (Git #2356, Feature #2355 item 1). -->
                        <TextBlock x:Name="NotBuiltPanelBody" Margin="14,16,14,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   FontFamily="{StaticResource FontFamily.Sans}"
                                   FontSize="{StaticResource FontSize.11}"/>

                        <!-- Git #2356 (Feature #2355 item 1) — Batter Up rail panel shell: the
                             lane switch (All / Batter Up / AI Batter Up / Ask Shane) with a real
                             live count per tab, off ChatGitHubFilter.GetBatterUpLaneCountsAsync().
                             Rows/grouping/item content are later builds on #2357 onward — this is
                             the shell + lanes + counts only. Built in code-behind
                             (MainWindow.BatterUpPanel.cs). -->
                        <StackPanel x:Name="BatterUpPanelBody" Margin="8,8,8,12" Visibility="Collapsed">
                            <TextBlock x:Name="BatterUpPanelStatus" Margin="6,4,6,10"
                                       TextWrapping="Wrap"
                                       Text="Loading real board counts…"
                                       Foreground="{StaticResource Brush.Text.Dim}"
                                       FontFamily="{StaticResource FontFamily.Sans}"
                                       FontSize="{StaticResource FontSize.10.5}"/>
                            <WrapPanel x:Name="BatterUpLaneTabs" Margin="6,0,6,10"/>
                            <StackPanel x:Name="BatterUpLaneBody"/>
                        </StackPanel>

                        <!-- Git #2290 — the Git Panel navigation shell (Feature #2289 items
                             1-11): Milestones / Gate cards / Epic → FEATURE → Issue tree plus
                             the in-panel peek with breadcrumb trail. Rows are built in
                             code-behind (MainWindow.GitPanel.cs) off real GitHub state via
                             GitPanelService/GitMapService — no fixture rows exist to declare
                             here. -->
                        <StackPanel x:Name="GitPanelBody" Margin="8,8,8,12" Visibility="Collapsed">
                            <TextBlock x:Name="GitPanelStatus" Margin="6,4,6,6"
                                       TextWrapping="Wrap"
                                       Text="Loading real GitHub state…"
                                       Foreground="{StaticResource Brush.Text.Dim}"
                                       FontFamily="{StaticResource FontFamily.Sans}"
                                       FontSize="{StaticResource FontSize.10.5}"/>
                            <StackPanel x:Name="GitPeekHost" Visibility="Collapsed"/>
                            <StackPanel x:Name="GitTreeHost"/>
                        </StackPanel>

                        <!-- Next Up groups issues under Critical Path / Other
                             Epics bands with a Gate banner above them once
                             critical epics clear (mockup lines 95-147). The
                             bands are real structure; GateBanner stays
                             collapsed until real Git data can say the gate
                             is actually clear. -->
                        <StackPanel x:Name="NextUpPanelBody" Visibility="Collapsed">
                            <Border x:Name="GateBanner" Margin="8,8,8,0" Padding="12"
                                    CornerRadius="9" BorderThickness="1.5"
                                    Background="{StaticResource Brush.Gate.Bg}"
                                    BorderBrush="{StaticResource Brush.Gate.Border}"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="GATE · V1.1 RELEASE"
                                               Foreground="{StaticResource Brush.Gate.Accent}"
                                               FontFamily="{StaticResource FontFamily.Sans}"
                                               FontSize="{StaticResource FontSize.9}"
                                               FontWeight="{StaticResource FontWeight.ExtraBold}"/>
                                    <TextBlock Text="All critical-path epics clear — the gate is now the blocker."
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               FontFamily="{StaticResource FontFamily.Sans}"
                                               FontSize="{StaticResource FontSize.10.5}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="8,10,8,4" Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,6,0"/>
                                <TextBlock Text="CRITICAL PATH"
                                           Foreground="{StaticResource Brush.Text.Muted}"
                                           FontFamily="{StaticResource FontFamily.Sans}"
                                           FontSize="{StaticResource FontSize.9}"
                                           FontWeight="{StaticResource FontWeight.ExtraBold}"/>
                            </StackPanel>
                            <TextBlock Margin="14,0,14,12" TextWrapping="Wrap"
                                       Text="No epics in this band yet."
                                       Foreground="{StaticResource Brush.Text.Dim}"
                                       FontFamily="{StaticResource FontFamily.Sans}"
                                       FontSize="{StaticResource FontSize.11}"/>

                            <StackPanel Margin="8,0,8,4" Orientation="Horizontal">
                                <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,6,0"/>
                                <TextBlock Text="OTHER EPICS"
                                           Foreground="{StaticResource Brush.Text.Muted}"
                                           FontFamily="{StaticResource FontFamily.Sans}"
                                           FontSize="{StaticResource FontSize.9}"
                                           FontWeight="{StaticResource FontWeight.ExtraBold}"/>
                            </StackPanel>
                            <TextBlock Margin="14,0,14,0" TextWrapping="Wrap"
                                       Text="No epics in this band yet."
                                       Foreground="{StaticResource Brush.Text.Dim}"
                                       FontFamily="{StaticResource FontFamily.Sans}"
                                       FontSize="{StaticResource FontSize.11}"/>
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Document host zone — center flex column, per mockup's
                 mainContentColumnStyle (line 2281). The tab strip is built
                 in code-behind (RenderTabStrip) since a tab pill's style
                 depends on active/inactive state, same as the mockup's own
                 tb.style computation (Shell Skeleton v2.html line 2467). -->
            <DockPanel Grid.Column="2" Background="{StaticResource Brush.Bg.Window}">
                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Bg.Window}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border.Default}"
                        Padding="8,6,8,0">
                    <StackPanel x:Name="TabStripPanel" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                </Border>

                <Grid x:Name="DocumentHostGrid" AllowDrop="True"
                      DragEnter="DocumentHostGrid_DragEnter" DragOver="DocumentHostGrid_DragEnter"
                      Drop="DocumentHostGrid_Drop">
                    <!-- Home tab content — per mockup's activeTab.isHome block
                         (Shell Skeleton v2.html line 283). The objective
                         picker/cards need real Epics data that doesn't exist
                         yet, so they're a plain notice for now rather than
                         fabricated placeholder rows (no invented data). -->
                    <StackPanel x:Name="HomeTabContent" Margin="24" VerticalAlignment="Top">
                        <TextBlock Text="Set Today's Objectives"
                                   Foreground="{StaticResource Brush.Text.Heading}"
                                   FontFamily="{StaticResource FontFamily.Sans}"
                                   FontSize="{StaticResource FontSize.15}"
                                   FontWeight="{StaticResource FontWeight.ExtraBold}"/>
                        <TextBlock Text="Pick 1–2 epics to anchor today — everything else can wait."
                                   Margin="0,2,0,12"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   FontFamily="{StaticResource FontFamily.Sans}"
                                   FontSize="{StaticResource FontSize.11.5}"/>
                        <TextBlock Text="No objectives set — Epics/Next Up data wiring lands in a later pass."
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   FontFamily="{StaticResource FontFamily.Sans}"
                                   FontSize="{StaticResource FontSize.11}"/>
                    </StackPanel>

                    <TextBlock x:Name="StubTabContent"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Foreground="{StaticResource Brush.Text.Dim}"
                               FontFamily="{StaticResource FontFamily.Sans}"
                               FontSize="{StaticResource FontSize.13}"/>

                    <!-- Real claude.ai, not a re-implemented chat UI — the message
                         thread and composer inside are the actual site via WebView2
                         (same mechanism BuildConsole's own ClaudeWebView uses), not
                         redrawn in WPF. Everything AROUND it — the context bar, the
                         Detected Items flyout, the Inspector check-in overlays — is
                         real chrome built here, per README items 6 and 9. Shown for
                         any chat-kind tab (currently just #1202 ShaneBuilder). -->
                    <Grid x:Name="ClaudeChatDock" Visibility="Collapsed">
                        <!-- Git #2209 §1 — the 5-band anatomy: (0) Context bar [cool] /
                             (1) Breadcrumb-Share [warm] / (2) Inspector warning [transient] /
                             (3) Transcript + Tool rail body [warm] / (4) Composer [warm].
                             Only band 0 stays on the cool shell palette; every warm band uses
                             Brush.Claude.* — the palette split is intentional, do NOT harmonise. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Context bar — cool palette (Brush.Bg.Card), not the warm
                             Claude.* one; per the mockup it sits above the warm chat
                             surface as shell-level metadata, not part of the pane
                             itself. Epic stats are real (from _queueItems, filtered to
                             this chat's BuildSet); the context-usage fraction has no
                             real token-tracking source yet, so it's an honest "—",
                             not a fabricated percentage. Two columns (content * / actions
                             Auto) so the two action buttons pin to the far right instead
                             of just trailing whatever content precedes them. -->
                        <!-- Git #2209 §2 — real layout bug already hit twice: the context bar must be
                             overflow:visible + z-index:40 so the wrench Popup can paint OVER the warm
                             surface below instead of being clipped/occluded. WPF: no ClipToBounds on
                             this Border (default false, kept so), and an explicit Panel.ZIndex="40" so
                             it sits above the Row-2 body. The wrench menu itself is a WPF Popup anchored
                             by PlacementTarget — NOT measured screen coordinates (the second flagged
                             bug) — so it follows the button under window moves/DPI changes for free. -->
                        <Border Grid.Row="0" Panel.ZIndex="40" x:Name="CtxBarBorder"
                                Background="{StaticResource Brush.Bg.Card}"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border.Default}">
                            <Grid>
                                <Border x:Name="CtxBarFill" Width="0" HorizontalAlignment="Left" Opacity="0.16"
                                        Background="{StaticResource Brush.Accent.Primary}"/>
                                <Grid Margin="14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <!-- Git #2209 §11 bug FIX — the chat's epic is DERIVED from the
                                             active tab (TabDef.EpicNumber), set in RenderClaudeChatContext,
                                             never hardcoded. The original mockup shipped "#1202" baked in
                                             here and the panel lied about which chat you were in after a
                                             tab switch. Clickable → real epic click-target (CtxEpic_Click). -->
                                        <TextBlock x:Name="CtxEpicNum" Text="#—" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Cursor="Hand" MouseLeftButtonDown="CtxEpic_Click"
                                                   ToolTip="This chat's epic — click to view / reassign"
                                                   Foreground="{StaticResource Brush.Accent.IssueNum}"
                                                   FontFamily="{StaticResource FontFamily.Monospace}"
                                                   FontSize="17" FontWeight="{StaticResource FontWeight.ExtraBold}"/>
                                        <Border Width="1" Height="16" Margin="0,0,10,0" Background="{StaticResource Brush.Border.Default}"/>
                                        <!-- Each stat opens the left-side detail panel (mirrors
                                             Detected Items on the right) filtered to that status
                                             — Shane's own addition, not in the original mockup. -->
                                        <TextBlock x:Name="CtxStatVerifying" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="Verifying" MouseLeftButtonDown="CtxStat_Click"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                                   Foreground="{StaticResource Brush.Status.Verifying}"/>
                                        <TextBlock x:Name="CtxStatInFlight" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="Running" MouseLeftButtonDown="CtxStat_Click"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                                   Foreground="{StaticResource Brush.Status.Running}"/>
                                        <TextBlock x:Name="CtxStatQueued" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="Queued" MouseLeftButtonDown="CtxStat_Click"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                                   Foreground="{StaticResource Brush.Text.Muted}"/>
                                        <TextBlock x:Name="CtxStatBlocked" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="Blocked" MouseLeftButtonDown="CtxStat_Click"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                                   Foreground="{StaticResource Brush.Status.Blocked}"/>
                                        <TextBlock x:Name="CtxStatDone" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="Done" MouseLeftButtonDown="CtxStat_Click"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                                   FontWeight="{StaticResource FontWeight.Bold}"
                                                   Foreground="{StaticResource Brush.Status.Done}"/>
                                        <Border Width="1" Height="16" Margin="0,0,10,0" Background="{StaticResource Brush.Border.Default}"/>
                                        <!-- Git #2209 §2 — context-used gauge. Two-part shape (used / 300k)
                                             is non-negotiable; the estimate is the doc's own 0.28 tokens/char
                                             + 40k fixed overhead (resolved open question #3: no real tokeniser
                                             is wired yet, keep the estimate, keep the two-part shape). Fed by
                                             the app-owned composer draft length + a stated transcript overhead;
                                             CtxBarFill above renders the fraction as a background sweep. -->
                                        <TextBlock x:Name="CtxGauge" Text="≈40k / 300k ctx" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.11}"
                                                   Foreground="{StaticResource Brush.Text.Dim}"
                                                   ToolTip="Estimated (0.28 tokens/char + 40k overhead) — no real tokeniser wired yet."/>
                                        <!-- Appears only at ≥75% context used, per §2. -->
                                        <Button x:Name="BtnStartNewChat" Style="{StaticResource PanelCollapseButton}"
                                                Width="Auto" Height="20" Padding="8,2" Margin="10,0,0,0" Visibility="Collapsed"
                                                ToolTip="Context is getting full — start a fresh chat"
                                                Click="BtnStartNewChat_Click">
                                            <TextBlock Text="Start new chat" FontFamily="{StaticResource FontFamily.Sans}"
                                                       FontSize="9.5" Foreground="{StaticResource Brush.Accent.IssueNum}"/>
                                        </Button>
                                    </WrapPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnSimulateInspector" Style="{StaticResource PanelCollapseButton}"
                                                Width="Auto" Height="22" Padding="8,3" Margin="10,0,0,0"
                                                ToolTip="Simulate an Inspector check-in (demo — no real inspector agent exists yet)"
                                                Click="BtnSimulateInspector_Click">
                                            <TextBlock Text="Simulate Inspector Check-in"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="9.5"
                                                       Foreground="{StaticResource Brush.Text.Muted}"/>
                                        </Button>
                                        <!-- Git #2233 — Log Peek / SQL Runner / Repo Health / JSON Viewer /
                                             Windows File Browser / Git Map / Git Doctor mini rail each used to
                                             have their own standalone toggle button here (BtnToggleLogPeek,
                                             BtnToggleSqlRunner, BtnToggleRepoHealth, BtnToggleJsonViewer,
                                             BtnToggleFileBrowser, BtnToggleGitMap, BtnToggleGitDoctorMini) —
                                             seven scattered buttons duplicating access to the same seven tools
                                             now reachable from the one wrench menu below (BuildWrenchMenu).
                                             Removed rather than kept as a second path in; each handler and its
                                             panel/column state is untouched, only this bar entry point is gone.
                                             "Detected panel" is a different, non-toolbelt feature and keeps its
                                             own bar button. -->
                                        <Button x:Name="BtnToggleDetectedItems" Style="{StaticResource PanelCollapseButton}"
                                                Margin="8,0,0,0"
                                                ToolTip="Detected in this chat — mentioned issues + pinned questions (⌘)"
                                                Click="BtnToggleDetectedItems_Click">
                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                        </Button>
                                        <!-- Git #2209 §10 — the Claude Floaty (⧉) button. Full floaty spec
                                             lives with the #2035/#2059/#2065 chain; what belongs HERE is only
                                             the button + that the floaty and this tab show the SAME conversation
                                             (BtnFloaty_Click pops the current claude.ai URL into a topmost mini
                                             window). -->
                                        <Button x:Name="BtnFloaty" Style="{StaticResource PanelCollapseButton}"
                                                Margin="8,0,0,0"
                                                ToolTip="Pop this conversation into the always-on-top Claude Floaty"
                                                Click="BtnFloaty_Click">
                                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                        </Button>
                                        <!-- Git #2209 §2 — wrench menu. A WPF Popup anchored by
                                             PlacementTarget/Placement=Bottom, deliberately NOT positioned by
                                             measured screen coordinates (the real bug flagged twice in the doc).
                                             StaysOpen=False so a click-away dismisses it. -->
                                        <Button x:Name="BtnWrench" Style="{StaticResource PanelCollapseButton}"
                                                Margin="8,0,0,0" ToolTip="Chat tools &amp; actions"
                                                Click="BtnWrench_Click">
                                            <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                        </Button>
                                        <Popup x:Name="WrenchPopup" PlacementTarget="{Binding ElementName=BtnWrench}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                               HorizontalOffset="-160" VerticalOffset="4">
                                            <Border Background="{StaticResource Brush.Bg.Panel}" CornerRadius="8"
                                                    BorderBrush="{StaticResource Brush.Border.Popover}" BorderThickness="1"
                                                    Padding="6" Width="230">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
                                                </Border.Effect>
                                                <StackPanel x:Name="WrenchMenuItems"/>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Git #2209 §3 — Breadcrumb / Share bar (band 2, WARM). A near-replica of
                             claude.ai's own chrome strip: a breadcrumb of Epic › Chat, and the Share
                             pill. Resolved open question #1: Share is wired to the real claude.ai share
                             URL for the mapped conversation; if the WebView2 host can't expose that
                             cleanly the pill hides itself (BtnShare_Click) rather than shipping a fake
                             inert one. Warm palette on purpose — this band is part of the chat document,
                             not the shell. -->
                        <Border Grid.Row="1" Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Claude.Border}"
                                Padding="14,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CrumbEpic" Text="Epic" VerticalAlignment="Center"
                                               Cursor="Hand" MouseLeftButtonDown="CtxEpic_Click"
                                               FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                               Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                    <TextBlock x:Name="CrumbFeatureSep" Text="&#xE76C;" Margin="7,0" VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                               Visibility="Collapsed"/>
                                    <!-- Git #2324 — Feature-tier segment, resolved async (ResolveChatFeatureNumbersAsync,
                                         #2319) onto TabDef.FeatureNumber. Collapsed (not just empty) when the tab's
                                         Epic genuinely has no Feature-tier ancestor, matching the tab-strip badge. -->
                                    <TextBlock x:Name="CrumbFeature" Text="" VerticalAlignment="Center"
                                               Cursor="Hand" MouseLeftButtonDown="CtxFeature_Click"
                                               FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                               Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                               Visibility="Collapsed"/>
                                    <TextBlock Text="&#xE76C;" Margin="7,0" VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                    <TextBlock x:Name="CrumbChat" Text="Chat" VerticalAlignment="Center"
                                               FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                               FontWeight="{StaticResource FontWeight.SemiBold}"
                                               Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                </StackPanel>
                                <Button x:Name="BtnShare" Grid.Column="1" Style="{StaticResource PanelCollapseButton}"
                                        Width="Auto" Height="22" Padding="9,3" ToolTip="Copy this conversation's claude.ai share link"
                                        Click="BtnShare_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"
                                                   Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                        <TextBlock Text="Share" FontFamily="{StaticResource FontFamily.Sans}" FontSize="10"
                                                   Foreground="{StaticResource Brush.Claude.Text.Body}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Inspector "warning" phase — floaty notice, non-blocking. Lives in
                             its own row ABOVE the webview rather than overlapping it: WebView2
                             hosts a native child window that always paints on top of any WPF
                             sibling sharing its screen space ("airspace"), so an overlay drawn
                             in the same Grid cell as ClaudeWebView is invisible no matter its
                             Z-order — this row-based placement is the actual fix, not a
                             cosmetic choice. Collapses to 0 height when hidden. -->
                        <Border Grid.Row="2" x:Name="InspectorWarningNotice" Visibility="Collapsed"
                                Padding="14,8" Background="{StaticResource Brush.Claude.Bg.Bubble}"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Claude.Border}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7BA;" Margin="0,0,8,0" VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Brush.FocusNudge.Quiet15m.Fg}"/>
                                <TextBlock x:Name="InspectorWarningText" Text="Inspector will ask Claude a question in 5s…" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11.5}"
                                           FontWeight="{StaticResource FontWeight.SemiBold}"
                                           Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="StatDetailColumn" Width="0"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="DetectedItemsColumn" Width="0"/>
                                <ColumnDefinition x:Name="LogPeekColumn" Width="0"/>
                                <ColumnDefinition x:Name="SqlRunnerColumn" Width="0"/>
                                <ColumnDefinition x:Name="RepoHealthColumn" Width="0"/>
                                <ColumnDefinition x:Name="JsonViewerColumn" Width="0"/>
                                <ColumnDefinition x:Name="FileBrowserColumn" Width="0"/>
                                <ColumnDefinition x:Name="GitMapColumn" Width="0"/>
                                <ColumnDefinition x:Name="GdMiniColumn" Width="0"/>
                                <ColumnDefinition x:Name="PsColumn" Width="0"/>
                                <ColumnDefinition x:Name="TerminalColumn" Width="0"/>
                                <ColumnDefinition x:Name="ApiExplorerColumn" Width="0"/>
                            </Grid.ColumnDefinitions>

                            <!-- Stat detail flyout — Shane's own addition, not in the mockup:
                                 clicking a context-bar stat (e.g. "1 verifying") opens this,
                                 the Detected Items panel's twin on the opposite edge, listing
                                 the real matching builds for that status. -->
                            <Border x:Name="StatDetailPanel" Grid.Column="0" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="280">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE711;" Cursor="Hand"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                       MouseLeftButtonDown="CloseStatDetailPanel_Click"/>
                                            <TextBlock x:Name="StatDetailTitle" Text="Verifying" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="StatDetailResults" Margin="10"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Column="1">
                                <!-- Git #2470 — mount point for the ACTIVE keep-alive tab's own
                                     persistent WebView2. There is no longer a single shared
                                     ClaudeWebView: each keep-alive (chat) tab owns its own live
                                     view (see MainWindow.KeepAliveTabs.cs). SelectTab reparents the
                                     active tab's view host into here and parks every other one 1×1
                                     off-screen in KeepAliveHostCanvas — so switching two chat tabs
                                     shows each tab's OWN distinct live page (the #2465 fix). -->
                                <Grid x:Name="ChatWebViewHost"/>

                                <!-- Inspector "blocking" phase — locks the chat surface until
                                     Claude responds. Same airspace constraint as the warning
                                     notice above means this can't visually sit "over" the live
                                     WebView2 either — the fix here is code-behind toggling
                                     ClaudeWebView's own Visibility off while this shows, so
                                     there's nothing underneath competing for the same pixels.
                                     A flat Border, not a real backdrop-blur (WPF can't blur what
                                     it doesn't render without a snapshot) — the wpf-handoff
                                     README's own suggested fallback for backdrop-filter. -->
                                <Border x:Name="InspectorBlockingOverlay" Visibility="Collapsed"
                                        Background="{StaticResource Brush.Claude.Bg.Content}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center"
                                                Background="{StaticResource Brush.Claude.Bg.Button}"
                                                BorderBrush="{StaticResource Brush.Claude.Accent}" BorderThickness="1">
                                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.Claude.Accent}"/>
                                        </Border>
                                        <TextBlock Text="Inspector is asking Claude a question…" Margin="0,8,0,2"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12.5}"
                                                   FontWeight="{StaticResource FontWeight.Bold}"
                                                   Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        <TextBlock Text="You'll get control back once Claude responds"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.10.5}"
                                                   Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Detected Items flyout — warm palette, matches the mockup's own
                                 treatment even though it's shell chrome, since it's part of the
                                 same dock. No real DOM-injection/detection engine reads the
                                 webview's content yet, so this is an honest empty state, not
                                 invented findings. -->
                            <!-- Git #2209 §6 — Detected in this chat. Body is now DYNAMIC, rendered by
                                 RenderDetectedItems() from the real #2197 ChatDockData pipe (Postgres
                                 chat-mentions + pinned questions, live GitHub board status) — no more
                                 fixture "nothing caught yet". Grouped detections + loose cards with
                                 DetectionKind chips + Promote to Queue / Dismiss. -->
                            <Border x:Name="DetectedItemsPanel" Grid.Column="2" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="280">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE711;" Cursor="Hand"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                       MouseLeftButtonDown="BtnToggleDetectedItems_Click"/>
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE72C;" Cursor="Hand" Margin="0,0,12,0"
                                                       ToolTip="Refresh detections"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                       MouseLeftButtonDown="DetectedRefresh_Click"/>
                                            <TextBlock Text="Detected in this chat" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="DetectedItemsResults" Margin="10,10,10,14"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Log Peek — Step 10 (wpf-handoff/readme-phase2.md), the chat
                                 document's own tool-panel flyout. Shares LogService/state with
                                 the full Log Viewer document (RenderLogPeek / RenderLogViewer
                                 both read the same _log* fields) rather than owning a second
                                 copy — "two surfaces, one state" per the spec. Bolted on as a
                                 4th single-purpose flyout column, same mechanism as
                                 StatDetailPanel/DetectedItemsPanel above; Step 9's generic
                                 multi-tool tool-belt (docs/Toolbelt.md) is real design but not
                                 yet built in code (real audit, Git #2200), so this follows the
                                 precedent already set rather than building that first. -->
                            <Border x:Name="LogPeekPanel" Grid.Column="3" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="280">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock Text="&#xE740;" Margin="0,0,10,0" Cursor="Hand"
                                                           ToolTip="Maximize to the full Log Viewer"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                           MouseLeftButtonDown="LogPeekMaximize_Click"/>
                                                <TextBlock Text="&#xE711;" Cursor="Hand"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                           MouseLeftButtonDown="BtnToggleLogPeek_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="Log Peek" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>

                                    <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <StackPanel>
                                            <StackPanel x:Name="LogPeekSourceChips" Orientation="Horizontal" Margin="0,0,0,7"/>
                                            <StackPanel x:Name="LogPeekStreamSwitch" Orientation="Horizontal" Margin="0,0,0,7"/>
                                            <TextBox x:Name="LogPeekSearchBox" Height="26" Padding="6,0"
                                                     VerticalContentAlignment="Center"
                                                     Background="{StaticResource Brush.Claude.Bg.Button}"
                                                     BorderBrush="{StaticResource Brush.Claude.Border}"
                                                     Foreground="{StaticResource Brush.Claude.Text.Bright}"
                                                     FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.10.5}"
                                                     Tag="Search…"
                                                     TextChanged="LogPeekSearchBox_TextChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <Button x:Name="BtnLogPeekSendToChat" Width="Auto" Height="26" HorizontalAlignment="Stretch"
                                                Style="{StaticResource PanelCollapseButton}"
                                                Click="BtnLogPeekSendToChat_Click">
                                            <TextBlock x:Name="LogPeekSendToChatLabel" Text="Send 0 to chat"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.10.5}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                        </Button>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="LogPeekLinesPanel" Margin="8"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Git #2215 — SQL Runner mini panel (README-ClaudeChat.md §6.7, per
                                 #2215's issue-body paraphrase — the doc itself isn't committed, see
                                 #2227). Same bolt-on-flyout mechanism as StatDetailPanel/
                                 DetectedItemsPanel/LogPeekPanel above — a single-purpose column.
                                 Execution logic (Services/SqlRunnerService.cs +
                                 Services/SqlScriptSplitter.cs) is a direct port of BuildConsole's
                                 real, already-working SqlDocumentView/LocalSqlExecutor/
                                 SqlScriptSplitter, not a reimplementation. No "full document" tab
                                 in this pass — out of scope for this session, tracked separately. -->
                            <Border x:Name="SqlRunnerPanel" Grid.Column="4" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="380">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE711;" Cursor="Hand"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                       MouseLeftButtonDown="BtnToggleSqlRunner_Click"/>
                                            <TextBlock Text="SQL Runner" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Toolbar: Execute + status -->
                                    <Border DockPanel.Dock="Top" Padding="10,7" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel>
                                            <Button x:Name="BtnSqlRunnerExecute" DockPanel.Dock="Left"
                                                    Style="{StaticResource PanelCollapseButton}"
                                                    Width="Auto" Height="24"
                                                    Padding="10,4" ToolTip="Execute (Ctrl+Enter)"
                                                    Click="BtnSqlRunnerExecute_Click">
                                                <TextBlock Text="&#x26A1; Execute" FontFamily="{StaticResource FontFamily.Sans}"
                                                           FontSize="10.5" FontWeight="{StaticResource FontWeight.SemiBold}"
                                                           Foreground="{StaticResource Brush.Claude.Accent}"/>
                                            </Button>
                                            <TextBlock x:Name="SqlRunnerStatus" Text="Ready" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="9.5"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Bottom action bar: Copy CSV / Copy JSON / Send to chat -->
                                    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Button x:Name="BtnSqlRunnerCopyCsv" Style="{StaticResource PanelCollapseButton}"
                                                        Width="Auto" Height="22"
                                                        Padding="8,3" Margin="0,0,6,0" IsEnabled="False"
                                                        ToolTip="Copy all results as CSV" Click="BtnSqlRunnerCopyCsv_Click">
                                                    <TextBlock Text="Copy CSV" FontFamily="{StaticResource FontFamily.Sans}" FontSize="9.5"
                                                               Foreground="{StaticResource Brush.Claude.Text.Body}"/>
                                                </Button>
                                                <Button x:Name="BtnSqlRunnerCopyJson" Style="{StaticResource PanelCollapseButton}"
                                                        Width="Auto" Height="22"
                                                        Padding="8,3" IsEnabled="False"
                                                        ToolTip="Copy all results as JSON" Click="BtnSqlRunnerCopyJson_Click">
                                                    <TextBlock Text="Copy JSON" FontFamily="{StaticResource FontFamily.Sans}" FontSize="9.5"
                                                               Foreground="{StaticResource Brush.Claude.Text.Body}"/>
                                                </Button>
                                            </StackPanel>
                                            <Button x:Name="BtnSqlRunnerSendToChat" Width="Auto" Height="26" HorizontalAlignment="Stretch"
                                                    Style="{StaticResource PanelCollapseButton}" IsEnabled="False"
                                                    ToolTip="Send these results into the composer" Click="BtnSqlRunnerSendToChat_Click">
                                                <TextBlock Text="Send result to chat" FontFamily="{StaticResource FontFamily.Sans}" FontSize="10.5"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition x:Name="SqlRunnerEditorRow" Height="90" MinHeight="54"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*" MinHeight="60"/>
                                        </Grid.RowDefinitions>

                                        <!-- Gutter-numbered mono editor, 4 rows tall by default, resizable
                                             via the GridSplitter below it (§6.7). Gutter + editor share one
                                             ScrollViewer so the line numbers scroll in lockstep with the
                                             text instead of drifting (TextBox owns no scrollbar of its own). -->
                                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                      Background="{StaticResource Brush.Claude.Bg.Content}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SqlRunnerGutter" Grid.Column="0" Text="1" Padding="6,6,6,6"
                                                           FontFamily="{StaticResource FontFamily.Monospace}" FontSize="11.5"
                                                           LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                                           TextAlignment="Right" IsHitTestVisible="False"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                                <TextBox x:Name="SqlRunnerEditor" Grid.Column="1" Padding="6,6,6,6"
                                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                         Background="Transparent" BorderThickness="0"
                                                         FontFamily="{StaticResource FontFamily.Monospace}" FontSize="11.5"
                                                         Foreground="{StaticResource Brush.Claude.Text.Bright}"
                                                         Text="SELECT *&#x0a;FROM public.users&#x0a;LIMIT 100;"
                                                         TextChanged="SqlRunnerEditor_TextChanged"
                                                         PreviewKeyDown="SqlRunnerEditor_PreviewKeyDown"/>
                                            </Grid>
                                        </ScrollViewer>

                                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Background="{StaticResource Brush.Claude.Border}" ResizeDirection="Rows"/>

                                        <!-- Results header: row count + Table/JSON toggle -->
                                        <DockPanel Grid.Row="2" Margin="10,7,10,5">
                                            <TextBlock x:Name="SqlRunnerRowCount" DockPanel.Dock="Left" Text="No results"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="9.5"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="SqlRunnerViewTableBtn" Content="Table"
                                                        Width="Auto" Height="22"
                                                        Padding="8,2" Margin="0,0,4,0"
                                                        Style="{StaticResource PanelCollapseButton}"
                                                        Click="SqlRunnerViewTableBtn_Click"/>
                                                <Button x:Name="SqlRunnerViewJsonBtn" Content="JSON"
                                                        Width="Auto" Height="22"
                                                        Padding="8,2"
                                                        Style="{StaticResource PanelCollapseButton}"
                                                        Click="SqlRunnerViewJsonBtn_Click"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Table view: one compact grid per statement, stacked -->
                                        <ScrollViewer x:Name="SqlRunnerTableScrollView" Grid.Row="3"
                                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="SqlRunnerResultsStack" Margin="10,0,10,10"/>
                                        </ScrollViewer>

                                        <!-- JSON view -->
                                        <TextBox x:Name="SqlRunnerJsonView" Grid.Row="3" Margin="10,0,10,10"
                                                 IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 Background="{StaticResource Brush.Claude.Bg.Content}" BorderThickness="0"
                                                 FontFamily="{StaticResource FontFamily.Monospace}" FontSize="10.5"
                                                 Foreground="{StaticResource Brush.Claude.Text.Bright}"
                                                 Visibility="Collapsed"/>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <!-- Repo Health mini panel — Git #2214 §6.6. Scan line + 4 rule-counter tiles
                                 (Depth/Naming/Stale/Orphan) + open findings list with checkboxes capped at
                                 5 selections, already-sent rows locked to "In chat", footer "Send N to this
                                 chat" writes a real markdown work order into the composer. Same flyout
                                 mechanism as LogPeekPanel/SqlRunnerPanel above — column 5 since #2215's
                                 SQL Runner landed concurrently and took column 4. -->
                            <Border x:Name="RepoHealthPanel" Grid.Column="5" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="300">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock Text="&#xE740;" Margin="0,0,10,0" Cursor="Hand"
                                                           ToolTip="Maximize to the full Repo Health document"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                           MouseLeftButtonDown="RepoHealthMaximize_Click"/>
                                                <TextBlock Text="&#xE711;" Cursor="Hand"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                           MouseLeftButtonDown="BtnToggleRepoHealth_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="Repo Health" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>

                                    <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,7">
                                                <TextBlock x:Name="RepoHealthScanLine" DockPanel.Dock="Left" Text="Scanning…"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource FontFamily.Monospace}" FontSize="9.5"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                                <TextBlock Text="&#xE72C;" Cursor="Hand" HorizontalAlignment="Right"
                                                           ToolTip="Re-scan"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                           MouseLeftButtonDown="RepoHealthRescan_Click"/>
                                            </DockPanel>
                                            <UniformGrid x:Name="RepoHealthTiles" Rows="1" Columns="4"/>
                                        </StackPanel>
                                    </Border>

                                    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <Button x:Name="BtnRepoHealthSendToChat" Width="Auto" Height="26" HorizontalAlignment="Stretch"
                                                Style="{StaticResource PanelCollapseButton}"
                                                Click="BtnRepoHealthSendToChat_Click">
                                            <TextBlock x:Name="RepoHealthSendToChatLabel" Text="Send 0 to this chat"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.10.5}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                        </Button>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="RepoHealthFindingsPanel" Margin="8"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Git #2217 — JSON Viewer mini panel (§6.9). 6-row paste textarea, Prettify,
                                 error line on invalid input, formatted output, Copy JSON. Seeded with a
                                 small object so the panel is never blank on first open. Same bolt-on-flyout
                                 mechanism as StatDetailPanel/SqlRunnerPanel/RepoHealthPanel above — a 7th
                                 single-purpose column. -->
                            <Border x:Name="JsonViewerPanel" Grid.Column="6" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="340">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE711;" Cursor="Hand"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                       MouseLeftButtonDown="BtnToggleJsonViewer_Click"/>
                                            <TextBlock Text="JSON Viewer" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Toolbar: Prettify + error line -->
                                    <Border DockPanel.Dock="Top" Padding="10,7" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel>
                                            <Button x:Name="BtnJsonViewerPrettify" DockPanel.Dock="Left"
                                                    Style="{StaticResource PanelCollapseButton}"
                                                    Width="Auto" Height="24"
                                                    Padding="10,4" ToolTip="Prettify"
                                                    Click="BtnJsonViewerPrettify_Click">
                                                <TextBlock Text="Prettify" FontFamily="{StaticResource FontFamily.Sans}"
                                                           FontSize="10.5" FontWeight="{StaticResource FontWeight.SemiBold}"
                                                           Foreground="{StaticResource Brush.Claude.Accent}"/>
                                            </Button>
                                            <TextBlock x:Name="JsonViewerError" Text="" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="9.5"
                                                       Foreground="{StaticResource Brush.Status.Blocked}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Bottom action bar: Copy JSON -->
                                    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <Button x:Name="BtnJsonViewerCopy" Width="Auto" Height="24" HorizontalAlignment="Stretch"
                                                Style="{StaticResource PanelCollapseButton}"
                                                ToolTip="Copy the formatted JSON" Click="BtnJsonViewerCopy_Click">
                                            <TextBlock Text="Copy JSON" FontFamily="{StaticResource FontFamily.Sans}" FontSize="10.5"
                                                       Foreground="{StaticResource Brush.Claude.Text.Body}"/>
                                        </Button>
                                    </Border>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition x:Name="JsonViewerInputRow" Height="108" MinHeight="54"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="*" MinHeight="60"/>
                                        </Grid.RowDefinitions>

                                        <!-- 6-row paste textarea (§6.9), seeded with a small object so this
                                             panel is never blank on first open. -->
                                        <TextBox x:Name="JsonViewerInput" Grid.Row="0" Margin="10,8,10,0" Padding="6"
                                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                 Background="{StaticResource Brush.Claude.Bg.Content}" BorderThickness="0"
                                                 FontFamily="{StaticResource FontFamily.Monospace}" FontSize="11"
                                                 Foreground="{StaticResource Brush.Claude.Text.Bright}"
                                                 TextChanged="JsonViewerInput_TextChanged"/>

                                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Background="{StaticResource Brush.Claude.Border}" ResizeDirection="Rows"/>

                                        <!-- Formatted output — read-only -->
                                        <TextBox x:Name="JsonViewerOutput" Grid.Row="2" Margin="10,0,10,10" Padding="6"
                                                 IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 Background="{StaticResource Brush.Claude.Bg.Content}" BorderThickness="0"
                                                 FontFamily="{StaticResource FontFamily.Monospace}" FontSize="10.5"
                                                 Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <!-- Git #2217 — Windows File Browser mini panel (§6.10). Indented tree,
                                 folders expand in place, selecting a file shows full path (word-break,
                                 Copy Path). READ-ONLY BY DESIGN — hands Claude an exact path, does not
                                 edit files; no write/rename/delete capability added, per spec. -->
                            <Border x:Name="FileBrowserPanel" Grid.Column="7" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="320">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE711;" Cursor="Hand"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                       MouseLeftButtonDown="BtnToggleFileBrowser_Click"/>
                                            <TextBlock Text="File Browser" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Selected file's full path + Copy Path. Word-break so a long
                                         Windows path wraps instead of overflowing the fixed-width panel. -->
                                    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <StackPanel>
                                            <TextBlock x:Name="FileBrowserSelectedPath" Text="No file selected"
                                                       Margin="0,0,0,7" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource FontFamily.Monospace}" FontSize="10"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                            <Button x:Name="BtnFileBrowserCopyPath" Width="Auto" Height="24" HorizontalAlignment="Stretch"
                                                    Style="{StaticResource PanelCollapseButton}" IsEnabled="False"
                                                    ToolTip="Copy the selected file's full path" Click="BtnFileBrowserCopyPath_Click">
                                                <TextBlock Text="Copy Path" FontFamily="{StaticResource FontFamily.Sans}" FontSize="10.5"
                                                           Foreground="{StaticResource Brush.Claude.Text.Body}"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Indented tree, folders expand in place (lazy-loaded on expand —
                                         real local DriveInfo/DirectoryInfo, no fixture data). -->
                                    <TreeView x:Name="FileBrowserTree" Margin="6,8,6,8"
                                              Background="Transparent" BorderThickness="0"
                                              SelectedItemChanged="FileBrowserTree_SelectedItemChanged"/>
                                </DockPanel>
                            </Border>

                            <!-- Git #2213 — Git Map mini panel. Same 280px flyout-column mechanism
                                 as StatDetailPanel/DetectedItemsPanel/LogPeekPanel above (the real,
                                 established rail-mini-panel precedent — #2209 shipped no generic tool
                                 rail container). Body is entirely dynamic (GitMapService, single-
                                 sourced with the full Git Map document tab) — see RenderGitMap*
                                 in code-behind. Column 8 — SQL Runner/Repo Health/JSON Viewer/File
                                 Browser landed concurrently and took 4-7. -->
                            <Border x:Name="GitMapPanel" Grid.Column="8" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="280">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock Text="&#xE740;" Margin="0,0,10,0" Cursor="Hand"
                                                           ToolTip="Maximize to the full Git Map"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                           MouseLeftButtonDown="GitMapMaximize_Click"/>
                                                <TextBlock Text="&#xE711;" Cursor="Hand"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                           MouseLeftButtonDown="BtnToggleGitMap_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="Git Map" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="GitMapResults" Margin="10,10,10,14"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Git Doctor mini rail panel — Git #2218, README-ClaudeChat.md §6.2 (posted
                                 as a comment on #2194). Summary (headline, branch/ahead-behind, big red
                                 "Fix My Git Nightmare" button) → Findings list (severity dot + title + chip,
                                 clickable) → Claude bridge (send findings, paste-reply textarea, Extract
                                 commands) → Plan (checkbox rows of parsed commands, Run N approved) → Run
                                 log (mono scroller). Reuses the real landed GitDoctorService and every piece
                                 of GitDoctorDock's own state (_gdFindings/_gdPlan/_gdLog/_gdRunning etc.) —
                                 no reimplementation, just a compact rendering path over the same data, same
                                 flyout mechanism as LogPeekPanel/SqlRunnerPanel/RepoHealthPanel above. The
                                 one real behavioral difference from the full document's clipboard-based
                                 bridge: this panel sits inside ClaudeChatDock next to the real app-owned
                                 composer, so "send findings" / "Ask Claude" write into AppendToComposer
                                 instead of the clipboard (§5's tool-writes-to-composer invariant). Column 9 —
                                 #2217's JSON Viewer/File Browser and #2213's Git Map landed concurrently and
                                 took columns 6-8. -->
                            <Border x:Name="GdMiniPanel" Grid.Column="9" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="300">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBlock Text="&#xE740;" Margin="0,0,10,0" Cursor="Hand"
                                                           ToolTip="Maximize to the full Git Doctor document"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                           MouseLeftButtonDown="GdMiniMaximize_Click"/>
                                                <TextBlock Text="&#xE711;" Cursor="Hand"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                           MouseLeftButtonDown="BtnToggleGitDoctorMini_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="Git Doctor" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="10,10,10,14">
                                            <!-- Summary -->
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="&#xE72C;" Cursor="Hand" DockPanel.Dock="Right"
                                                           ToolTip="Re-check" HorizontalAlignment="Right"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                           MouseLeftButtonDown="GdMiniRecheck_Click"/>
                                                <TextBlock x:Name="GdMiniHeadline" Text="Checking git…" TextWrapping="Wrap"
                                                           FontFamily="{StaticResource FontFamily.Sans}" FontSize="12"
                                                           FontWeight="{StaticResource FontWeight.Bold}"
                                                           Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                            </DockPanel>
                                            <TextBlock x:Name="GdMiniSubline" Text="" Margin="0,0,0,8" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource FontFamily.Monospace}" FontSize="9.5"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                            <Button x:Name="GdMiniNightmareBtn" Width="Auto" Height="30" HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,10" Background="{StaticResource Brush.Epic.Gate}"
                                                    BorderThickness="0" Click="GdMiniNightmareBtn_Click">
                                                <TextBlock x:Name="GdMiniNightmareLabel" Text="Fix My Git Nightmare"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource FontFamily.Sans}" FontSize="10.5"
                                                           FontWeight="{StaticResource FontWeight.Bold}" Foreground="Black"/>
                                            </Button>

                                            <!-- Findings -->
                                            <TextBlock Text="FINDINGS" Margin="0,0,0,5"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="9"
                                                       FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                            <StackPanel x:Name="GdMiniFindingsPanel" Margin="0,0,0,10"/>

                                            <!-- Claude bridge -->
                                            <TextBlock Text="CLAUDE BRIDGE" Margin="0,0,0,5"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="9"
                                                       FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                            <Button x:Name="GdMiniSendFindings" Width="Auto" Height="26" HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,6" Style="{StaticResource PanelCollapseButton}"
                                                    ToolTip="Write the open findings (or the selected one) into the composer"
                                                    Click="GdMiniSendFindings_Click">
                                                <TextBlock Text="Send findings to this chat" FontFamily="{StaticResource FontFamily.Sans}" FontSize="10"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                            </Button>
                                            <TextBox x:Name="GdMiniInboundBox" Height="54" Margin="0,0,0,6"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Background="{StaticResource Brush.Claude.Bg.Content}"
                                                     BorderBrush="{StaticResource Brush.Claude.Border}"
                                                     Foreground="{StaticResource Brush.Claude.Text.Bright}"
                                                     FontFamily="{StaticResource FontFamily.Monospace}" FontSize="9.5"
                                                     Tag="Paste Claude's reply here…"/>
                                            <Button x:Name="GdMiniExtract" Width="Auto" Height="24" HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,10" Style="{StaticResource PanelCollapseButton}"
                                                    Click="GdMiniExtract_Click">
                                                <TextBlock Text="Extract commands" FontFamily="{StaticResource FontFamily.Sans}" FontSize="10"
                                                           Foreground="{StaticResource Brush.Claude.Accent}"/>
                                            </Button>

                                            <!-- Plan -->
                                            <StackPanel x:Name="GdMiniPlanBlock" Margin="0,0,0,10">
                                                <TextBlock Text="PLAN" Margin="0,0,0,5"
                                                           FontFamily="{StaticResource FontFamily.Sans}" FontSize="9"
                                                           FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                                <StackPanel x:Name="GdMiniPlanPanel" Margin="0,0,0,6"/>
                                                <Button x:Name="GdMiniRunPlan" Width="Auto" Height="26" HorizontalAlignment="Stretch"
                                                        Visibility="Collapsed" Style="{StaticResource PanelCollapseButton}"
                                                        Click="GdMiniRunPlan_Click">
                                                    <TextBlock x:Name="GdMiniRunPlanLabel" Text="Run 0 approved"
                                                               FontFamily="{StaticResource FontFamily.Sans}" FontSize="10"
                                                               Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Run log -->
                                            <TextBlock Text="RUN LOG" Margin="0,0,0,5"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="9"
                                                       FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                            <TextBlock x:Name="GdMiniRunningLabel" Text="Running…" Visibility="Collapsed" Margin="0,0,0,4"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="9.5" FontStyle="Italic"
                                                       Foreground="{StaticResource Brush.Status.Running}"/>
                                            <StackPanel x:Name="GdMiniLogPanel"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Git #2216 — §6.8 PowerShell mini panel: a REAL persistent powershell.exe
                                 child process per chat tab (Services/TerminalSessionService.cs), not a
                                 scripted reply table — Shane's own explicit 2026-09-02 decision on the
                                 issue. Same flyout-column mechanism as the other tool panels above
                                 (Step 9's generic tool belt still isn't built, Git #2200) — columns 10-11
                                 since several sibling tool builds landed concurrently and took columns
                                 4-9. -->
                            <Border x:Name="PsPanel" Grid.Column="10" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="280">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE711;" Cursor="Hand"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                       MouseLeftButtonDown="BtnTogglePs_Click"/>
                                            <TextBlock Text="&#xE756;" Margin="0,0,8,0" VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4f8ff0"/>
                                            <TextBlock Text="PowerShell" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>

                                    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <TextBox x:Name="PsInputBox" Height="28" Padding="7,0"
                                                 VerticalContentAlignment="Center"
                                                 Background="{StaticResource Brush.Claude.Bg.Content}"
                                                 BorderBrush="{StaticResource Brush.Claude.Border}"
                                                 Foreground="#4f8ff0"
                                                 CaretBrush="{StaticResource Brush.Claude.Text.Bright}"
                                                 FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.10.5}"
                                                 PreviewKeyDown="PsInputBox_PreviewKeyDown"/>
                                    </Border>

                                    <ScrollViewer x:Name="PsOutputScroll" VerticalScrollBarVisibility="Auto" MinHeight="80">
                                        <StackPanel x:Name="PsLinesPanel" Margin="8"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Git #2216 — §6.8 Terminal mini panel: the same real-session mechanism as
                                 PsPanel above, backed by a real cmd.exe child process instead of
                                 powershell.exe. Identical layout, different prompt/colour per the spec
                                 ("$" #6ee7b7 vs "PS>" #4f8ff0). -->
                            <Border x:Name="TerminalPanel" Grid.Column="11" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="280">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE711;" Cursor="Hand"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                       MouseLeftButtonDown="BtnToggleTerminal_Click"/>
                                            <TextBlock Text="&#xE756;" Margin="0,0,8,0" VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#6ee7b7"/>
                                            <TextBlock Text="Terminal" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>

                                    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <TextBox x:Name="TerminalInputBox" Height="28" Padding="7,0"
                                                 VerticalContentAlignment="Center"
                                                 Background="{StaticResource Brush.Claude.Bg.Content}"
                                                 BorderBrush="{StaticResource Brush.Claude.Border}"
                                                 Foreground="#6ee7b7"
                                                 CaretBrush="{StaticResource Brush.Claude.Text.Bright}"
                                                 FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.10.5}"
                                                 PreviewKeyDown="TerminalInputBox_PreviewKeyDown"/>
                                    </Border>

                                    <ScrollViewer x:Name="TerminalOutputScroll" VerticalScrollBarVisibility="Auto" MinHeight="80">
                                        <StackPanel x:Name="TerminalLinesPanel" Margin="8"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Git #2220 — API Runner / Graph Read / Graph Write mini panel (§6.3). One panel,
                                 three modes, launched from three separate wrench-menu entries (BtnToggleApiExplorer,
                                 mode passed in) that share this one column — same bolt-on-flyout mechanism as
                                 StatDetailPanel/LogPeekPanel/SqlRunnerPanel/GitMapPanel above. Real audit: #2202
                                 (the full explorer document + ITokenBroker/GatedProfile) is NOT landed as of this
                                 build, so auth/endpoint execution is self-contained here (Services/ApiExplorerService.cs)
                                 rather than reading a store that doesn't exist yet — see that file's header comment.
                                 Column 12 — GdMini/Ps/Terminal (#2216/#2218) landed concurrently and took 9-11. -->
                            <Border x:Name="ApiExplorerPanel" Grid.Column="12" ClipToBounds="True"
                                    Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Claude.Border}">
                                <DockPanel Width="320">
                                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE711;" Cursor="Hand"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                       MouseLeftButtonDown="BtnToggleApiExplorer_CloseClick"/>
                                            <TextBlock x:Name="ApiExplorerTitle" Text="API Runner" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                       FontWeight="{StaticResource FontWeight.Bold}"
                                                       Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Auth row: token-state pill + mode-specific extra (tenant label for Graph,
                                         autofill lock for local) + Get/Refresh token. -->
                                    <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <StackPanel>
                                            <StackPanel x:Name="ApiExplorerAuthExtra" Margin="0,0,0,6"/>
                                            <DockPanel>
                                                <Border x:Name="ApiExplorerTokenPill" DockPanel.Dock="Left" CornerRadius="99"
                                                        Padding="8,3" Margin="0,0,6,0"
                                                        Background="{StaticResource Brush.Claude.Bg.Button}">
                                                    <TextBlock x:Name="ApiExplorerTokenPillText" Text="No token" FontSize="9.5"
                                                               FontFamily="{StaticResource FontFamily.Monospace}"
                                                               Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                                </Border>
                                                <Button x:Name="BtnApiExplorerToken" Width="Auto" Height="24" Padding="8,3"
                                                        HorizontalAlignment="Right"
                                                        Style="{StaticResource PanelCollapseButton}"
                                                        Click="BtnApiExplorerToken_Click">
                                                    <TextBlock x:Name="ApiExplorerTokenBtnLabel" Text="Get token" FontSize="10"
                                                               FontFamily="{StaticResource FontFamily.Sans}"
                                                               FontWeight="{StaticResource FontWeight.SemiBold}"/>
                                                </Button>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Selected endpoint + write-safety + send/copy (bottom-docked, always visible). -->
                                    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0"
                                            BorderBrush="{StaticResource Brush.Claude.Border}">
                                        <StackPanel>
                                            <StackPanel x:Name="ApiExplorerSelectedPanel" Margin="0,0,0,7"/>

                                            <!-- Write safety segmented control — write mode only. DRY RUN is the
                                                 default on every panel open, never remembered as LIVE (§6.3). -->
                                            <UniformGrid x:Name="ApiExplorerWriteSafetyRow" Rows="1" Columns="2"
                                                         Margin="0,0,0,7" Visibility="Collapsed">
                                                <Button x:Name="BtnApiExplorerDryRun" Height="24" Margin="0,0,3,0"
                                                        Background="{StaticResource Brush.Claude.Bg.Content}"
                                                        BorderThickness="1" BorderBrush="{StaticResource Brush.Claude.Border}"
                                                        Click="BtnApiExplorerDryRun_Click">
                                                    <TextBlock Text="DRY RUN" FontSize="9.5" FontWeight="{StaticResource FontWeight.Bold}"
                                                               FontFamily="{StaticResource FontFamily.Monospace}"/>
                                                </Button>
                                                <Button x:Name="BtnApiExplorerLive" Height="24" Margin="3,0,0,0"
                                                        Background="{StaticResource Brush.Claude.Bg.Content}"
                                                        BorderThickness="1" BorderBrush="{StaticResource Brush.Claude.Border}"
                                                        Click="BtnApiExplorerLive_Click">
                                                    <TextBlock Text="LIVE" FontSize="9.5" FontWeight="{StaticResource FontWeight.Bold}"
                                                               FontFamily="{StaticResource FontFamily.Monospace}"/>
                                                </Button>
                                            </UniformGrid>

                                            <DockPanel>
                                                <Button x:Name="BtnApiExplorerCopy" DockPanel.Dock="Right" Width="26" Height="26"
                                                        Margin="6,0,0,0" Style="{StaticResource PanelCollapseButton}"
                                                        ToolTip="Copy response" Click="BtnApiExplorerCopy_Click">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                               Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                                                </Button>
                                                <Button x:Name="BtnApiExplorerSend" Height="26" HorizontalAlignment="Stretch"
                                                        Style="{StaticResource PanelCollapseButton}"
                                                        Click="BtnApiExplorerSend_Click">
                                                    <TextBlock Text="Send" FontFamily="{StaticResource FontFamily.Sans}" FontSize="10.5"
                                                               FontWeight="{StaticResource FontWeight.SemiBold}"
                                                               Foreground="{StaticResource Brush.Claude.Accent}"/>
                                                </Button>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Body: search, endpoint list, response — the only part that scrolls
                                         (§6 "every panel's body is flex:1; min-height:0; overflow-y:auto"). -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="10,10,10,10">
                                            <TextBox x:Name="ApiExplorerSearchBox" Height="26" Padding="6,0"
                                                     VerticalContentAlignment="Center" Margin="0,0,0,7"
                                                     Background="{StaticResource Brush.Claude.Bg.Button}"
                                                     BorderBrush="{StaticResource Brush.Claude.Border}"
                                                     Foreground="{StaticResource Brush.Claude.Text.Bright}"
                                                     FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.10}"
                                                     Tag="Search endpoints…"
                                                     TextChanged="ApiExplorerSearchBox_TextChanged"/>
                                            <ScrollViewer MaxHeight="184" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                                <StackPanel x:Name="ApiExplorerEndpointList"/>
                                            </ScrollViewer>
                                            <StackPanel x:Name="ApiExplorerResponsePanel"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Git #2209 §8/§5 — Composer band (band 5, WARM). App-OWNED composer, the one
                             surface tools write into (never auto-send, §5) and the anchor for the per-tab
                             draft dictionary (ChatDrafts keyed by tab id, §8 — a global draft breaks both
                             the tool-writes-to-composer pattern AND the cross-epic flow, so it is a real
                             correctness requirement, not a nicety). "Send to Claude" injects the draft
                             into the live claude.ai composer via the WebView2 DOM bridge; sending clears
                             ONLY this tab's draft. The return-address bar appears when a cross-epic
                             question was written into this tab (§7). -->
                        <Border Grid.Row="4" Background="{StaticResource Brush.Claude.Bg.Chrome}"
                                BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Claude.Border}"
                                Padding="14,10">
                            <StackPanel>
                                <Border x:Name="ComposerReturnBar" Visibility="Collapsed" Margin="0,0,0,8"
                                        CornerRadius="6" Padding="9,6"
                                        Background="{StaticResource Brush.Claude.Bg.Bubble}"
                                        BorderBrush="{StaticResource Brush.Claude.Accent}" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE711;" Cursor="Hand"
                                                   VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource Brush.Claude.Text.Muted}"
                                                   MouseLeftButtonDown="ComposerReturnClear_Click"/>
                                        <TextBlock Text="&#xE72C;" Margin="0,0,7,0" VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource Brush.Claude.Accent}"/>
                                        <TextBlock x:Name="ComposerReturnText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.10.5}"
                                                   Foreground="{StaticResource Brush.Claude.Text.Body}"/>
                                    </DockPanel>
                                </Border>
                                <Border CornerRadius="10" Background="{StaticResource Brush.Claude.Bg.Content}"
                                        BorderBrush="{StaticResource Brush.Claude.Border}" BorderThickness="1" Padding="4">
                                    <DockPanel>
                                        <Button x:Name="BtnComposerSend" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                                                Style="{StaticResource PanelCollapseButton}" Width="Auto" Height="30"
                                                Padding="12,0" Margin="6,0,2,2"
                                                ToolTip="Send this draft to the live claude.ai composer"
                                                Click="BtnComposerSend_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Send" VerticalAlignment="Center" Margin="0,0,5,0"
                                                           FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                                           FontWeight="{StaticResource FontWeight.SemiBold}"
                                                           Foreground="{StaticResource Brush.Claude.Text.Bright}"/>
                                                <TextBlock Text="&#xE72A;" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11" Foreground="{StaticResource Brush.Claude.Accent}"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBox x:Name="ChatComposer" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MaxHeight="120" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                                 Padding="8,6" Background="Transparent"
                                                 Foreground="{StaticResource Brush.Claude.Text.Bright}"
                                                 CaretBrush="{StaticResource Brush.Claude.Accent}"
                                                 FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.12}"
                                                 TextChanged="ChatComposer_TextChanged"/>
                                    </DockPanel>
                                </Border>
                                <TextBlock x:Name="ComposerHint" Margin="4,6,0,0"
                                           Text="Tools and cross-epic answers write here — nothing sends until you click Send."
                                           FontFamily="{StaticResource FontFamily.Sans}" FontSize="9.5"
                                           Foreground="{StaticResource Brush.Claude.Text.Muted}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Git #2472 — mount point for a keep-alive tab that ISN'T a chat: Gemini/Google
                         AI Studio, a product website, or Azure/M365 Admin. No chat chrome (context
                         bar / breadcrumb / composer) belongs here — those are ClaudeChatDock's own
                         real chat surface. This is deliberately bare: just the tab's own live,
                         parked-off-screen-when-inactive WebView2 (see MainWindow.KeepAliveTabs.cs
                         MountKeepAliveView), full-bleed. No real entry point opens one of these tabs
                         yet (see the #2472 finding under #2469) — this exists so the mount point is
                         real and correct the moment one does, rather than a generic browser tab
                         silently rendering nothing under the "— nothing here yet" stub. -->
                    <Grid x:Name="GenericBrowserDock" Visibility="Collapsed">
                        <Grid x:Name="GenericBrowserWebViewHost"/>
                    </Grid>

                    <!-- Git Doctor — Step 13 (wpf-handoff/readme-phase2.md). Real
                         findings from Services/GitDoctorService.cs against the
                         actual repo; no seeded/fabricated data. Header + 3-pane
                         body (findings list | detail | run log & Claude bridge)
                         are built here as a layout skeleton; each ItemsControl-
                         style panel is populated in code-behind (RenderGitDoctor*),
                         same convention as RenderQueue/RenderBuildDetail. -->
                    <Grid x:Name="GitDoctorDock" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,12" Background="{StaticResource Brush.Bg.Window}"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border.Default}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnGitDoctorRecheck" Content="Re-run checks" Margin="8,0,0,0"
                                            Style="{StaticResource PanelCollapseButton}" Width="Auto" Height="32" Padding="12,0"
                                            Click="BtnGitDoctorRecheck_Click"
                                            Foreground="{StaticResource Brush.Text.Primary}"
                                            FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11.5}"/>
                                    <StackPanel Margin="10,0,0,0" HorizontalAlignment="Right">
                                        <Button x:Name="BtnGitDoctorNightmare" Click="BtnGitDoctorNightmare_Click"
                                                Style="{StaticResource PanelCollapseButton}" Width="Auto" Height="38" Padding="16,0"
                                                Background="{StaticResource Brush.Epic.Gate}"
                                                FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.13}"
                                                FontWeight="{StaticResource FontWeight.ExtraBold}">
                                            <TextBlock x:Name="GitDoctorNightmareLabel" Text="End this git nightmare" Foreground="Black"/>
                                        </Button>
                                        <TextBlock x:Name="GitDoctorNightmareSub" HorizontalAlignment="Right" Margin="0,3,0,0"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.9}"
                                                   Foreground="{StaticResource Brush.Text.Dim}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Width="220" Margin="14,0" VerticalAlignment="Center">
                                    <TextBox x:Name="GitDoctorQueryBox" Height="32" Padding="8,0"
                                             VerticalContentAlignment="Center"
                                             Background="{StaticResource Brush.Bg.Card}"
                                             BorderBrush="{StaticResource Brush.Border.Card}"
                                             Foreground="{StaticResource Brush.Text.Heading}"
                                             FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.11.5}"
                                             Tag="Paste a commit hash…"
                                             TextChanged="GitDoctorQueryBox_TextChanged"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.Git}"
                                          Stroke="{StaticResource Brush.Epic.Gate}" Width="18" Height="18" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="GitDoctorHeadline"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.14}"
                                                   FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                   Foreground="{StaticResource Brush.Text.Heading}"/>
                                        <TextBlock x:Name="GitDoctorSubline" Margin="0,3,0,0"
                                                   FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.10}"
                                                   Foreground="{StaticResource Brush.Text.Dim}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="266"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="290"/>
                            </Grid.ColumnDefinitions>

                            <!-- Findings list -->
                            <Border Grid.Column="0" Background="{StaticResource Brush.Bg.Panel}"
                                    BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border.Strong}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="11,9" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Border.Card}">
                                        <DockPanel>
                                            <TextBlock x:Name="GitDoctorOpenCount" DockPanel.Dock="Right"
                                                       FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.9}"
                                                       Foreground="{StaticResource Brush.Text.Dim}"/>
                                            <TextBlock Text="WHAT GIT IS COMPLAINING ABOUT"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.9}"
                                                       FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                       Foreground="{StaticResource Brush.Text.Dim}"/>
                                        </DockPanel>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="GitDoctorFindingsPanel" Margin="6"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Detail -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="GitDoctorDetailPanel" Margin="16,14"/>
                            </ScrollViewer>

                            <!-- Run log + Claude bridge -->
                            <Border Grid.Column="2" Background="{StaticResource Brush.Bg.Panel}"
                                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Border.Strong}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="11,9" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Border.Card}">
                                        <DockPanel>
                                            <TextBlock x:Name="GitDoctorRunningLabel" DockPanel.Dock="Right" Text="RUNNING…"
                                                       Visibility="Collapsed"
                                                       FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.9}"
                                                       FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                       Foreground="{StaticResource Brush.Epic.AppCore}"/>
                                            <TextBlock Text="RUN LOG"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.9}"
                                                       FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                       Foreground="{StaticResource Brush.Text.Dim}"/>
                                        </DockPanel>
                                    </Border>

                                    <Border DockPanel.Dock="Bottom" Padding="11,9" BorderThickness="0,1,0,0"
                                            BorderBrush="{StaticResource Brush.Border.Card}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,7">
                                                <TextBlock DockPanel.Dock="Left" Text="CLAUDE BRIDGE" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.9}"
                                                           FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                           Foreground="{StaticResource Brush.Text.Dim}"/>
                                                <TextBlock x:Name="GitDoctorSendAll" Text="send all findings"
                                                           HorizontalAlignment="Right" Cursor="Hand"
                                                           MouseLeftButtonDown="GitDoctorSendAll_Click"
                                                           Foreground="{StaticResource Brush.Claude.Accent}"
                                                           FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.9.5}"
                                                           FontWeight="{StaticResource FontWeight.Bold}"/>
                                            </DockPanel>
                                            <TextBox x:Name="GitDoctorInboundBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Background="{StaticResource Brush.Bg.Window}"
                                                     BorderBrush="{StaticResource Brush.Border.Card}"
                                                     Foreground="{StaticResource Brush.Text.Heading}"
                                                     FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.10.5}"/>
                                            <Button x:Name="BtnGitDoctorExtract" Content="Extract commands" Margin="0,7,0,0" Height="26"
                                                    Click="BtnGitDoctorExtract_Click"
                                                    Style="{StaticResource PanelCollapseButton}"
                                                    Foreground="{StaticResource Brush.Text.Primary}"
                                                    FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.10.5}"/>
                                            <StackPanel x:Name="GitDoctorPlanPanel" Margin="0,7,0,0"/>
                                            <Button x:Name="BtnGitDoctorRunPlan" Margin="0,7,0,0" Height="28"
                                                    Visibility="Collapsed" Click="BtnGitDoctorRunPlan_Click"
                                                    Background="{StaticResource Brush.Claude.Accent}"
                                                    FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                                    FontWeight="{StaticResource FontWeight.Bold}">
                                                <TextBlock x:Name="GitDoctorRunPlanLabel" Foreground="Black"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="GitDoctorLogPanel" Margin="11,8"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Repo Health — full document, Git #2214 §6.6. Same layout skeleton convention
                         as GitDoctorDock/LogViewerDock above: header (scan line + rescan + rule tiles)
                         + 3-pane body (findings list | detail | markdown work-order preview). Real
                         findings only, from Services/RepoHealthService.cs's live `gh api graphql`
                         scan of this repo's own open issues — no seeded data. -->
                    <Grid x:Name="RepoHealthDock" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,12" Background="{StaticResource Brush.Bg.Window}"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border.Default}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" x:Name="BtnRepoHealthDocRescan" Content="Re-scan"
                                        Style="{StaticResource PanelCollapseButton}" Width="Auto" Height="32" Padding="12,0"
                                        Click="RepoHealthDocRescan_Click"
                                        Foreground="{StaticResource Brush.Text.Primary}"
                                        FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11.5}"/>
                                <UniformGrid DockPanel.Dock="Right" x:Name="RepoHealthDocTiles" Rows="1" Columns="4" Margin="0,0,14,0" Width="440"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.Git}"
                                          Stroke="{StaticResource Brush.Epic.Gate}" Width="18" Height="18" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Repo Health"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.14}"
                                                   FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                   Foreground="{StaticResource Brush.Text.Heading}"/>
                                        <TextBlock x:Name="RepoHealthDocScanLine" Margin="0,3,0,0"
                                                   FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.10}"
                                                   Foreground="{StaticResource Brush.Text.Dim}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Findings list — every open finding, grouped by rule, with the same
                                 capped-5-checkbox selection as the mini panel (shared state). -->
                            <Border Grid.Column="0" Background="{StaticResource Brush.Bg.Panel}"
                                    BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border.Strong}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="11,9" BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource Brush.Border.Card}">
                                        <TextBlock Text="ALL OPEN FINDINGS"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.9}"
                                                   FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                   Foreground="{StaticResource Brush.Text.Dim}"/>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="RepoHealthDocFindingsPanel" Margin="6"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Detail + markdown work-order preview -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="RepoHealthDocDetailPanel" Margin="16,14"/>
                                </ScrollViewer>
                                <Border Grid.Row="1" Padding="16,10" BorderThickness="0,1,0,0"
                                        BorderBrush="{StaticResource Brush.Border.Card}">
                                    <Button x:Name="BtnRepoHealthDocSendToChat" HorizontalAlignment="Right"
                                            Width="Auto" Height="32" Padding="14,0"
                                            Style="{StaticResource PanelCollapseButton}"
                                            Click="BtnRepoHealthSendToChat_Click">
                                        <TextBlock x:Name="RepoHealthDocSendToChatLabel" Text="Send 0 to this chat"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                                   Foreground="{StaticResource Brush.Text.Primary}"/>
                                    </Button>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Log Viewer — Step 10 (wpf-handoff/readme-phase2.md), corrected by
                         issue #2200's 2026-09-02 comment (per-source level handling, not one
                         uniform InferLevel pass). Header (streaming 3-way switch + status
                         pill) + left rail (Sources/Archive) | center stream | right inspector,
                         same layout skeleton convention as GitDoctorDock above — a static XAML
                         shell with named panels populated in code-behind (RenderLogViewer*).
                         Step 9's Tab Workspaces (a "Logs" workspace grouping) is real design
                         but not yet built in code (real audit, Git #2200), so this bolts on as
                         its own document exactly like Git Doctor did before it, rather than
                         waiting on that grouping infrastructure. -->
                    <Grid x:Name="LogViewerDock" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,10" Background="{StaticResource Brush.Bg.Window}"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border.Default}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="LogViewerStreamSwitch" Orientation="Horizontal" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="LogViewerStatusPill" VerticalAlignment="Center" Padding="8,3"
                                               FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.10}"
                                               FontWeight="{StaticResource FontWeight.Bold}"
                                               Foreground="{StaticResource Brush.Text.Dim}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,12,0" Fill="{StaticResource Brush.LogSource.Console}"/>
                                    <TextBlock Text="Log Viewer"
                                               FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.14}"
                                               FontWeight="{StaticResource FontWeight.ExtraBold}"
                                               Foreground="{StaticResource Brush.Text.Heading}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left rail — Sources / Archive tabs -->
                            <Border Grid.Column="0" Background="{StaticResource Brush.Bg.Panel}"
                                    BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border.Strong}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,0">
                                        <Button x:Name="BtnLogViewerRailSources" Content="Sources" Width="Auto" Height="26" Padding="10,0" Margin="0,0,4,0"
                                                Style="{StaticResource PanelCollapseButton}" Click="BtnLogViewerRailSources_Click"
                                                FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.10.5}"/>
                                        <Button x:Name="BtnLogViewerRailArchive" Content="Archive" Width="Auto" Height="26" Padding="10,0"
                                                Style="{StaticResource PanelCollapseButton}" Click="BtnLogViewerRailArchive_Click"
                                                FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.10.5}"/>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="LogViewerRailContent" Margin="8"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Center — filter bar + scrubber + stream -->
                            <DockPanel Grid.Column="1">
                                <Border x:Name="LogViewerArchiveBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                                        Padding="14,8" Background="{StaticResource Brush.Gate.Bg}"
                                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Gate.Border}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="Back to live sources" Cursor="Hand"
                                                   MouseLeftButtonDown="LogViewerCloseArchiveBanner_Click"
                                                   Foreground="{StaticResource Brush.Gate.Accent}"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.10.5}"
                                                   FontWeight="{StaticResource FontWeight.Bold}"/>
                                        <TextBlock x:Name="LogViewerArchiveBannerText"
                                                   FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.10.5}"
                                                   Foreground="{StaticResource Brush.Gate.Accent}"/>
                                    </DockPanel>
                                </Border>

                                <Border DockPanel.Dock="Top" Padding="12,10" BorderThickness="0,0,0,1"
                                        BorderBrush="{StaticResource Brush.Border.Card}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="180"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="LogViewerSearchBox" Grid.Column="0" Height="28" Padding="8,0" Margin="0,0,6,0"
                                                     VerticalContentAlignment="Center"
                                                     Background="{StaticResource Brush.Bg.Card}"
                                                     BorderBrush="{StaticResource Brush.Border.Card}"
                                                     Foreground="{StaticResource Brush.Text.Heading}"
                                                     FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.11.5}"
                                                     Tag="Search (plain text)…"
                                                     TextChanged="LogViewerSearchBox_TextChanged"/>
                                            <Button x:Name="BtnLogViewerRegex" Grid.Column="1" Content=".*" Width="30" Height="28" Margin="0,0,6,0"
                                                    Style="{StaticResource PanelCollapseButton}" Click="BtnLogViewerRegex_Click"
                                                    ToolTip="Treat search as a regular expression"
                                                    FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.11}"/>
                                            <TextBox x:Name="LogViewerExcludeBox" Grid.Column="2" Height="28" Padding="8,0"
                                                     VerticalContentAlignment="Center"
                                                     Background="{StaticResource Brush.Bg.Card}"
                                                     BorderBrush="{StaticResource Brush.Border.Card}"
                                                     Foreground="{StaticResource Brush.Alert.Danger.Border}"
                                                     FontFamily="{StaticResource FontFamily.Monospace}" FontSize="{StaticResource FontSize.11}"
                                                     Tag="exclude, comma, separated…"
                                                     TextChanged="LogViewerExcludeBox_TextChanged"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">

                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border.Default}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0"
                                           Foreground="{StaticResource Brush.Accent.Primary}"/>

                                                    FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.9}"
                                                    FontWeight="{StaticResource FontWeight.ExtraBold}"/>
                                            <StackPanel x:Name="LogViewerSavedFilters" Orientation="Horizontal" Margin="0,0,10,0"/>
                                            <TextBlock Text="save current" Cursor="Hand" VerticalAlignment="Center"
                                                       MouseLeftButtonDown="LogViewerSaveCurrentFilter_Click"
                                                       Foreground="{StaticResource Brush.Claude.Accent}"
                                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.9.5}"

                                    <TextBlock Text="Settings" Margin="0,0,12,0"
                                               FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.14}"
                                               FontWeight="{StaticResource FontWeight.ExtraBold}"

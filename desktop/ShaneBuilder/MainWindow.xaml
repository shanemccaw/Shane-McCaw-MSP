                                    <TextBlock x:Name="GitItemDocTitleText" Text="Git item" FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.14}"
                                               FontWeight="{StaticResource FontWeight.ExtraBold}"
                                               Foreground="{StaticResource Brush.Text.Heading}"/>

                                        <StackPanel x:Name="LogViewerLineDetail" Margin="11,9"/>
                                    </ScrollViewer>

                                    <Border DockPanel.Dock="Bottom" Padding="11,9" BorderThickness="0,1,0,0"
                                            BorderBrush="{StaticResource Brush.Border.Card}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,7">
                                                <TextBlock DockPanel.Dock="Left" Text="SCRATCH PAD" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.9}"
                                                           FontWeight="{StaticResource FontWeight.ExtraBold}"
                                                           Foreground="{StaticResource Brush.Text.Dim}"/>
                                                <TextBlock x:Name="LogViewerScratchCopy" Text="copy" HorizontalAlignment="Right" Cursor="Hand"
                                                           Margin="0,0,10,0"
                                                           MouseLeftButtonDown="LogViewerScratchCopy_Click"
                                                           Foreground="{StaticResource Brush.Claude.Accent}"
                                                           FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.9.5}"

                    <!-- Git #2213 — Git Map full document. Real audit: README-ClaudeChat.md, the
                         doc that would define this document's OWN distinct layout, does not exist
                         in the repo (git history search came back empty; tracked at #2227, still
                         open). Rather than invent a layout, this reuses the EXACT SAME card-render
                         methods the mini panel uses (single-source, per #2213's hard constraint) in
                         a single wide column — real data, honestly plain layout. -->
                    <Grid x:Name="GitMapDock" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,10" Background="{StaticResource Brush.Bg.Window}"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border.Default}">

                         populated in code-behind from the real ISettingsStore, same "layout
                         skeleton here, Render* builds the rows" convention as Git Doctor/Repo
                         Health above. -->
                    <Grid x:Name="SettingsDock" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,11" Background="{StaticResource Brush.Bg.Window}"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border.Default}">
                            <DockPanel LastChildFill="True">
                                <TextBox x:Name="SettingsSearchBox" DockPanel.Dock="Right" Width="260" Height="28"
                                         VerticalContentAlignment="Center" Padding="10,0"
                                         Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Card}"
                                         Foreground="{StaticResource Brush.Text.Heading}"
                                         FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.11}"
                                         TextChanged="SettingsSearchBox_TextChanged"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource RailIconPath}" Data="{StaticResource Icon.Settings}"

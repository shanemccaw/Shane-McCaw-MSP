                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SettingsRailColumn" Width="214"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource Brush.Bg.Panel}"
                                    BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border.Strong}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SettingsRailPanel" Margin="6,8"/>
                                </ScrollViewer>
                            </Border>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SettingsContentPanel" Margin="18,14" MaxWidth="660" HorizontalAlignment="Left"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </DockPanel>

            <!-- Build detail flyout — slides out from the Build Queue panel's
                 LEFT edge, per mockup's buildDetailPanelStyle (line 2277):
                 0px closed / 320px normal / fills the document area when
                 expanded. Content is built in code-behind (RenderBuildDetail)
                 since it depends on which QueueItem is selected. -->
            <Border x:Name="BuildDetailPanel" Grid.Column="3" Background="{StaticResource Brush.Bg.Card}"
                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Border.Default}"
                    ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource Brush.Border.Default}">
                        <DockPanel VerticalAlignment="Center">
                            <StackPanel x:Name="BuildDetailActions" DockPanel.Dock="Right" Orientation="Horizontal"/>
                            <TextBlock x:Name="BuildDetailNum" Text="#0000" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Accent.IssueNum}"
                                       FontFamily="{StaticResource FontFamily.Monospace}"
                                       FontSize="{StaticResource FontSize.13}"
                                       FontWeight="{StaticResource FontWeight.ExtraBold}"/>
                            <StackPanel x:Name="BuildDetailStatusHost" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BuildDetailBody" Margin="0,0,0,12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Build Queue panel — 348px open / 40px collapsed, per
                 mockup's queuePanelStyle (line 2370). Defaults to OPEN
                 (Shane: "that right panel should always be extended by
                 default") — the mockup's own collapsed-by-default doesn't
                 apply here. -->
            <Border x:Name="BuildQueuePanel" Grid.Column="4" Width="348" Background="{StaticResource Brush.Bg.Panel}"
                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Border.Default}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource Brush.Border.Default}">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="BtnToggleQueue" Style="{StaticResource PanelCollapseButton}"
                                        ToolTip="Collapse Build Queue" Click="BtnToggleQueue_Click">
                                    <TextBlock x:Name="BtnToggleQueueIcon" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                </Button>
                                <TextBlock x:Name="QueuePanelTitle" Text="Build Queue" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Text.Heading}"
                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                           FontSize="{StaticResource FontSize.12}"
                                           FontWeight="{StaticResource FontWeight.Bold}"/>
                            </StackPanel>

                            <!-- Active/Paused + Lens chip — per mockup lines 1024-1025.
                                 Active/Paused toggles a real (if only locally-tracked)
                                 queue-paused flag; the Lens chip is a placeholder for
                                 Filter Studio, which Shane is architecting separately —
                                 it's a real, clickable entry point, but the click just
                                 says so rather than opening a feature that doesn't
                                 exist yet. -->
                            <StackPanel x:Name="QueueHeaderActions" DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border x:Name="BtnQueueActivePaused" CornerRadius="5" Padding="7,3" Margin="0,0,6,0"
                                        Cursor="Hand" MouseLeftButtonDown="BtnQueueActivePaused_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="QueueActivePausedIcon" Margin="0,0,4,0" VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                                        <TextBlock x:Name="QueueActivePausedText" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.10.5}"
                                                   FontWeight="{StaticResource FontWeight.Bold}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Brush.Bg.Chip}" BorderBrush="{StaticResource Brush.Border.Default}"
                                        BorderThickness="1" CornerRadius="5" Padding="7,3" Cursor="Hand"
                                        ToolTip="Filter Studio — Ctrl+Shift+F"
                                        MouseLeftButtonDown="BtnLensChip_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE81E;" Margin="0,0,4,0" VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   Foreground="{StaticResource Brush.Text.Muted}"/>
                                        <TextBlock Text="Lens" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.10.5}"
                                                   FontWeight="{StaticResource FontWeight.Bold}"
                                                   Foreground="{StaticResource Brush.Text.Muted}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Build Queue body — grouped Build Set cards, each a
                         vertical timeline of build cards, per README's
                         "Build Queue panel" spec. BuildConsole's own
                         Controls/BuildQueuePanel.xaml.cs (BuildQueueCard) is
                         the proven mechanism this borrows — status pill per
                         state, issue-number badge, model/effort badge — but
                         recolored onto THIS app's own theme (Brush.Status.*
                         / Brush.NextUp.*) rather than BuildConsole's
                         Catppuccin one; card content is built in code-behind
                         (RenderQueue) since a card's colors depend on its
                         status. No real queue backend exists yet, so it
                         starts empty rather than showing invented builds. -->
                    <Grid x:Name="QueuePanelBody">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="QueueSetsHost" Margin="10,8"/>
                        </ScrollViewer>
                        <TextBlock x:Name="QueueEmptyText" Margin="14,16,14,0"
                                   TextWrapping="Wrap"
                                   Text="No builds in the queue yet."
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Foreground="{StaticResource Brush.Text.Dim}"
                                   FontFamily="{StaticResource FontFamily.Sans}"
                                   FontSize="{StaticResource FontSize.11}"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>

    <!-- Git #2470 — keep-alive park canvas. Each keep-alive tab (a claude.ai chat, and
         later Gemini/product-site/Azure-M365 browser tabs) owns its own persistent
         WebView2; when its tab isn't the active one, that view is parked HERE, shrunk to
         1×1 at (-20000,-20000) — the load-bearing #982 fix, ported verbatim from
         desktop/BuildConsole/MainWindow.ShelvedTabs.cs: a WebView2 is an HwndHost whose
         surface only leaves view on a real SIZE change (z-order/visibility can't occlude
         it), and 1×1 is NONZERO so CoreWebView2 is never torn down — the session stays
         warm/logged-in. ClipToBounds clips the parked child fully out of view; the canvas
         never takes hits. The ACTIVE tab's view is reparented OUT of here into
         ChatWebViewHost (inside the chat dock) — reflow only, never a reload. -->
    <Canvas x:Name="KeepAliveHostCanvas" IsHitTestVisible="False" ClipToBounds="True"/>

    <!-- Command Palette — Ctrl+K anywhere, or click the search trigger.
         Searches real data only: open tabs and queue items (_tabs /
         _queueItems), plus a couple of quick actions that actually do
         something (open a tab, toggle the Build Queue panel) — no fabricated
         results. Selecting an epic/build result opens the matching real UI
         (SelectTab / OpenBuildDetail), same as the mockup's own palette
         result actions. -->
    <Border x:Name="CommandPaletteOverlay" Visibility="Collapsed"
            Background="#BF000000" MouseLeftButtonDown="CommandPaletteOverlay_Click">
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                Width="900" Height="560"
                Background="{StaticResource Brush.Bg.Window}"
                BorderBrush="{StaticResource Brush.Border.Popover}" BorderThickness="1"
                CornerRadius="12" MouseLeftButtonDown="CommandPaletteDialog_Click">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="12" Opacity="0.6"/>
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,14" BorderThickness="0,0,0,1"
                        BorderBrush="{StaticResource Brush.Border.Default}">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Margin="0,0,10,0" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource Brush.Text.Dim}"/>
                        <Border DockPanel.Dock="Right" Background="{StaticResource Brush.Bg.Chip}"
                                BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1"
                                CornerRadius="5" Padding="8,3" Cursor="Hand" Margin="8,0,0,0"
                                MouseLeftButtonDown="CommandPaletteEsc_Click">
                            <TextBlock Text="ESC" FontFamily="{StaticResource FontFamily.Sans}" FontSize="9"
                                       FontWeight="{StaticResource FontWeight.Bold}"
                                       Foreground="{StaticResource Brush.Text.Muted}"/>
                        </Border>
                        <Grid>
                            <TextBox x:Name="CommandPaletteInput" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Brush.Text.Heading}"
                                     FontFamily="{StaticResource FontFamily.Monospace}" FontSize="14"
                                     CaretBrush="{StaticResource Brush.Text.Heading}"
                                     TextChanged="CommandPaletteInput_TextChanged"
                                     PreviewKeyDown="CommandPaletteInput_PreviewKeyDown"/>
                            <TextBlock x:Name="CommandPalettePlaceholder" IsHitTestVisible="False"
                                       Text="Search epics, builds, and chats — # for issue number"
                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="{StaticResource FontSize.13}"
                                       Foreground="{StaticResource Brush.Text.Dim}"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Category tabs — Git #2203: every category now has a real backing data
                     source (Git Epics/Issues off live `gh`, Builds/Build IDs off real
                     bt_build_queue rows, Claude & URLs off _tabs, Services off
                     scripts/dev-all.mjs's own .meta.json, Terminal/SQL off real live
                     sessions) except Files, which stays an honest (0) — Tab Workspaces
                     (Step 9) isn't built yet and Step 14's own contract doesn't list it. -->
                <Border DockPanel.Dock="Top" Padding="14,8" BorderThickness="0,0,0,1"
                        BorderBrush="{StaticResource Brush.Border.Default}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CommandPaletteCategories" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Border>

                <!-- Footer hint bar -->
                <Border DockPanel.Dock="Bottom" Padding="14,7" BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource Brush.Border.Default}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Esc Close"
                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="9.5"
                                   Foreground="{StaticResource Brush.Text.Dim}"/>
                        <TextBlock Text="↑↓ Navigate    ↵ Select    Tab Switch Category"
                                   FontFamily="{StaticResource FontFamily.Sans}" FontSize="9.5"
                                   Foreground="{StaticResource Brush.Text.Dim}"/>
                    </DockPanel>
                </Border>

                <!-- Git #2203 — bounded grid: Height="*" on the (only) row + the two column
                     ScrollViewers give the body one real scroll region each, so a per-category
                     right pane (Git Epics' contains tiles, a build's last-10 stdout lines, a
                     SQL result table) can genuinely grow past 300px without pushing its own
                     primary buttons outside the dialog — the reference README's own "grid-
                     template-rows: minmax(0,1fr) + overflow:hidden" fix, ported to WPF as
                     Grid.RowDefinitions="*" + ScrollViewer per column instead of a bare Grid. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Quick-action tiles — only the actions that are genuinely
                                 real in ShaneBuilder today, not the reference's
                                 BuildConsole-specific ones (Git Pull / Paste Manual
                                 Build / Recover Builds don't exist here). -->
                            <WrapPanel x:Name="CommandPaletteTiles" Margin="12,12,12,0"/>
                            <StackPanel x:Name="CommandPaletteResults" Margin="8"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="0" Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Border.Default}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CommandPalettePreview" Margin="16"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Border>

    <!-- Filter Studio — Ctrl+Shift+F or the Lens chip. Built against the real
         spec in docs/Filter Studio &amp; Lenses.md. Layout follows
         docs/fs-overlay-stash.txt: scope rail | facet panel | live-impact +
         lenses. Only Build Queue is a real registered surface right now
         (state/build-set/search facets actually filter QueueSetsHost);
         Chats Pane / Git Board / Batter Up are shown per the doc's scope
         model but sit under "Awaiting Registration" — no real surface to
         filter yet, not a fabricated one. -->
    <Border x:Name="FilterStudioOverlay" Visibility="Collapsed"
            Background="#C7020A0A" MouseLeftButtonDown="FilterStudioOverlay_Click">
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,44,0,20"
                Width="1050" Height="620"
                Background="{StaticResource Brush.Bg.Terminal}"
                BorderBrush="{StaticResource Brush.Border.Popover}" BorderThickness="1"
                CornerRadius="14" MouseLeftButtonDown="FilterStudioDialog_Click">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="50" ShadowDepth="14" Opacity="0.65"/>
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="18,13" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border.Popover}">
                    <DockPanel VerticalAlignment="Center">
                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0"
                                Background="{StaticResource Brush.Bg.Chip}" BorderBrush="{StaticResource Brush.Accent.Active}" BorderThickness="1">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Accent.Active}"/>
                        </Border>
                        <Border DockPanel.Dock="Right" Background="{StaticResource Brush.Bg.Chip}"
                                BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1"
                                CornerRadius="5" Padding="9,3" Cursor="Hand"
                                MouseLeftButtonDown="FilterStudioEsc_Click">
                            <TextBlock Text="ESC" FontFamily="{StaticResource FontFamily.Monospace}" FontSize="9.5"
                                       FontWeight="{StaticResource FontWeight.Bold}"
                                       Foreground="{StaticResource Brush.Text.Muted}"/>
                        </Border>
                        <Border x:Name="FilterStudioResetButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                                Background="{StaticResource Brush.Alert.Danger.Bg}" BorderBrush="{StaticResource Brush.Alert.Danger.Border}"
                                BorderThickness="1" CornerRadius="5" Padding="9,3" Cursor="Hand" Visibility="Collapsed"
                                MouseLeftButtonDown="FilterStudioResetAll_Click">
                            <TextBlock Text="Reset everything" FontFamily="{StaticResource FontFamily.Sans}" FontSize="10"
                                       FontWeight="{StaticResource FontWeight.Bold}"
                                       Foreground="{StaticResource Brush.Alert.Danger.Border}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Filter Studio" FontFamily="{StaticResource FontFamily.Sans}" FontSize="13.5"
                                           FontWeight="{StaticResource FontWeight.Bold}" Foreground="{StaticResource Brush.Text.Heading}"/>
                                <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="99"
                                        Background="{StaticResource Brush.Bg.Chip}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                                    <TextBlock x:Name="FilterStudioRegistryLabel"
                                               FontFamily="{StaticResource FontFamily.Monospace}" FontSize="8.5"
                                               FontWeight="{StaticResource FontWeight.Bold}" Foreground="{StaticResource Brush.Text.Muted}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="One lens for every surface — filter and sort globally, or target a panel."
                                       FontFamily="{StaticResource FontFamily.Sans}" FontSize="10.5" Margin="0,1,0,0"
                                       Foreground="{StaticResource Brush.Text.Dim}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border.Popover}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" x:Name="FilterStudioSummary"
                                   FontFamily="{StaticResource FontFamily.Monospace}" FontSize="9" Foreground="{StaticResource Brush.Text.Dim}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Esc Close    Ctrl+Shift+F Toggle    Enter Applies search"
                                       FontFamily="{StaticResource FontFamily.Monospace}" FontSize="9" Foreground="{StaticResource Brush.Text.Dim}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="198"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Brush.Border.Popover}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="FilterStudioScopeList" Margin="8"/>
                        </ScrollViewer>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FilterStudioFacetHost" Margin="16"/>
                    </ScrollViewer>

                    <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Border.Popover}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="FilterStudioImpactHost" Margin="12"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Border>
    </Grid>
</Window>

<Window x:Class="ShaneBuilder.NewChatAnchorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="New Chat"
        Width="440" MinHeight="260" MaxHeight="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource Brush.Bg.Window}"
        KeyDown="Window_KeyDown">

    <!-- Git #2321 (Feature #2318 item 3) — the real anchor disclosure OpenNewChatFlow shows
         before navigating to claude.ai/new. Same real custom-chrome pattern as AppDialog
         (WindowChromeHelper, #2147 tokens) — this one adds a scrollable list host instead of a
         message/textbox body, since its real content is the live Feature list, not static text. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="0"
                             GlassFrameThickness="-1"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Chip}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.13}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Border.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCaptionCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Alert.Danger.Border}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Heading}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
        <DockPanel LastChildFill="True" Background="{StaticResource Brush.Bg.Window}">
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource Brush.Bg.Panel}"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    BorderThickness="0,0,0,1"
                    Height="36">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="New Chat" Margin="14,0,0,0"
                               VerticalAlignment="Center" FontSize="{StaticResource FontSize.13}" FontWeight="{StaticResource FontWeight.SemiBold}"
                               Foreground="{StaticResource Brush.Text.Primary}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnCloseWindow" Style="{StaticResource DialogCaptionCloseButton}" ToolTip="Close" Click="BtnCloseWindow_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
                <Button x:Name="BtnDecideLater" Content="No feature yet — decide later" Style="{StaticResource DialogButton}" Padding="14,6" Margin="0,0,8,0" Click="BtnDecideLater_Click"/>
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource DialogButton}" Padding="14,6" IsCancel="True" Click="BtnCancel_Click"/>
            </StackPanel>

            <Grid Margin="20,18,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="This chat's work gets tracked against a Feature — pick the one it's anchored to. The Feature's Epic and current state are shown alongside each one."
                           TextWrapping="Wrap"
                           FontSize="{StaticResource FontSize.12}"
                           Foreground="{StaticResource Brush.Text.Muted}"/>

                <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,12,0,0"
                           Text="Loading active features…"
                           FontSize="{StaticResource FontSize.11.5}"
                           FontStyle="Italic"
                           Foreground="{StaticResource Brush.Text.Dim}"
                           Visibility="Collapsed"/>

                <ScrollViewer Grid.Row="2" Margin="0,10,0,16" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                    <StackPanel x:Name="FeatureListHost"/>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>

<Window x:Class="ShaneBuilder.RegionSelectOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Draw a region to capture"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="#40000000"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <!-- Git #2210 — ported from desktop/BuildConsole/RegionSelectOverlayWindow.xaml (Git #1866),
         desktop-mode only (BuildConsole's original also serves a WebView2 DIP-relative crop mode for
         its Visual Test Tracker; ShaneBuilder has no such caller, so that half was left behind rather
         than carried over unused). Caller calls ConfigureForVirtualScreen() then ShowDialog(); a drag
         draws the selection box and the result comes back in PHYSICAL screen pixels via
         SelectedPhysicalRect, read straight from the Win32 cursor position rather than WPF's
         per-visual-root DIP mapping — see the code-behind's class doc for why that's what sidesteps
         the per-monitor-DPI trap. Esc or right-click cancels (DialogResult=false).
         Background MUST be a non-null brush (Transparent works) or the Canvas is NOT hit-test-visible
         over its empty area, so MouseLeftButtonDown/Move/Up never fire when you press on the dim
         overlay (BuildConsole's Git #1888) — Transparent keeps the dim (drawn by the Window behind
         this Canvas) fully visible while making the whole overlay area catch the drag. -->
    <Canvas x:Name="RootCanvas"
            Background="Transparent"
            MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
            MouseMove="RootCanvas_MouseMove"
            MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp"
            MouseRightButtonDown="RootCanvas_MouseRightButtonDown">
        <TextBlock Canvas.Left="12" Canvas.Top="12"
                   Text="Drag to select a region — Esc or right-click to cancel"
                   Foreground="White" FontSize="13" FontWeight="SemiBold"
                   Background="#80000000" Padding="6,3,6,3"/>
        <Rectangle x:Name="SelectionRect"
                   Stroke="{DynamicResource Brush.Accent.Primary}" StrokeThickness="2"
                   Fill="#337C8CF0"
                   Visibility="Collapsed"/>
    </Canvas>
</Window>

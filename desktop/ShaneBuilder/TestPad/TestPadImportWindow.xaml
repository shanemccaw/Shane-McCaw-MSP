<Window x:Class="ShaneBuilder.TestPadImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Import from Notepad"
        Width="480" MinHeight="360" MaxHeight="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource Brush.Bg.Window}"
        KeyDown="Window_KeyDown">

    <!-- Git #2343 (Feature: Test Pad, #2326) — "Import: paste a whole Notepad file." Same real
         custom-chrome dialog pattern as NewChatAnchorDialog (WindowChromeHelper, #2147 tokens).
         Two-stage body: a paste box (Stage 1), and once Parse runs, a preview list of the
         candidate notes TestPadImportParser split out (Stage 2) with an Import button that files
         them into TestPadService. The header-stats line, per-row type-chip correction, and
         merge-up UI (#2350-#2354) extend PreviewHost/PreviewHeaderText in place. #2352's
         per-row "↑ merge up" chip lives inside each row (TestPadImportWindow.xaml.cs
         BuildPreviewRow) rather than as a separate element here. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="0"
                             GlassFrameThickness="-1"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Chip}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.13}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Border.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Primary}"/>
        </Style>

        <Style x:Key="DialogCaptionCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Alert.Danger.Border}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Heading}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
        <DockPanel LastChildFill="True" Background="{StaticResource Brush.Bg.Window}">
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource Brush.Bg.Panel}"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    BorderThickness="0,0,0,1"
                    Height="36">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Import from Notepad" Margin="14,0,0,0"
                               VerticalAlignment="Center" FontSize="{StaticResource FontSize.13}" FontWeight="{StaticResource FontWeight.SemiBold}"
                               Foreground="{StaticResource Brush.Text.Primary}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnCloseWindow" Style="{StaticResource DialogCaptionCloseButton}" ToolTip="Close" Click="BtnCloseWindow_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource DialogButton}" Padding="14,6" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnParse" Content="Parse" Style="{StaticResource DialogButton}" Padding="14,6" Margin="0,0,8,0" Click="BtnParse_Click"/>
                <Button x:Name="BtnImport" Content="Import" Style="{StaticResource DialogPrimaryButton}" Padding="14,6" Click="BtnImport_Click" IsEnabled="False"/>
            </StackPanel>

            <Grid Margin="20,18,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Paste a whole Notepad file below, then Parse. Each blank-line-separated block becomes a note; a leading !/?/+/. still sets its type."
                           TextWrapping="Wrap"
                           FontSize="{StaticResource FontSize.12}"
                           Foreground="{StaticResource Brush.Text.Muted}"/>

                <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="6"
                        Background="{StaticResource Brush.Bg.Chip}"
                        BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                    <TextBox x:Name="PasteBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="140" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Padding="8,6" Background="Transparent"
                             Foreground="{StaticResource Brush.Text.Primary}"
                             CaretBrush="{StaticResource Brush.Text.Primary}"
                             FontSize="11.5"/>
                </Border>

                <TextBlock x:Name="PreviewHeaderText" Grid.Row="2" Margin="0,12,0,4"
                           FontSize="{StaticResource FontSize.11.5}" FontWeight="{StaticResource FontWeight.SemiBold}"
                           Foreground="{StaticResource Brush.Text.Muted}"
                           TextWrapping="Wrap"
                           Text="" Visibility="Collapsed"/>

                <!-- Git #2353 (Feature: Test Pad, #2326) — "Import: multi-select tick boxes with
                     Merge N up." One tick box per row (BuildPreviewRow's select checkbox, distinct
                     from the Include checkbox) feeds this bar: it shows the live selected count and
                     a single button that merges every selected row up into whatever unselected row
                     precedes the topmost selection. Collapsed until at least one row is selected. -->
                <Border Grid.Row="3" x:Name="MergeBar" Margin="0,0,0,6" Visibility="Collapsed"
                        CornerRadius="6" Padding="8,5" Background="{StaticResource Brush.Bg.Chip}"
                        BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="MergeBarText" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSize.11.5}"
                                   Foreground="{StaticResource Brush.Text.Muted}" Text=""/>
                        <Button x:Name="BtnMergeUp" DockPanel.Dock="Right" Content="Merge N up"
                                Style="{StaticResource DialogButton}" Padding="10,3"
                                Click="BtnMergeUp_Click"/>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="4" Margin="0,0,0,16" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                    <StackPanel x:Name="PreviewHost"/>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>

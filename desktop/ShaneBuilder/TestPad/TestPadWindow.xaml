<Window x:Class="ShaneBuilder.TestPadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShaneBuilder"
        Title="Test Pad"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="320"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Git #2327 — "expands to the pad." What the pill opens. The composer (#2328), type chips
         (#2330), status band (#2332), notes list/grouping/edit/lock (#2333-#2336), Send to Claude
         (#2337), pipeline caption (#2338), copy-as-markdown (#2339, header action), shots/Paste
         Tray (#2340-#2342) and import (#2343-#2354) each build out this body in their own issue —
         this shell is only the floating, non-layout-shifting container the pill expands into, with
         an honest empty state until a note actually exists. -->
    <Border CornerRadius="10" Background="{StaticResource Brush.Bg.Panel}"
            BorderBrush="{StaticResource Brush.Border.Popover}" BorderThickness="1" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="14,12,10,10">
                <TextBlock Text="Test Pad" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Heading}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Git #2339 — "Copy as markdown" for the checked selection, distinct from
                         "Send to Claude" (#2337) which falls back to every unsent note when nothing
                         is checked. This one only ever acts on TestPadNote.IsSelected, so it's
                         hidden entirely until at least one note is checked. -->
                    <Border x:Name="BtnCopyMarkdown" Height="20" CornerRadius="4" Cursor="Hand"
                            Padding="6,0" Margin="0,0,6,0" Background="Transparent"
                            MouseLeftButtonUp="BtnCopyMarkdown_Click"
                            Visibility="Collapsed"
                            ToolTip="Copy the selected notes as a markdown block">
                        <TextBlock x:Name="CopyMarkdownLabel" Text="Copy as markdown" FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- Git #2334 — "By feature" regroups the list. Toggles the notes list below
                         between flat (newest-first) and grouped-by-Feature. -->
                    <Border x:Name="BtnGroupByFeature" Height="20" CornerRadius="4" Cursor="Hand"
                            Padding="6,0" Margin="0,0,6,0" Background="Transparent"
                            MouseLeftButtonUp="BtnGroupByFeature_Click"
                            ToolTip="Group notes by feature">
                        <TextBlock x:Name="GroupByFeatureLabel" Text="By feature" FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="BtnClose" Width="22" Height="22" CornerRadius="4" Cursor="Hand"
                            Background="Transparent"
                            MouseLeftButtonUp="BtnClose_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
            <Border Height="1" Background="{StaticResource Brush.Border.Default}"/>
            <!-- Git #2332 — status band. "Claude is working — N waiting" while the active chat is
                 generating and notes are queued, "Claude is free — send N" once it's idle with
                 notes still queued, "Nothing waiting" once the queue is empty either way. #2337's
                 real Send-to-Claude button sits below the notes list, at the foot of the pad. -->
            <Border x:Name="StatusBand" Padding="14,7,14,7" Background="{StaticResource Brush.Bg.Card}">
                <TextBlock x:Name="StatusBandText" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Muted}"/>
            </Border>

            <!-- Composer (#2328) — Enter files a new note and clears; clicking a note body below
                 (#2335) loads it back in here for editing instead — Enter then saves the edit in
                 place (stamping IsEdited so the list shows an EDITED tag) and Esc cancels back to
                 an empty box without touching the note. -->
            <StackPanel Margin="14,10,14,8">
                <Border x:Name="EditingBanner" Background="{StaticResource Brush.Bg.Chip}" CornerRadius="6"
                        Padding="8,4" Margin="0,0,0,6" Visibility="Collapsed">
                    <TextBlock Text="Editing note — Enter saves, Esc cancels" FontSize="10.5"
                               Foreground="{StaticResource Brush.Text.Muted}"/>
                </Border>
                <Border Background="{StaticResource Brush.Bg.Chip}" BorderBrush="{StaticResource Brush.Border.Default}"
                        BorderThickness="1" CornerRadius="6">
                    <TextBox x:Name="ComposerBox" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="30"
                             MaxHeight="90" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                             Padding="8,6" Background="Transparent"
                             Foreground="{StaticResource Brush.Text.Primary}"
                             CaretBrush="{StaticResource Brush.Text.Primary}"
                             FontSize="11.5"
                             PreviewKeyDown="ComposerBox_PreviewKeyDown"/>
                </Border>
                <local:TypeChipsControl x:Name="TypeChips" Margin="0,6,0,0"/>
            </StackPanel>
            <Border Height="1" Background="{StaticResource Brush.Border.Default}"/>

            <Grid x:Name="EmptyState" Margin="16,28,16,28">
                <TextBlock Text="No notes yet." FontSize="11.5"
                           Foreground="{StaticResource Brush.Text.Muted}"
                           HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel x:Name="NotesHost" Margin="10,4,10,10"/>
            <Border Height="1" Background="{StaticResource Brush.Border.Default}"/>
            <!-- Git #2337 — "Send to Claude" drops a formatted block with every stamp into the
                 open chat's composer. Selected unsent notes if any are checked; otherwise every
                 unsent note. -->
            <Border x:Name="BtnSendToClaude" Margin="10,8,10,0" Height="28" CornerRadius="6"
                    Cursor="Hand" Background="{StaticResource Brush.Bg.Chip}"
                    MouseLeftButtonUp="BtnSendToClaude_Click"
                    ToolTip="Drop the selected (or every unsent) note into the open chat's composer">
                <TextBlock x:Name="SendToClaudeLabel" Text="Send to Claude" FontSize="11"
                           FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Primary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- Git #2338 — pipeline caption, captioning the "Send to Claude" button directly above
                 it: making the destination explicit — filing a note here is the start of a real
                 pipeline, not a fire-and-forget message. -->
            <Border x:Name="PipelineCaption" Padding="14,7,14,8">
                <TextBlock TextWrapping="Wrap" FontSize="9.5" FontStyle="Italic" TextAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Dim}">
                    <Run Text="Note"/><Run Text=" → "/><Run Text="Claude architects"/><Run Text=" → "/><Run Text="you approve"/><Run Text=" → "/><Run Text="prompt + git issue"/><Run Text=" → "/><Run Text="Batter Up"/>
                </TextBlock>
            </Border>
        </StackPanel>
    </Border>
</Window>

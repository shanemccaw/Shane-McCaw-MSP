<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark, flat scrollbars matching the app theme, ported from the
         wpf-handoff mockup's own .om-scroll CSS (13px width, transparent
         track, rounded thumb with a border "gutter" inset, brighter on
         hover). Colors are existing theme brushes, not new ones:
         Brush.Border.Popover is byte-for-byte the mockup's thumb color
         (#2E3742), Brush.Bg.Scroll is the section of Colors.xaml already
         named for exactly this (track/gutter), and Brush.Border.Hover is
         the existing "brighter border" hover token reused for the thumb's
         hover state. Applied with no x:Key so it's the implicit style for
         every ScrollBar in the app, including the ones ScrollViewer builds
         internally. -->

    <Style x:Key="ShaneBuilderScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{StaticResource Brush.Border.Popover}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush.Bg.Scroll}"
                            BorderThickness="3"
                            CornerRadius="8"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Border.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Border.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShaneBuilderScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource Brush.Bg.Scroll}"/>
        <Setter Property="Width" Value="13"/>
        <Setter Property="MinWidth" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ShaneBuilderScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ShaneBuilderScrollThumb}" Margin="1" MinHeight="52" MinWidth="20"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ShaneBuilderScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="13"/>
                <Setter Property="MinHeight" Value="13"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

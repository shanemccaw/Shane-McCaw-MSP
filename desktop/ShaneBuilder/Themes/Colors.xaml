    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#30363D"/>
    <SolidColorBrush x:Key="Brush.Border.Card" Color="#262C36"/>
    <SolidColorBrush x:Key="Brush.Border.Popover" Color="#2E3742"/>
    <SolidColorBrush x:Key="Brush.Border.Hover" Color="#333A46"/>

    <!-- 3. Text -->

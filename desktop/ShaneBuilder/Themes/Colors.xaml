    <!-- ══════════════════════════════════════════════════════════════════
         10. Claude Chat Pane (warm dark) — SEPARATE sub-palette, embedded
         Claude webview ONLY. Do not use Brush.Claude.* outside the chat
         pane, and do not use any brush above inside the chat pane.
         ══════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Brush.Claude.Bg.Chrome" Color="#1A1A19"/>
    <SolidColorBrush x:Key="Brush.Claude.Bg.Content" Color="#1E1E1C"/>
    <SolidColorBrush x:Key="Brush.Claude.Bg.Bubble" Color="#2A2A27"/>
    <SolidColorBrush x:Key="Brush.Claude.Bg.Button" Color="#302F2D"/>
    <SolidColorBrush x:Key="Brush.Claude.Border" Color="#3A3A37"/>
    <SolidColorBrush x:Key="Brush.Claude.Accent" Color="#D97757"/>
    <SolidColorBrush x:Key="Brush.Claude.Text.Bright" Color="#ECE9E4"/>
    <SolidColorBrush x:Key="Brush.Claude.Text.Body" Color="#DEDBD5"/>
    <SolidColorBrush x:Key="Brush.Claude.Text.Muted" Color="#7A7975"/>

    <!-- 11. Semantic / Alert Colors — Danger has two hexes (bg + border)
         in the doc under one suggested key; split into .Bg/.Border. -->
    <SolidColorBrush x:Key="Brush.Alert.Danger.Bg" Color="#3A0D0D"/>
    <SolidColorBrush x:Key="Brush.Alert.Danger.Border" Color="#E8746F"/>
    <SolidColorBrush x:Key="Brush.Alert.Success" Color="#34D399"/>
    <SolidColorBrush x:Key="Brush.Alert.Locked" Color="#FB7185"/>
    <SolidColorBrush x:Key="Brush.Alert.Critical" Color="#F87171"/>

    <!-- 12. Toast Notifications (Git #2174, port of BuildConsole's ToastEngine) —
         no dedicated Info/Warning entries exist in the #2147 doc, so these are
         aliases onto existing real tokens above rather than new hex values:
         Success/Error reuse the section 11 alert colors verbatim, Info reuses
         the section 4 primary accent, and Warning reuses the section 8 focus-
         nudge mid-escalation amber (the closest existing "heads-up, not yet
         critical" tone in the palette).

         Git #2179 fix: `<StaticResource x:Key="X" ResourceKey="Y"/>` does NOT
         actually register a lookup-able "X" entry in a merged ResourceDictionary
         loaded via Source=... — confirmed via a runtime FindResource/indexer
         probe (Resources.Contains("Brush.Toast.Info") returned false), which is
         exactly why AppDialog.Alert's default Info icon threw
         ResourceReferenceKeyNotFoundException at runtime, and why ToastCard's own
         `Res()` helper (Notifications/ToastCard.xaml.cs) has been silently
         swallowing this same failure and falling back to Brushes.SteelBlue for
         every toast kind since #2174 shipped. Fixed by making each key a real
         SolidColorBrush carrying the identical hex already defined on its source
         brush above (copied value, not a new color) so both FindResource and the
         XAML {StaticResource} lookups actually resolve it. -->
    <SolidColorBrush x:Key="Brush.Toast.Info" Color="#7C8CF0"/>
    <SolidColorBrush x:Key="Brush.Toast.Success" Color="#34D399"/>
    <SolidColorBrush x:Key="Brush.Toast.Warning" Color="#E2984A"/>
    <SolidColorBrush x:Key="Brush.Toast.Error" Color="#E8746F"/>

    <!-- Tab workspace accent colors (Step 9, wpf-handoff/readme-phase2.md).
         Six of the seven are the same hex already defined above under a
         different semantic role (copied value, not a new color, same
         pattern as Brush.Toast.* just above) — only Brush.Workspace.Designs
         (#00B4D8) is genuinely new, and it comes straight from the readme's
         own workspace color table, which is authoritative for this step. -->
    <SolidColorBrush x:Key="Brush.Workspace.Chats" Color="#7C8CF0"/>
    <SolidColorBrush x:Key="Brush.Workspace.Designs" Color="#00B4D8"/>
    <SolidColorBrush x:Key="Brush.Workspace.GitIssues" Color="#E2593F"/>
    <SolidColorBrush x:Key="Brush.Workspace.Favorites" Color="#E2B039"/>
    <SolidColorBrush x:Key="Brush.Workspace.Logs" Color="#7FB08A"/>
    <SolidColorBrush x:Key="Brush.Workspace.Api" Color="#C084FC"/>
    <SolidColorBrush x:Key="Brush.Workspace.Files" Color="#8FA7C4"/>

    <!-- File-tab ext badge tones (Step 9's Files workspace). Also from the
         readme's own table; d4a56c and a78bfa are new the same way
         Designs's #00B4D8 is above. -->
    <SolidColorBrush x:Key="Brush.Ext.Md" Color="#8FA7C4"/>
    <SolidColorBrush x:Key="Brush.Ext.Sql" Color="#D4A56C"/>
    <SolidColorBrush x:Key="Brush.Ext.Json" Color="#7FB08A"/>
    <SolidColorBrush x:Key="Brush.Ext.Code" Color="#A78BFA"/>
    <SolidColorBrush x:Key="Brush.Ext.Ts" Color="#7DC4F5"/>

</ResourceDictionary>

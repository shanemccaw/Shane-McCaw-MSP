    <PathGeometry x:Key="Icon.BuildConsole"
        Figures="M12 19h8 M4,17 L10,11 L4,5"/>

    <!-- eye — rail: Build Watch -->
    <PathGeometry x:Key="Icon.BuildWatch"
        Figures="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0 M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12"/>

    <!-- flask-conical — rail: UI Testing -->
    <PathGeometry x:Key="Icon.UiTesting"
        Figures="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2 M6.453 15h11.094 M8.5 2h7"/>

    <!-- camera — rail: Shot Vault -->
    <PathGeometry x:Key="Icon.ShotVault"
        Figures="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z M9,13 A3,3 0 1 0 15,13 A3,3 0 1 0 9,13"/>

    <!-- settings — rail: Settings (pinned bottom) -->
    <PathGeometry x:Key="Icon.Settings"
        Figures="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915 M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12"/>

    <!-- Shared style so every rail icon renders identically (16x16, round
         joins/caps matching Lucide's own stroke-linecap="round"). -->
    <Style x:Key="RailIconPath" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>

</ResourceDictionary>

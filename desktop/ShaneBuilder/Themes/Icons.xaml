<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Real Lucide icon path data (fetched from lucide-icons/lucide's own
         SVG source, not guessed from memory) as WPF Geometry resources —
         same pattern BuildConsole's own Resources/Icons.xaml already uses,
         just applied app-wide here instead of one pane. This replaces
         Segoe MDL2 Assets glyphs for the icons Shane actually wants: no
         more invisible-private-use-character editing risk, and it matches
         what the wpf-handoff mockups already specify via data-lucide="...".
         SVG circles have no WPF equivalent primitive in a path string, so
         each is expanded to two semicircle arcs (M-A-A) by hand. Consume
         with a Path: Data="{StaticResource Icon.X}" Stroke="{...}"
         StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round"
         StrokeEndLineCap="Round" Stretch="Uniform" Fill="Transparent" —
         Lucide icons are stroke-only, 24x24 viewBox, 2px stroke. -->

    <!-- message-square — rail: Chat -->
    <PathGeometry x:Key="Icon.Chat"
        Figures="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"/>

    <!-- git-fork — rail: Git -->
    <PathGeometry x:Key="Icon.Git"
        Figures="M9,18 A3,3 0 1 0 15,18 A3,3 0 1 0 9,18 M3,6 A3,3 0 1 0 9,6 A3,3 0 1 0 3,6 M15,6 A3,3 0 1 0 21,6 A3,3 0 1 0 15,6 M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9 M12 12v3"/>

    <!-- skip-forward — rail: Next Up -->
    <PathGeometry x:Key="Icon.NextUp"
        Figures="M21 4v16 M6.029 4.285A2 2 0 0 0 3 6v12a2 2 0 0 0 3.029 1.715l9.997-5.998a2 2 0 0 0 .003-3.432z"/>

    <!-- zap — rail: Batter Up -->
    <PathGeometry x:Key="Icon.BatterUp"
        Figures="M15.914 4 a1.5 1.5 0 0 0 -2.474 -1.561 l-9 9 A1.5 1.5 0 0 0 5.5 14 h4.002 a.5 .5 0 0 1 .471 .666 L8.086 20 a1.5 1.5 0 0 0 2.475 1.56 l9-9 A1.5 1.5 0 0 0 18.5 10 h-3.997 a.5 .5 0 0 1 -.472 -.667 z"/>


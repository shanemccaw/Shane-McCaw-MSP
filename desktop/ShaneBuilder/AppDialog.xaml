<Window x:Class="ShaneBuilder.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ShaneBuilder"
        MinWidth="380" MaxWidth="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource Brush.Bg.Window}"
        KeyDown="Window_KeyDown">

    <!-- Git #2179 — real custom-chrome dialog (WindowChromeHelper pattern, same as every other
         ShaneBuilder/BuildConsole top-level window) replacing MessageBox.Show, this time actually
         landed in desktop/ShaneBuilder (redo of #2175, reverted in #2177 for landing in
         desktop/BuildConsole instead). Styled against the real #2147 token dictionary
         (Themes/Colors.xaml Brush.* / Themes/Typography.xaml FontSize.*), not BuildConsole's
         #2126 palette. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="0"
                             GlassFrameThickness="-1"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Minimal local button styles — ShaneBuilder has no shared button style system yet
             (same rationale as Notifications/ToastCard.xaml's ToastCloseButton), so these stay
             scoped to this window rather than reaching for a style that doesn't exist. -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Chip}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.13}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Border.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{StaticResource Brush.Accent.Primary}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Bg.Window}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeight.SemiBold}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogCaptionCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Alert.Danger.Border}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Heading}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
        <DockPanel LastChildFill="True" Background="{StaticResource Brush.Bg.Window}">
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource Brush.Bg.Panel}"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    BorderThickness="0,0,0,1"
                    Height="36">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Grid.Column="0" Text="ShaneBuilder" Margin="14,0,0,0"
                               VerticalAlignment="Center" FontSize="{StaticResource FontSize.13}" FontWeight="{StaticResource FontWeight.SemiBold}"
                               Foreground="{StaticResource Brush.Text.Primary}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnCloseWindow" Style="{StaticResource DialogCaptionCloseButton}" ToolTip="Close" Click="BtnCloseWindow_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="20,18,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Margin="0,0,14,0"
                               VerticalAlignment="Top"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="MessageText"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSize.13}"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               VerticalAlignment="Top"/>
                </StackPanel>

                <TextBox x:Name="InputTextBox"
                         Grid.Row="1"
                         Margin="0,14,0,0"
                         Padding="8,6"
                         FontSize="{StaticResource FontSize.13}"
                         Background="{StaticResource Brush.Bg.Card}"
                         Foreground="{StaticResource Brush.Text.Primary}"
                         BorderBrush="{StaticResource Brush.Border.Default}"
                         Visibility="Collapsed"
                         KeyDown="InputTextBox_KeyDown"/>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button x:Name="BtnNo" Content="No" Style="{StaticResource DialogButton}" Padding="14,6" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="BtnNo_Click"/>
                    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource DialogButton}" Padding="14,6" Margin="0,0,8,0"
                            IsCancel="True" Visibility="Collapsed" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnPrimary" Content="OK" Style="{StaticResource DialogPrimaryButton}"
                            Padding="14,6" IsDefault="True" Click="BtnPrimary_Click"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════
         Git #4275 — MyArchitect's own theming source of truth.

         Every value below is genuinely MyArchitect's — derived from the raw
         hex literals already scattered across MainWindow.xaml,
         LoginWindow.xaml and RegionSelectOverlayWindow.xaml (the shell as it
         visually reads today), consolidated into named roles instead of
         scattered raw hex. None of these are copied from
         desktop/BuildConsole/Themes/Colors.xaml — that file's Catppuccin-
         derived hues (#7C8CF0 accent, #0D1117 backgrounds, etc.) are a
         different app's palette; MyArchitect's own accent (#389BFF) and its
         darker near-black background ladder are unrelated values that
         happen to share BuildConsole's organizational pattern only
         (backgrounds / text / borders / accent / status / washes).

         Retrofitting the ~30 already-shipped views' existing inline hex to
         reference these keys is real, separate follow-up work — explicitly
         deferred by #4275's own scope, not silently folded in here.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Backgrounds (layered, darkest → lightest, matching the shell's real
         recessed-chrome-to-raised-surface layering: tab strip is the
         darkest recessed strip, the center document area is the base
         window fill, cards/inputs sit raised above both). -->
    <Color x:Key="StripBackgroundColor">#141414</Color>
    <Color x:Key="PanelBackgroundColor">#181818</Color>
    <Color x:Key="AppBackgroundColor">#1E1E1E</Color>
    <Color x:Key="CardBackgroundColor">#252526</Color>

    <SolidColorBrush x:Key="StripBackgroundBrush" Color="{StaticResource StripBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="AppBackgroundBrush"   Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="{StaticResource CardBackgroundColor}"/>

    <!-- Borders -->
    <Color x:Key="BorderColor">#2B2B2B</Color>
    <Color x:Key="ControlBorderColor">#3E3E42</Color>
    <Color x:Key="OverlayBorderColor">#444444</Color>

    <SolidColorBrush x:Key="BorderDividerBrush"  Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ControlBorderBrush"  Color="{StaticResource ControlBorderColor}"/>
    <SolidColorBrush x:Key="OverlayBorderBrush"  Color="{StaticResource OverlayBorderColor}"/>

    <!-- Text (ladder as the shell genuinely uses it today: bright white for
         headings/high-emphasis labels, down through progressively softer
         tiers for body copy, captions/placeholders, footnotes, and
         disabled state). -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#E0E0E0</Color>
    <Color x:Key="TextMutedColor">#B0B0B0</Color>
    <Color x:Key="TextTertiaryColor">#858585</Color>
    <Color x:Key="TextFaintColor">#5A5A5A</Color>
    <Color x:Key="TextDisabledColor">#666666</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush"  Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextFaintBrush"     Color="{StaticResource TextFaintColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="{StaticResource TextDisabledColor}"/>

    <!-- Accent (interactive elements, active tab, selection) — MyArchitect's
         own blue, not BuildConsole's. -->
    <Color x:Key="AccentColor">#389BFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <!-- Deeper CTA-fill blue, distinct from AccentColor — the real value
         already used for LoginWindow's primary "Sign in"/"Verify" button
         fill, and the real hyperlink blue used for its "Back to sign in"
         link. -->
    <Color x:Key="AccentCtaColor">#0E639C</Color>
    <Color x:Key="LinkColor">#4DA3E0</Color>
    <SolidColorBrush x:Key="AccentCtaBrush" Color="{StaticResource AccentCtaColor}"/>
    <SolidColorBrush x:Key="LinkBrush"      Color="{StaticResource LinkColor}"/>

    <!-- Low-opacity accent washes for hover/selection fills — two tiers,
         the lighter one at the exact alpha already in real use
         (RegionSelectOverlayWindow's SelectionRect fill, #30389BFF), the
         medium tier derived at roughly double that alpha for a stronger
         selected/pressed state. -->
    <SolidColorBrush x:Key="AccentWashLightBrush"  Color="#30389BFF"/>
    <SolidColorBrush x:Key="AccentWashMediumBrush" Color="#55389BFF"/>

    <!-- Neutral control-chrome hover/pressed fills — the real values already
         used by MainWindow's NavBarButtonStyle IsMouseOver/IsPressed
         triggers. -->
    <Color x:Key="ControlHoverBackgroundColor">#2D2D2D</Color>
    <Color x:Key="ControlPressedBackgroundColor">#383838</Color>
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush"   Color="{StaticResource ControlHoverBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlPressedBackgroundBrush" Color="{StaticResource ControlPressedBackgroundColor}"/>

    <!-- Status colors — the real values already used for a genuine status
         meaning: contract-hours progress fill (success/green), sign-in/MFA
         credential error text (error/red), update-available notice
         (warning/gold). No "running" tier exists yet — no real call site
         uses one today; add it only when a genuine running-state indicator
         is actually built, not speculatively here. -->
    <Color x:Key="StatusSuccessColor">#3FE0A0</Color>
    <Color x:Key="StatusErrorColor">#F48771</Color>
    <Color x:Key="StatusWarningColor">#FFD700</Color>

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}"/>
    <SolidColorBrush x:Key="StatusErrorBrush"   Color="{StaticResource StatusErrorColor}"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}"/>

    <!-- Status bar — its own real, distinct component background (the
         bottom shell status bar's real #007ACC fill and #3D8BD4 divider),
         kept separate from the shared background ladder above since no
         other surface in the shell uses this blue. -->
    <Color x:Key="StatusBarBackgroundColor">#007ACC</Color>
    <Color x:Key="StatusBarDividerColor">#3D8BD4</Color>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource StatusBarBackgroundColor}"/>
    <SolidColorBrush x:Key="StatusBarDividerBrush"    Color="{StaticResource StatusBarDividerColor}"/>

    <!-- Isolated-profile badge — real armed-state fill already in use
         (MainWindow's IsolatedProfileBadgeBorder). -->
    <Color x:Key="IsolatedProfileBadgeColor">#004578</Color>
    <SolidColorBrush x:Key="IsolatedProfileBadgeBrush" Color="{StaticResource IsolatedProfileBadgeColor}"/>

    <!-- Progress meter track/border — real values from the contract-hours
         utilization meter (MainWindow's ContractHoursProgressBar). -->
    <Color x:Key="ProgressTrackColor">#00284A</Color>
    <Color x:Key="ProgressTrackBorderColor">#00182E</Color>
    <SolidColorBrush x:Key="ProgressTrackBrush"       Color="{StaticResource ProgressTrackColor}"/>
    <SolidColorBrush x:Key="ProgressTrackBorderBrush" Color="{StaticResource ProgressTrackBorderColor}"/>

    <!-- Modal/overlay dim "scrim" brushes — real values from
         RegionSelectOverlayWindow (its own window Background, and its
         instruction-pill background). -->
    <SolidColorBrush x:Key="ScrimLightBrush" Color="#40000000"/>
    <SolidColorBrush x:Key="ScrimBrush"      Color="#D0000000"/>

</ResourceDictionary>

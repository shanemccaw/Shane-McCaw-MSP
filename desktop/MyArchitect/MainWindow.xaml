<ui:FluentWindow x:Class="MyArchitect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:fluent="urn:fluent-ribbon"
        xmlns:controls="clr-namespace:MyArchitect.Controls"
        xmlns:shell="clr-namespace:MyArchitect.Shell"
        mc:Ignorable="d"
        Title="MyArchitect" Height="800" Width="1280"
        WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <ui:FluentWindow.Resources>
        <!-- Navigation Bar / Toolbar Action Button Style -->
        <Style x:Key="NavBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2D2D2D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#383838" />
                                <Setter Property="Foreground" Value="#389BFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Foreground" Value="#666666" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Portal Tab Item Border Style -->
        <Style x:Key="TabBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#141414" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#1E1E1E" />
                    <Setter Property="BorderBrush" Value="#389BFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Title bar (QAT) -->
            <RowDefinition Height="Auto" /> <!-- Fixed + contextual Ribbon -->
            <RowDefinition Height="*" />    <!-- Body: left / center / right -->
            <RowDefinition Height="Auto" /> <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Custom Top Title Bar — QAT: Tenant Switcher, Command Palette trigger, Undo (UI_RULES.md §1) -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="MyArchitect">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <controls:TenantSwitcher x:Name="ShellTenantSwitcher" Margin="0,0,10,0" />
                    <Button x:Name="UndoButton"
                            Style="{StaticResource NavBarButtonStyle}"
                            ToolTip="Undo — only live for a Change Control execution (UI_RULES.md §7)"
                            IsEnabled="False"
                            Click="UndoButton_Click"
                            Margin="0,0,4,0">
                        <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="16" />
                    </Button>
                    <Button x:Name="PaletteTriggerButton"
                            Style="{StaticResource NavBarButtonStyle}"
                            Width="150"
                            ToolTip="Command Palette (Ctrl+K)"
                            Click="PaletteTriggerButton_Click"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="4,0,6,0" />
                            <TextBlock Text="Search or run…" FontSize="11" Foreground="#858585" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogViewerButton"
                            Style="{StaticResource NavBarButtonStyle}"
                            Width="34"
                            Margin="4,0,0,0"
                            ToolTip="Log Viewer — Loaded (local history) / Live (SSE + console stdout), UI_RULES.md §1"
                            Click="LogViewerButton_Click"
                            HorizontalContentAlignment="Center">
                        <TextBlock Text="Log" FontSize="11" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Fixed + contextual Ribbon (UI_RULES.md §1/§2) — Fluent.Ribbon, populated at runtime
             from ShellRegistry by FixedRibbonRenderer; never hand-authored per tab in XAML. -->
        <fluent:Ribbon x:Name="AppRibbon" Grid.Row="1" IsMinimized="False" />

        <!-- Body: Left reference panel | Center documents | Right record workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="270" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Left panel — reference, read-only (UI_RULES.md §1) -->
            <Border Grid.Column="0" BorderBrush="#2B2B2B" BorderThickness="0,0,1,0">
                <shell:LeftReferencePanel x:Name="LeftReferencePanelControl" />
            </Border>

            <!-- Center: documents (tabs + nav bar + WebView2 hosts / dashboards) -->
            <Grid Grid.Column="1" Background="#1E1E1E">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Dynamic Portal Tab Strip -->
                <Border Grid.Row="0"
                        Background="#141414"
                        BorderBrush="#2B2B2B"
                        BorderThickness="0,0,0,1"
                        Padding="4,2,4,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,0">
                            <Button x:Name="NewTabButton"
                                    Style="{StaticResource NavBarButtonStyle}"
                                    ToolTip="Open a Portal Bookmark from the left panel"
                                    Click="NewTabButton_Click">
                                <Path Data="M 19,13 L 13,13 L 13,19 L 11,19 L 11,13 L 5,13 L 5,11 L 11,11 L 11,5 L 13,5 L 13,11 L 19,11 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="12" Height="12"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TabsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TabBorderStyle}"
                                                BorderThickness="0,0,0,2"
                                                Height="34"
                                                MaxWidth="220"
                                                Margin="0,0,2,0"
                                                Padding="10,0,6,0"
                                                Cursor="Hand"
                                                SnapsToDevicePixels="True"
                                                MouseLeftButtonUp="TabItem_MouseLeftButtonUp">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Grid.Column="0"
                                                               Symbol="{Binding IconSymbol}"
                                                               FontSize="14"
                                                               Foreground="#389BFF"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="#FFFFFF"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DisplaySubtitle}"
                                                               Foreground="#858585"
                                                               FontSize="9"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Width="18" Height="18"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        ToolTip="Close Tab"
                                                        Click="CloseTabButton_Click">
                                                    <Path Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                                          Fill="#858585"
                                                          Width="9" Height="9"
                                                          Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Navigation / Address Bar with Isolated Profile Indicator -->
                <Border Grid.Row="1"
                        Background="#181818"
                        BorderBrush="#2B2B2B"
                        BorderThickness="0,0,0,1"
                        Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Button x:Name="BackButton" Style="{StaticResource NavBarButtonStyle}" ToolTip="Back" Click="BackButton_Click">
                                <Path Data="M 12,4 L 4,12 L 12,20 M 4,12 L 20,12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="ForwardButton" Style="{StaticResource NavBarButtonStyle}" ToolTip="Forward" Click="ForwardButton_Click">
                                <Path Data="M 12,4 L 20,12 L 12,20 M 4,12 L 20,12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="RefreshButton" Style="{StaticResource NavBarButtonStyle}" ToolTip="Reload Portal" Click="RefreshButton_Click">
                                <Path Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4.01,7.58 4.01,12 C 4.01,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 L 17.65,14 C 16.83,16.33 14.61,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 L 20,11 L 20,4 L 17.65,6.35 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#004578" CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 18,8 L 17,8 L 17,6 C 17,3.24 14.76,1 12,1 C 9.24,1 7,3.24 7,6 L 7,8 L 6,8 C 4.9,8 4,8.9 4,10 L 4,20 C 4,21.1 4.9,22 6,22 L 18,22 C 19.1,22 20,21.1 20,20 L 20,10 C 20,8.9 19.1,8 18,8 Z M 12,17 C 10.9,17 10,16.1 10,15 C 10,13.9 10.9,13 12,13 C 13.1,13 14,13.9 14,15 C 14,16.1 13.1,17 12,17 Z M 15.1,8 L 8.9,8 L 8.9,6 C 8.9,4.29 10.29,2.9 12,2.9 C 13.71,2.9 15.1,4.29 15.1,6 L 15.1,8 Z"
                                      Fill="#FFFFFF" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" Stretch="Uniform" />
                                <TextBlock x:Name="IsolatedProfileBadgeTextBlock" Text="Profile: Contoso" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBox x:Name="UrlTextBox" Background="Transparent" Foreground="#E0E0E0" CaretBrush="#FFFFFF" BorderThickness="0" FontSize="11" FontFamily="Consolas" IsReadOnly="True" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="ScreenClipButton" Style="{StaticResource NavBarButtonStyle}" ToolTip="Capture Region Screenshot (PrintScreen / Ctrl+Shift+S)" Margin="0,0,4,0" Click="ScreenClipButton_Click">
                                <Path Data="M 9,2 L 7.17,4 L 4,4 C 2.9,4 2,4.9 2,6 L 2,18 C 2,19.1 2.9,20 4,20 L 20,20 C 21.1,20 22,19.1 22,18 L 22,6 C 22,4.9 21.1,4 20,4 L 16.83,4 L 15,2 L 9,2 Z M 12,17 C 9.24,17 7,14.76 7,12 C 7,9.24 9.24,7 12,7 C 14.76,7 17,9.24 17,12 C 17,14.76 14.76,17 12,17 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="LaunchExternalButton" Style="{StaticResource NavBarButtonStyle}" ToolTip="Open in External Browser" Click="LaunchExternalButton_Click">
                                <Path Data="M 19,19 L 5,19 L 5,5 L 12,5 L 12,3 L 5,3 C 3.89,3 3,3.9 3,5 L 3,19 C 3,20.1 3.89,21 5,21 L 19,21 C 20.1,21 21,20.1 21,19 L 21,12 L 19,12 L 19,19 Z M 14,3 L 14,5 L 17.59,5 L 7.76,14.83 L 9.17,16.24 L 19,6.41 L 19,10 L 21,10 L 21,3 L 14,3 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Central Area: Multiple Isolated WebView2 Hosts & Dashboard/Document Views -->
                <Grid Grid.Row="2">
                    <Grid x:Name="WebViewsContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <controls:SowAssessmentView x:Name="SowAssessmentDashboardView"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <controls:TelemetryConsoleView x:Name="TelemetryDashboardView"
                                                  Visibility="Collapsed"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <shell:ConsolePanelView x:Name="ConsolePanel"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <!-- Credential Vault (#3461) — Admin-tab document, local-only DPAPI-encrypted store -->
                    <shell:VaultPanelView x:Name="VaultPanel"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <Border x:Name="ScreenshotEvidenceDocument"
                            Background="#181818"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <controls:ScreenshotGalleryPanel x:Name="EvidenceGalleryPanel" />
                    </Border>

                    <Border x:Name="EmptyTabsOverlay"
                            Background="#1E1E1E"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <Path Data="M 17,3 L 7,3 C 5.9,3 5,3.9 5,5 L 5,21 L 12,18 L 19,21 L 19,5 C 19,3.9 18.1,3 17,3 Z"
                                  Fill="#389BFF" Width="44" Height="44" Margin="0,0,0,16" Stretch="Uniform" HorizontalAlignment="Center" />
                            <TextBlock Text="No Open Portal Tabs" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Select a portal from the Bookmarks in the left panel, or press '+' above."
                                       Foreground="#858585" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right panel — full-panel record workspace, always docked (UI_RULES.md §3) -->
            <Border x:Name="RightPanelBorder" Grid.Column="2" BorderBrush="#2B2B2B" BorderThickness="1,0,0,0" ClipToBounds="True">
                <shell:RecordWorkspacePanel x:Name="RecordWorkspaceControl" />
            </Border>
        </Grid>

        <!-- Bottom Shell Status Bar -->
        <Border Grid.Row="3" Background="#007ACC" Height="22" Padding="8,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Path Data="M 18,8 L 17,8 L 17,6 C 17,3.24 14.76,1 12,1 C 9.24,1 7,3.24 7,6 L 7,8 L 6,8 C 4.9,8 4,8.9 4,10 L 4,20 C 4,21.1 4.9,22 6,22 L 18,22 C 19.1,22 20,21.1 20,20 L 20,10 C 20,8.9 19.1,8 18,8 Z M 12,17 C 10.9,17 10,16.1 10,15 C 10,13.9 10.9,13 12,13 C 13.1,13 14,13.9 14,15 C 14,16.1 13.1,17 12,17 Z M 15.1,8 L 8.9,8 L 8.9,6 C 8.9,4.29 10.29,2.9 12,2.9 C 13.71,2.9 15.1,4.29 15.1,6 L 15.1,8 Z"
                          Fill="#FFFFFF" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" Stretch="Uniform" />
                    <TextBlock x:Name="StatusProfileTextBlock" Text="Session Isolation: Active" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />
                    <!-- Sign-in state (#3501): the real MSP-operator session driving every auth-gated call. -->
                    <Border Width="1" Background="#3D8BD4" Margin="12,3,12,3" />
                    <Button x:Name="SessionStatusButton" Background="Transparent" BorderThickness="0"
                            Foreground="#FFFFFF" FontSize="11" Cursor="Hand" Padding="0"
                            VerticalAlignment="Center" Click="SessionStatusButton_Click"
                            Content="Not signed in · Sign in" />
                    <!-- Contract-hours utilization (#3474) — real GET /api/admin/retainer/:customerId,
                         corrected anniversary-based period from #3473. The bar is a plain, inert
                         visual (never a fake clickable stop — UI_RULES.md §1); hidden until a real
                         bucket has actually loaded. -->
                    <Border Width="1" Background="#3D8BD4" Margin="12,3,12,3" />
                    <StackPanel x:Name="ContractHoursPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="ContractHoursTextBlock" Text="" Foreground="#D8E8FF" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ProgressBar x:Name="ContractHoursProgressBar"
                                     Width="80" Height="8"
                                     Minimum="0" Maximum="100"
                                     Background="#005A9E"
                                     Foreground="#7FD1FF"
                                     BorderThickness="0"
                                     VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusTabCountTextBlock" Text="1 Open Tab" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock x:Name="StatusClockTextBlock" Text="" Foreground="#E0E0E0" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="UpdateAvailableButton"
                            Visibility="Collapsed"
                            Background="Transparent" BorderThickness="0" Foreground="#FFD700" FontSize="11"
                            Cursor="Hand" Padding="0" Margin="0,0,12,0"
                            Click="UpdateAvailableButton_Click"
                            Content="Update available" />
                    <TextBlock x:Name="StatusVersionTextBlock" Text="MyArchitect" Foreground="#E0E0E0" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Command Palette overlay — topmost, spans the whole window (UI_RULES.md §5) -->
        <shell:CommandPaletteOverlay x:Name="PaletteOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="1000" />

        <!-- Log Viewer (UI_RULES.md §1, #3506) — title-bar command area, not the Ribbon or either panel -->
        <shell:LogViewerOverlay x:Name="LogViewerOverlayControl" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="1000" />
    </Grid>
</ui:FluentWindow>

<ui:FluentWindow x:Class="MyArchitect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:MyArchitect.Controls"
        mc:Ignorable="d"
        Title="MyArchitect" Height="800" Width="1280"
        WindowState="Maximized">

    <ui:FluentWindow.Resources>
        <!-- Activity Bar Radio Item Style (Top navigation icons) -->
        <Style x:Key="ActivityBarRadioItemStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#858585" />
            <Setter Property="GroupName" Value="ActivityBarGroup" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="ActiveIndicator"
                                        Width="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="#FFFFFF"
                                        Visibility="Collapsed" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#252526" />
                                <Setter Property="Foreground" Value="#D4D4D4" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RootBorder" Property="Background" Value="#252526" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Activity Bar Button Style (Bottom action icons: Accounts, Settings) -->
        <Style x:Key="ActivityBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#858585" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#252526" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#2A2D2E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Portal Menu Button Style inside New Tab Flyout -->
        <Style x:Key="PortalMenuItemStyle" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D30" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Portal Tab Item Border Style -->
        <Style x:Key="TabBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#141414" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#1E1E1E" />
                    <Setter Property="BorderBrush" Value="#389BFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom Top Title Bar with Tenant Switcher -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="MyArchitect">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <controls:TenantSwitcher x:Name="ShellTenantSwitcher" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Body Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Icon Bar (Activity Bar) -->
            <Border Grid.Column="0"
                    Width="48"
                    Background="#181818"
                    BorderBrush="#2B2B2B"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Navigation Icons -->
                    <StackPanel Grid.Row="0" Orientation="Vertical">
                        <RadioButton Style="{StaticResource ActivityBarRadioItemStyle}"
                                     IsChecked="True"
                                     ToolTip="Explorer / Portal Cockpit (Ctrl+Shift+E)">
                            <ui:SymbolIcon Symbol="DocumentMultiple24" FontSize="20" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ActivityBarRadioItemStyle}"
                                     ToolTip="Search (Ctrl+Shift+F)">
                            <ui:SymbolIcon Symbol="Search24" FontSize="20" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ActivityBarRadioItemStyle}"
                                     ToolTip="Source Control (Ctrl+Shift+G)">
                            <ui:SymbolIcon Symbol="BranchCompare24" FontSize="20" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ActivityBarRadioItemStyle}"
                                     ToolTip="Run and Debug (Ctrl+Shift+D)">
                            <ui:SymbolIcon Symbol="Play24" FontSize="20" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource ActivityBarRadioItemStyle}"
                                     ToolTip="Extensions &amp; Scripts (Ctrl+Shift+X)">
                            <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="20" />
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Action Icons -->
                    <StackPanel Grid.Row="1" Orientation="Vertical">
                        <Button Style="{StaticResource ActivityBarButtonStyle}"
                                ToolTip="Accounts">
                            <ui:SymbolIcon Symbol="PersonCircle24" FontSize="20" />
                        </Button>
                        <Button Style="{StaticResource ActivityBarButtonStyle}"
                                ToolTip="Settings (Ctrl+,)">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="20" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Workspace: Multi-Tab Isolated Portal Shell -->
            <Grid Grid.Column="1" Background="#1E1E1E">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Dynamic Portal Tab Strip -->
                <Border Grid.Row="0"
                        Background="#141414"
                        BorderBrush="#2B2B2B"
                        BorderThickness="0,0,0,1"
                        Padding="4,2,4,0">
                    <DockPanel LastChildFill="True">
                        <!-- Add Tab Button with Portal Menu Flyout -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,0">
                            <Button x:Name="NewTabButton"
                                    Width="28" Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Open Portal Tab for Active Tenant"
                                    Click="NewTabButton_Click">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Foreground="#858585" />
                            </Button>
                            <Popup x:Name="NewTabPopup"
                                   PlacementTarget="{Binding ElementName=NewTabButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="#1E1E1E"
                                        BorderBrush="#3E3E42"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Width="260"
                                        Padding="6"
                                        Margin="0,4,0,0"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.5" Color="Black" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="OPEN PORTAL TAB" Foreground="#858585" FontSize="10" FontWeight="Bold" Margin="8,4,8,6" />
                                        <Button Style="{StaticResource PortalMenuItemStyle}" Click="OpenM365Tab_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Globe24" FontSize="14" Foreground="#389BFF" Margin="0,0,8,0" />
                                                <TextBlock Text="M365 Admin Center" Foreground="#FFFFFF" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PortalMenuItemStyle}" Click="OpenAzureTab_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Cloud24" FontSize="14" Foreground="#389BFF" Margin="0,0,8,0" />
                                                <TextBlock Text="Azure Portal" Foreground="#FFFFFF" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PortalMenuItemStyle}" Click="OpenEntraTab_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Shield24" FontSize="14" Foreground="#389BFF" Margin="0,0,8,0" />
                                                <TextBlock Text="Entra ID Admin Center" Foreground="#FFFFFF" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PortalMenuItemStyle}" Click="OpenIntuneTab_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Globe24" FontSize="14" Foreground="#389BFF" Margin="0,0,8,0" />
                                                <TextBlock Text="Intune Endpoint Manager" Foreground="#FFFFFF" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PortalMenuItemStyle}" Click="OpenExchangeTab_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Mail24" FontSize="14" Foreground="#389BFF" Margin="0,0,8,0" />
                                                <TextBlock Text="Exchange Admin Center" Foreground="#FFFFFF" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>

                        <!-- Open Tabs List -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TabsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TabBorderStyle}"
                                                BorderThickness="0,0,0,2"
                                                Height="34"
                                                MaxWidth="220"
                                                Margin="0,0,2,0"
                                                Padding="10,0,6,0"
                                                Cursor="Hand"
                                                SnapsToDevicePixels="True"
                                                MouseLeftButtonUp="TabItem_MouseLeftButtonUp">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Grid.Column="0"
                                                               Symbol="{Binding IconSymbol}"
                                                               FontSize="14"
                                                               Foreground="#389BFF"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="#FFFFFF"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Tenant.Name}"
                                                               Foreground="#858585"
                                                               FontSize="9"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Width="18" Height="18"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        ToolTip="Close Tab"
                                                        Click="CloseTabButton_Click">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="10" Foreground="#858585" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Navigation / Address Bar with Isolated Profile Indicator -->
                <Border Grid.Row="1"
                        Background="#181818"
                        BorderBrush="#2B2B2B"
                        BorderThickness="0,0,0,1"
                        Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Navigation Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Button x:Name="BackButton"
                                    Width="28" Height="26"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Back"
                                    Click="BackButton_Click">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13" Foreground="#858585" />
                            </Button>
                            <Button x:Name="ForwardButton"
                                    Width="28" Height="26"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Forward"
                                    Click="ForwardButton_Click">
                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="13" Foreground="#858585" />
                            </Button>
                            <Button x:Name="RefreshButton"
                                    Width="28" Height="26"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Reload Portal"
                                    Click="RefreshButton_Click">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13" Foreground="#858585" />
                            </Button>
                        </StackPanel>

                        <!-- Tenant Isolation Badge -->
                        <Border Grid.Column="1"
                                Background="#004578"
                                CornerRadius="4"
                                Padding="8,3"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="12" Foreground="#FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="IsolatedProfileBadgeTextBlock"
                                           Text="Profile: Contoso"
                                           Foreground="#FFFFFF"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- URL Display Box -->
                        <Border Grid.Column="2"
                                Background="#252526"
                                BorderBrush="#3E3E42"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBox x:Name="UrlTextBox"
                                     Background="Transparent"
                                     Foreground="#CCCCCC"
                                     CaretBrush="#FFFFFF"
                                     BorderThickness="0"
                                     FontSize="11"
                                     FontFamily="Consolas"
                                     IsReadOnly="True"
                                     VerticalAlignment="Center" />
                        </Border>

                        <!-- External Browser Launch Button -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="LaunchExternalButton"
                                    Width="28" Height="26"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Open In External Browser"
                                    Click="LaunchExternalButton_Click">
                                <ui:SymbolIcon Symbol="Open24" FontSize="14" Foreground="#858585" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Central Area: Multiple Isolated WebView2 Hosts -->
                <Grid Grid.Row="2">
                    <Grid x:Name="WebViewsContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <!-- Fallback / Empty Tabs Overlay -->
                    <Border x:Name="EmptyTabsOverlay"
                            Background="#1E1E1E"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="48" Foreground="#389BFF" Margin="0,0,0,16" HorizontalAlignment="Center" />
                            <TextBlock Text="No Open Portal Tabs"
                                       Foreground="#FFFFFF"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Click '+' above to open a portal tab scoped to the active tenant."
                                       Foreground="#858585"
                                       FontSize="12"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Shell Status Bar -->
        <Border Grid.Row="2"
                Background="#007ACC"
                Height="22"
                Padding="8,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="12" Foreground="#FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusProfileTextBlock" Text="Session Isolation: Active" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusTabCountTextBlock" Text="1 Open Tab" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="MyArchitect v1.1" Foreground="#E0E0E0" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

<Window x:Class="MyArchitect.RegionSelectOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Draw a region to capture"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="#40000000"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <!-- Transparent full-bounds overlay positioned across monitors.
         A drag-a-box crop tool: MouseDown starts the rectangle, MouseMove resizes it,
         MouseUp finalizes and closes with DialogResult=true; Esc cancels.
         Canvas Background MUST be Transparent to be hit-test visible over empty area. -->
    <Canvas x:Name="RootCanvas"
            Background="Transparent"
            MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
            MouseMove="RootCanvas_MouseMove"
            MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp"
            MouseRightButtonDown="RootCanvas_MouseRightButtonDown">
        <Border Canvas.Left="16" Canvas.Top="16"
                Background="#D0000000"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Path Data="M 3,5 C 3,3.9 3.9,3 5,3 L 8,3 L 8,5 L 5,5 L 5,8 L 3,8 L 3,5 Z M 16,3 L 19,3 C 20.1,3 21,3.9 21,5 L 21,8 L 19,8 L 19,5 L 16,5 L 16,3 Z M 3,16 L 5,16 L 5,19 L 8,19 L 8,21 L 5,21 C 3.9,21 3,20.1 3,19 L 3,16 Z M 19,16 L 21,16 L 21,19 C 21,20.1 20.1,21 19,21 L 16,21 L 16,19 L 19,19 L 19,16 Z"
                      Fill="#389BFF" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="Drag to select a region to capture — Esc or right-click to cancel"
                           Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Rectangle x:Name="SelectionRect"
                   Stroke="#389BFF" StrokeThickness="2"
                   Fill="#30389BFF"
                   Visibility="Collapsed"/>
    </Canvas>
</Window>

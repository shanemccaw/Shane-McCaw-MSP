<UserControl x:Class="MyArchitect.Controls.ScreenshotGalleryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="360"
             Background="#181818">

    <UserControl.Resources>
        <Style x:Key="PanelActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2E2E32" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#555555" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0078D4" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#0078D4" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptureThumbnailButtonStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#2B2B2B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252528" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#444444" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1B2B3A" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#389BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12,10" BorderBrush="#262626" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SCREENSHOT EVIDENCE"
                               Foreground="#858585"
                               FontSize="10"
                               FontWeight="Bold" />
                    <TextBlock x:Name="HeaderStatusTextBlock"
                               Text="Evidence Gallery &amp; Review"
                               Foreground="#389BFF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- New Capture Button -->
                <Button Grid.Column="1"
                        x:Name="CaptureButton"
                        Style="{StaticResource PanelActionButtonStyle}"
                        ToolTip="Take Region Screenshot"
                        Margin="0,0,6,0"
                        Click="CaptureButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 9,2 L 7.17,4 L 4,4 C 2.9,4 2,4.9 2,6 L 2,18 C 2,19.1 2.9,20 4,20 L 20,20 C 21.1,20 22,19.1 22,18 L 22,6 C 22,4.9 21.1,4 20,4 L 16.83,4 L 15,2 L 9,2 Z M 12,17 C 9.24,17 7,14.76 7,12 C 7,9.24 9.24,7 12,7 C 14.76,7 17,9.24 17,12 C 17,14.76 14.76,17 12,17 Z"
                              Fill="#389BFF" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Clip" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Close / Collapse Button -->
                <Button Grid.Column="2"
                        x:Name="ClosePanelButton"
                        Style="{StaticResource PanelActionButtonStyle}"
                        Width="26" Height="26" Padding="0"
                        ToolTip="Close Evidence Gallery"
                        Click="ClosePanelButton_Click">
                    <Path Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                          Fill="#858585" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>

        <!-- Main Body: List + Detail -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="180" MinHeight="100" /> <!-- Thumbnails List -->
                <RowDefinition Height="5" />                    <!-- Splitter -->
                <RowDefinition Height="*" MinHeight="150" />    <!-- Review & Caption Editor -->
            </Grid.RowDefinitions>

            <!-- Thumbnails List -->
            <Grid Grid.Row="0">
                <ListBox x:Name="EvidenceListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource CaptureThumbnailButtonStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Padding="10,8"
                         SelectionChanged="EvidenceListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Mini Thumbnail Placeholder / Icon -->
                                <Border Grid.Column="0"
                                        Width="44" Height="36"
                                        CornerRadius="3"
                                        Background="#111111"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        Margin="0,0,8,0">
                                    <Path Data="M 21,19 V 5 C 21,3.9 20.1,3 19,3 H 5 C 3.9,3 3,3.9 3,5 V 19 C 3,20.1 3.9,21 5,21 H 19 C 20.1,21 21,20.1 21,19 Z M 8.5,13.5 L 11,16.51 L 14.5,12 L 19,18 H 5 L 8.5,13.5 Z"
                                          Fill="#555555" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FormattedTime}"
                                               Foreground="#E0E0E0"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DisplayContext}"
                                               Foreground="#389BFF"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0" />
                                    <TextBlock Text="{Binding DisplayResolution}"
                                               Foreground="#777777"
                                               FontSize="9" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State -->
                <Border x:Name="EmptyEvidenceOverlay"
                        Background="#181818"
                        Visibility="Collapsed"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                        <Path Data="M 9,2 L 7.17,4 L 4,4 C 2.9,4 2,4.9 2,6 L 2,18 C 2,19.1 2.9,20 4,20 L 20,20 C 21.1,20 22,19.1 22,18 L 22,6 C 22,4.9 21.1,4 20,4 L 16.83,4 L 15,2 L 9,2 Z M 12,17 C 9.24,17 7,14.76 7,12 C 7,9.24 9.24,7 12,7 C 14.76,7 17,9.24 17,12 C 17,14.76 14.76,17 12,17 Z"
                              Fill="#444444" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="No Screenshots Captured"
                                   Foreground="#777777"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Click 'Clip' above or press PrintScreen to capture a region."
                                   Foreground="#555555"
                                   FontSize="10"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Row="1"
                          Height="3"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="#262626" />

            <!-- Detail & Caption Editor View -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,8">
                <StackPanel x:Name="DetailContainer" Visibility="Visible">
                    <!-- Image Preview -->
                    <Border Background="#111111"
                            BorderBrush="#2B2B2B"
                            BorderThickness="1"
                            CornerRadius="4"
                            Height="140"
                            Margin="0,0,0,10">
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <!-- Metadata summary -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="DetailTenantTextBlock" Text="Tenant: Contoso Ltd" Foreground="#389BFF" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailTimestampTextBlock" Text="Time: 2026-09-10 03:50:00" Foreground="#858585" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#222222" CornerRadius="3" Padding="6,2" VerticalAlignment="Top">
                            <TextBlock x:Name="DetailResolutionTextBlock" Text="1920 × 1080" Foreground="#AAAAAA" FontSize="10" />
                        </Border>
                    </Grid>

                    <!-- Caption Input -->
                    <TextBlock Text="CAPTION / DESCRIPTION" Foreground="#858585" FontSize="10" FontWeight="Bold" Margin="0,4,0,4" />
                    <TextBox x:Name="CaptionTextBox"
                             Background="#222222"
                             BorderBrush="#333333"
                             BorderThickness="1"
                             Foreground="#FFFFFF"
                             FontSize="11"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="48"
                             VerticalScrollBarVisibility="Auto"
                             Padding="6,4"
                             Margin="0,0,0,8" />

                    <!-- Linked Step / Change Ref -->
                    <TextBlock Text="REMEDIATION STEP ID (e.g. s5) — with Customer ID below" Foreground="#858585" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox x:Name="StepRefTextBox"
                             Background="#222222"
                             BorderBrush="#333333"
                             BorderThickness="1"
                             Foreground="#FFFFFF"
                             FontSize="11"
                             Padding="6,4"
                             Margin="0,0,0,8" />

                    <TextBlock Text="CUSTOMER ID (numeric — required for Remediation Step)" Foreground="#858585" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox x:Name="CustomerIdTextBox"
                             Background="#222222"
                             BorderBrush="#333333"
                             BorderThickness="1"
                             Foreground="#FFFFFF"
                             FontSize="11"
                             Padding="6,4"
                             Margin="0,0,0,8" />

                    <TextBlock Text="OR — CHANGE CONTROL EXECUTION ID (numeric)" Foreground="#858585" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox x:Name="ChangeRefTextBox"
                             Background="#222222"
                             BorderBrush="#333333"
                             BorderThickness="1"
                             Foreground="#FFFFFF"
                             FontSize="11"
                             Padding="6,4"
                             Margin="0,0,0,10" />

                    <!-- Action Buttons -->
                    <WrapPanel Margin="0,0,0,6">
                        <Button x:Name="SaveCaptionButton"
                                Style="{StaticResource PanelActionButtonStyle}"
                                Content="Save Caption"
                                Margin="0,0,6,6"
                                Click="SaveCaptionButton_Click" />
                        <Button x:Name="CopyImageButton"
                                Style="{StaticResource PanelActionButtonStyle}"
                                Content="Copy Image"
                                Margin="0,0,6,6"
                                Click="CopyImageButton_Click" />
                        <Button x:Name="OpenExplorerButton"
                                Style="{StaticResource PanelActionButtonStyle}"
                                Content="Open in Explorer"
                                Margin="0,0,6,6"
                                Click="OpenExplorerButton_Click" />
                        <Button x:Name="DiscardButton"
                                Style="{StaticResource PanelActionButtonStyle}"
                                Content="Discard"
                                Foreground="#FF6B6B"
                                Margin="0,0,6,6"
                                Click="DiscardButton_Click" />
                    </WrapPanel>

                    <!-- Post Evidence to Backend (#3503) -->
                    <Border Background="#1A1F2E"
                            BorderBrush="#2E3B4E"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Post Evidence to Backend" Foreground="#389BFF" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="Fills a Remediation Step ID + Customer ID, or a Change Control Execution ID above, then posts the current capture to that real record (#3503)."
                                       Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,6" />
                            <Button x:Name="PostEvidenceButton"
                                    Style="{StaticResource PanelActionButtonStyle}"
                                    Content="Post Evidence"
                                    HorizontalAlignment="Left"
                                    Click="PostEvidenceButton_Click" />
                            <TextBlock x:Name="PostStatusTextBlock"
                                       Text=""
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

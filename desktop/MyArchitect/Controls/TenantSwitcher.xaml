<UserControl x:Class="MyArchitect.Controls.TenantSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">

    <Grid>
        <!-- Pill Switcher Trigger -->
        <Border x:Name="SwitcherPillBorder"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,4"
                Height="30"
                Cursor="Hand"
                MouseLeftButtonUp="SwitcherPill_MouseLeftButtonUp"
                MouseEnter="SwitcherPill_MouseEnter"
                MouseLeave="SwitcherPill_MouseLeave"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Building24" FontSize="14" Foreground="#389BFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TenantNameTextBlock"
                           Text="Select Tenant"
                           Foreground="#FFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           MaxWidth="200"
                           TextTrimming="CharacterEllipsis" />
                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Foreground="#858585" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Dropdown Popup -->
        <Popup x:Name="TenantPopup"
               PlacementTarget="{Binding ElementName=SwitcherPillBorder}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="TenantPopup_Closed">
            <Border Background="#1E1E1E"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="6"
                    Width="340"
                    Margin="0,4,0,0"
                    Padding="10"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MaxHeight="280" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="SWITCH TENANT SCOPE"
                                   Foreground="#858585"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="CountTextBlock"
                                   DockPanel.Dock="Right"
                                   Foreground="#6E6E6E"
                                   FontSize="10"
                                   HorizontalAlignment="Right" />
                    </DockPanel>

                    <!-- Search Box -->
                    <Border Grid.Row="1"
                            Background="#252526"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,0,8"
                            Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="#858585" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchFilterTextBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#FFFFFF"
                                     BorderThickness="0"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchFilterTextBox_TextChanged" />
                        </Grid>
                    </Border>

                    <!-- Tenant Items List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TenantsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="0,1"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="TenantItem_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2A2D2E" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="Building24"
                                                           FontSize="16"
                                                           Foreground="#389BFF"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Tenant.Name}"
                                                           Foreground="#FFFFFF"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Tenant.TenantGuid}"
                                                           Foreground="#858585"
                                                           FontSize="10"
                                                           FontFamily="Consolas"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ui:SymbolIcon Grid.Column="2"
                                                           Symbol="Checkmark24"
                                                           FontSize="14"
                                                           Foreground="#389BFF"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding CheckmarkVisibility}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer Note -->
                    <Border Grid.Row="3" Margin="0,8,0,0" Padding="0,6,0,0" BorderBrush="#2D2D30" BorderThickness="0,1,0,0">
                        <TextBlock Foreground="#6E6E6E"
                                   FontSize="10"
                                   Text="All cockpit modules scope to active tenant." />
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>

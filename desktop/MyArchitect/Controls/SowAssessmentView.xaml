<UserControl x:Class="MyArchitect.Controls.SowAssessmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#1E1E1E">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2E2E32" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#555555" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0078D4" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#0078D4" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCardBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header & Action Bar -->
            <RowDefinition Height="Auto" /> <!-- High-Level KPI Cards -->
            <RowDefinition Height="*" />    <!-- Drill-down detail tabs -->
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SOW &amp; ASSESSMENT VIEWER"
                                   Foreground="#858585"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <Border x:Name="SourceBadgeBorder"
                                Background="#1A3A5A"
                                CornerRadius="3"
                                Padding="6,1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="SourceBadgeTextBlock"
                                       Text="Live Backend"
                                       Foreground="#389BFF"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TenantTitleTextBlock"
                               Text="Tenant: Contoso Managed Services"
                               Foreground="#FFFFFF"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="TimestampTextBlock"
                               Text="Snapshot: 2026-09-10 04:00:00 UTC"
                               Foreground="#858585"
                               FontSize="11"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Actions: Save Snapshot, Load Snapshot, Refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshLiveButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Click="RefreshLiveButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4.01,7.58 4.01,12 C 4.01,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 L 17.65,14 C 16.83,16.33 14.61,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 L 20,11 L 20,4 L 17.65,6.35 Z"
                                  Fill="#389BFF" Width="11" Height="11" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh Live" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveSnapshotButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Click="SaveSnapshotButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 17,3 H 5 C 3.89,3 3,3.9 3,5 V 19 C 3,20.1 3.89,21 5,21 H 19 C 20.1,21 21,20.1 21,19 V 7 L 17,3 Z M 12,19 C 10.34,19 9,17.66 9,16 C 9,14.34 10.34,13 12,13 C 13.66,13 15,14.34 15,16 C 15,17.66 13.66,19 12,19 Z M 15,9 H 5 V 5 H 15 V 9 Z"
                                  Fill="#4CAF50" Width="11" Height="11" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Save Snapshot (JSON)" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="LoadSnapshotButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="LoadSnapshotButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 20,6 H 12 L 10,4 H 4 C 2.9,4 2.01,4.9 2.01,6 L 2,18 C 2,19.1 2.9,20 4,20 H 20 C 21.1,20 22,19.1 22,18 V 8 C 22,6.9 21.1,6 20,6 Z M 20,18 H 4 V 8 H 20 V 18 Z"
                                  Fill="#FF9800" Width="11" Height="11" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Load Snapshot (JSON)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI Cards Row -->
        <Grid Grid.Row="1" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Copilot Gate Card -->
            <Border Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="COPILOT READINESS GATE" Foreground="#858585" FontSize="10" FontWeight="Bold" />
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CopilotScoreTextBlock" Text="85" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" />
                            <TextBlock Text=" / 100" Foreground="#858585" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <Border x:Name="GateVerdictBorder"
                                Grid.Column="1"
                                Background="#1B4D2E"
                                CornerRadius="4"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="GateVerdictTextBlock" Text="GATE PASSED" Foreground="#4CAF50" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="Threshold: 82 points minimum required" Foreground="#777777" FontSize="10" />
                </StackPanel>
            </Border>

            <!-- Remediation Progress Card -->
            <Border Grid.Column="1" Style="{StaticResource MetricCardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="SOW REMEDIATION PROGRESS" Foreground="#858585" FontSize="10" FontWeight="Bold" />
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="RemediationPercentTextBlock" Text="75%" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock x:Name="RemediationStepsCountTextBlock"
                                   Grid.Column="1"
                                   Text="18 / 24 steps"
                                   Foreground="#389BFF"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar x:Name="RemediationProgressBar" Value="75" Maximum="100" Height="6" Background="#333333" Foreground="#389BFF" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Drift & Signals Card -->
            <Border Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="DRIFT &amp; GOVERNANCE SIGNALS" Foreground="#858585" FontSize="10" FontWeight="Bold" />
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="DriftCountTextBlock" Text="3" Foreground="#FFA726" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Drift Events" Foreground="#858585" FontSize="10" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="OversharingCountTextBlock" Text="5" Foreground="#FF5252" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Overshared" Foreground="#858585" FontSize="10" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="DlpIncidentCountTextBlock" Text="2" Foreground="#42A5F5" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="DLP Conflicts" Foreground="#858585" FontSize="10" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="UnapprovedDriftSubtext" Text="1 Unapproved change detected" Foreground="#FFA726" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Drill-Down Detail Tabs -->
        <TabControl Grid.Row="2"
                    Background="#181818"
                    BorderBrush="#2B2B2B"
                    BorderThickness="0,1,0,0"
                    Margin="16,4,16,16">

            <!-- Tab 1: SOW Phases -->
            <TabItem Header="SOW Phases" Foreground="#E0E0E0" FontSize="12">
                <DataGrid x:Name="SowPhasesDataGrid"
                          Background="#181818"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#262626"
                          Foreground="#FFFFFF"
                          RowBackground="#1E1E1E"
                          AlternatingRowBackground="#222222"
                          HeadersVisibility="Column"
                          Padding="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Workstream Phase" Binding="{Binding Title}" Width="200" />
                        <DataGridTextColumn Header="Scope Description" Binding="{Binding Scope}" Width="*" />
                        <DataGridTextColumn Header="Weeks" Binding="{Binding Weeks}" Width="70" />
                        <DataGridTextColumn Header="Price (USD)" Binding="{Binding PriceUsd, StringFormat={}{0:C0}}" Width="100" />
                        <DataGridTextColumn Header="Est. Delivery" Binding="{Binding DeliveryDate}" Width="110" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 2: Remediation Checklist -->
            <TabItem Header="Remediation Checklist" Foreground="#E0E0E0" FontSize="12">
                <DataGrid x:Name="RemediationDataGrid"
                          Background="#181818"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#262626"
                          Foreground="#FFFFFF"
                          RowBackground="#1E1E1E"
                          AlternatingRowBackground="#222222"
                          HeadersVisibility="Column"
                          Padding="8">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Done" Binding="{Binding IsCompleted}" Width="50" />
                        <DataGridTextColumn Header="Remediation Step" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Pillar" Binding="{Binding Pillar}" Width="120" />
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 3: Configuration Drift -->
            <TabItem Header="Configuration Drift" Foreground="#E0E0E0" FontSize="12">
                <DataGrid x:Name="DriftDataGrid"
                          Background="#181818"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#262626"
                          Foreground="#FFFFFF"
                          RowBackground="#1E1E1E"
                          AlternatingRowBackground="#222222"
                          HeadersVisibility="Column"
                          Padding="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Setting Key" Binding="{Binding SettingKey}" Width="*" />
                        <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="120" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        <DataGridTextColumn Header="Detected At" Binding="{Binding DetectedAt}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 4: Overshared Sites -->
            <TabItem Header="Overshared Sites" Foreground="#E0E0E0" FontSize="12">
                <DataGrid x:Name="OversharingDataGrid"
                          Background="#181818"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#262626"
                          Foreground="#FFFFFF"
                          RowBackground="#1E1E1E"
                          AlternatingRowBackground="#222222"
                          HeadersVisibility="Column"
                          Padding="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Site Name" Binding="{Binding SiteName}" Width="220" />
                        <DataGridTextColumn Header="URL" Binding="{Binding SiteUrl}" Width="*" />
                        <DataGridTextColumn Header="Sensitive Items" Binding="{Binding SensitiveItemsCount}" Width="110" />
                        <DataGridTextColumn Header="Guests" Binding="{Binding GuestCount}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 5: Health & Pillar Breakdown -->
            <TabItem Header="Pillar Scores" Foreground="#E0E0E0" FontSize="12">
                <DataGrid x:Name="PillarsDataGrid"
                          Background="#181818"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#262626"
                          Foreground="#FFFFFF"
                          RowBackground="#1E1E1E"
                          AlternatingRowBackground="#222222"
                          HeadersVisibility="Column"
                          Padding="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pillar" Binding="{Binding Name}" Width="200" />
                        <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="90" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="MyArchitect.Shell.LeftReferencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#181818"
             d:DesignWidth="270">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="14,12,10,10" BorderBrush="#262626" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="REFERENCE" Foreground="#858585" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="TenantSubtext" Text="No tenant selected" Foreground="#389BFF"
                               FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,8,10,8">

                <!-- Portal Bookmarks (folded in from the old activity-bar popout, UI_RULES.md §8) -->
                <TextBlock Text="PORTAL BOOKMARKS" Foreground="#858585" FontSize="10" FontWeight="Bold" Margin="4,4,0,4" />
                <Border Margin="0,0,0,4" Background="#222222" CornerRadius="4" BorderBrush="#333333" BorderThickness="1" Padding="8,4">
                    <TextBox x:Name="BookmarkSearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="#E0E0E0" CaretBrush="#FFFFFF" FontSize="11"
                             TextChanged="BookmarkSearchBox_TextChanged" />
                </Border>
                <StackPanel x:Name="BookmarksList" Margin="0,4,0,12" />

                <!-- VIP lookup — #3484: real check against msp-vip-classifications before acting
                     on a user (surfaced here, and inline in the Console/Remediation Run flow). -->
                <TextBlock Text="VIP LOOKUP" Foreground="#858585" FontSize="10" FontWeight="Bold" Margin="4,8,0,4" />
                <Border Margin="4,0,4,4" Background="#222222" CornerRadius="4" BorderBrush="#333333" BorderThickness="1" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="VipUpnBox" Grid.Column="0" Background="Transparent" BorderThickness="0"
                                 Foreground="#E0E0E0" CaretBrush="#FFFFFF" FontSize="11"
                                 ToolTip="Principal UPN, e.g. alice@contoso.com"
                                 KeyDown="VipUpnBox_KeyDown" />
                        <Button x:Name="VipCheckButton" Grid.Column="1" Content="Check" FontSize="10"
                                Padding="6,2" Margin="6,0,0,0" Click="VipCheckButton_Click" />
                    </Grid>
                </Border>
                <TextBlock x:Name="VipResultText" Text="" Foreground="#5A5A5A" FontSize="11"
                           TextWrapping="Wrap" Margin="4,0,4,12" />

                <!-- Consent status (#3485) — real precondition flag for the active tenant, driven
                     by GET /api/msp/consent (MainWindow.RefreshConsentStatusAsync). -->
                <TextBlock Text="CONSENT STATUS" Foreground="#858585" FontSize="10" FontWeight="Bold" Margin="4,0,0,4" />
                <TextBlock x:Name="ConsentStatusEmptyText" Text="No consent record for this tenant." Foreground="#5A5A5A" FontSize="11"
                           TextWrapping="Wrap" Margin="4,0,4,12" />
                <StackPanel x:Name="ConsentStatusList" Margin="0,0,0,12" />

                <!-- Document browse — #3486, not built yet. -->
                <TextBlock Text="DOCUMENT BROWSE" Foreground="#858585" FontSize="10" FontWeight="Bold" Margin="4,0,0,4" />
                <TextBlock Text="Not available yet — Feature #3486." Foreground="#5A5A5A" FontSize="11"
                           TextWrapping="Wrap" Margin="4,0,4,4" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

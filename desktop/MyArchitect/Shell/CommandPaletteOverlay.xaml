<UserControl x:Class="MyArchitect.Shell.CommandPaletteOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Visibility="Collapsed"
             Background="#88000000"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown"
             MouseDown="Root_MouseDown">
    <Border Width="560" MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,120,0,0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
            CornerRadius="6" MouseDown="Panel_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12,10" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
                <TextBox x:Name="QueryBox" Background="Transparent" BorderThickness="0"
                         Foreground="#FFFFFF" CaretBrush="#FFFFFF" FontSize="15"
                         TextChanged="QueryBox_TextChanged" />
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="340" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultsPanel" Margin="6" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

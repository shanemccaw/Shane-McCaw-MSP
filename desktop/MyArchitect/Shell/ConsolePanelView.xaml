<UserControl x:Class="MyArchitect.Shell.ConsolePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="OutputScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="10">
            <TextBlock x:Name="OutputText"
                       FontFamily="Consolas"
                       FontSize="12"
                       Foreground="#D4D4D4"
                       TextWrapping="Wrap" />
        </ScrollViewer>

        <Border Grid.Row="1" Background="#181818" BorderBrush="#2B2B2B" BorderThickness="0,1,0,0" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="PS&gt;" Foreground="#389BFF" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="InputBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                         Foreground="#E0E0E0" CaretBrush="#FFFFFF" FontFamily="Consolas" FontSize="12"
                         VerticalAlignment="Center" KeyDown="InputBox_KeyDown" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="MyArchitect.Shell.LogViewerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Visibility="Collapsed"
             Background="#88000000"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown"
             MouseDown="Root_MouseDown">
    <Border Width="760" Height="500" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,60,0,0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
            CornerRadius="6" MouseDown="Panel_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: title, mode toggle (Loaded/Live), channel picker + Play (Live only) -->
            <Border Grid.Row="0" Padding="12,10" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Log Viewer" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,16,0" />

                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Width="26" Height="26"
                            Background="Transparent" BorderThickness="0" Foreground="#858585"
                            Cursor="Hand" Click="CloseButton_Click" />

                    <ComboBox x:Name="ChannelComboBox" DockPanel.Dock="Right" Width="200" Margin="0,0,10,0"
                              Visibility="Collapsed" ToolTip="Channel — GET /api/admin/live-stream/channels" />

                    <Button x:Name="PlayButton" DockPanel.Dock="Right" Width="90" Margin="0,0,10,0"
                            Content="▶ Play" Cursor="Hand" Click="PlayButton_Click" Visibility="Collapsed"
                            ToolTip="Explicit-only — starts the SSE + local console stdout subscription (UI_RULES.md §1). No auto-connect." />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="LoadedModeButton" Content="Loaded" IsChecked="True"
                                      Padding="10,4" Margin="0,0,4,0" Cursor="Hand"
                                      ToolTip="Static local console history — nothing arrives on its own"
                                      Click="LoadedModeButton_Click" />
                        <ToggleButton x:Name="LiveModeButton" Content="Live" Padding="10,4" Cursor="Hand"
                                      ToolTip="Explicit-only — press Play to start"
                                      Click="LiveModeButton_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="OutputScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" Padding="12" Background="#1E1E1E">
                <TextBlock x:Name="OutputText" Foreground="#D4D4D4" FontFamily="Consolas" FontSize="12" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

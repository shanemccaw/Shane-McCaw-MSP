<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════════════════════════════════════════════════════════════
         Git #2147 — audited directly from
         desktop/ShaneBuilder/wpf-handoff/Shell Skeleton v2.html (the real
         app-shell mockup, not the palette doc's own documentation styling).
         No font-size/weight/family standard was assumed; every value here
         was grepped out of the mockup's real inline styles.

         Font families (3 distinct real stacks found):
         - Base UI: "Inter,ui-sans-serif,system-ui,sans-serif" — the shell's
           root font-family (set once, on the outermost container, line 32).
         - Monospace: "Consolas,ui-monospace,Menlo,monospace" — used 78/83
           times for every count/log/code element; the other two variants
           found ("ui-monospace,Menlo,Consolas,monospace" x1,
           "ui-monospace,Menlo,monospace" x4) are minor reorderings in the
           mockup itself and not treated as a second real stack.
         - Serif: "ui-serif,Georgia,'Times New Roman',serif" — Claude chat
           pane assistant message text only (line 731), matching the real
           Claude.ai interface it mimics.

         Font sizes: every distinct px value found in the mockup, 7.5–20px.
         Font weights: every distinct CSS font-weight found (400/500/600/
         700/800), named with their standard OpenType weight-class names
         (Regular/Medium/SemiBold/Bold/ExtraBold) — not invented values.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Font families — ported verbatim as the doc's own comma-separated
         fallback stacks, unmodified (including the CSS generic keywords
         ui-sans-serif/system-ui/ui-monospace/sans-serif/monospace/serif).
         WPF's FontFamily resolves each name left-to-right and silently
         skips any it can't find, same as a browser's font stack, so the
         real first-choice fonts (Inter / Consolas / Georgia) still win
         without substituting in a different real font name that isn't in
         the doc. -->
    <FontFamily x:Key="FontFamily.Sans">Inter, ui-sans-serif, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamily.Monospace">Consolas, ui-monospace, Menlo, monospace</FontFamily>
    <FontFamily x:Key="FontFamily.Serif">ui-serif, Georgia, Times New Roman, serif</FontFamily>

    <!-- Font sizes — real distinct px values from the mockup -->
    <sys:Double x:Key="FontSize.7.5">7.5</sys:Double>
    <sys:Double x:Key="FontSize.8">8</sys:Double>
    <sys:Double x:Key="FontSize.8.5">8.5</sys:Double>
    <sys:Double x:Key="FontSize.9">9</sys:Double>
    <sys:Double x:Key="FontSize.9.5">9.5</sys:Double>
    <sys:Double x:Key="FontSize.10">10</sys:Double>
    <sys:Double x:Key="FontSize.10.5">10.5</sys:Double>
    <sys:Double x:Key="FontSize.11">11</sys:Double>
    <sys:Double x:Key="FontSize.11.5">11.5</sys:Double>
    <sys:Double x:Key="FontSize.12">12</sys:Double>
    <sys:Double x:Key="FontSize.12.5">12.5</sys:Double>
    <sys:Double x:Key="FontSize.13">13</sys:Double>
    <sys:Double x:Key="FontSize.13.5">13.5</sys:Double>
    <sys:Double x:Key="FontSize.14">14</sys:Double>
    <sys:Double x:Key="FontSize.15">15</sys:Double>
    <sys:Double x:Key="FontSize.16">16</sys:Double>
    <sys:Double x:Key="FontSize.17">17</sys:Double>
    <sys:Double x:Key="FontSize.18">18</sys:Double>
    <sys:Double x:Key="FontSize.20">20</sys:Double>

    <!-- Font weights — real distinct css font-weight values from the mockup -->
    <FontWeight x:Key="FontWeight.Regular">Regular</FontWeight>
    <FontWeight x:Key="FontWeight.Medium">Medium</FontWeight>
    <FontWeight x:Key="FontWeight.SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeight.Bold">Bold</FontWeight>
    <FontWeight x:Key="FontWeight.ExtraBold">ExtraBold</FontWeight>

</ResourceDictionary>

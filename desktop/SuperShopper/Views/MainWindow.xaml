<Window x:Class="SuperShopper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SuperShopper.ViewModels"
        xmlns:models="clr-namespace:SuperShopper.Models"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SuperShopper Desktop - Supermarket Weekly Ads &amp; Deals Extractor" 
        Height="850" Width="1350"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Main Outer Window Border -->
    <Border x:Name="mainBorder" Background="{StaticResource WindowBackgroundBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Custom TitleBar -->
                <RowDefinition Height="35"/>
                <!-- Row 1: Main IDE Workspace (Activity Bar, Store Directory Sidebar, WebView2 Browser, Deals Panel) -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Status Bar -->
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: CUSTOM TITLEBAR ==================== -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: App Brand & Dropdown Menu -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <Path Data="{StaticResource IconExplorer}" Fill="{StaticResource AccentBrush}"
                              Width="16" Height="16" Stretch="Uniform" Margin="4,0,8,0"/>
                        <TextBlock Text="SuperShopper" Foreground="{StaticResource ForegroundBrightBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Menu VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <MenuItem Header="Stores">
                                <MenuItem Header="Publix Weekly Ad" Command="{Binding NavigateToUrlCommand}" CommandParameter="https://www.publix.com/savings/weekly-ad/view-all"/>
                                <MenuItem Header="Kroger Weekly Ad" Command="{Binding NavigateToUrlCommand}" CommandParameter="https://www.kroger.com/weeklyad"/>
                                <MenuItem Header="Walmart Savings" Command="{Binding NavigateToUrlCommand}" CommandParameter="https://www.walmart.com/savings-spotlight"/>
                                <MenuItem Header="Target Circle Offers" Command="{Binding NavigateToUrlCommand}" CommandParameter="https://www.target.com/c/target-circle-offers/-/N-55119"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="Exit" Click="MenuExit_Click"/>
                            </MenuItem>
                            <MenuItem Header="Deals Extractor">
                                <MenuItem Header="Extract Deals from Page" Click="ExtractDeals_Click"/>
                                <MenuItem Header="View Extracted Sales" Command="{Binding TogglePanelCommand}"/>
                            </MenuItem>
                            <MenuItem Header="Shopping List">
                                <MenuItem Header="View Saved Items" Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Search}"/>
                                <MenuItem Header="Add New Custom Store" Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.SourceControl}"/>
                            </MenuItem>
                            <MenuItem Header="View">
                                <MenuItem Header="Toggle Sidebar" Command="{Binding ToggleSidebarCommand}"/>
                                <MenuItem Header="Toggle Extracted Deals Panel" Command="{Binding TogglePanelCommand}"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <!-- Middle: Quick Store Search / Status -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="450" Height="24" Background="#1E1E1E" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource ForegroundMutedBrush}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ActiveStoreName, StringFormat='Active Supermarket: {0}'}"
                                       Foreground="{StaticResource ForegroundBrightBrush}" FontSize="11" 
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Right: Window Management Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="{StaticResource IconWindowMinimize}" Click="WindowMinimize_Click"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="{StaticResource IconWindowMaximize}" Click="WindowMaximize_Click"/>
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}" Content="{StaticResource IconWindowClose}" Click="WindowClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ROW 1: MAIN WORKSPACE ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Activity Bar Column -->
                    <ColumnDefinition Width="48"/>
                    <!-- Sidebar Column -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Splitter Column -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Main Browser & Shopping Panel Column -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Activity Bar (Far Left Strip) -->
                <Border Grid.Column="0" Background="{StaticResource ActivityBarBackgroundBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <!-- Top Navigation Icons -->
                        <StackPanel VerticalAlignment="Top" Margin="0,4,0,0">
                            <ToggleButton Style="{StaticResource ActivityBarButtonStyle}" Content="{StaticResource IconExplorer}" 
                                          IsChecked="{Binding IsExplorerActive, Mode=OneWay}" ToolTip="Supermarket Directory &amp; Weekly Ads"
                                          Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Explorer}"/>
                            <ToggleButton Style="{StaticResource ActivityBarButtonStyle}" Content="{StaticResource IconSearch}" 
                                          IsChecked="{Binding IsSearchActive, Mode=OneWay}" ToolTip="Shopping List &amp; Saved Deals"
                                          Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Search}"/>
                            <ToggleButton Style="{StaticResource ActivityBarButtonStyle}" Content="{StaticResource IconSourceControl}" 
                                          IsChecked="{Binding IsSourceControlActive, Mode=OneWay}" ToolTip="Add Custom Store Bookmark"
                                          Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.SourceControl}"/>
                        </StackPanel>

                        <!-- Bottom Settings Icon -->
                        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <ToggleButton Style="{StaticResource ActivityBarButtonStyle}" Content="{StaticResource IconSettings}" 
                                          IsChecked="{Binding IsSettingsActive, Mode=OneWay}" ToolTip="Settings &amp; Preferences"
                                          Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Settings}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Primary Sidebar (Store Directory & Deals) -->
                <Border Grid.Column="1" Width="280" Background="{StaticResource SidebarBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                        Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Sidebar Header -->
                        <Border Grid.Row="0" Padding="12,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="{Binding SidebarHeaderTitle}" Foreground="{StaticResource ForegroundMutedBrush}"
                                           FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource TitleBarButtonStyle}" Content="{StaticResource IconCloseSmall}"
                                        HorizontalAlignment="Right" Width="24" Height="24" Command="{Binding ToggleSidebarCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Sidebar Body Content -->
                        <Grid Grid.Row="1" Margin="4">

                            <!-- View 1: Supermarket Directory & Weekly Ads -->
                            <ScrollViewer Visibility="{Binding IsExplorerActive, Converter={StaticResource BoolToVisConverter}}" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding StoreBookmarks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:StoreBookmarkModel}">
                                            <Border Background="#1E1E1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                                    CornerRadius="4" Padding="10" Margin="4">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource ForegroundBrightBrush}" 
                                                                   FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource ForegroundMutedBrush}" 
                                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                                    <Button Grid.Row="2" Content="View Weekly Ad &gt;" HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.SelectStoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- View 2: Shopping List & Saved Deals -->
                            <Grid Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisConverter}}" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="SAVED SHOPPING LIST" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>

                                <!-- Quick Add Item Box -->
                                <Border Grid.Row="1" Background="{StaticResource InputBackgroundBrush}" Padding="6" CornerRadius="3" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewItemTitle, UpdateSourceTrigger=PropertyChanged}" 
                                                 BorderThickness="0" Background="Transparent" 
                                                 Padding="4" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Add" Command="{Binding AddShoppingItemCommand}" Margin="4,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Shopping List View -->
                                <ListBox Grid.Row="2" ItemsSource="{Binding ShoppingList}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ShoppingItemModel}">
                                            <Border Background="#1E1E1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                                    CornerRadius="3" Padding="8" Margin="0,2,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource ForegroundBrightBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding StoreName}" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding PriceInfo}" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- View 3: Add Custom Store Bookmark -->
                            <StackPanel Visibility="{Binding IsSourceControlActive, Converter={StaticResource BoolToVisConverter}}" Margin="8">
                                <TextBlock Text="ADD CUSTOM STORE BOOKMARK" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>

                                <TextBlock Text="Store Name:" Foreground="{StaticResource ForegroundBrush}" FontSize="11" Margin="0,4,0,2"/>
                                <TextBox Text="{Binding NewBookmarkName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                <TextBlock Text="Weekly Ad / Deals URL:" Foreground="{StaticResource ForegroundBrush}" FontSize="11" Margin="0,4,0,2"/>
                                <TextBox Text="{Binding NewBookmarkUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <Button Content="Save Bookmark" Command="{Binding AddBookmarkCommand}"/>
                            </StackPanel>

                            <!-- View 4: Settings -->
                            <StackPanel Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVisConverter}}" Margin="8">
                                <TextBlock Text="SUPERSHOPPER PREFERENCES" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                <CheckBox Content="Persistent Cookies &amp; Session Data" Foreground="{StaticResource ForegroundBrush}" IsChecked="True" IsEnabled="False" Margin="0,4"/>
                                <CheckBox Content="Auto-Extract API Sales Payload" Foreground="{StaticResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>
                                <CheckBox Content="Microsoft Dark Mode Theme" Foreground="{StaticResource ForegroundBrush}" IsChecked="True" IsEnabled="False" Margin="0,4"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Grid Splitter for Resizable Sidebar -->
                <GridSplitter Grid.Column="2" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}" ShowsPreview="False"
                              Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisConverter}}"/>

                <!-- Main WebView2 Browser & Bottom Shopping Panel -->
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <!-- Row 0: WebView2 Browser Viewport -->
                        <RowDefinition Height="*"/>
                        <!-- Row 1: Panel Splitter -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Bottom Extracted Sales Panel -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ==================== WEBVIEW2 BROWSER VIEWPORT ==================== -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <!-- Row 0: Browser Control Bar (Back, Refresh, Address Bar, Extract Deals) -->
                            <RowDefinition Height="38"/>
                            <!-- Row 1: WebView2 Renderer -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Browser Navigation Bar -->
                        <Border Grid.Row="0" Background="#2D2D2D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Back/Forward/Refresh Buttons -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Address Bar Input -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Action Buttons -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Navigation Buttons -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&lt;" Width="28" Height="28" 
                                            ToolTip="Back" Click="WebBack_Click"/>
                                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&gt;" Width="28" Height="28" 
                                            ToolTip="Forward" Click="WebForward_Click"/>
                                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#x21BB;" Width="28" Height="28" 
                                            ToolTip="Refresh Page" Click="WebRefresh_Click"/>
                                </StackPanel>

                                <!-- Address Bar Input Box -->
                                <Border Grid.Column="1" Background="#1E1E1E" BorderBrush="{StaticResource BorderBrush}" 
                                        BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                                    <Grid Margin="6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔒 " Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding AddressBarInput, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" Foreground="{StaticResource ForegroundBrightBrush}"
                                                 FontSize="12" VerticalAlignment="Center" Padding="4,2" KeyDown="AddressBar_KeyDown"/>
                                        <Button Grid.Column="2" Content="Go" Style="{StaticResource TitleBarButtonStyle}" Width="32" Height="22" 
                                                Command="{Binding NavigateToUrlCommand}"/>
                                    </Grid>
                                </Border>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button Content="⚡ Extract Sales Deals" Style="{StaticResource TitleBarButtonStyle}" Width="140" Height="26"
                                            Background="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,6,0"
                                            Click="ExtractDeals_Click" ToolTip="Scrape and parse weekly ad deals from current page"/>
                                    <Button Content="Open in Browser ↗" Style="{StaticResource TitleBarButtonStyle}" Width="110" Height="26"
                                            Command="{Binding OpenExternalBrowserCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- WebView2 Web Rendering Control -->
                        <Grid Grid.Row="1" Background="{StaticResource WindowBackgroundBrush}">
                            <wv2:WebView2 x:Name="webView" 
                                          NavigationStarting="WebView_NavigationStarting" 
                                          NavigationCompleted="WebView_NavigationCompleted"/>
                        </Grid>
                    </Grid>

                    <!-- Bottom Panel Splitter -->
                    <GridSplitter Grid.Row="1" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="{StaticResource BorderBrush}" ShowsPreview="False"
                                  Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- ==================== BOTTOM PANEL (EXTRACTED WEEKLY SALES) ==================== -->
                    <Border Grid.Row="2" Height="240" Background="#1E1E1E" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Panel Header -->
                            <Border Grid.Row="0" Background="#252526" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ EXTRACTED WEEKLY SALES DEALS" Foreground="{StaticResource ForegroundBrightBrush}" 
                                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource AccentBrush}" Padding="6,1" CornerRadius="10" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExtractedDealsCount, StringFormat={}{0} Deals}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Deal Search Filter -->
                                    <Border Grid.Column="1" Width="240" Height="22" HorizontalAlignment="Center" Background="#1E1E1E" 
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                        <Grid Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource ForegroundMutedBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding DealFilterQuery, UpdateSourceTrigger=PropertyChanged}" 
                                                     BorderThickness="0" Background="Transparent" Foreground="{StaticResource ForegroundBrightBrush}" FontSize="11" Padding="4,0"/>
                                        </Grid>
                                    </Border>

                                    <Button Grid.Column="2" Style="{StaticResource TitleBarButtonStyle}" Content="{StaticResource IconCloseSmall}" 
                                            HorizontalAlignment="Right" Width="24" Height="24" Command="{Binding TogglePanelCommand}"/>
                                </Grid>
                            </Border>

                            <!-- Extracted Deals Data Items Grid -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredExtractedDeals}" Background="Transparent" BorderThickness="0" Margin="6">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ExtractedDealModel}">
                                        <Border Background="#252526" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                                CornerRadius="4" Width="290" Padding="8" Margin="4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource ForegroundBrightBrush}" 
                                                               FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <Border Grid.Column="1" Background="#007ACC" Padding="4,1" CornerRadius="2" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding DealType}" Foreground="#FFFFFF" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Grid.Row="1" Text="{Binding PriceInfo}" Foreground="#4EC9B0" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>

                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,6">
                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="10" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding ValidDates}" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="10"/>
                                                </StackPanel>

                                                <Button Grid.Row="3" Content="+ Add to Shopping List" HorizontalAlignment="Right" Height="22" FontSize="10"
                                                        Command="{Binding DataContext.AddDealToShoppingListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== ROW 2: STATUS BAR ==================== -->
            <Border Grid.Row="2" Background="{StaticResource ActivityBarBackgroundBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="8,0">
                    <!-- Left Status Items -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#007ACC" Padding="6,1" CornerRadius="2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ActiveStoreName, StringFormat=Store: \{0\}}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ForegroundBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right Status Items -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ExtractedDealsCount, StringFormat=Extracted Deals: \{0\}}" Foreground="{StaticResource ForegroundBrightBrush}" FontSize="11" Margin="10,0"/>
                        <TextBlock Text="{Binding ShoppingList.Count, StringFormat=Saved Items: \{0\}}" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" Margin="10,0"/>
                        <TextBlock Text="Cookies: Persistent (%LocalAppData%)" Foreground="{StaticResource ForegroundBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

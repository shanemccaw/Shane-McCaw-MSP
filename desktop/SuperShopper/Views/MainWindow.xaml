<Window x:Class="SuperShopper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SuperShopper.ViewModels"
        xmlns:models="clr-namespace:SuperShopper.Models"
        Title="SuperShopper - Antigravity / VS Code Studio" 
        Height="850" Width="1350"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Converter for Enum to Boolean Visibility / Checked State -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <!-- Main Outer Window Border -->
    <Border Background="{StaticResource WindowBackgroundBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: TitleBar / Header -->
                <RowDefinition Height="35"/>
                <!-- Row 1: Main IDE Workspace (Activity Bar, Sidebar, Editor, Panel) -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Status Bar -->
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: CUSTOM TITLEBAR ==================== -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo & Dropdown Menu -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <Path Data="{StaticResource IconFileCode}" Fill="{StaticResource AccentBrush}"
                              Width="16" Height="16" Stretch="Uniform" Margin="4,0,8,0"/>
                        <Menu VerticalAlignment="Center">
                            <MenuItem Header="File">
                                <MenuItem Header="New Text File" InputGestureText="Ctrl+N"/>
                                <MenuItem Header="Open File..." InputGestureText="Ctrl+O"/>
                                <MenuItem Header="Open Folder..." InputGestureText="Ctrl+K Ctrl+O"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="Save" InputGestureText="Ctrl+S"/>
                                <MenuItem Header="Save As..." InputGestureText="Ctrl+Shift+S"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="Exit" Click="MenuExit_Click"/>
                            </MenuItem>
                            <MenuItem Header="Edit">
                                <MenuItem Header="Undo" InputGestureText="Ctrl+Z"/>
                                <MenuItem Header="Redo" InputGestureText="Ctrl+Y"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="Cut" InputGestureText="Ctrl+X"/>
                                <MenuItem Header="Copy" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="Paste" InputGestureText="Ctrl+V"/>
                            </MenuItem>
                            <MenuItem Header="View">
                                <MenuItem Header="Command Palette..." InputGestureText="Ctrl+Shift+P"/>
                                <MenuItem Header="Open View..."/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="Explorer" InputGestureText="Ctrl+Shift+E" Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Explorer}"/>
                                <MenuItem Header="Search" InputGestureText="Ctrl+Shift+F" Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Search}"/>
                                <MenuItem Header="Terminal" InputGestureText="Ctrl+`" Command="{Binding TogglePanelCommand}"/>
                            </MenuItem>
                            <MenuItem Header="Go"/>
                            <MenuItem Header="Run"/>
                            <MenuItem Header="Terminal"/>
                            <MenuItem Header="Help"/>
                        </Menu>
                    </StackPanel>

                    <!-- Middle: Centered Command Palette Search Bar -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="420" Height="24" Background="#1E1E1E" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource ForegroundMutedBrush}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="SuperShopper (Workspace) - Search files, commands (Ctrl+P)"
                                       Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" 
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Right: Window Management Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="{StaticResource IconWindowMinimize}" Click="WindowMinimize_Click"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="{StaticResource IconWindowMaximize}" Click="WindowMaximize_Click"/>
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}" Content="{StaticResource IconWindowClose}" Click="WindowClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ROW 1: MAIN WORKSPACE ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Activity Bar Column -->
                    <ColumnDefinition Width="48"/>
                    <!-- Sidebar Column -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Splitter Column -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Main Editor & Panel Column -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Activity Bar (Far Left Strip) -->
                <Border Grid.Column="0" Background="{StaticResource ActivityBarBackgroundBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <!-- Top Icons -->
                        <StackPanel VerticalAlignment="Top" Margin="0,4,0,0">
                            <ToggleButton Style="{StaticResource ActivityBarButtonStyle}" Content="{StaticResource IconExplorer}" 
                                          IsChecked="{Binding IsExplorerActive, Mode=OneWay}" ToolTip="Explorer (Ctrl+Shift+E)"
                                          Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Explorer}"/>
                            <ToggleButton Style="{StaticResource ActivityBarButtonStyle}" Content="{StaticResource IconSearch}" 
                                          IsChecked="{Binding IsSearchActive, Mode=OneWay}" ToolTip="Search (Ctrl+Shift+F)"
                                          Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Search}"/>
                            <ToggleButton Style="{StaticResource ActivityBarButtonStyle}" Content="{StaticResource IconSourceControl}" 
                                          IsChecked="{Binding IsSourceControlActive, Mode=OneWay}" ToolTip="Source Control (Ctrl+Shift+G)"
                                          Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.SourceControl}"/>
                            <ToggleButton Style="{StaticResource ActivityBarButtonStyle}" Content="{StaticResource IconRunDebug}" 
                                          ToolTip="Run &amp; Debug (Ctrl+Shift+D)"/>
                            <ToggleButton Style="{StaticResource ActivityBarButtonStyle}" Content="{StaticResource IconExtensions}" 
                                          ToolTip="Extensions (Ctrl+Shift+X)"/>
                        </StackPanel>

                        <!-- Bottom Icons -->
                        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <ToggleButton Style="{StaticResource ActivityBarButtonStyle}" Content="{StaticResource IconSettings}" 
                                          IsChecked="{Binding IsSettingsActive, Mode=OneWay}" ToolTip="Settings (Ctrl+,)"
                                          Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Settings}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Primary Sidebar -->
                <Border Grid.Column="1" Width="260" Background="{StaticResource SidebarBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                        Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Sidebar Header -->
                        <Border Grid.Row="0" Padding="12,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="{Binding SidebarHeaderTitle}" Foreground="{StaticResource ForegroundMutedBrush}"
                                           FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource TitleBarButtonStyle}" Content="{StaticResource IconCloseSmall}"
                                        HorizontalAlignment="Right" Width="24" Height="24" Command="{Binding ToggleSidebarCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Sidebar Body Content -->
                        <Grid Grid.Row="1" Margin="4">

                            <!-- View 1: Explorer View -->
                            <TreeView ItemsSource="{Binding FileTree}" Visibility="{Binding IsExplorerActive, Converter={StaticResource BoolToVisConverter}}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}" DataType="{x:Type models:FileItemModel}">
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <Path Data="{Binding IconKey, Converter={x:Null}}" 
                                                  Fill="{StaticResource ForegroundMutedBrush}"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource ForegroundBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <!-- View 2: Search View -->
                            <StackPanel Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisConverter}}" Margin="8">
                                <TextBlock Text="SEARCH IN WORKSPACE" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                <TextBlock Text="SEARCH RESULTS:" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" Margin="0,8,0,4"/>
                                <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}"/>
                            </StackPanel>

                            <!-- View 3: Source Control View -->
                            <StackPanel Visibility="{Binding IsSourceControlActive, Converter={StaticResource BoolToVisConverter}}" Margin="8">
                                <TextBlock Text="SOURCE CONTROL: GIT" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Border Background="{StaticResource InputBackgroundBrush}" Padding="8" CornerRadius="3" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Message (Ctrl+Enter to commit)" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11"/>
                                        <TextBox BorderThickness="0" Background="Transparent" Height="40" Margin="0,4,0,0" AcceptsReturn="True"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="Commit &amp; Push" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- View 4: Settings View -->
                            <StackPanel Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVisConverter}}" Margin="8">
                                <TextBlock Text="USER SETTINGS" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                <CheckBox Content="Auto Save files on focus change" Foreground="{StaticResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>
                                <CheckBox Content="Enable Line Numbers in Editor" Foreground="{StaticResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>
                                <CheckBox Content="Render Whitespace" Foreground="{StaticResource ForegroundBrush}" IsChecked="False" Margin="0,4"/>
                                <CheckBox Content="Microsoft Dark High-Contrast Mode" Foreground="{StaticResource ForegroundBrush}" IsChecked="True" Margin="0,4"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Grid Splitter for Resizable Sidebar -->
                <GridSplitter Grid.Column="2" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}" ShowsPreview="False"
                              Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisConverter}}"/>

                <!-- Main Editor & Bottom Panel Container -->
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Document Editor Area -->
                        <RowDefinition Height="*"/>
                        <!-- Row 1: Panel Splitter -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Bottom Panel (Terminal/Output) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ==================== EDITOR WORK AREA ==================== -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab Bar Header -->
                        <Border Grid.Row="0" Background="#2D2D2D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:EditorTabModel}">
                                            <Border Background="#1E1E1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10,6" Margin="0,0,1,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconFileCode}" Fill="{StaticResource AccentBrush}"
                                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource ForegroundBrightBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="{StaticResource IconCloseSmall}"
                                                            Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Editor Breadcrumb Navigation Bar -->
                        <Border Grid.Row="1" Background="#1E1E1E" Padding="12,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SuperShopper" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11"/>
                                <TextBlock Text=" > " Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding ActiveTab.FilePath, FallbackValue='src > Views > MainWindow.xaml'}" 
                                           Foreground="{StaticResource ForegroundBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Editor Content Grid -->
                        <Grid Grid.Row="2" Background="{StaticResource WindowBackgroundBrush}">
                            <Grid.ColumnDefinitions>
                                <!-- Line Numbers Gutter -->
                                <ColumnDefinition Width="42"/>
                                <!-- Code Editor Text View -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Line Numbers Column -->
                            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="0,8">
                                <StackPanel HorizontalAlignment="Right" Margin="0,0,8,0">
                                    <TextBlock Text="1" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="2" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="3" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="4" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="5" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="6" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="7" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="8" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="9" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="10" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="11" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="12" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="13" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="14" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="15" Foreground="{StaticResource EditorLineNumberBrush}" FontFamily="Consolas" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <!-- Main Syntax Code Editor View -->
                            <TextBox Grid.Column="1" Text="{Binding ActiveTab.Content, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AcceptsTab="True" 
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                                     Background="Transparent" BorderThickness="0" 
                                     Foreground="{StaticResource ForegroundBrightBrush}"
                                     Padding="12,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>

                    <!-- Bottom Panel Splitter -->
                    <GridSplitter Grid.Row="1" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="{StaticResource BorderBrush}" ShowsPreview="False"
                                  Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- ==================== BOTTOM PANEL (TERMINAL / OUTPUT) ==================== -->
                    <Border Grid.Row="2" Height="200" Background="#1E1E1E" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Panel Header Tabs -->
                            <Border Grid.Row="0" Background="#252526" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <Button Content="TERMINAL" Style="{StaticResource TitleBarButtonStyle}" Width="80" 
                                                Foreground="{StaticResource ForegroundBrightBrush}" FontWeight="SemiBold"
                                                Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:ActivePanelMode.Terminal}"/>
                                        <Button Content="OUTPUT" Style="{StaticResource TitleBarButtonStyle}" Width="70"
                                                Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:ActivePanelMode.Output}"/>
                                        <Button Content="PROBLEMS (0)" Style="{StaticResource TitleBarButtonStyle}" Width="100"
                                                Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:ActivePanelMode.Problems}"/>
                                        <Button Content="DEBUG CONSOLE" Style="{StaticResource TitleBarButtonStyle}" Width="110"
                                                Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:ActivePanelMode.Debug}"/>
                                    </StackPanel>

                                    <!-- Panel Controls -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="{StaticResource IconCloseSmall}" 
                                                Width="24" Height="24" Command="{Binding TogglePanelCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Terminal Content -->
                            <Grid Grid.Row="1" Margin="10,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Output Log View -->
                                <TextBox Grid.Row="0" Text="{Binding TerminalOutput, Mode=OneWay}"
                                         IsReadOnly="True" AcceptsReturn="True"
                                         FontFamily="Consolas, Cascadia Code" FontSize="12"
                                         Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

                                <!-- Terminal Input Box -->
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="> " Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" FontSize="12" Background="#252526" BorderBrush="{StaticResource BorderBrush}"
                                             Padding="4,2" KeyDown="TerminalInput_KeyDown"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== ROW 2: STATUS BAR ==================== -->
            <Border Grid.Row="2" Background="{StaticResource ActivityBarBackgroundBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="8,0">
                    <!-- Left Status Items -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Remote Host Badge -->
                        <Border Background="#007ACC" Padding="6,1" CornerRadius="2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTerminal}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text=" &gt;&lt; WSL: Ubuntu" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Git Branch Indicator -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconGitBranch}" Fill="{StaticResource ForegroundMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusBranch}" Foreground="{StaticResource ForegroundBrush}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Error / Warning Counts -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconError}" Fill="#F14C4C" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorCount}" Foreground="{StaticResource ForegroundBrush}" FontSize="11" Margin="3,0,8,0" VerticalAlignment="Center"/>

                            <Path Data="{StaticResource IconWarning}" Fill="#CCA700" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WarningCount}" Foreground="{StaticResource ForegroundBrush}" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Status Items -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Ln 14, Col 28" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" Margin="10,0"/>
                        <TextBlock Text="Spaces: 4" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" Margin="10,0"/>
                        <TextBlock Text="UTF-8" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" Margin="10,0"/>
                        <TextBlock Text="LF" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" Margin="10,0"/>
                        <TextBlock Text="{Binding ActiveTab.Language, FallbackValue='C#'}" Foreground="{StaticResource ForegroundBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="SuperShopper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SuperShopper.ViewModels"
        xmlns:models="clr-namespace:SuperShopper.Models"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Weekly Grocery Deal Finder" 
        Height="880" Width="1440"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Outer Window Border -->
    <Border x:Name="mainBorder" Background="{StaticResource WindowBackgroundBrush}" 
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Top Header Bar -->
                <RowDefinition Height="42"/>
                <!-- Row 1: Main Dashboard Workspace -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: TOP HEADER BAR ==================== -->
            <Border Grid.Row="0" Background="#0B0E14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconExplorer}" Fill="#0084FF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Weekly Grocery Deal Finder" Foreground="{StaticResource ForegroundBrightBrush}" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>

                    <!-- Top Sync Info & Global Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Sync Indicator -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="5 of 7 stores synced" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Week Date Switcher -->
                        <Border Background="#141A26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&lt;" Style="{StaticResource VSCodePanelTabButtonStyle}" Padding="4,0" Foreground="{StaticResource ForegroundMutedBrush}"/>
                                <Path Data="{StaticResource IconPantry}" Fill="{StaticResource ForegroundMutedBrush}" Width="12" Height="12" Stretch="Uniform" Margin="6,0"/>
                                <TextBlock Text="Week of Sep 6 – 12" Foreground="{StaticResource ForegroundBrightBrush}" FontSize="12" FontWeight="SemiBold" Margin="4,0"/>
                                <Button Content="&gt;" Style="{StaticResource VSCodePanelTabButtonStyle}" Padding="4,0" Foreground="{StaticResource ForegroundMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Search Button -->
                        <Button Style="{StaticResource VSCodePanelTabButtonStyle}" Width="32" Height="30" Margin="0,0,8,0" ToolTip="Search Deals">
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource ForegroundMutedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>

                        <!-- Refresh Ads Button -->
                        <Button Content="↻  Refresh ads" Style="{StaticResource PrimaryActionButtonStyle}" Height="30" Margin="0,0,16,0" Click="ExtractDeals_Click"/>

                        <!-- Window Controls -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource TitleBarButtonStyle}" Content="{StaticResource IconWindowMinimize}" Click="WindowMinimize_Click"/>
                            <Button Style="{StaticResource TitleBarButtonStyle}" Content="{StaticResource IconWindowMaximize}" Click="WindowMaximize_Click"/>
                            <Button Style="{StaticResource TitleBarCloseButtonStyle}" Content="{StaticResource IconWindowClose}" Click="WindowClose_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ROW 1: MAIN DASHBOARD WORKSPACE ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Left Navigation Drawer -->
                    <ColumnDefinition Width="240"/>
                    <!-- Col 1: Main Content Surface -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== LEFT NAVIGATION DRAWER ==================== -->
                <Border Grid.Column="0" Background="#080C14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Drawer Brand Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#0084FF" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconCart}" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Deal Finder" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Weekly ads • 7 stores" Foreground="#94A3B8" FontSize="11" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Navigation Menu Sections -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Section 1: RENTAL -->
                                <TextBlock FontSize="11" FontWeight="Bold" Margin="6,0,0,8">
                                    <Run Text="• " Foreground="#8B5CF6"/>
                                    <Run Text="RENTAL" Foreground="#818CF8"/>
                                </TextBlock>

                                <!-- Shopping list (RENTAL) -->
                                <Button Style="{StaticResource VSCodePanelTabButtonStyle}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4" Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Search}">
                                    <Grid Width="190">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Path Data="{StaticResource IconCart}" Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                            <TextBlock Text="Shopping list" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Border Background="#1E293B" Padding="8,2" CornerRadius="8" HorizontalAlignment="Right">
                                            <TextBlock Text="15" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Best deals (RENTAL) -->
                                <Button Style="{StaticResource VSCodePanelTabButtonStyle}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTag}" Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="Best deals" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Pantry (RENTAL) -->
                                <Button Style="{StaticResource VSCodePanelTabButtonStyle}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,18" Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Pantry}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconBox}" Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="Pantry" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Section 2: HOME -->
                                <TextBlock FontSize="11" FontWeight="Bold" Margin="6,0,0,8">
                                    <Run Text="• " Foreground="#06B6D4"/>
                                    <Run Text="HOME" Foreground="#38BDF8"/>
                                </TextBlock>

                                <!-- Shopping list (HOME - Active Blue State) -->
                                <Border Background="#0084FF" CornerRadius="10" Padding="10,8" Margin="0,0,0,4">
                                    <Grid Width="190">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Path Data="{StaticResource IconCart}" Fill="#FFFFFF" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                            <TextBlock Text="Shopping list" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Border Background="#3B9EFF" Padding="8,2" CornerRadius="8" HorizontalAlignment="Right">
                                            <TextBlock Text="19" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Best deals (HOME) -->
                                <Button Style="{StaticResource VSCodePanelTabButtonStyle}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTag}" Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="Best deals" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Pantry (HOME) -->
                                <Button Style="{StaticResource VSCodePanelTabButtonStyle}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,18" Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Pantry}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconBox}" Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="Pantry" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Section 3: WEEKLY ADS -->
                                <TextBlock Text="WEEKLY ADS" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="6,0,0,8"/>

                                <!-- Ad viewer -->
                                <Button Style="{StaticResource VSCodePanelTabButtonStyle}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4" Command="{Binding SelectViewCommand}" CommandParameter="{x:Static vm:ActiveViewMode.Explorer}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAdViewer}" Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="Ad viewer" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Stores & scraping -->
                                <Button Style="{StaticResource VSCodePanelTabButtonStyle}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSettings}" Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="Stores &amp; scraping" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Savings history -->
                                <Button Style="{StaticResource VSCodePanelTabButtonStyle}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTrendingUp}" Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="Savings history" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Drawer Footer Status -->
                        <Border Grid.Row="2" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Ads for week of Sep 6" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="Bold">
                                        <Run Text="• " Foreground="#10B981"/>
                                        <Run Text="Live" Foreground="#10B981"/>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="Last scrape today 6:56 AM" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock Text="Next run Wed 6:00 AM" Foreground="#94A3B8" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== MAIN CONTENT SURFACE ==================== -->
                <Grid Grid.Column="1" Margin="16">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Page Subheader & Action Buttons -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: 3-Column Workspace -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Page Subheader & Primary Actions Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Heading Text -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Weekly ad viewer" Foreground="{StaticResource ForegroundBrightBrush}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Each store's ad loads in the embedded WebView2. The extractor reads offers off the page and matches them to your pantry." 
                                       Foreground="{StaticResource ForegroundMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="↻  Re-scrape all" Height="34" Margin="0,0,10,0" Padding="14,6" Foreground="{StaticResource ForegroundBrightBrush}"/>
                            <Button Content="⚡ Extract from this page" Style="{StaticResource PrimaryActionButtonStyle}" Height="34" Padding="16,6" Click="ExtractDeals_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 3-Column Workspace Layout -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Col 0: Stores List Panel -->
                            <ColumnDefinition Width="260"/>
                            <!-- Col 1: Center Browser Surface -->
                            <ColumnDefinition Width="*"/>
                            <!-- Col 2: Right Extracted Deals Stream & Log -->
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <!-- ==================== COLUMN 0: STORES STATUS PANEL ==================== -->
                        <Border Grid.Column="0" Background="#141A26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Stores" Foreground="{StaticResource ForegroundBrightBrush}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="5 of 7 stores synced" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Stores List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding StoreBookmarks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:StoreBookmarkModel}">
                                                <Border Background="#1A2232" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Store Name Badge & Sync Status -->
                                                        <Grid Grid.Row="0">
                                                            <Border Background="{Binding PillColor}" Padding="8,2" CornerRadius="12" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding StatusText}" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>

                                                        <!-- Offers Count & Latency -->
                                                        <TextBlock Grid.Row="1" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" Margin="0,6,0,0">
                                                            <Run Text="{Binding OfferCount}"/>
                                                            <Run Text=" • "/>
                                                            <Run Text="{Binding LastScrapeTime}"/>
                                                            <Run Text=" • "/>
                                                            <Run Text="{Binding ScrapeSpeed}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- ==================== COLUMN 1: CENTER WEBVIEW2 VIEWPORT ==================== -->
                        <Border Grid.Column="1" Background="#141A26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Mini Browser Top Bar -->
                                    <RowDefinition Height="36"/>
                                    <!-- WebView2 Viewport Surface -->
                                    <RowDefinition Height="*"/>
                                    <!-- Bottom Info Status Strip -->
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>

                                <!-- Mini Browser Header -->
                                <Border Grid.Row="0" Background="#0B0E14" CornerRadius="6" Padding="6,2" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Nav Buttons -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="&lt;" Style="{StaticResource VSCodePanelTabButtonStyle}" Width="24" Height="22" Padding="0" Click="WebBack_Click"/>
                                            <Button Content="&gt;" Style="{StaticResource VSCodePanelTabButtonStyle}" Width="24" Height="22" Padding="0" Click="WebForward_Click"/>
                                            <Button Content="↻" Style="{StaticResource VSCodePanelTabButtonStyle}" Width="24" Height="22" Padding="0" Click="WebRefresh_Click"/>
                                        </StackPanel>

                                        <!-- URL Input -->
                                        <Border Grid.Column="1" Background="#141A26" CornerRadius="4" Margin="6,0" Padding="6,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🌐 " FontSize="10" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding AddressBarInput, UpdateSourceTrigger=PropertyChanged}" 
                                                         BorderThickness="0" Background="Transparent" Foreground="{StaticResource ForegroundMutedBrush}" 
                                                         FontSize="11" VerticalAlignment="Center" Padding="2,0" KeyDown="AddressBar_KeyDown"/>
                                            </Grid>
                                        </Border>

                                        <!-- Right Badges -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#0084FF" Padding="8,2" CornerRadius="4" Margin="0,0,6,0">
                                                <TextBlock Text="WebView2" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <Button Content="↗" Style="{StaticResource VSCodePanelTabButtonStyle}" Width="24" Height="22" Padding="0" Command="{Binding OpenExternalBrowserCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- WebView2 Rendering Surface -->
                                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="6" ClipToBounds="True">
                                    <wv2:WebView2 x:Name="webView" 
                                                  NavigationStarting="WebView_NavigationStarting" 
                                                  NavigationCompleted="WebView_NavigationCompleted"/>
                                </Border>

                                <!-- Bottom Status Bar -->
                                <Border Grid.Row="2" Background="#0B0E14" CornerRadius="6" Padding="10,0" Margin="0,8,0,0">
                                    <Grid VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconExplorer}" Fill="#0084FF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Aldi • live page renders here" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExtractedDealsCount, StringFormat='{}{0} offers parsed'}" Foreground="{StaticResource ForegroundBrightBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding PersonalizedDealsCount, StringFormat='{}{0} matched'}" Foreground="#10B981" FontSize="11" FontWeight="Bold" Margin="0,0,12,0"/>
                                            <TextBlock Text="2.4 s" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ==================== COLUMN 2: RIGHT EXTRACTED DEALS & LOG ==================== -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <!-- Section 1: Live Deals Stream -->
                                <RowDefinition Height="*"/>
                                <!-- Section 2: Real-time Extraction Log Terminal -->
                                <RowDefinition Height="200"/>
                            </Grid.RowDefinitions>

                            <!-- Live Extracted Deals Container -->
                            <Border Grid.Row="0" Background="#141A26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Deal Stream Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Extracted from Aldi" Foreground="{StaticResource ForegroundBrightBrush}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="Today 6:42 AM" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Filter Pill Tabs -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton Content="All" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" 
                                                     Padding="10,3" Margin="0,0,6,0" FontSize="11" FontWeight="Bold"/>
                                        <RadioButton Content="Matched" Style="{StaticResource {x:Type ToggleButton}}" 
                                                     Padding="10,3" Margin="0,0,6,0" FontSize="11" FontWeight="Bold"/>
                                        <RadioButton Content="Unmatched" Style="{StaticResource {x:Type ToggleButton}}" 
                                                     Padding="10,3" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- Extracted Items Stream -->
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FilteredExtractedDeals}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ExtractedDealModel}">
                                                    <Border Background="#1A2232" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Indicator Dot -->
                                                            <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                            <!-- Item Details -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource ForegroundBrightBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Category, StringFormat='Matched → {0}'}" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- Price Tag -->
                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding PriceInfo}" Foreground="{StaticResource ForegroundBrightBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                                <TextBlock Text="reg. $3.89" Foreground="{StaticResource ForegroundMutedBrush}" FontSize="9" HorizontalAlignment="Right"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Extraction Log Terminal Container -->
                            <Border Grid.Row="1" Background="#141A26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Log Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="Extraction log" Foreground="{StaticResource ForegroundBrightBrush}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Synced" Foreground="#10B981" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Log Lines List -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ExtractionLogs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ExtractionLogModel}">
                                                    <TextBlock FontSize="10" FontFamily="Consolas, Courier New" Margin="0,2">
                                                        <Run Text="{Binding Timestamp}" Foreground="{StaticResource ForegroundMutedBrush}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Message}" Foreground="{StaticResource ForegroundBrush}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

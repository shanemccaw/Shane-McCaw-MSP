<Window x:Class="ShanesSurvival.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Settings" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Postgres" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Text="Connection string" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" x:Name="ConnectionStringTextBox" Margin="0,0,0,8"
                 ToolTip="e.g. Host=localhost;Port=5432;Database=shanessurvival;Username=postgres;Password=..."/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="TestConnectionButton" Content="Test Connection" Width="130" Height="26"
                    Click="TestConnectionButton_Click"/>
            <TextBlock x:Name="TestResultText" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Plaid"
                   FontWeight="Bold" FontSize="14" Margin="0,16,0,8"/>

        <Grid Grid.Row="5" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Client ID" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="PlaidClientIdTextBox"/>
        </Grid>

        <Grid Grid.Row="6" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Secret" VerticalAlignment="Center"/>
            <PasswordBox Grid.Column="1" x:Name="PlaidSecretPasswordBox"/>
        </Grid>

        <Grid Grid.Row="7" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Environment" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="PlaidEnvironmentComboBox">
                <ComboBoxItem Content="sandbox"/>
                <ComboBoxItem Content="development"/>
                <ComboBoxItem Content="production"/>
            </ComboBox>
        </Grid>

        <TextBlock Grid.Row="8" x:Name="SettingsFilePathText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                    VerticalAlignment="Bottom" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="90" Height="28" Margin="0,0,8,0"
                    Click="SaveButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="28"
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

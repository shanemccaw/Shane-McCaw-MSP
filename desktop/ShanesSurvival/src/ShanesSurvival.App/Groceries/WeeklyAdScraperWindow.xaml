<Window x:Class="ShanesSurvival.App.Groceries.WeeklyAdScraperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Weekly Ad — Publix" Height="820" Width="1100"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Store:" VerticalAlignment="Center"/>
            <TextBlock x:Name="StoreNameText" Text="Publix" FontWeight="Bold" Margin="6,0,16,0" VerticalAlignment="Center"/>
            <TextBlock Text="Browse this real page below like a normal browser — pick/confirm your store the first time, wait for the ad to finish loading, then click Extract."
                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="1">
            <wv2:WebView2 x:Name="AdWebView"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,4">
            <Button x:Name="ExtractButton" Content="Extract &amp; Push Deals" Height="30" Padding="10,0"
                    VerticalAlignment="Center" Click="ExtractButton_Click"/>
            <Button x:Name="ReloadButton" Content="Reload Page" Height="30" Padding="10,0" Margin="8,0,0,0"
                    VerticalAlignment="Center" Click="ReloadButton_Click"/>
            <Button x:Name="CloseButton" Content="Close" Height="30" Padding="10,0" Margin="8,0,0,0"
                    VerticalAlignment="Center" Click="CloseButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Loading the real Publix weekly-ad page…"
                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
    </Grid>
</Window>

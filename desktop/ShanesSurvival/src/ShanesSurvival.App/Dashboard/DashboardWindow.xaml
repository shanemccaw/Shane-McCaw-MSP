<Window x:Class="ShanesSurvival.App.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Survival Dashboard" Height="800" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Survival Dashboard" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" Content="Refresh (Sync Now)" Height="28" Padding="8,0"
                    Margin="16,0,0,0" VerticalAlignment="Center" Click="RefreshButton_Click"/>
            <TextBlock x:Name="RefreshStatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Top-line covered/short banner -->
                <Border x:Name="TopLineBorder" BorderThickness="2" Padding="16" Margin="0,0,0,16" CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="TopLineText" FontSize="32" FontWeight="Bold"/>
                        <TextBlock x:Name="TopLineSubText" FontSize="13" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- GATE cards -->
                <TextBlock Text="GATE" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <WrapPanel x:Name="GateCardsPanel" Margin="0,0,0,16"/>

                <!-- Other bills, worst-shortfall-first -->
                <TextBlock Text="Bills" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel x:Name="OtherBillsPanel" Margin="0,0,0,16"/>

                <!-- Spend bleed -->
                <TextBlock Text="Spend Bleed (last 30 days, by merchant)" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel x:Name="SpendBleedPanel" Margin="0,0,0,16"/>

                <!-- Warnings -->
                <Border x:Name="WarningsBorder" BorderThickness="1" BorderBrush="Orange" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Notes" FontWeight="Bold" Margin="0,0,0,4"/>
                        <StackPanel x:Name="WarningsPanel"/>
                    </StackPanel>
                </Border>

                <!-- Current Plan -->
                <TextBlock Text="Current Plan" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border x:Name="CurrentPlanBorder" BorderThickness="1" BorderBrush="Gray" Padding="12" Margin="0,0,0,16" CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="CurrentPlanHeaderText" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurrentPlanSubText" Foreground="Gray" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <StackPanel x:Name="CurrentPlanAllocationsPanel"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

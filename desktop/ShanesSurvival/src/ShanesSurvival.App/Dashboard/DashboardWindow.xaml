<Window x:Class="ShanesSurvival.App.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Survival Dashboard" Height="900" Width="1000"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Survival Dashboard" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" Content="Refresh (Sync Now)" Height="28" Padding="8,0"
                    Margin="16,0,0,0" VerticalAlignment="Center" Click="RefreshButton_Click"/>
            <TextBlock x:Name="RefreshStatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. GATE readout — the single biggest, most prominent element on screen. -->
                <Border x:Name="GateReadoutBorder" BorderThickness="2" Background="{StaticResource PanelBackgroundBrush}"
                        Padding="24" Margin="0,0,0,20" CornerRadius="6">
                    <StackPanel>
                        <TextBlock x:Name="GateVerdictText" FontSize="40" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="GateSupportingText" FontSize="14" Margin="0,10,0,0"
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 2. Critical debts strip — real is_critical debts (#2915), always surfaced. -->
                <TextBlock Text="Critical Debts" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel x:Name="CriticalDebtsPanel" Margin="0,0,0,20"/>

                <!-- 3. This cycle / Next cycle panels, side by side (#2918's pay_period_forecast). -->
                <TextBlock Text="Pay-Period Forecast" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock x:Name="ForecastErrorText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                           Margin="0,0,0,8" Visibility="Collapsed"/>
                <Grid x:Name="ForecastGrid" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderThickness="1" Background="{StaticResource PanelBackgroundBrush}"
                            Padding="16" CornerRadius="4">
                        <StackPanel x:Name="Cycle1Panel"/>
                    </Border>
                    <Border Grid.Column="2" BorderThickness="1" Background="{StaticResource PanelBackgroundBrush}"
                            Padding="16" CornerRadius="4">
                        <StackPanel x:Name="Cycle2Panel"/>
                    </Border>
                </Grid>

                <!-- Spend bleed — real bleed view scoped to the 2 spend accounts (#2880). -->
                <TextBlock Text="Spend Bleed (last 30 days, by merchant)" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel x:Name="SpendBleedPanel" Margin="0,0,0,20"/>

                <!-- Warnings -->
                <Border x:Name="WarningsBorder" BorderThickness="1" BorderBrush="{StaticResource DangerAccentBrush}"
                        Background="{StaticResource PanelBackgroundBrush}" Padding="12" Margin="0,0,0,20"
                        CornerRadius="4" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Notes" FontWeight="Bold" Margin="0,0,0,4"/>
                        <StackPanel x:Name="WarningsPanel"/>
                    </StackPanel>
                </Border>

                <!-- Current Plan (#2892) -->
                <TextBlock Text="Current Plan" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border x:Name="CurrentPlanBorder" BorderThickness="1" Background="{StaticResource PanelBackgroundBrush}"
                        Padding="12" Margin="0,0,0,16" CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="CurrentPlanHeaderText" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurrentPlanSubText" Style="{StaticResource MutedTextStyle}" FontSize="12"
                                   Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <StackPanel x:Name="CurrentPlanAllocationsPanel"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

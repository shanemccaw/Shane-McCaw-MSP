<Window x:Class="ShanesSurvival.App.Plaid.PlaidLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Connect a bank account" Height="640" Width="480"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <wv2:WebView2 x:Name="LinkWebView"/>
        <TextBlock x:Name="ErrorText" Foreground="DarkRed" Margin="20" TextWrapping="Wrap"
                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Window>

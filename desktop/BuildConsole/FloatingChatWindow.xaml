<Window x:Class="BuildConsole.FloatingChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BuildConsole.Controls"
        Title="Chat"
        Width="380" Height="500"
        MinWidth="280" MinHeight="300"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Git #2059 (Phase 1) / #2065 (Phase 2) — Floating Chat Window, part of the
         #2035 Global Chat Drawer epic. Always-on-top floaty, same borderless/DragMove
         shape as the #937 Sticky Notes / #973 LinkedIn floaties. Phase 2 adds TABS:
         more than one chat can be open at once (the "would need to support tabs so I
         could have more than one chat open" ask). Each tab is its own chat session
         reusing the SAME bridge #2059 built (FloatingChatBridgeScript) — one
         ChatSafeWebView2 per tab, all living in the BridgeHost grid, but only the
         ACTIVE tab's WebView2 is Visible; the rest are Collapsed, which throttles
         them (WebView2 throttles a hidden control) and pauses their capture until
         reactivated — the exact per-tab equivalent of Phase 1's "collapse pauses
         capture". The formatted latest assistant reply for the active tab renders as
         RichText (MarkdownRenderer output) in the main area; the compact live "bridge"
         strip at the bottom hosts the active chat's real claude.ai WebView2. Quick-send
         fires into that chat's real composer via the existing DOM-injection technique
         and submits, so Shane never has to switch to the tab. -->
    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DockColumn" Width="0"/>
            </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="BridgeRow" Height="170"/>
            </Grid.RowDefinitions>

            <!-- Header strip: active chat title + toggle-dock + collapse-bridge + close; doubles as drag handle -->
            <Border x:Name="HeaderStrip" Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="8,5,6,5"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE8BD;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{StaticResource BlueBrush}"/>
                    <TextBlock x:Name="HeaderTitle" Grid.Column="1" Text="Chat"
                               FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <!-- Git #2195 — side dock toggle: synthesized pending-items relationship map
                         (mentioned issues cross-checked live against GitHub + active pinned
                         questions) for whichever tab is active. -->
                    <Button x:Name="BtnToggleDock" Grid.Column="2"
                            Content="&#xE8A1;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="4,1,4,1"
                            Margin="0,0,2,0"
                            ToolTip="Show/hide the pending-items dock for this chat"
                            Click="BtnToggleDock_Click"/>
                    <Button x:Name="BtnToggleBridge" Grid.Column="3"
                            Content="&#xE010;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="4,1,4,1"
                            Margin="0,0,2,0"
                            ToolTip="Show/hide the live chat page (hiding pauses live capture)"
                            Click="BtnToggleBridge_Click"/>
                    <Button x:Name="BtnClose" Grid.Column="4"
                            Content="&#x2715;"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="4,1,4,1"
                            ToolTip="Close"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Tab strip (#2065). One chip per open chat, horizontally scrollable.
                 Chips are built in code-behind (RebuildTabStrip) so their brushes track
                 the active tab. Hidden entirely when only one chat is open, so a
                 single-chat floaty still reads as the lightweight Phase-1 window. -->
            <Border x:Name="TabStripBorder" Grid.Row="1"
                    Background="{StaticResource CrustBrush}"
                    Visibility="Collapsed">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Padding="4,3,4,0">
                    <StackPanel x:Name="TabStripPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <!-- Active tab's latest assistant reply, rendered as RichText (MarkdownRenderer
                 output injected into ResponseHost in code-behind). -->
            <ScrollViewer Grid.Row="2"
                          x:Name="ResponseScroll"
                          Margin="6,6,6,4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource BaseBrush}">
                <Grid>
                    <TextBlock x:Name="EmptyHint"
                               Margin="10"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource Subtext1Brush}"
                               Text="Waiting for the chat to load… send a message below and the reply will appear here."/>
                    <ContentControl x:Name="ResponseHost" Margin="8,6,8,6"/>
                </Grid>
            </ScrollViewer>

            <!-- Quick-send input (fires into the active tab's chat) -->
            <Grid Grid.Row="3" Margin="6,0,6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="90"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Background="{StaticResource BaseBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource Surface0Brush}"
                         BorderThickness="1"
                         FontSize="13"
                         Padding="6"
                         PreviewKeyDown="InputBox_PreviewKeyDown"/>
                <Button x:Name="BtnSend" Grid.Column="1"
                        Content="Send"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        Margin="6,0,0,0"
                        Padding="12,6,12,6"
                        ToolTip="Send into this chat (Enter). Shift+Enter for a newline."
                        Click="BtnSend_Click"/>
            </Grid>

            <!-- Inline status/error for the active tab (empty by default) -->
            <TextBlock x:Name="InlineMessage" Grid.Row="4"
                       Margin="8,0,8,4"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{StaticResource Subtext1Brush}"/>

            <!-- Live bridge strip: one real claude.ai WebView2 PER open tab (added in
                 code-behind). All tabs' WebView2s live here stacked; only the ACTIVE
                 tab's is Visible, the rest Collapsed — a Collapsed WebView2 is throttled
                 so its scraper pauses, which is precisely the mechanism Phase 1 used for
                 the whole-strip collapse, now applied per-tab. The active one is kept
                 visible so its scraper runs at full speed. -->
            <Border Grid.Row="5"
                    Margin="6,0,6,8"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Grid x:Name="BridgeHost"/>
            </Border>
        </Grid>

        <!-- Git #2195 — side dock: one synthesized "what's actually pending in this chat right
             now" panel per active tab (mentioned-issue relationship map + pinned questions). Hidden
             (DockColumn Width=0) until BtnToggleDock is clicked; content is rebuilt in code-behind
             (ChatDockPanel.Render) whenever the active tab changes or new data arrives. -->
        <Border x:Name="DockBorder" Grid.Column="1"
                Margin="0,0,0,0"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="1,0,0,0"
                Background="{StaticResource CrustBrush}"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <local:ChatDockPanel x:Name="ChatDock" Grid.Row="0"/>
                <Button x:Name="BtnRefreshDock" Grid.Row="1"
                        Content="⟳ Refresh"
                        Style="{StaticResource IconButton}"
                        FontSize="10.5"
                        Padding="6,4,6,4"
                        Margin="6,0,6,6"
                        ToolTip="Re-check mentioned issues and pinned questions for this chat"
                        Click="BtnRefreshDock_Click"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>

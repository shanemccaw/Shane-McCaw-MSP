<Window x:Class="BuildConsole.FloatingChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat"
        Width="380" Height="500"
        MinWidth="280" MinHeight="300"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Git #2059 — Floating Chat Window, Phase 1 of the #2035 Global Chat Drawer
         epic. Always-on-top single-chat floaty, same borderless/DragMove shape as
         the #937 Sticky Notes / #973 LinkedIn floaties. The formatted latest
         assistant reply renders as RichText (MarkdownRenderer output) in the main
         area; a compact live "bridge" strip at the bottom hosts the real claude.ai
         WebView2 (kept visible so its DOM scraper runs at full speed — WebView2
         throttles a hidden control) and is the send/receive engine. Quick-send
         input fires into the chat's real composer via the existing DOM-injection
         technique (FloatingChatBridgeScript) and submits, so Shane never has to
         switch to the tab. -->
    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="BridgeRow" Height="170"/>
            </Grid.RowDefinitions>

            <!-- Header strip: chat title + collapse-bridge + close; doubles as drag handle -->
            <Border x:Name="HeaderStrip" Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="8,5,6,5"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE8BD;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{StaticResource BlueBrush}"/>
                    <TextBlock x:Name="HeaderTitle" Grid.Column="1" Text="Chat"
                               FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <Button x:Name="BtnToggleBridge" Grid.Column="2"
                            Content="&#xE010;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="4,1,4,1"
                            Margin="0,0,2,0"
                            ToolTip="Show/hide the live chat page (hiding pauses live capture)"
                            Click="BtnToggleBridge_Click"/>
                    <Button x:Name="BtnClose" Grid.Column="3"
                            Content="&#x2715;"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="4,1,4,1"
                            ToolTip="Close"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Latest assistant reply, rendered as RichText (MarkdownRenderer output
                 injected into ResponseHost in code-behind). -->
            <ScrollViewer Grid.Row="1"
                          x:Name="ResponseScroll"
                          Margin="6,6,6,4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource BaseBrush}">
                <Grid>
                    <TextBlock x:Name="EmptyHint"
                               Margin="10"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource Subtext1Brush}"
                               Text="Waiting for the chat to load… send a message below and the reply will appear here."/>
                    <ContentControl x:Name="ResponseHost" Margin="8,6,8,6"/>
                </Grid>
            </ScrollViewer>

            <!-- Quick-send input -->
            <Grid Grid.Row="2" Margin="6,0,6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="90"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Background="{StaticResource BaseBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource Surface0Brush}"
                         BorderThickness="1"
                         FontSize="13"
                         Padding="6"
                         PreviewKeyDown="InputBox_PreviewKeyDown"/>
                <Button x:Name="BtnSend" Grid.Column="1"
                        Content="Send"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        Margin="6,0,0,0"
                        Padding="12,6,12,6"
                        ToolTip="Send into this chat (Enter). Shift+Enter for a newline."
                        Click="BtnSend_Click"/>
            </Grid>

            <!-- Inline status/error (empty by default) -->
            <TextBlock x:Name="InlineMessage" Grid.Row="3"
                       Margin="8,0,8,4"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{StaticResource Subtext1Brush}"/>

            <!-- Live bridge strip: the real claude.ai WebView2 (added in code-behind).
                 Kept visible by default so its scraper runs at full speed. -->
            <Border x:Name="BridgeHost" Grid.Row="4"
                    Margin="6,0,6,8"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True"/>
        </Grid>
    </Border>
</Window>

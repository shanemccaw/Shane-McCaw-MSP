<Window x:Class="BuildConsole.SessionSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA Session Finalization &amp; Repo Sync"
        Width="550" Height="570"
        MinWidth="480" MinHeight="460"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">

    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content Body -->
                <RowDefinition Height="Auto"/> <!-- Bottom Actions & Status -->
            </Grid.RowDefinitions>

            <!-- 1. Header strip: drag handle + title + close button -->
            <Border x:Name="HeaderStrip" Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="10,6,8,6"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🚀" FontSize="13"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="QA Session Finalization &amp; Repo Sync"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <Button x:Name="BtnClose" Grid.Column="2"
                            Content="✕"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="5,2,5,2"
                            ToolTip="Close"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 2. Main Content Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,10,12,6">
                    <!-- Scope & Target Area Row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Product Name / Area Picker -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Product Name / Area:" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbProductName" Height="25"
                                      IsEditable="True" FontSize="10"
                                      Background="{StaticResource Surface0Brush}"
                                      Foreground="{StaticResource TextBrush}"
                                      BorderBrush="{StaticResource Surface1Brush}"
                                      BorderThickness="1" Padding="4,2,4,2"
                                      SelectionChanged="CmbProductName_SelectionChanged"
                                      ToolTip="Select target product folder under /Bugs/ or type custom name">
                                <ComboBoxItem Content="MSP_Console"/>
                                <ComboBoxItem Content="Portal"/>
                                <ComboBoxItem Content="Admin-Panel"/>
                                <ComboBoxItem Content="Marketing"/>
                                <ComboBoxItem Content="MSP_Marketing"/>
                                <ComboBoxItem Content="Website"/>
                                <ComboBoxItem Content="BillingPortal"/>
                                <ComboBoxItem Content="General"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Session ID -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Session ID (Folder):" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtSessionId" Height="25"
                                     FontSize="10" FontFamily="Consolas"
                                     Background="{StaticResource Surface0Brush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource Surface1Brush}"
                                     BorderThickness="1" Padding="4,2,4,2"
                                     TextChanged="TxtSessionId_TextChanged"
                                     ToolTip="Unique timestamp or identifier for this QA session"/>
                        </StackPanel>
                    </Grid>

                    <!-- Artifacts Summary Card -->
                    <Border Background="{StaticResource Surface0Brush}"
                            BorderBrush="{StaticResource Surface1Brush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,6,8,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="🐛 Bugs" FontSize="8" Foreground="{StaticResource Subtext1Brush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtBugCountBadge" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="📷 Shots" FontSize="8" Foreground="{StaticResource Subtext1Brush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtShotsBadge" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="💻 Errors" FontSize="8" Foreground="{StaticResource Subtext1Brush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtErrorsBadge" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="🌐 API Calls" FontSize="8" Foreground="{StaticResource Subtext1Brush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtApiBadge" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="⏱ Duration" FontSize="8" Foreground="{StaticResource Subtext1Brush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtDurationBadge" Text="00:00" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Commit Message Input / Preview -->
                    <TextBlock Text="Git Commit Message:" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtCommitMessage" Height="48"
                             FontSize="9" FontFamily="Consolas"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Background="{StaticResource Surface0Brush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource Surface1Brush}"
                             BorderThickness="1" Padding="4,3,4,3"
                             Margin="0,0,0,8"
                             ToolTip="Standard commit format: QA Session &lt;SessionId&gt; – &lt;ProductName&gt; \n &lt;Short Summary Line&gt;"/>

                    <!-- Destination Path Preview -->
                    <TextBlock Text="Repo Target Directory:" FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                    <Border Background="{StaticResource Surface0Brush}"
                            BorderBrush="{StaticResource Surface1Brush}"
                            BorderThickness="1" CornerRadius="3"
                            Padding="6,4,6,4" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtDestinationPath"
                                   Text="/Bugs/MSP_Console/2026-09-13-1327/"
                                   FontFamily="Consolas" FontSize="9"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Push to Git Checkbox -->
                    <CheckBox x:Name="ChkPushToGit"
                              Content="Push to remote repository (current branch) after commit"
                              FontSize="10" Foreground="{StaticResource TextBrush}"
                              IsChecked="True" Margin="0,0,0,8"
                              ToolTip="Executes git push to sync artifacts to GitHub/origin for Claude integration"/>

                    <!-- Summary Markdown Preview Expander -->
                    <Expander x:Name="ExpanderSummary"
                              Header="Preview summary.md (Human-readable for Claude)"
                              FontSize="9" Foreground="{StaticResource AccentBrush}"
                              IsExpanded="False">
                        <Border Background="{StaticResource CrustBrush}"
                                BorderBrush="{StaticResource Surface1Brush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="4" Margin="0,4,0,0">
                            <TextBox x:Name="TxtSummaryPreview"
                                     Height="120" FontSize="8" FontFamily="Consolas"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="{StaticResource BaseBrush}" Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0" Padding="4"/>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Bottom Action Bar & Status -->
            <Border Grid.Row="2" Background="{StaticResource CrustBrush}"
                    CornerRadius="0,0,6,6"
                    Padding="12,8,12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <ProgressBar x:Name="SyncProgressBar" Height="3" IsIndeterminate="True"
                                     Foreground="{StaticResource AccentBrush}"
                                     Visibility="Collapsed" Margin="0,0,0,4"/>
                        <TextBlock x:Name="StatusMessageText"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource StatusSuccessBrush}"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnSyncAndPush" Grid.Column="0"
                                Content="🚀 End Session &amp; Sync to Git"
                                Style="{StaticResource PrimaryButton}"
                                FontWeight="SemiBold" FontSize="11"
                                Padding="10,5,10,5"
                                IsDefault="True"
                                Click="BtnSyncAndPush_Click"/>

                        <Button x:Name="BtnOpenFolder" Grid.Column="1"
                                Content="📂 Open Folder"
                                Style="{StaticResource IconButton}"
                                FontSize="10" Padding="8,5,8,5"
                                Margin="6,0,0,0" IsEnabled="False"
                                ToolTip="Open the session folder in Windows Explorer"
                                Click="BtnOpenFolder_Click"/>

                        <Button x:Name="BtnCopySummary" Grid.Column="2"
                                Content="📋 Copy Summary"
                                Style="{StaticResource IconButton}"
                                FontSize="10" Padding="8,5,8,5"
                                Margin="6,0,0,0" IsEnabled="False"
                                ToolTip="Copy the summary.md content to clipboard"
                                Click="BtnCopySummary_Click"/>

                        <Button x:Name="BtnCancel" Grid.Column="3"
                                Content="Cancel"
                                Style="{StaticResource IconButton}"
                                FontSize="10" Padding="8,5,8,5"
                                Margin="6,0,0,0"
                                Click="BtnClose_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

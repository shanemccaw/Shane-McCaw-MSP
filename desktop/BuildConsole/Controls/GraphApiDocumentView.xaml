<UserControl x:Class="BuildConsole.Controls.GraphApiDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BaseBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Title & Description -->
            <RowDefinition Height="*"/>    <!-- Split workspace: Inputs on left, Results on right -->
        </Grid.RowDefinitions>

        <!-- 1. Header Area -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <DockPanel>
                <Border x:Name="BadgeType" Background="{StaticResource SapphireBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtBadgeType" Text="READ-ONLY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CrustBrush}"/>
                </Border>
                <TextBlock x:Name="TxtApiTitle" Text="Microsoft Graph API Connection Point" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauveBrush}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="TxtApiDescription" Text="No endpoint selected. Choose a Graph API connection point from the left sidebar to execute." FontSize="11.5" Foreground="{StaticResource Subtext1Brush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- 2. Mid Split Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/> <!-- Left: Configurations / Inputs -->
                <ColumnDefinition Width="Auto"/> <!-- Splitter -->
                <ColumnDefinition Width="3*"/>   <!-- Right: Execution results -->
            </Grid.ColumnDefinitions>

            <!-- Inputs Panel (Left) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel>
                    <!-- Target Tenant -->
                    <TextBlock Text="Target Tenant" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboTenants" Height="28" FontSize="12" Margin="0,0,0,16" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>

                    <!-- Endpoint Path / Method details -->
                    <TextBlock Text="Request Route" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource Surface0Brush}" BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1,1,0,1" CornerRadius="4,0,0,4" Padding="8,4" Height="28" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtMethod" Text="GET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauveBrush}" VerticalAlignment="Center"/>
                        </Border>
                        <TextBox x:Name="TxtEndpoint" Grid.Column="1" Height="28" FontSize="12" IsReadOnly="True" Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface1Brush}" BorderThickness="0,1,1,1" Padding="8,4" VerticalContentAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    </Grid>

                    <!-- Required Variables Grid -->
                    <TextBlock x:Name="LblVariables" Text="Required Parameters" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <ItemsControl x:Name="VariablesItemsControl" Margin="0,0,0,16" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Subtext0Brush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="12" VerticalContentAlignment="Center" Background="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}" Padding="6,2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Request Body (POST/PUT only) -->
                    <TextBlock x:Name="LblRequestBody" Text="Request Body (JSON)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtRequestBody" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Courier New" FontSize="11.5" Background="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}" Padding="6" Margin="0,0,0,16" Visibility="Collapsed"/>

                    <!-- Execute Button -->
                    <Button x:Name="BtnExecute" Content="⚡ Execute Graph API" Height="32" FontWeight="SemiBold" Background="{StaticResource PeachBrush}" Foreground="{StaticResource CrustBrush}" BorderThickness="0" Click="BtnExecute_Click" Cursor="Hand" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Surface0Brush}"/>

            <!-- Results Panel (Right) -->
            <Grid Grid.Column="2" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Status bar -->
                    <RowDefinition Height="*"/>    <!-- Output Viewer -->
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="4,4,0,0" Padding="12,8">
                    <DockPanel>
                        <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtExecutionTime" Text="" FontSize="11" Foreground="{StaticResource Subtext0Brush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="1,0,1,1" BorderBrush="{StaticResource Surface0Brush}">
                    <TabItem Header="JSON Output">
                        <TextBox x:Name="TxtJsonOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Courier New" FontSize="11" Background="{StaticResource BaseBrush}" Foreground="{StaticResource TextBrush}" Padding="8" BorderThickness="0"/>
                    </TabItem>
                    <TabItem Header="Raw Response">
                        <TextBox x:Name="TxtRawOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Courier New" FontSize="11" Background="{StaticResource BaseBrush}" Foreground="{StaticResource TextBrush}" Padding="8" BorderThickness="0"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

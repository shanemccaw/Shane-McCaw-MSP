<UserControl x:Class="BuildConsole.Controls.GitManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Git #4158 — Git Manager: a brand new, focused document tab, NOT a Git Doctor
         redesign. Git Doctor's existing narrow ActivityBar/tab surface (GitDoctorView)
         crams 6+ check types, remedies, a run log, the Claude bridge, and commit lookup
         into a tight column. This is deliberately narrower in scope: one job, show what
         the repo needs right now as big, GitHub-Desktop-style action cards (a bold
         headline, a real explanation line, one big one-click button). All detection and
         execution is reused verbatim from GitDoctorService — GetRepoStatusAsync,
         RunChecksAsync, RunStepsAsync — nothing here re-derives that logic. -->

    <Border Background="{StaticResource MantleBrush}">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Padding="20,16"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button x:Name="BtnGitManagerRefresh" DockPanel.Dock="Right"
                            Content="Refresh" Height="30" Padding="14,0" Cursor="Hand"
                            Background="{StaticResource Surface0Brush}"
                            Foreground="{StaticResource TextBrush}" BorderThickness="0"
                            FontSize="{StaticResource CaptionFontSize}" Click="BtnGitManagerRefresh_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Git Manager" FontSize="{StaticResource SubHeaderFontSize}" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="GitManagerSubline" Margin="0,3,0,0"
                                   FontFamily="{StaticResource MonospaceFontFamily}" FontSize="{StaticResource CaptionFontSize}"
                                   Foreground="{StaticResource OverlayBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="GitManagerCardsPanel" Margin="28,24,28,24" MaxWidth="820"
                            HorizontalAlignment="Stretch"/>
            </ScrollViewer>

        </DockPanel>
    </Border>
</UserControl>

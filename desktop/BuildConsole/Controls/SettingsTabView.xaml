<UserControl x:Class="BuildConsole.Controls.SettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════ TOP HEADER BAR & DASHBOARD ════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1"
                Padding="24,14,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings &amp; Environment" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Configure test variables, API credentials, automated watchers, and tool integrations."
                               FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,2,0,8"/>

                    <!-- Health / Status Badges Row -->
                    <WrapPanel Orientation="Horizontal">
                        <!-- Test Env Health Pill -->
                        <Border x:Name="TestEnvHealthBadge" Background="{StaticResource Surface0Brush}"
                                CornerRadius="12" Padding="10,3" Margin="0,0,8,4" Cursor="Hand"
                                MouseLeftButtonDown="TestEnvHealthBadge_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧪 Test Variables: " FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                                <TextBlock x:Name="TestEnvHealthText" Text="Loading..." FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource GreenBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- GitHub PAT Pill -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="12" Padding="10,3" Margin="0,0,8,4"
                                Cursor="Hand" MouseLeftButtonDown="GitHubPatBadge_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑 GitHub PAT: " FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                                <TextBlock x:Name="GitHubPatHealthText" Text="Configured" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource GreenBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Zoho Token Pill -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="12" Padding="10,3" Margin="0,0,8,4"
                                Cursor="Hand" MouseLeftButtonDown="ZohoTokenBadge_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☁️ Zoho API: " FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                                <TextBlock x:Name="ZohoTokenHealthText" Text="Configured" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource GreenBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Replit Watcher Pill -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="12" Padding="10,3" Margin="0,0,8,4"
                                Cursor="Hand" MouseLeftButtonDown="ReplitWatcherBadge_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔁 Replit Watcher: " FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                                <TextBlock x:Name="ReplitWatcherHealthText" Text="Inactive" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Universal Settings Filter Search -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="260" Margin="16,0,0,0">
                    <TextBlock Text="Search Settings &amp; Variables" FontSize="10" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,3"/>
                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="{StaticResource Subtext0Brush}"
                                       VerticalAlignment="Center" Margin="2,0,6,0"/>
                            <TextBox x:Name="SettingsSearchBox" Grid.Column="1" Background="Transparent"
                                     BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="12"
                                     TextChanged="SettingsSearchBox_TextChanged"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" FontSize="10"
                                    Style="{StaticResource IconButton}" Padding="4,0" Visibility="Collapsed"
                                    Click="BtnClearSearch_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════ MAIN TWO-COLUMN SPLIT ════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT NAVIGATION MENU (PERFECTLY ALIGNED) ────────── -->
            <Border Grid.Column="0" Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,1,0" Padding="12,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavButtonsPanel">
                        <TextBlock Text="CATEGORIES" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Subtext0Brush}" Margin="10,0,0,10"/>

                        <!-- 1. Test Environment -->
                        <Border x:Name="NavWrapTestEnvironment" CornerRadius="6" Margin="0,0,0,4">
                            <Button x:Name="NavBtnTestEnvironment" Style="{StaticResource IconButton}"
                                    HorizontalContentAlignment="Stretch" Padding="10,9"
                                    Tag="TestEnvironment" Click="NavButton_Click">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="🧪" FontSize="13" Width="24" TextAlignment="Left" VerticalAlignment="Center"/>
                                    <Border x:Name="TestEnvAlertPill" DockPanel.Dock="Right" Background="{StaticResource PeachBrush}"
                                            CornerRadius="8" Padding="6,1" Visibility="Collapsed" VerticalAlignment="Center">
                                        <TextBlock x:Name="TestEnvAlertCount" Text="!" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource CrustBrush}"/>
                                    </Border>
                                    <TextBlock x:Name="NavTextTestEnvironment" Text="Test Environment" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </Border>

                        <!-- 2. Credentials -->
                        <Border x:Name="NavWrapCredentials" CornerRadius="6" Margin="0,0,0,4">
                            <Button x:Name="NavBtnCredentials" Style="{StaticResource IconButton}"
                                    HorizontalContentAlignment="Stretch" Padding="10,9"
                                    Tag="Credentials" Click="NavButton_Click">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="🔑" FontSize="13" Width="24" TextAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavTextCredentials" Text="API Credentials" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </Border>

                        <!-- 3. General -->
                        <Border x:Name="NavWrapGeneral" CornerRadius="6" Margin="0,0,0,4">
                            <Button x:Name="NavBtnGeneral" Style="{StaticResource IconButton}"
                                    HorizontalContentAlignment="Stretch" Padding="10,9"
                                    Tag="General" Click="NavButton_Click">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="⚙" FontSize="13" Width="24" TextAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavTextGeneral" Text="General &amp; API" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </Border>

                        <!-- 4. Replit Watcher -->
                        <Border x:Name="NavWrapReplitWatcher" CornerRadius="6" Margin="0,0,0,4">
                            <Button x:Name="NavBtnReplitWatcher" Style="{StaticResource IconButton}"
                                    HorizontalContentAlignment="Stretch" Padding="10,9"
                                    Tag="ReplitWatcher" Click="NavButton_Click">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="🔁" FontSize="13" Width="24" TextAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavTextReplitWatcher" Text="Replit Watcher" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </Border>

                        <!-- 5. Scheduled Runs -->
                        <Border x:Name="NavWrapScheduledRun" CornerRadius="6" Margin="0,0,0,4">
                            <Button x:Name="NavBtnScheduledRun" Style="{StaticResource IconButton}"
                                    HorizontalContentAlignment="Stretch" Padding="10,9"
                                    Tag="ScheduledRun" Click="NavButton_Click">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="⏰" FontSize="13" Width="24" TextAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavTextScheduledRun" Text="Scheduled Runs" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </Border>

                        <!-- 6. Web Tools -->
                        <Border x:Name="NavWrapWebTools" CornerRadius="6" Margin="0,0,0,4">
                            <Button x:Name="NavBtnWebTools" Style="{StaticResource IconButton}"
                                    HorizontalContentAlignment="Stretch" Padding="10,9"
                                    Tag="WebTools" Click="NavButton_Click">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="🌐" FontSize="13" Width="24" TextAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavTextWebTools" Text="Web Tools" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </Border>

                        <!-- 7. Claude Projects -->
                        <Border x:Name="NavWrapChatIntegration" CornerRadius="6" Margin="0,0,0,4">
                            <Button x:Name="NavBtnChatIntegration" Style="{StaticResource IconButton}"
                                    HorizontalContentAlignment="Stretch" Padding="10,9"
                                    Tag="ChatIntegration" Click="NavButton_Click">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="💬" FontSize="13" Width="24" TextAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavTextChatIntegration" Text="Claude Projects" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </Border>

                        <!-- 8. Sound & Audio -->
                        <Border x:Name="NavWrapBuildSound" CornerRadius="6" Margin="0,0,0,4">
                            <Button x:Name="NavBtnBuildSound" Style="{StaticResource IconButton}"
                                    HorizontalContentAlignment="Stretch" Padding="10,9"
                                    Tag="BuildSound" Click="NavButton_Click">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="🔊" FontSize="13" Width="24" TextAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavTextBuildSound" Text="Sound &amp; Audio" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </Border>

                        <!-- 9. LinkedIn Pre-fill -->
                        <Border x:Name="NavWrapLinkedIn" CornerRadius="6" Margin="0,0,0,4">
                            <Button x:Name="NavBtnLinkedIn" Style="{StaticResource IconButton}"
                                    HorizontalContentAlignment="Stretch" Padding="10,9"
                                    Tag="LinkedIn" Click="NavButton_Click">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="💼" FontSize="13" Width="24" TextAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavTextLinkedIn" Text="LinkedIn Pre-fill" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── RIGHT CONTENT PER-PAGE AREA ─────────────────────── -->
            <ScrollViewer x:Name="RootScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="28,20,32,40">
                <StackPanel MaxWidth="880" HorizontalAlignment="Left">

                    <!-- ════════════════ 1. PAGE: TEST ENVIRONMENT ════════════════ -->
                    <StackPanel x:Name="PageTestEnvironment" Visibility="Visible">
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🧪" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Test Environment Variables" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource PeachBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnRescanManifests" Content="🔄 Rescan Manifests"
                                                Style="{StaticResource IconButton}" Padding="10,5" FontSize="12"
                                                Click="BtnRescanManifests_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnToggleAddVarCard" Content="➕ Add Variable"
                                                Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="12"
                                                Click="BtnToggleAddVarCard_Click"/>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="Values injected into test manifests resolving {{NAME}} placeholders (e.g. GRAPH_TEST_TENANT_ID, TEST_PORTAL_PASSWORD). Organized by domain with live manifest references so you know exactly where each variable belongs."
                                           FontSize="11.5" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock x:Name="TestEnvScanStatusText" Text="" FontSize="11"
                                           Foreground="{StaticResource BlueBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <!-- Dedicated Test Environment Variables Search -->
                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,14"
                                        BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{StaticResource Subtext0Brush}"
                                                   VerticalAlignment="Center" Margin="2,0,8,0"/>
                                        <TextBox x:Name="TestEnvSearchBox" Grid.Column="1" Background="Transparent"
                                                 BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                                 VerticalAlignment="Center" TextChanged="TestEnvSearchBox_TextChanged"/>
                                        <TextBlock Grid.Column="1" x:Name="TestEnvSearchPlaceholder" Text="Search variables by name, value, manifest file, or area..."
                                                   FontSize="12" Foreground="{StaticResource Subtext0Brush}" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Visible"/>
                                        <Button x:Name="BtnClearTestEnvSearch" Grid.Column="2" Content="✕ Clear" FontSize="11"
                                                Style="{StaticResource IconButton}" Padding="8,2" Visibility="Collapsed"
                                                Click="BtnClearTestEnvSearch_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Quick Add Variable Form Card (Collapsible) -->
                                <Border x:Name="AddVarCard" Background="{StaticResource Surface0Brush}"
                                        BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Create New Environment Variable" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Variable Name (e.g. GRAPH_TEST_TENANT_ID)" FontSize="10"
                                                           Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TestEnvVarNameBox" Height="28" FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Value" FontSize="10"
                                                           Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TestEnvVarValueBox" Height="28" FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <Button x:Name="BtnCancelAddVar" Content="Cancel"
                                                        Style="{StaticResource IconButton}" Padding="12,6" Margin="0,0,8,0"
                                                        Click="BtnCancelAddVar_Click"/>
                                                <Button x:Name="BtnAddTestEnvVar" Content="Save Variable"
                                                        Style="{StaticResource PrimaryButton}" Padding="16,6"
                                                        Click="BtnAddTestEnvVar_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Category Filter Chips -->
                                <WrapPanel x:Name="EnvCategoryChipsPanel" Orientation="Horizontal" Margin="0,0,0,12"/>

                                <!-- Variables List / Cards Container -->
                                <StackPanel x:Name="TestEnvVarsSettingsList"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════ 2. PAGE: CREDENTIALS ════════════════ -->
                    <StackPanel x:Name="PageCredentials" Visibility="Collapsed">
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🔑" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="API Tokens &amp; Credentials" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource PeachBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Authentication tokens used for real GitHub issue synchronization and Zoho API test runs. Stored securely on your local machine."
                                           FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <!-- GitHub PAT Card -->
                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="GitHub Personal Access Token (PAT)" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Used for Git Board sync, milestone management, sub-issue links, and closing issues."
                                                   FontSize="10.5" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="GitHubPatBox" Grid.Column="0" Height="28" FontSize="12" Margin="0,0,8,0"/>
                                            <Button x:Name="BtnSaveGitHubPat" Grid.Column="1" Content="Save Token"
                                                    Style="{StaticResource PrimaryButton}" Padding="16,5" Click="BtnSaveGitHubPat_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="GitHubPatSavedText" Text="" FontSize="11" Foreground="{StaticResource GreenBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Zoho Token Card -->
                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Zoho API Token" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Used for real Zoho CRM test manifests and automation authentication."
                                                   FontSize="10.5" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="ZohoApiTokenBox" Grid.Column="0" Height="28" FontSize="12" Margin="0,0,8,0"/>
                                            <Button x:Name="BtnSaveZohoApiToken" Grid.Column="1" Content="Save Token"
                                                    Style="{StaticResource PrimaryButton}" Padding="16,5" Click="BtnSaveZohoApiToken_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="ZohoApiTokenSavedText" Text="" FontSize="11" Foreground="{StaticResource GreenBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════ 3. PAGE: GENERAL & API ════════════════ -->
                    <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⚙" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="General &amp; Appearance" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource PeachBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Core endpoint configurations and application appearance."
                                           FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <TextBlock Text="Claude Web Endpoint" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <TextBox Text="https://claude.ai" Height="28" FontSize="12" Margin="0,0,0,14" IsReadOnly="True"/>

                                <TextBlock Text="Build Tracker API Server (from scripts\build-queue-watcher.config.json)"
                                           FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ApiBaseUrlDisplay" Text="(not connected)" Height="28" FontSize="12" Margin="0,0,0,4" IsReadOnly="True"/>
                                <TextBlock x:Name="ConfigPathText" Text="" FontSize="10" Foreground="{StaticResource Subtext0Brush}"
                                           Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <TextBlock Text="Color Theme" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <ComboBox Height="28" FontSize="12">
                                    <ComboBoxItem Content="Catppuccin Mocha (Default Dark)" IsSelected="True"/>
                                    <ComboBoxItem Content="Catppuccin Latte (Light)"/>
                                    <ComboBoxItem Content="One Dark Pro"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════ 4. PAGE: REPLIT WATCHER ════════════════ -->
                    <StackPanel x:Name="PageReplitWatcher" Visibility="Collapsed">
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🔁" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Replit Dev Server Watcher" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource PeachBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Automatically monitors your live deployed app and clicks Run on Replit when the server goes to sleep after inactivity."
                                           FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <CheckBox x:Name="ReplitWatcherEnabledCheck" Content="Enable automated background watcher &amp; auto-wake"
                                          FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                                <TextBlock Text="Check interval (minutes)" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ReplitWatcherIntervalBox" Height="28" FontSize="12" Margin="0,0,0,12"/>

                                <TextBlock Text="Replit Run Button Selector (CSS)" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ReplitRunSelectorBox" Height="28" FontSize="12" Margin="0,0,0,2"/>
                                <TextBlock Text="Selector for Replit's Run button in your live workspace. Falls back to button text matching &quot;Run&quot;."
                                           FontSize="10" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Deployed App URL (Polled for health)" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ReplitAppUrlBox" Height="28" FontSize="12" Margin="0,0,0,12"/>

                                <TextBlock Text="Replit Workspace URL (Dashboard where Run is clicked)" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ReplitWorkspaceUrlBox" Height="28" FontSize="12" Margin="0,0,0,14"/>

                                <Button x:Name="BtnSaveReplitWatcher" Content="Save Watcher Settings" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Padding="16,5" Click="BtnSaveReplitWatcher_Click"/>
                                <TextBlock x:Name="ReplitWatcherSavedText" Text="" FontSize="11" Foreground="{StaticResource GreenBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════ 5. PAGE: SCHEDULED RUNS ════════════════ -->
                    <StackPanel x:Name="PageScheduledRun" Visibility="Collapsed">
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⏰" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Scheduled Unattended Runs" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource PeachBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Run the FULL regression suite automatically on a recurring timer. Alerts you via web push notification only if a test fails."
                                           FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <CheckBox x:Name="ScheduledRunEnabledCheck" Content="Enable scheduled regression runs"
                                          FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                                <TextBlock Text="Run interval (hours)" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ScheduledRunIntervalBox" Height="28" FontSize="12" Margin="0,0,0,12"/>

                                <CheckBox x:Name="ScheduledRunPushCheck" Content="Push-notify admins when any step fails"
                                          FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>

                                <Button x:Name="BtnSaveScheduledRun" Content="Save Schedule" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Padding="16,5" Click="BtnSaveScheduledRun_Click"/>
                                <TextBlock x:Name="ScheduledRunSavedText" Text="" FontSize="11" Foreground="{StaticResource GreenBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════ 6. PAGE: WEB TOOLS ════════════════ -->
                    <StackPanel x:Name="PageWebTools" Visibility="Collapsed">
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🌐" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Web Tools Popout Shortcuts" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource PeachBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Quick-launch URLs accessible from the ActivityBar Web Tools popout."
                                           FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <StackPanel x:Name="WebToolsSettingsList" Margin="0,0,0,12"/>

                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Add New Web Tool" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0" Width="60">
                                                <TextBlock Text="Emoji" FontSize="10" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                                <TextBox x:Name="WebToolIconBox" Height="26" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Name" FontSize="10" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                                <TextBox x:Name="WebToolNameBox" Height="26" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="URL" FontSize="10" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                                <TextBox x:Name="WebToolUrlBox" Height="26" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button x:Name="BtnAddWebTool" Content="Add Web Tool" Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left" Padding="14,4" Click="BtnAddWebTool_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════ 7. PAGE: CHAT INTEGRATION ════════════════ -->
                    <StackPanel x:Name="PageChatIntegration" Visibility="Collapsed">
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="💬" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Claude Chat &amp; Projects" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource PeachBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Destination project URL used when right-clicking an Epic on the Git Board to start a new chat."
                                           FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <TextBlock Text="New Chat Project URL" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="EpicChatProjectUrlBox" Height="28" FontSize="12" Margin="0,0,0,10"/>
                                <Button x:Name="BtnSaveEpicChatProjectUrl" Content="Save Project URL" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Padding="16,5" Click="BtnSaveEpicChatProjectUrl_Click"/>
                                <TextBlock x:Name="EpicChatProjectUrlSavedText" Text="" FontSize="11" Foreground="{StaticResource GreenBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════ 8. PAGE: BUILD SOUND ════════════════ -->
                    <StackPanel x:Name="PageBuildSound" Visibility="Collapsed">
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🔊" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Build Completion Audio" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource PeachBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Audio notification chime played when a queue-managed build finishes. (Leave blank to use the bundled default)."
                                           FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <TextBlock Text="Custom Sound File (.mp3 / .wav)" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BuildSoundPathBox" Grid.Column="0" Height="28" FontSize="12" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnBrowseBuildSound" Grid.Column="1" Content="Browse…" Style="{StaticResource IconButton}"
                                            Padding="12,5" FontSize="12" Click="BtnBrowseBuildSound_Click"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnSaveBuildSound" Content="Save Audio" Style="{StaticResource PrimaryButton}"
                                            Padding="16,5" Click="BtnSaveBuildSound_Click"/>
                                    <Button x:Name="BtnResetBuildSound" Content="Reset Default" Style="{StaticResource IconButton}"
                                            Padding="12,5" FontSize="12" Margin="8,0,0,0" Click="BtnResetBuildSound_Click"/>
                                    <Button x:Name="BtnTestBuildSound" Content="▶ Play Test" Style="{StaticResource IconButton}"
                                            Padding="12,5" FontSize="12" Margin="8,0,0,0" Click="BtnTestBuildSound_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="BuildSoundSavedText" Text="" FontSize="11" Foreground="{StaticResource GreenBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════ 9. PAGE: LINKEDIN ════════════════ -->
                    <StackPanel x:Name="PageLinkedIn" Visibility="Collapsed">
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="💼" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="LinkedIn Composer Pre-fill" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Calibrate DOM selectors for pre-filling your scheduled post drafts into LinkedIn."
                                           FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <TextBlock Text="LinkedIn Composer Selector (CSS)" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="LinkedInComposerSelectorBox" Height="28" FontSize="12" Margin="0,0,0,2"/>
                                <TextBlock Text="CSS selector for LinkedIn's contenteditable compose box. Falls back to default Quill container."
                                           FontSize="10" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="LinkedIn Feed URL" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="LinkedInComposeUrlBox" Height="28" FontSize="12" Margin="0,0,0,14"/>

                                <Button x:Name="BtnSaveLinkedIn" Content="Save LinkedIn Config" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Padding="16,5" Click="BtnSaveLinkedIn_Click"/>
                                <TextBlock x:Name="LinkedInSavedText" Text="" FontSize="11" Foreground="{StaticResource GreenBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

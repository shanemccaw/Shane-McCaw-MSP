<UserControl x:Class="BuildConsole.Controls.BuildQueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BuildConsole.Controls"
             MinWidth="220">

    <UserControl.Resources>
        <!-- Git #874 — quiet count-badge tile header (In-Flight/Sessions/To-Do rows).
             A ToggleButton so IsChecked IS the expanded state; the chevron flips via a
             trigger and the actual content Visibility is toggled in code-behind off the
             same Checked/Unchecked events. Rest state deliberately matches the app's
             ordinary Surface0/Surface1 hover language ("quiet") - ToDoTile below swaps
             brushes in code-behind only when its count > 0, per Shane's "announce itself
             only when something's there" ask. -->
        <Style x:Key="QuietTile" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background"      Value="{StaticResource MantleBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Surface0Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{StaticResource Subtext0Brush}"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1,0,0,0">
        <DockPanel LastChildFill="True">

            <!-- ── Header ── -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="QueueDot"
                                 Width="8" Height="8"
                                 Fill="{StaticResource BlueBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"
                                 Effect="{StaticResource BlueGlowFaint}"/>
                        <TextBlock Text="BUILD QUEUE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext1Brush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Global "Queue Paused / Running" toggle — separate from any
                             individual build's Stop. While paused, new queued items are NOT
                             picked up/started (already-running builds keep going); queuing
                             still works normally. See QueueWatcherService.SetPaused and the
                             BuildQueuePanel.QueuePause.cs partial. Colour + glyph flip in
                             code-behind so the paused state is unmistakable at a glance. -->
                        <Button x:Name="BtnPauseQueue"
                                Style="{StaticResource IconButton}"
                                ToolTip="Queue running — click to pause (already-running builds keep going; no new items start until resumed)"
                                Padding="6,4"
                                Margin="0,0,3,0"
                                Click="BtnPauseQueue_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PauseQueueIcon"
                                           Text="&#xE769;"
                                           FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="PauseQueueLabel"
                                           Text="Running"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Manual-only GitHub (Shane, 2026-08-14): the three GitHub-backed
                             tiles below (In-Flight / To-Do / Completed) no longer poll on a
                             timer — this is their single, explicit refresh trigger, matching
                             the Git Board's own #863 header refresh icon. -->
                        <Button x:Name="BtnRefreshGitHubTiles"
                                Style="{StaticResource IconButton}"
                                ToolTip="Refresh Git board, milestones, focus progress, and GitHub tiles"
                                Padding="5,4"
                                Margin="2,0,0,0"
                                Click="BtnRefreshGitHubTiles_Click">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="11"
                                       Foreground="{StaticResource BlueBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnPinQueue"
                                Style="{StaticResource IconButton}"
                                ToolTip="Pin / Collapse Panel"
                                Padding="5,4"
                                Margin="2,0,0,0"
                                Click="BtnPinQueue_Click">
                            <TextBlock x:Name="PinQueueIcon"
                                       Text="&#xE718;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="11"
                                       Foreground="{StaticResource Subtext0Brush}"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Critter Lounge & Picnic/Party Ground ── -->
            <local:CritterLoungeControl DockPanel.Dock="Bottom" x:Name="CritterLounge" Margin="0"/>

            <!-- Git #874 - Shane: "the two things out of all of I actually care about:
                 Build Queue, Open issue current associated to this chat. In-Flight I
                 reference only. To-Do I reference only after a build tells me there is
                 something for me to do." Replaces #866's equal-weight RightPanelTabs
                 TabControl with one scrollable stacked panel, ordered by that priority -
                 Queue and Issues-in-epic get full always-expanded weight, In-Flight/
                 Sessions/To-Do shrink to collapsed-by-default quiet tiles below. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- ══ 1. QUEUE — primary, always expanded, full visual weight ══ -->
                    <Border Padding="10,12" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="QUEUE"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       Margin="0,0,0,8"/>

                            <!-- Git #933 - Shane: "Mark the filtering pills be a drop down menu
                                 because they go off streen. Make All last, and make Queued &
                                 Running first and Default." The old ToggleButton pill row
                                 (real — see code-behind's ApplyFilter) had no wrap/scroll of its
                                 own, so on a narrow panel the later chips (Canceled/Tests) ran
                                 straight off the edge with no way to reach them. A ComboBox
                                 never overflows - it just shows whichever one's selected, and
                                 the dropdown list itself scrolls if it ever needs to. -->
                            <ComboBox x:Name="QueueFilterCombo"
                                      Margin="0,0,0,8"
                                      SelectedIndex="0"
                                      SelectionChanged="QueueFilterCombo_SelectionChanged">
                                <ComboBoxItem Content="Queued &amp; Running" Tag="Active"/>
                                <ComboBoxItem Content="Done"                 Tag="Done"/>
                                <ComboBoxItem Content="Canceled"             Tag="Canceled"/>
                                <ComboBoxItem Content="Tests"                Tag="Tests"/>
                                <ComboBoxItem Content="All"                  Tag="All"/>
                            </ComboBox>

                            <!-- Git #950 - Shane: "Add a search box so I can search direct
                                 Git numbers." Live substring filter on GithubNumber (see
                                 QueueSearchBox_TextChanged); layers on top of the filter chip
                                 above, clears to the full sorted list when emptied. The grey
                                 placeholder is the standard WPF overlay-TextBlock trick (no
                                 native placeholder), shown only while the box is empty. -->
                            <Grid Margin="0,0,0,8">
                                <TextBox x:Name="QueueSearchBox"
                                         Height="26"
                                         Padding="6,4"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Background="{StaticResource Surface0Brush}"
                                         TextChanged="QueueSearchBox_TextChanged"/>
                                <TextBlock IsHitTestVisible="False"
                                           Text="Search # (e.g. 94)"
                                           FontSize="12"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource Subtext1Brush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=QueueSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- ── Queue tree (populated live from GET /extension/queue — see code-behind) ── -->
                            <Grid>
                                <TreeView x:Name="QueueTree" BorderThickness="0" Padding="0,4" SelectedItemChanged="QueueTree_SelectedItemChanged">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0,2"/>
                                            <Setter Property="Margin" Value="0,0,0,3"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                                <TextBlock x:Name="QueueEmptyText"
                                           Text="Not connected — see Settings"
                                           FontSize="11"
                                           Foreground="{StaticResource Subtext1Brush}"
                                           Margin="12,10"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══ 2. ISSUES IN THIS CHAT'S EPIC — second primary section ══
                         Git #829 - Shane: "I need the right panel to have another section
                         that shows me all the issues assigned to the chat I'm on." Only
                         visible while the active editor tab is a chat linked to an epic
                         (see MainWindow's EditorTabs_SelectionChanged -> SetActiveChatEpic).
                         Git #874 adds the real All/Open/Closed filter (default Open),
                         same real-GitHub-state pattern #839 established for the Git Board
                         (not a label). -->
                    <Border x:Name="ChatEpicIssuesSection"
                            Padding="10,12"
                            BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="0,0,0,1"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ChatEpicIssuesHeader"
                                       Text="ISSUES IN THIS EPIC"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ToggleButton x:Name="ChipEpicAll"    Content="All"    Style="{StaticResource FilterChip}" Click="EpicFilterChip_Click" Tag="All"/>
                                <ToggleButton x:Name="ChipEpicOpen"   Content="Open"   Style="{StaticResource FilterChip}" IsChecked="True" Click="EpicFilterChip_Click" Tag="Open"/>
                                <ToggleButton x:Name="ChipEpicClosed" Content="Closed" Style="{StaticResource FilterChip}" Click="EpicFilterChip_Click" Tag="Closed"/>
                            </StackPanel>

                            <ListBox x:Name="ChatEpicIssuesList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="260"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ 3. IN-FLIGHT — one quiet count-badge tile, collapsed by default ══
                         Git #874 - Shane: "In-Flight I reference only." Shrunk from a full
                         equal-weight tab (#866) to a quiet tile; expands in place on click
                         to reveal its existing list, collapsed by default so it stays out
                         of the way until wanted.
                         Git #971 - Shane: "In-Flight and Sessions should not be a 2 column
                         layout, they should work the same as Completed & To-Do." Replaces
                         the old side-by-side 2-column Grid with the same full-width single
                         -column StackPanel shape as #941's Completed/To-Do, same mutually
                         -exclusive accordion between the two (see TileInFlight_Click/
                         TileSessions_Click), same no-MaxHeight-cap + ellipsis-title
                         treatment on the inner list. -->
                    <StackPanel Margin="10,0,10,12">
                        <ToggleButton x:Name="TileInFlight" Style="{StaticResource QuietTile}" Click="TileInFlight_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏳" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="In-Flight" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="InFlightCountText" Text="(0)" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Subtext1Brush}"/>
                            </StackPanel>
                        </ToggleButton>
                        <Border x:Name="TileInFlightContent"
                                Visibility="Collapsed"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1,0,1,1"
                                Padding="4"
                                CornerRadius="0,0,6,6">
                            <ListBox x:Name="InFlightIssuesList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="InFlightIssuesList_SelectionChanged"
                                     SizeChanged="InFlightIssuesList_SizeChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- ══ 3b. SESSIONS — one quiet count-badge tile, collapsed by default ══
                         Git #971 - Shane: "The Build Queue needs to show even when I am
                         building using 'Send to Builder' since that opens a different
                         process... it's not part of the Queue.. but I need a way to know
                         it's running. I think this is what Session is for?" Correct - this
                         reads the real claude CLI agent list directly (ClaudeAgentsService),
                         which lists every active Claude Code session on the machine
                         (interactive AND background) regardless of whether it ever touched
                         the queue, so a Send-to-Builder launch (a plain named claude.exe
                         process, no queue row at all) shows up here same as anything else. -->
                    <StackPanel Margin="10,0,10,12">
                        <ToggleButton x:Name="TileSessions" Style="{StaticResource QuietTile}" Click="TileSessions_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Sessions" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SessionsCountText" Text="(0)" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Subtext1Brush}"/>
                            </StackPanel>
                        </ToggleButton>
                        <Border x:Name="TileSessionsContent"
                                Visibility="Collapsed"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1,0,1,1"
                                Padding="4"
                                CornerRadius="0,0,6,6">
                            <ListBox x:Name="ActiveSessionsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SizeChanged="ActiveSessionsList_SizeChanged"
                                     SelectionChanged="ActiveSessionsList_SelectionChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- ══ 3b. COMPLETED — done builds whose real GitHub issue is still
                         open, one quiet count-badge tile, collapsed by default ══
                         Git #905 - Shane: "I ran a fix on an item in the 400s, it went
                         to done... I don't know what it was... Maybe I need like a last
                         complete list that stays there until the actual issue is closed
                         in Git." Unlike the Queue tab's own "Done" filter chip (which
                         shows EVERY done row, growing forever per #865), this list only
                         ever holds done rows whose linked GitHub issue is STILL OPEN -
                         closing the issue on GitHub is what removes a row from here, not
                         the passage of time or how deep it's buried in queue history.
                         Same "announce itself" accent behavior as To-Do below, since this
                         too is something Shane still needs to act on (review + close). -->
                    <StackPanel Margin="10,0,10,12">
                        <ToggleButton x:Name="TileCompleted" Style="{StaticResource QuietTile}" Click="TileCompleted_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CompletedIcon" Text="✅" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="CompletedLabel" Text="Completed" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CompletedCountText" Text="(0)" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Subtext1Brush}"/>
                            </StackPanel>
                        </ToggleButton>
                        <Border x:Name="TileCompletedContent"
                                Visibility="Collapsed"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1,0,1,1"
                                Padding="4"
                                CornerRadius="0,0,6,6">
                            <ListBox x:Name="CompletedIssuesList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="CompletedIssuesList_SelectionChanged"
                                     SizeChanged="CompletedIssuesList_SizeChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- ══ 4. TO-DO — one quiet count-badge tile, collapsed by default ══
                         Git #874 - Shane: "To-Do I reference only after a build tells me
                         there is something for me to do." The ONE section that should
                         visually announce itself: neutral/quiet at 0 (identical to
                         In-Flight/Sessions above), swaps to the app's existing warning/
                         accent brush (PeachBrush) when count > 0 — done in code-behind
                         since it's data-driven, not a static style trigger. -->
                    <StackPanel Margin="10,0,10,12">
                        <ToggleButton x:Name="TileToDo" Style="{StaticResource QuietTile}" Click="TileToDo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ToDoIcon" Text="🔴" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="ToDoLabel" Text="To-Do" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ToDoCountText" Text="(0)" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Subtext1Brush}"/>
                            </StackPanel>
                        </ToggleButton>
                        <Border x:Name="TileToDoContent"
                                Visibility="Collapsed"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1,0,1,1"
                                Padding="4"
                                CornerRadius="0,0,6,6">
                            <ListBox x:Name="WaitingOnMeList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SizeChanged="WaitingOnMeList_SizeChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- ══ 5. NEEDS ATTENTION (test runs) — one quiet count-badge tile, collapsed by default ══
                         A durable fallback for #54's "needs attention" test-result toast. That toast
                         (surfaced by MainWindow.ApplyRunOutcomeToRunnerWindow when a run fails or #975's
                         screenshot-review fires) auto-dismisses after a few seconds — Shane can miss it.
                         Every such result is ALSO recorded here and STAYS until he actually opens/reviews
                         it (clicking either the toast or the row here addresses + clears it). Same quiet
                         collapsed-by-default tile + PeachBrush/red "announce itself" treatment as To-Do
                         above; wholly in-memory / local (no GitHub, no DB), driven by the real run outcome. -->
                    <StackPanel Margin="10,0,10,12">
                        <ToggleButton x:Name="TileAttention" Style="{StaticResource QuietTile}" Click="TileAttention_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AttentionIcon" Text="🧪" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="AttentionLabel" Text="Needs Attention" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AttentionCountText" Text="(0)" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Subtext1Brush}"/>
                            </StackPanel>
                        </ToggleButton>
                        <Border x:Name="TileAttentionContent"
                                Visibility="Collapsed"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1,0,1,1"
                                Padding="4"
                                CornerRadius="0,0,6,6">
                            <ListBox x:Name="AttentionList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="AttentionList_SelectionChanged"
                                     SizeChanged="AttentionList_SizeChanged"/>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>
</UserControl>

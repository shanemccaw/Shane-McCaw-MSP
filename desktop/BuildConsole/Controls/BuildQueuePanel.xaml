<UserControl x:Class="BuildConsole.Controls.BuildQueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BuildConsole.Controls"
             MinWidth="220">

    <UserControl.Resources>
        <!-- Git #874 — quiet count-badge tile header (In-Flight/Sessions/To-Do rows).
             A ToggleButton so IsChecked IS the expanded state; the chevron flips via a
             trigger and the actual content Visibility is toggled in code-behind off the
             same Checked/Unchecked events. Rest state deliberately matches the app's
             ordinary Surface0/Surface1 hover language ("quiet") - ToDoTile below swaps
             brushes in code-behind only when its count > 0, per Shane's "announce itself
             only when something's there" ask. -->
        <Style x:Key="QuietTile" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background"      Value="{StaticResource MantleBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Surface0Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{StaticResource Subtext0Brush}"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Git #2693 — activity filter chip base look (All/Running/Verifying next to BUILD
             SETS). Selected-state highlight is applied in code-behind
             (UpdateRollupActivityFilterChipsVisual), same convention as the accent-tinted
             selected-row background in BuildRollupRow, since which chip is selected is plain
             code-behind state, not a bindable property here. -->
        <Style x:Key="RollupFilterChipStyle" TargetType="{x:Type Border}">
            <Setter Property="Background"      Value="{StaticResource Surface0Brush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Surface1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="7,2"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style x:Key="RollupFilterChipTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize"    Value="10.5"/>
            <Setter Property="Foreground"  Value="{StaticResource Subtext1Brush}"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1,0,0,0">
        <DockPanel LastChildFill="True">

            <!-- ── Header ── -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="QueueDot"
                                 Width="8" Height="8"
                                 Fill="{StaticResource BlueBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"
                                 Effect="{StaticResource BlueGlowFaint}"/>
                        <TextBlock Text="BUILD QUEUE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext1Brush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Recover Session-Limit Builds — scans every build's raw stdout log
                             touched in the last hour for the CLI's "hit your session limit ·
                             resets …" message (SessionLimitAutoRestartService.TryDetectLimitMessage)
                             and requeues (resumes, doesn't restart from scratch) whatever it finds,
                             regardless of what status the row landed in. Manual counterpart to the
                             automatic reset-timer restart — for when a build died some other way
                             and never got flagged/parked by the live watcher path. See
                             BtnRecoverSessionLimit_Click / SessionLimitAutoRestartService.ManualRecoverFromLogsAsync. -->
                        <Button x:Name="BtnRecoverSessionLimit"
                                Style="{StaticResource IconButton}"
                                ToolTip="Recover session-limit builds — scan the last hour of build logs for 'hit your session limit' and resume any that hit it"
                                Padding="6,4"
                                Margin="0,0,3,0"
                                Click="BtnRecoverSessionLimit_Click">
                            <TextBlock Text="&#xE777;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="11"
                                       Foreground="{StaticResource BlueBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <!-- Git #2136 — Board Reconcile: opens the cleanup/migration window that
                             surfaces every local Verifying/Parked/Crashed/limit-paused row against
                             its REAL current GitHub board Status, so a stale local row (the #1867
                             pattern) can be migrated to the matching board column or dismissed. -->
                        <Button x:Name="BtnBoardReconcile"
                                Style="{StaticResource IconButton}"
                                ToolTip="Board reconcile — review local Verifying/Parked/Crashed rows against the real GitHub board (Git #2136)"
                                Padding="6,4"
                                Margin="0,0,3,0"
                                Click="BtnBoardReconcile_Click">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="11"
                                       Foreground="{StaticResource MauveBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <!-- Git #1480 — paste a full build prompt (headers + body) straight into
                             the queue without going through a chat tab first. Opens the same
                             EditBuildPromptDialog the chat-injected "Edit Build" button uses, so
                             pasting a leading flag line (model / effort / title / buildSet / etc.)
                             is honored identically. -->
                        <Button x:Name="BtnNewBuildFromPaste"
                                Style="{StaticResource IconButton}"
                                ToolTip="Paste a full build prompt (with --flags) and add it to the queue"
                                Padding="6,4"
                                Margin="0,0,3,0"
                                Click="BtnNewBuildFromPaste_Click">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="11"
                                       Foreground="{StaticResource BlueBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <!-- Global "Queue Paused / Running" toggle — separate from any
                             individual build's Stop. While paused, new queued items are NOT
                             picked up/started (already-running builds keep going); queuing
                             still works normally. See QueueWatcherService.SetPaused and the
                             BuildQueuePanel.QueuePause.cs partial. Colour + glyph flip in
                             code-behind so the paused state is unmistakable at a glance. -->
                        <Button x:Name="BtnPauseQueue"
                                Style="{StaticResource IconButton}"
                                ToolTip="Queue running — click to pause (already-running builds keep going; no new items start until resumed)"
                                Padding="6,4"
                                Margin="0,0,3,0"
                                Click="BtnPauseQueue_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PauseQueueIcon"
                                           Text="&#xE769;"
                                           FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="PauseQueueLabel"
                                           Text="Running"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Manual-only GitHub (Shane, 2026-08-14): the three GitHub-backed
                             tiles below (In-Flight / To-Do / Completed) no longer poll on a
                             timer — this is their single, explicit refresh trigger, matching
                             the Git Board's own #863 header refresh icon.
                             Git #1816 — this is now also THE one shared refresh control for
                             Git Board + Batter Up + AI Batter Up: BtnRefreshGitHubTiles_Click
                             raises FullGitRefreshRequested, which MainWindow wires to
                             LeftSidebar.PopulateGitTrackerBoard(forceFresh: true); that fetch
                             fires BoardRefreshCompleted on completion, which #1813 already
                             wired to also await BatterUpPanel.RefreshAsync() and
                             AiBatterUpPanel.RefreshAsync(). No second button needed — this one
                             already cascades into both panels, so it's relabeled here instead
                             of duplicated. -->
                        <Button x:Name="BtnRefreshGitHubTiles"
                                Style="{StaticResource IconButton}"
                                ToolTip="Refresh Git board, Batter Up, AI Batter Up, milestones, focus progress, and GitHub tiles"
                                Padding="5,4"
                                Margin="2,0,0,0"
                                Click="BtnRefreshGitHubTiles_Click">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="11"
                                       Foreground="{StaticResource BlueBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnPinQueue"
                                Style="{StaticResource IconButton}"
                                ToolTip="Pin / Collapse Panel"
                                Padding="5,4"
                                Margin="2,0,0,0"
                                Click="BtnPinQueue_Click">
                            <TextBlock x:Name="PinQueueIcon"
                                       Text="&#xE718;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="11"
                                       Foreground="{StaticResource Subtext0Brush}"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Build Set Rollup — Git #1834: collapsible per-buildSet status summary,
                 filling the space #1816 freed up when Batter Up/AI Batter Up collapsed to a
                 single header row when empty (MainWindow docks AiBatterUpPanel →
                 BatterUpPanel → BuildQueuePanel top-to-bottom, so this is the next thing on
                 screen after them). Lives here rather than on a sibling Batter Up panel's
                 header because the data (bt_build_queue via _lastItems) is already owned by
                 this panel, and their post-#1816 header only has room for a short count
                 string, not a rollup list. Docked Top (not inside the ScrollViewer below) so
                 it stays visible regardless of scroll position. Populated entirely in
                 code-behind (RenderBuildSetRollup) — hidden outright when no build set has
                 any real current activity, so an idle queue doesn't grow this back into dead
                 space either. -->
            <Border x:Name="BuildSetRollupSection"
                    DockPanel.Dock="Top"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8,10,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="BUILD SETS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext1Brush}"/>
                        <!-- Git #1834 addendum — clicking a row below drills the queue graph
                             down to that build set (composes with QueueFilterCombo + the
                             search box as AND, doesn't override either — see ApplyFilter).
                             This is the "clear it" affordance; hidden while no drill-down is
                             active. -->
                        <TextBlock x:Name="BuildSetRollupClearText"
                                   DockPanel.Dock="Right"
                                   FontSize="10.5"
                                   Foreground="{StaticResource BlueBrush}"
                                   Cursor="Hand"
                                   HorizontalAlignment="Right"
                                   Visibility="Collapsed"
                                   MouseLeftButtonDown="BuildSetRollupClear_Click"/>
                        <!-- Git #2693 — activity filter chips: which rollup rows below show, by
                             real running/verifying activity within each set. A SEPARATE concept
                             from _buildSetFilter/BuildSetRollupClearText above (which drills the
                             queue graph down to one chosen set) — this only narrows which of the
                             existing rollup rows render, composing with the any-activity filter
                             RenderBuildSetRollup already applies. -->
                        <StackPanel x:Name="RollupActivityFilterChips"
                                    Orientation="Horizontal"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left">
                            <Border x:Name="RollupFilterChipAll" Style="{StaticResource RollupFilterChipStyle}" Tag="all" MouseLeftButtonDown="RollupActivityFilterChip_Click">
                                <TextBlock Text="All" Style="{StaticResource RollupFilterChipTextStyle}"/>
                            </Border>
                            <Border x:Name="RollupFilterChipRunning" Style="{StaticResource RollupFilterChipStyle}" Tag="running" MouseLeftButtonDown="RollupActivityFilterChip_Click">
                                <TextBlock Text="Running" Style="{StaticResource RollupFilterChipTextStyle}"/>
                            </Border>
                            <Border x:Name="RollupFilterChipVerifying" Style="{StaticResource RollupFilterChipStyle}" Tag="verifying" MouseLeftButtonDown="RollupActivityFilterChip_Click">
                                <TextBlock Text="Verifying" Style="{StaticResource RollupFilterChipTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <!-- Git #2179 — Shane: a wide/active queue can have 15-20+ concurrent build
                         sets, and this section was unbounded (Dock=Top, no MaxHeight), so it grew
                         tall enough to push the real queue graph below it clean off the visible
                         panel — "blocking my view of the actual build queue and cannot manage the
                         queue items." Cap it and let IT scroll instead of the whole panel, so the
                         queue graph below always stays reachable regardless of how many build
                         sets are active. -->
                    <ScrollViewer MaxHeight="180"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BuildSetRollupList"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ── Critter Lounge & Picnic/Party Ground ── -->
            <local:CritterLoungeControl DockPanel.Dock="Bottom" x:Name="CritterLounge" Margin="0"/>

            <!-- Git #874 - Shane: "the two things out of all of I actually care about:
                 Build Queue, Open issue current associated to this chat. In-Flight I
                 reference only. To-Do I reference only after a build tells me there is
                 something for me to do." Replaces #866's equal-weight RightPanelTabs
                 TabControl with one scrollable stacked panel, ordered by that priority -
                 Queue and Issues-in-epic get full always-expanded weight, In-Flight/
                 Sessions/To-Do shrink to collapsed-by-default quiet tiles below. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- ══ 1. QUEUE — primary, always expanded, full visual weight ══ -->
                    <Border Padding="10,12" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="QUEUE"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       Margin="0,0,0,6"/>

                            <!-- Queue status counts (Git #1862) — replaces the old token/cost
                                 badge (it flipped between a context-window ESTIMATE and a real
                                 spend total under one label; see #1862 for why it was unfixable).
                                 Four REAL, reconciled counts: In queue = queued + limit-paused;
                                 Blocked = queued rows a GitHub-open blocker holds; Up next = the
                                 real claim candidates (queued, all blockers closed, not paused);
                                 Verifying = rows at VerifyingStatus. The "(N active)" running
                                 readout on the right is unchanged. Clicking opens QueueNextPopup:
                                 the next five builds about to run, in genuine claim order (a
                                 read-only peek at GetNextAsync's own selection — claims nothing). -->
                            <Border x:Name="QueueStatusBorder"
                                    Background="{StaticResource Surface0Brush}"
                                    BorderBrush="{StaticResource Surface1Brush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5"
                                    Margin="0,0,0,8"
                                    Cursor="Hand"
                                    ToolTip="Live queue status — click for the next builds to run, in real claim order."
                                    MouseLeftButtonUp="QueueStatusBorder_Click">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="&#xE70D;"
                                               DockPanel.Dock="Right"
                                               FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                               FontSize="9"
                                               Margin="4,0,0,0"
                                               Foreground="{StaticResource Subtext0Brush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="QueueActiveSlotsText" Text=" (0 active)"
                                               DockPanel.Dock="Right"
                                               FontSize="10"
                                               Foreground="{StaticResource Subtext0Brush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="QueueStatusCountsText"
                                               Text="In queue: 0  ·  Blocked: 0  ·  Up next: 0  ·  Verifying: 0"
                                               FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Popup x:Name="QueueNextPopup"
                                   PlacementTarget="{Binding ElementName=QueueStatusBorder}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Background="{StaticResource MantleBrush}"
                                        BorderBrush="{StaticResource Surface1Brush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        MinWidth="280"
                                        MaxWidth="340">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.4"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="NEXT TO RUN"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Subtext1Brush}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="Real claim order — a read-only peek, claims nothing."
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource Subtext0Brush}"
                                                   Margin="0,0,0,8"/>
                                        <StackPanel x:Name="QueueNextHost"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- Crash/orphan bulk recovery banner — Shane's video-driver hard
                                 crash left multiple builds stuck 'running' from the dead
                                 instance; the per-item startup sweep (RecoverOrphanedRunningItemsAsync)
                                 already marks each one failed (exit -2) so nothing sits silently
                                 lost, but recovering N of them one right-click at a time is its
                                 own mess. This banner surfaces the count and recovers all of them
                                 in one click — Resume Session where a real session id got
                                 captured, plain Retry otherwise. Hidden (Collapsed) whenever there
                                 are none. Two rows (text, then a full-width button below) — a
                                 single DockPanel row ran the button off the panel's narrow width;
                                 right-click for "Mark All Recovered (Dismiss)" when Shane just
                                 wants the warning gone without re-queuing anything. -->
                            <Border x:Name="OrphanRecoveryBanner"
                                    Background="#3A1E26"
                                    BorderBrush="{StaticResource RedBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6"
                                    Margin="0,0,0,8"
                                    Visibility="Collapsed"
                                    ToolTip="Right-click to mark all recovered (dismiss) without re-queuing">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="MiDismissOrphans" Header="✓ Mark All Recovered (Dismiss)" Click="DismissAllOrphans_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <TextBlock x:Name="OrphanRecoveryText"
                                               Text="0 builds orphaned by a crash/restart"
                                               FontSize="11"
                                               Foreground="{StaticResource RedBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="BtnRecoverOrphans"
                                            Content="♻ Recover All"
                                            Padding="8,3"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Stretch"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Click="BtnRecoverOrphans_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Git #933 - Shane: "Mark the filtering pills be a drop down menu
                                 because they go off streen. Make All last, and make Queued &
                                 Running first and Default." The old ToggleButton pill row
                                 (real — see code-behind's ApplyFilter) had no wrap/scroll of its
                                 own, so on a narrow panel the later chips (Canceled/Tests) ran
                                 straight off the edge with no way to reach them. A ComboBox
                                 never overflows - it just shows whichever one's selected, and
                                 the dropdown list itself scrolls if it ever needs to. -->
                            <ComboBox x:Name="QueueFilterCombo"
                                      Margin="0,0,0,8"
                                      SelectedIndex="0"
                                      SelectionChanged="QueueFilterCombo_SelectionChanged">
                                <!-- Git #1829 — split from the old combined "Queued & Running"
                                     entry: Running = running + VerifyingStatus (still visually
                                     "in motion" work), Queued = queued + LimitPausedStatus
                                     (genuinely not executing right now, waiting to resume). -->
                                <ComboBoxItem Content="Running" Tag="Running"/>
                                <ComboBoxItem Content="Queued"  Tag="Queued"/>
                                <!-- Git #1894 — Shane found himself switching back and forth
                                     between Running/Queued after #1829 split them; with #1834's
                                     per-buildSet filtering now available a combined view isn't
                                     as noisy as it was before #1829, so it's added back as a
                                     third choice alongside (not replacing) the two split ones.
                                     Reuses the exact pre-#1829 combined "Active" criteria. -->
                                <ComboBoxItem Content="Running &amp; Queued" Tag="RunningAndQueued"/>
                                <!-- Git #1927 — Shane needs a standalone "Verifying" entry
                                     distinct from "Running" above (which folds VerifyingStatus
                                     into the broader "in motion" bucket): filters to exactly
                                     status == VerifyingStatus, same single-status pattern as
                                     Crashed/Parked/Done/Canceled below. -->
                                <ComboBoxItem Content="Verifying"    Tag="Verifying"/>
                                <!-- Git #1638 — the Park staging area: never shown under
                                     Running/Queued (that's the whole point of a
                                     staging spot the watcher can't pick up), only here. -->
                                <!-- Git #1877 — the orphaned-by-crash set, same criteria the
                                     existing recovery banner already uses (status=="failed" &&
                                     ExitCode==-2), just as a findable filtered view. -->
                                <ComboBoxItem Content="Crashed"              Tag="Crashed"/>
                                <ComboBoxItem Content="Parked"               Tag="Parked"/>
                                <!-- Git #1989 — Conservation Cap: a build parked because it
                                     exceeded Sonnet High while the toggle was on. Deliberately
                                     its OWN filter, distinct from the #1638 "Parked" staging
                                     area above (a different concept — see AccountCapPolicy's
                                     CappedStatus doc comment) — must stay visible/findable, not
                                     buried, per Shane's own requirement on #1989. -->
                                <ComboBoxItem Content="Capped"               Tag="Capped"/>
                                <!-- Git #1638 — "Send to Builder" launches tracked purely
                                     for dedup/visibility/log-capture; never claimable by the
                                     watcher, never in the 8-slot Build Watch grid. -->
                                <ComboBoxItem Content="External"             Tag="External"/>
                                <ComboBoxItem Content="Done"                 Tag="Done"/>
                                <ComboBoxItem Content="Canceled"             Tag="Canceled"/>
                                <ComboBoxItem Content="Tests"                Tag="Tests"/>
                                <ComboBoxItem Content="All"                  Tag="All"/>
                            </ComboBox>

                            <!-- Git #950 - Shane: "Add a search box so I can search direct
                                 Git numbers." Substring filter on GithubNumber; layers on top
                                 of the filter chip above, clears to the full sorted list when
                                 emptied. The grey placeholder is the standard WPF
                                 overlay-TextBlock trick (no native placeholder), shown only
                                 while the box is empty.
                                 Git #2028 — genuine submit-on-Enter only: TextChanged just
                                 tracks the raw text for the placeholder trigger below; the
                                 actual search (QueueSearchBox_KeyDown) fires exactly once,
                                 only on Enter — never mid-type, not even debounced. -->
                            <Grid Margin="0,0,0,8">
                                <TextBox x:Name="QueueSearchBox"
                                         Style="{StaticResource SearchTextBox}"
                                         Height="32"
                                         Padding="6,4,24,4"
                                         FontSize="{StaticResource BodyFontSize}"
                                         VerticalContentAlignment="Center"
                                         Background="{StaticResource Surface0Brush}"
                                         TextChanged="QueueSearchBox_TextChanged"
                                         KeyDown="QueueSearchBox_KeyDown"/>
                                <TextBlock IsHitTestVisible="False"
                                           Text="Search # (e.g. 94)"
                                           FontSize="{StaticResource BodyFontSize}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource Subtext1Brush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=QueueSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Git #2058 — non-reflowing warning when a build is dispatched or a
                                 search is run while a Build Set filter (rollup row above) is still
                                 active: the new/matching item can genuinely exist but be hidden by
                                 the filter, and there was no signal telling Shane why. A Popup
                                 (same mechanism as QueueNextPopup above) renders in its own overlay
                                 layer entirely outside this StackPanel's layout pass, so it can
                                 never bump/reflow the rest of the panel — the explicit requirement
                                 from the issue. Shown via ShowBuildSetFilterWarning; auto-hides
                                 itself after a few seconds. Deliberately does NOT auto-clear the
                                 filter (considered and rejected in favor of this warning). -->
                            <Popup x:Name="BuildSetFilterWarningPopup"
                                   PlacementTarget="{Binding ElementName=QueueSearchBox}"
                                   Placement="Bottom"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   IsOpen="False">
                                <Border Background="#3A3200"
                                        BorderBrush="{StaticResource YellowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        MaxWidth="240"
                                        Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <TextBlock x:Name="BuildSetFilterWarningText"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource YellowBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </Popup>

                            <!-- ── Visual Queue DAG with Canvas-based connector lines (#860) ──
                                 Git #1634 — Shane: exactly one scrollbar for the whole panel, not
                                 one here plus the outer one (~line 155). This card list used to
                                 sit in its own capped ScrollViewer (MaxHeight="900") so a huge
                                 queue scrolled independently; Shane is explicitly reversing that
                                 now — no independent scroll region here, the list just grows to
                                 its natural height and the outer ScrollViewer is the only surface
                                 that scrolls. -->
                            <Grid x:Name="QueueGraphContainer" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="GraphColumn" Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Canvas for DAG lane connectors, Bézier curves, and status node dots -->
                                <Canvas x:Name="QueueGraphCanvas" Grid.Column="0" ClipToBounds="False" HorizontalAlignment="Left"/>
                                <!-- Stack of build cards (one per node), aligned with GraphCanvas -->
                                <StackPanel x:Name="QueueCardsHost" Grid.Column="1" SizeChanged="QueueCardsHost_SizeChanged"/>
                            </Grid>
                            <TextBlock x:Name="QueueEmptyText"
                                       Text="Not connected — see Settings"
                                       FontSize="11"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       Margin="12,10"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       Visibility="Collapsed"/>
                            <!-- Git #1833 — "All" (the broad, unfiltered view) with an empty search
                                 box no longer eagerly renders every non-hidden item as a full DAG +
                                 card pass; this placeholder stands in its place until a real query is
                                 typed. Narrow filters (Running/Queued/Parked/etc.) are unaffected and
                                 keep rendering their own contents normally with empty search. -->
                            <TextBlock x:Name="QueueBroadFilterPlaceholderText"
                                       Text="Type a build number to search."
                                       FontSize="11"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       Margin="12,10"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ 2. ISSUES IN THIS CHAT'S EPIC — second primary section ══
                         Git #829 - Shane: "I need the right panel to have another section
                         that shows me all the issues assigned to the chat I'm on." Only
                         visible while the active editor tab is a chat linked to an epic
                         (see MainWindow's EditorTabs_SelectionChanged -> SetActiveChatEpic).
                         Git #874 adds the real All/Open/Closed filter (default Open),
                         same real-GitHub-state pattern #839 established for the Git Board
                         (not a label). -->
                    <Border x:Name="ChatEpicIssuesSection"
                            Padding="10,12"
                            BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="0,0,0,1"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ChatEpicIssuesHeader"
                                       Text="ISSUES IN THIS EPIC"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ToggleButton x:Name="ChipEpicAll"    Content="All"    Style="{StaticResource FilterChip}" Click="EpicFilterChip_Click" Tag="All"/>
                                <ToggleButton x:Name="ChipEpicOpen"   Content="Open"   Style="{StaticResource FilterChip}" IsChecked="True" Click="EpicFilterChip_Click" Tag="Open"/>
                                <ToggleButton x:Name="ChipEpicClosed" Content="Closed" Style="{StaticResource FilterChip}" Click="EpicFilterChip_Click" Tag="Closed"/>
                            </StackPanel>

                            <ListBox x:Name="ChatEpicIssuesList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="260"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ 3. IN-FLIGHT — one quiet count-badge tile, collapsed by default ══
                         Git #874 - Shane: "In-Flight I reference only." Shrunk from a full
                         equal-weight tab (#866) to a quiet tile; expands in place on click
                         to reveal its existing list, collapsed by default so it stays out
                         of the way until wanted.
                         Git #971 - Shane: "In-Flight and Sessions should not be a 2 column
                         layout, they should work the same as Completed & To-Do." Full-width
                         single-column tile with accordion toggle.
                         2026-08-28 — Shane: "Hide In-Flight and Sessions... and expand the
                         height of the build queue." Hidden outright (Visibility.Collapsed) so
                         the panel gives that vertical space back to the queue graph above;
                         wiring/code-behind left intact in case this comes back. -->
                    <StackPanel Margin="10,0,10,12" Visibility="Collapsed">
                        <ToggleButton x:Name="TileInFlight" Style="{StaticResource QuietTile}" Click="TileInFlight_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏳" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="In-Flight" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="InFlightCountText" Text="(0)" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Subtext1Brush}"/>
                            </StackPanel>
                        </ToggleButton>
                        <Border x:Name="TileInFlightContent"
                                Visibility="Collapsed"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1,0,1,1"
                                Padding="4"
                                CornerRadius="0,0,6,6">
                            <ListBox x:Name="InFlightIssuesList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="InFlightIssuesList_SelectionChanged"
                                     SizeChanged="InFlightIssuesList_SizeChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- ══ 4. SESSIONS — one quiet count-badge tile, collapsed by default ══
                         Git #971 - Shane: "The Build Queue needs to show even when I am
                         building using 'Send to Builder' since that opens a different
                         process... it's not part of the Queue.. but I need a way to know
                         it's running. I think this is what Session is for?" Reads the real
                         claude CLI agent list directly (ClaudeAgentsService). -->
                    <StackPanel Margin="10,0,10,12" Visibility="Collapsed">
                        <ToggleButton x:Name="TileSessions" Style="{StaticResource QuietTile}" Click="TileSessions_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Sessions" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SessionsCountText" Text="(0)" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Subtext1Brush}"/>
                            </StackPanel>
                        </ToggleButton>
                        <Border x:Name="TileSessionsContent"
                                Visibility="Collapsed"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1,0,1,1"
                                Padding="4"
                                CornerRadius="0,0,6,6">
                            <ListBox x:Name="ActiveSessionsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SizeChanged="ActiveSessionsList_SizeChanged"
                                     SelectionChanged="ActiveSessionsList_SelectionChanged"/>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>
</UserControl>

<UserControl x:Class="BuildConsole.Controls.TestResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <Grid Background="{StaticResource BaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>   <!-- Telemetry cards -->
            <ColumnDefinition Width="5"/>   <!-- Splitter -->
            <ColumnDefinition Width="340"/> <!-- Live UI run WebView2, same layout the AutomationRunnerWindow popup used -->
        </Grid.ColumnDefinitions>

        <!-- ── Telemetry column ── -->
        <DockPanel Grid.Column="0" LastChildFill="True">

            <!-- Status header -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <DockPanel>
                            <TextBlock Text="TEST RESULTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                            <TextBlock x:Name="TxtStatusBadge" Text="● IDLE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtRunLabel" Text="No run yet — Load Manifest, then Menu &gt; Run, in the Automation sidebar." FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSummary" Text="0 pass / 0 warn / 0 crash" FontSize="11" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="BtnClear" Content="Clear" Click="BtnClear_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Telemetry card stream -->
            <ScrollViewer x:Name="TelemetryScroller" VerticalScrollBarVisibility="Auto" Padding="10,6">
                <StackPanel x:Name="TelemetryLogContainer"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Surface0Brush}"/>

        <!-- ── Live UI run WebView2 (drives UiTestExecutor for uiSteps) ── -->
        <DockPanel Grid.Column="2" LastChildFill="True">
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="1,0,0,1"
                    Padding="10,6">
                <TextBlock Text="Live UI Test View" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}"/>
            </Border>
            <wv2:WebView2 x:Name="RunnerWebView"/>
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="BuildConsole.Controls.GitModeGraphTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="{StaticResource BaseBrush}">

    <Grid Margin="10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Graph Header & Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="DEPENDENCY GRAPH"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
                <Border x:Name="GraphInfoBadge"
                        Background="{StaticResource Surface0Brush}"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtGraphFilterInfo"
                               Text="All Issues"
                               FontSize="11"
                               Foreground="{StaticResource Subtext0Brush}"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Chain Mode Segmented Toggle -->
                <Border Background="{StaticResource MantleBrush}" CornerRadius="4" Padding="2" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnChainFull"
                                Content="Full Chain"
                                Style="{StaticResource SecondaryButton}"
                                Padding="6,2" FontSize="11"
                                Click="ChainMode_Click" Tag="FullChain"/>
                        <Button x:Name="BtnChainBlockers"
                                Content="Blockers"
                                Style="{StaticResource SecondaryButton}"
                                Padding="6,2" FontSize="11" Margin="2,0,0,0"
                                Click="ChainMode_Click" Tag="BlockersOnly"/>
                        <Button x:Name="BtnChainDependents"
                                Content="Dependents"
                                Style="{StaticResource SecondaryButton}"
                                Padding="6,2" FontSize="11" Margin="2,0,0,0"
                                Click="ChainMode_Click" Tag="DependentsOnly"/>
                    </StackPanel>
                </Border>

                <!-- Bucket Filter -->
                <ComboBox x:Name="CmbBucketFilter" Width="100" Margin="0,0,6,0" SelectionChanged="GraphFilter_Changed">
                    <ComboBoxItem Content="All Buckets" IsSelected="True"/>
                    <ComboBoxItem Content="Batter Up"/>
                    <ComboBoxItem Content="In Progress"/>
                    <ComboBoxItem Content="Backlog"/>
                    <ComboBoxItem Content="Done"/>
                </ComboBox>

                <!-- Build Status Filter -->
                <ComboBox x:Name="CmbBuildFilter" Width="110" Margin="0,0,6,0" SelectionChanged="GraphFilter_Changed">
                    <ComboBoxItem Content="All Builds" IsSelected="True"/>
                    <ComboBoxItem Content="built"/>
                    <ComboBoxItem Content="failed"/>
                    <ComboBoxItem Content="missing"/>
                    <ComboBoxItem Content="outdated"/>
                    <ComboBoxItem Content="pending"/>
                </ComboBox>

                <Button x:Name="BtnRefreshGraph"
                        Content="Refresh"
                        Style="{StaticResource SecondaryButton}"
                        Padding="8,3" FontSize="11" Margin="0,0,6,0"
                        Click="BtnRefreshGraph_Click"/>

                <Button x:Name="BtnResetGraphFilters"
                        Content="Reset"
                        Style="{StaticResource SecondaryButton}"
                        Padding="8,3" FontSize="11"
                        Click="BtnResetGraphFilters_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Graph Canvas Area -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{StaticResource MantleBrush}"
                ClipToBounds="True">
            <ScrollViewer x:Name="GraphScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="True">
                <Canvas x:Name="GraphCanvas"
                        Width="1600" Height="1000"
                        Background="Transparent"
                        MouseDown="GraphCanvas_MouseDown"/>
            </ScrollViewer>
        </Border>

        <!-- Graph Legend Footer -->
        <Border Grid.Row="2" Margin="0,6,0,0" Padding="6,4" Background="{StaticResource CrustBrush}" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Legend:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,8,0"/>
                    <Border Background="{StaticResource RedBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Hard Block" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                    <Border Background="{StaticResource YellowBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Soft Block" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                    <Border Background="{StaticResource GreenBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Resolved (Closed)" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                    <Border Background="{StaticResource BlueBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Build" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                    <Border Background="{StaticResource MauveBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"/>
                    <TextBlock Text="AI/Agent" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <TextBlock x:Name="TxtGraphStatusSummary"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Text="0 Nodes • 0 Edges"
                           FontSize="11"
                           Foreground="{StaticResource Overlay0Brush}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="BuildConsole.Controls.GitModeContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svc="clr-namespace:BuildConsole.Services"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{StaticResource BaseBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Git Mode Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3-Panel Workspace -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Git Mode Header Bar (Empty) ── -->
        <Border Grid.Row="0"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Fill="{StaticResource MauveBrush}"
                              Data="M21 8.25C21 6.1815 19.3185 4.5 17.25 4.5C15.1815 4.5 13.5 6.1815 13.5 8.25C13.5 10.023 14.739 11.5035 16.395 11.892C16.116 12.819 15.2655 13.5 14.25 13.5H9.75C8.9025 13.5 8.1285 13.7925 7.5 14.268V7.4235C9.21 7.0755 10.5 5.5605 10.5 3.75C10.5 1.6815 8.8185 0 6.75 0C4.6815 0 3 1.6815 3 3.75C3 5.562 4.29 7.0755 6 7.4235V16.575C4.29 16.923 3 18.438 3 20.2485C3 22.317 4.6815 23.9985 6.75 23.9985C8.8185 23.9985 10.5 22.317 10.5 20.2485C10.5 18.4755 9.261 16.995 7.605 16.6065C7.884 15.6795 8.7345 14.9985 9.75 14.9985H14.25C16.0845 14.9985 17.61 13.6725 17.931 11.9295C19.674 11.607 21 10.0845 21 8.25ZM4.5 3.75C4.5 2.5095 5.5095 1.5 6.75 1.5C7.9905 1.5 9 2.5095 9 3.75C9 4.9905 7.9905 6 6.75 6C5.5095 6 4.5 4.9905 4.5 3.75ZM9 20.25C9 21.4905 7.9905 22.5 6.75 22.5C5.5095 22.5 4.5 21.4905 4.5 20.25C4.5 19.0095 5.5095 18 6.75 18C7.9905 18 9 19.0095 9 20.25ZM17.25 10.5C16.0095 10.5 15 9.4905 15 8.25C15 7.0095 16.0095 6 17.25 6C18.4905 6 19.5 7.0095 19.5 8.25C19.5 9.4905 18.4905 10.5 17.25 10.5Z"/>
                    </Viewbox>
                    <TextBlock Text="GIT MODE" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Git Mode Header Bar" FontSize="11" Foreground="{StaticResource Subtext0Brush}"/>
                    </Border>
                </StackPanel>

                <!-- Header right actions container -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnExitGitMode"
                            Style="{StaticResource SurfaceButton}"
                            Padding="10,4"
                            Click="BtnExitGitMode_Click"
                            ToolTip="Exit Git Mode (Ctrl+Shift+G)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,6,0" Foreground="{StaticResource RedBrush}"/>
                            <TextBlock Text="Exit Git Mode" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── 3-Panel Layout ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Panel: Epic Tree -->
                <ColumnDefinition Width="280" MinWidth="200" x:Name="ColEpicTree"/>
                <!-- Splitter 1 -->
                <ColumnDefinition Width="4"/>
                <!-- Middle Panel: Issue Grid -->
                <ColumnDefinition Width="*" MinWidth="250" x:Name="ColIssueGrid"/>
                <!-- Splitter 2 -->
                <ColumnDefinition Width="4"/>
                <!-- Right Panel: Issue Details -->
                <ColumnDefinition Width="360" MinWidth="200" x:Name="ColIssueDetails"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Panel (Epic Tree) ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="8,10">
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Tree View -->
                        <RowDefinition Height="*"/>
                        <!-- Footer Status -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Left Panel Header Bar -->
                    <DockPanel Grid.Row="0" Margin="4,0,4,10" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="EPIC TREE"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="TreeCountBadge"
                                    Background="{StaticResource Surface0Brush}"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTreeCount"
                                           Text="Loading..."
                                           FontSize="11"
                                           Foreground="{StaticResource Subtext0Brush}"/>
                            </Border>
                        </StackPanel>

                        <Button x:Name="BtnRefreshTree"
                                DockPanel.Dock="Right"
                                Style="{StaticResource IconButton}"
                                Width="26" Height="26"
                                ToolTip="Refresh from Postgres"
                                Click="BtnRefreshTree_Click">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" Foreground="{StaticResource Subtext0Brush}"/>
                        </Button>
                    </DockPanel>

                    <!-- TreeView -->
                    <TreeView x:Name="EpicTree"
                              Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectedItemChanged="EpicTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <!-- Custom Item Style -->
                            <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Padding" Value="2,3"/>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>

                    <!-- Tree Loading / Footer Status -->
                    <TextBlock x:Name="TxtTreeStatus"
                               Grid.Row="2"
                               Text="Postgres data source"
                               FontSize="11"
                               Foreground="{StaticResource Overlay0Brush}"
                               Margin="4,6,4,2"/>
                </Grid>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource Surface0Brush}"
                          ShowsPreview="False"/>

            <!-- ── Middle Panel (Interactive DAG Graph) ── -->
            <Border Grid.Column="2"
                    Background="{StaticResource BaseBrush}">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <!-- Middle Panel Graph Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Interactive Canvas Area -->
                        <RowDefinition Height="*"/>
                        <!-- Graph Footer Legend -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Graph Header & Toolbar -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                        <!-- Left Title & Filter Info -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="DEPENDENCY GRAPH"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="GraphInfoBadge"
                                    Background="{StaticResource Surface0Brush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtGraphFilterInfo"
                                           Text="All Issues"
                                           FontSize="11"
                                           Foreground="{StaticResource Subtext0Brush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Right Controls: Chain Mode Segmented Toggle & Filters -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Chain Mode Segmented Toggle -->
                            <Border Background="{StaticResource MantleBrush}" CornerRadius="4" Padding="2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnChainFull"
                                            Content="Full Chain"
                                            Style="{StaticResource SurfaceButton}"
                                            Padding="6,2" FontSize="11"
                                            Click="ChainMode_Click" Tag="FullChain"/>
                                    <Button x:Name="BtnChainBlockers"
                                            Content="Blockers"
                                            Style="{StaticResource SurfaceButton}"
                                            Padding="6,2" FontSize="11" Margin="2,0,0,0"
                                            Click="ChainMode_Click" Tag="BlockersOnly"/>
                                    <Button x:Name="BtnChainDependents"
                                            Content="Dependents"
                                            Style="{StaticResource SurfaceButton}"
                                            Padding="6,2" FontSize="11" Margin="2,0,0,0"
                                            Click="ChainMode_Click" Tag="DependentsOnly"/>
                                </StackPanel>
                            </Border>

                            <!-- Bucket Filter -->
                            <ComboBox x:Name="CmbBucketFilter" Width="100" Margin="0,0,6,0" SelectionChanged="GraphFilter_Changed">
                                <ComboBoxItem Content="All Buckets" IsSelected="True"/>
                                <ComboBoxItem Content="Batter Up"/>
                                <ComboBoxItem Content="In Progress"/>
                                <ComboBoxItem Content="Backlog"/>
                                <ComboBoxItem Content="Done"/>
                            </ComboBox>

                            <!-- Build Status Filter (Phase 7) -->
                            <ComboBox x:Name="CmbBuildFilter" Width="110" Margin="0,0,6,0" SelectionChanged="GraphFilter_Changed">
                                <ComboBoxItem Content="All Builds" IsSelected="True"/>
                                <ComboBoxItem Content="built"/>
                                <ComboBoxItem Content="failed"/>
                                <ComboBoxItem Content="missing"/>
                                <ComboBoxItem Content="outdated"/>
                                <ComboBoxItem Content="pending"/>
                            </ComboBox>

                            <!-- Reset Filters -->
                            <Button x:Name="BtnResetGraphFilters"
                                    Content="Reset"
                                    Style="{StaticResource SurfaceButton}"
                                    Padding="8,3" FontSize="11"
                                    Click="BtnResetGraphFilters_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Graph Canvas Area -->
                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{StaticResource MantleBrush}"
                            ClipToBounds="True">
                        <ScrollViewer x:Name="GraphScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Focusable="True">
                            <Canvas x:Name="GraphCanvas"
                                    Width="1600" Height="1000"
                                    Background="Transparent"
                                    MouseDown="GraphCanvas_MouseDown"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Graph Legend Footer -->
                    <Border Grid.Row="2" Margin="0,6,0,0" Padding="6,4" Background="{StaticResource CrustBrush}" CornerRadius="4">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Legend:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,8,0"/>
                                <Border Background="{StaticResource RedBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"/>
                                <TextBlock Text="Hard Block" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                                <Border Background="{StaticResource YellowBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"/>
                                <TextBlock Text="Soft Block" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                                <Border Background="{StaticResource GreenBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"/>
                                <TextBlock Text="Resolved (Closed)" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                                <Border Background="{StaticResource BlueBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"/>
                                <TextBlock Text="Build" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                                <Border Background="{StaticResource MauveBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"/>
                                <TextBlock Text="AI/Agent" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtGraphStatusSummary"
                                       DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"
                                       Text="0 Nodes • 0 Edges"
                                       FontSize="11"
                                       Foreground="{StaticResource Overlay0Brush}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource Surface0Brush}"
                          ShowsPreview="False"/>

            <!-- ── Right Panel (Issue Details Inspector) ── -->
            <Border Grid.Column="4"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="1,0,0,0">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <!-- Inspector Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Inspector Main Scroll Body -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Details Inspector Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtDetailHeaderNum"
                                       Text="#..."
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{StaticResource MauveBrush}"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="ISSUE DETAILS"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnOpenClaudeChat"
                                    Content="💬 Chat"
                                    Style="{StaticResource SurfaceButton}"
                                    Padding="6,3" FontSize="11" Margin="0,0,4,0"
                                    ToolTip="Launch Claude Chat for this issue"
                                    Click="BtnOpenClaudeChat_Click"/>
                            <Button x:Name="BtnCloseIssue"
                                    Content="✓ Close"
                                    Style="{StaticResource SurfaceButton}"
                                    Padding="6,3" FontSize="11"
                                    ToolTip="Mark issue as closed in Postgres"
                                    Click="BtnCloseIssue_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Scrollable Details Body -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PanelDetailsBody" Margin="0,0,4,0">
                            <!-- Empty Selection State -->
                            <Border x:Name="BorderEmptyDetails"
                                    Background="{StaticResource MantleBrush}"
                                    BorderBrush="{StaticResource Surface0Brush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16" Margin="0,10,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{StaticResource Overlay0Brush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="No Issue Selected" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Select a node in the tree or graph to inspect details" FontSize="11" Foreground="{StaticResource Subtext0Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Issue Detail Content (Hidden when no selection) -->
                            <StackPanel x:Name="StackActiveDetails" Visibility="Collapsed">
                                
                                <!-- GATE Enforcement Banner -->
                                <Border x:Name="GateBanner"
                                        Background="{StaticResource Surface0Brush}"
                                        BorderBrush="{StaticResource MauveBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10" Margin="0,0,0,10"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                            <TextBlock Text="🛡️ GATE COMPLETION" FontWeight="Bold" FontSize="11" Foreground="{StaticResource MauveBrush}" DockPanel.Dock="Left"/>
                                            <TextBlock x:Name="TxtGatePercent" Text="0%" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="GateProgressBar" Height="8" Value="0" Maximum="100" Margin="0,0,0,6"/>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock x:Name="TxtGateStatusInfo" Text="Release Actions Disabled" FontSize="10" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnReleaseGate"
                                                    Content="🚀 Release GATE"
                                                    Style="{StaticResource SurfaceButton}"
                                                    Padding="8,2" FontSize="10" FontWeight="Bold"
                                                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                    IsEnabled="False"
                                                    Click="BtnReleaseGate_Click"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Title Card -->
                                <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtDetailTitle" Text="Title..." FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtDetailHierarchy" Text="Milestone > Epic" FontSize="11" Foreground="{StaticResource Subtext0Brush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Metadata Controls Card: Bucket & Badges -->
                                <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                            <TextBlock Text="Bucket:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="CmbDetailBucket" Width="130" DockPanel.Dock="Left" SelectionChanged="CmbDetailBucket_SelectionChanged">
                                                <ComboBoxItem Content="Batter Up"/>
                                                <ComboBoxItem Content="In Progress"/>
                                                <ComboBoxItem Content="Backlog"/>
                                                <ComboBoxItem Content="Done"/>
                                            </ComboBox>

                                            <Border x:Name="BadgeDispatchable" Background="{StaticResource GreenBrush}" CornerRadius="3" Padding="4,2" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <TextBlock x:Name="TxtDetailDispatchable" Text="⚡ READY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BaseBrush}"/>
                                            </Border>
                                            <Border x:Name="BadgeBuildStatus" Background="{StaticResource Surface0Brush}" CornerRadius="3" Padding="4,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtDetailBuildStatus" Text="BUILD: NONE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            </Border>
                                        </DockPanel>

                                        <!-- Labels Management -->
                                        <TextBlock Text="Labels:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext0Brush}" Margin="0,4,0,4"/>
                                        <WrapPanel x:Name="WrapLabels" Margin="0,0,0,6"/>
                                        
                                        <DockPanel LastChildFill="True">
                                            <Button x:Name="BtnAddLabel" Content="+ Add" Style="{StaticResource SurfaceButton}" Padding="6,2" FontSize="10" DockPanel.Dock="Right" Click="BtnAddLabel_Click"/>
                                            <TextBox x:Name="TxtAddLabel" Height="24" FontSize="11" Padding="4,2" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Dependencies: Blockers & Dependents -->
                                <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="BLOCKERS (UPSTREAM)" FontWeight="Bold" FontSize="10" Foreground="{StaticResource RedBrush}" Margin="0,0,0,4"/>
                                        <StackPanel x:Name="PanelBlockers" Margin="0,0,0,8"/>

                                        <TextBlock Text="DEPENDENTS (DOWNSTREAM)" FontWeight="Bold" FontSize="10" Foreground="{StaticResource BlueBrush}" Margin="0,0,0,4"/>
                                        <StackPanel x:Name="PanelDependents"/>
                                    </StackPanel>
                                </Border>

                                <!-- PRs & Commits -->
                                <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="PULL REQUESTS &amp; COMMITS" FontWeight="Bold" FontSize="10" Foreground="{StaticResource MauveBrush}" Margin="0,0,0,4"/>
                                        <StackPanel x:Name="PanelPrs" Margin="0,0,0,6"/>
                                        <StackPanel x:Name="PanelCommits"/>
                                    </StackPanel>
                                </Border>

                                <!-- WHY Engine Analysis & Next Steps Card -->
                                <Border x:Name="WhyAnalysisCard" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource BlueBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                            <TextBlock Text="💡 WHY ANALYSIS &amp; NEXT STEPS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BlueBrush}" DockPanel.Dock="Left"/>
                                        </DockPanel>

                                        <!-- Why Blocked -->
                                        <TextBlock Text="WHY BLOCKED:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" Margin="0,2,0,2"/>
                                        <TextBlock x:Name="TxtWhyBlocked" Text="Loading..." FontSize="11" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <!-- What It Blocks -->
                                        <TextBlock Text="WHAT IT BLOCKS:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" Margin="0,2,0,2"/>
                                        <TextBlock x:Name="TxtWhatItBlocks" Text="Loading..." FontSize="11" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <!-- Build Requirements -->
                                        <TextBlock Text="BUILD REQUIREMENTS:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" Margin="0,2,0,2"/>
                                        <TextBlock x:Name="TxtWhyBuildInfo" Text="Loading..." FontSize="11" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <!-- Recommended Next Steps Banner -->
                                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="8,6" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="RECOMMENDED NEXT STEP:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PeachBrush}" Margin="0,0,0,2"/>
                                                <TextBlock x:Name="TxtWhyNextSteps" Text="Actionable step..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Comments Feed -->
                                <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="COMMENTS &amp; ACTIVITY" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,6"/>
                                        <StackPanel x:Name="PanelComments"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>

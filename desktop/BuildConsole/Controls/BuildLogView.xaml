<UserControl x:Class="BuildConsole.Controls.BuildLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource CrustBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>  <!-- context header -->
            <RowDefinition Height="*"/>   <!-- log stream   -->
        </Grid.RowDefinitions>

        <!-- ── Context header ── -->
        <Border Grid.Row="0"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="10,0">
            <DockPanel VerticalAlignment="Center">

                <!-- Status dot -->
                <Ellipse x:Name="HeaderDot"
                         Width="8" Height="8"
                         Fill="{StaticResource Surface2Brush}"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>

                <!-- BUILDING label -->
                <TextBlock x:Name="HeaderVerb"
                           Text="SELECT A TASK"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Subtext1Brush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <!-- Epic breadcrumb -->
                <TextBlock x:Name="EpicLabel"
                           Text=""
                           FontSize="12"
                           Foreground="{StaticResource Subtext0Brush}"
                           VerticalAlignment="Center"/>

                <TextBlock Text=" › "
                           FontSize="12"
                           Foreground="{StaticResource Subtext1Brush}"
                           VerticalAlignment="Center"/>

                <!-- Task name -->
                <TextBlock x:Name="TaskLabel"
                           Text=""
                           FontSize="12"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>

                <!-- Status badge -->
                <Border x:Name="StatusBadge"
                        DockPanel.Dock="Right"
                        Background="{StaticResource Surface0Brush}"
                        CornerRadius="3"
                        Padding="6,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusBadgeText"
                               Text=""
                               FontSize="11"
                               Foreground="{StaticResource Subtext1Brush}"/>
                </Border>

                <!-- Elapsed time -->
                <TextBlock x:Name="ElapsedLabel"
                           DockPanel.Dock="Right"
                           Text=""
                           FontSize="11"
                           Foreground="{StaticResource Subtext1Brush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,12,0"/>

            </DockPanel>
        </Border>

        <!-- ── Log stream ── -->
        <ListBox x:Name="LogList"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="10,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Focusable="False">

            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Padding"         Value="0,1"/>
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>  <!-- icon -->
                            <ColumnDefinition Width="68"/>  <!-- timestamp -->
                            <ColumnDefinition Width="*"/>   <!-- description -->
                        </Grid.ColumnDefinitions>

                        <!-- Status icon -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Icon}"
                                   Foreground="{Binding IconColor}"
                                   FontFamily="Cascadia Code, Consolas, Segoe UI Symbol"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <!-- Timestamp -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Time}"
                                   FontFamily="Cascadia Code, Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource Surface2Brush}"
                                   VerticalAlignment="Center"/>

                        <!-- Description -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Description}"
                                   Foreground="{Binding DescColor}"
                                   FontFamily="Cascadia Code, Consolas"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <!-- Empty state overlay -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.4">
            <TextBlock Text="&#xE7C4;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="32"
                       Foreground="{StaticResource Surface2Brush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Click an active or blocked task in the Build Queue"
                       FontSize="12"
                       Foreground="{StaticResource Subtext1Brush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

    </Grid>
</UserControl>

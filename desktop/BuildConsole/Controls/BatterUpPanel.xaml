<UserControl x:Class="BuildConsole.Controls.BatterUpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BuildConsole.Controls"
             MinWidth="220"
             MaxHeight="260">

    <!--
        Git #1709 — additive "Batter Up" board read + auto-queue panel, sitting above the
        existing BuildQueuePanel in the same right-hand column (see MainWindow.xaml). This
        control owns no launch logic of its own: it only reads the real "Batter Up" project
        board status, parses each item's BUILD: comment, and hands off to the exact same
        BuildQueuePostgresClient.QueueBuildAsync path Queue / Send to Builder already use
        (see BatterUpQueueService). The existing Queue button, Send to Builder chat button,
        and BuildQueuePanel itself are untouched.
    -->
    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="10,8,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⚾ Batter Up"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="TxtCount" Grid.Column="1" Margin="8,0,0,0"
                           Foreground="{StaticResource Subtext0Brush}" FontSize="11"
                           VerticalAlignment="Center" Text=""/>

                <Button x:Name="BtnRefresh" Grid.Column="2" Content="⟳" Padding="6,2" Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource Subtext0Brush}" Cursor="Hand"
                        ToolTip="Refresh Batter Up now" Click="BtnRefresh_Click"/>

                <ToggleButton x:Name="BtnCollapse" Grid.Column="3" Content="▾" Padding="6,2"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource Subtext0Brush}" Cursor="Hand"
                              IsChecked="False" Click="BtnCollapse_Click"/>
            </Grid>

            <ScrollViewer x:Name="RowsScroller" DockPanel.Dock="Top"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="220">
                <ItemsControl x:Name="RowsList" Margin="4,0,4,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1"
                                    Padding="6,5">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding HeaderText}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusBadgeText}"
                                                   FontSize="10" Margin="6,0,0,0"
                                                   Foreground="{Binding StatusBadgeBrush}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                               Foreground="{StaticResource Subtext0Brush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="TxtEmpty" DockPanel.Dock="Top" Margin="10,4,10,10"
                       Foreground="{StaticResource Subtext0Brush}" FontSize="11.5"
                       TextWrapping="Wrap" Text="No open issues in Batter Up."/>

        </DockPanel>
    </Border>
</UserControl>

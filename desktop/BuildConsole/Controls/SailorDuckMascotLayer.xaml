<UserControl x:Class="BuildConsole.Controls.SailorDuckMascotLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">

    <!-- ══════════════════════════════════════════════════════════════════
         SAILOR DUCK MASCOT OVERLAY LAYER
         A cute, stylized, chibi-style sailor duck inspired by classic
         animation aesthetics (Donald Duck), sitting inside a tiny white
         sailboat with a wooden mast and triangular sail.
         Never interactive (IsHitTestVisible=False) so it floats over the
         entire window without ever intercepting clicks or key events.
         ══════════════════════════════════════════════════════════════════ -->

    <Grid x:Name="RootGrid" ClipToBounds="True" IsHitTestVisible="False">
        <!-- Floating Mascot Stage Canvas -->
        <Canvas x:Name="MascotCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>

        <!-- Ambient Celebration & Sparkle Canvas -->
        <Canvas x:Name="FxCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>
    </Grid>
</UserControl>

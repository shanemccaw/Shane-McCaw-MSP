<UserControl x:Class="BuildConsole.Controls.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource CrustBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- quick-command chips -->
            <RowDefinition Height="Auto"/>  <!-- Git #2774 — queued-command status panel (collapsed when idle) -->
            <RowDefinition Height="*"/>     <!-- output -->
            <RowDefinition Height="Auto"/>  <!-- input bar -->
        </Grid.RowDefinitions>

        <!-- ── Quick-command chips ── -->
        <Border Grid.Row="0"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <WrapPanel Orientation="Horizontal">
                <Button Content="git status"  Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="git status"/>
                <Button Content="git log"     Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="git log --oneline -20"/>
                <Button Content="git pull"    Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="git pull"/>
                <Button Content="git push"    Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="git push"/>
                <Button Content="git fetch"   Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="git fetch --all"/>
                <Button Content="git stash"   Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="git stash"/>
                <Button Content="git diff"    Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="git diff"/>
                <Button Content="git branch"  Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="git branch -a"/>
                <Button Content="pnpm install" Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="pnpm install"/>
                <Button Content="pnpm build"   Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="pnpm run build"/>
                <!-- Sweeps every live agent worktree and merges + pushes any whose branch
                     has commits main doesn't have yet onto origin/main; anything too risky
                     to touch automatically (dirty tree, real merge conflict, detached HEAD)
                     is reported as NEEDS AGENT instead of guessed at. See
                     scripts/dev-server/fix-worktrees.mjs. Pastes like every other chip —
                     doesn't run until Shane presses Enter. -->
                <Button Content="fix worktrees" Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="node scripts/dev-server/fix-worktrees.mjs"/>
            </WrapPanel>
        </Border>

        <!-- ── Git #2774 — queued-command status panel ──
             Shows a sent multi-line block as a real per-step sequence: each row is one command with a
             live status (queued / running / done / failed). Collapsed whenever no queue has run. -->
        <Border x:Name="QueuePanel"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="8,6"
                MaxHeight="160">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock x:Name="QueueHeader"
                               DockPanel.Dock="Left"
                               Text="Command queue"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext1Brush}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="QueueClearButton"
                            DockPanel.Dock="Right"
                            Content="Clear"
                            Style="{StaticResource ChipButton}"
                            HorizontalAlignment="Right"
                            Click="QueueClear_Click"/>
                    <TextBlock/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="QueueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding StatusGlyph}"
                                               Foreground="{Binding StatusBrush}"
                                               FontFamily="Cascadia Code, Consolas"
                                               FontSize="12"
                                               Width="16"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Command}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontFamily="Cascadia Code, Consolas"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="{Binding StatusBrush}"
                                               FontFamily="Cascadia Code, Consolas"
                                               FontSize="11"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Terminal output ── -->
        <Grid Grid.Row="2">
            <TextBox x:Name="OutputBox"
                     Style="{StaticResource TerminalOutputBox}"
                     Text="BuildConsole Terminal — commands run on this local machine&#x0A;Type a command or click a chip above."
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True">
                <!-- Git #945 — heavy-mouse-user right-click menu; no ContextMenu existed here before. -->
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="CopyOutput_Click"/>
                        <MenuItem Header="Copy All" Click="CopyAllOutput_Click"/>
                        <Separator/>
                        <MenuItem Header="Clear" Click="ClearOutput_Click"/>
                        <MenuItem Header="Scroll to Bottom" Click="ScrollToBottom_Click"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>

            <!-- Pause/Resume live streaming so text can be selected/copied without it jumping. -->
            <Button x:Name="PauseButton"
                    Content="⏸ Pause"
                    Style="{StaticResource ChipButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,6,10,0"
                    Click="PauseToggle_Click"/>
        </Grid>

        <!-- ── Input bar ── -->
        <Border Grid.Row="3"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,1,0,0"
                Padding="8,5">
            <DockPanel>
                <!-- Prompt label -->
                <TextBlock DockPanel.Dock="Left"
                           Text="&gt;"
                           FontFamily="Cascadia Code, Consolas"
                           FontSize="13"
                           Foreground="{StaticResource GreenBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <!-- Send button -->
                <Button x:Name="SendButton"
                        DockPanel.Dock="Right"
                        Content="&#xE768;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Style="{StaticResource IconButton}"
                        ToolTip="Run locally (Enter)"
                        Click="Send_Click"
                        Margin="6,0,0,0"/>
                <!-- Command input -->
                <TextBox x:Name="InputBox"
                         FontFamily="Cascadia Code, Consolas"
                         FontSize="13"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource BlueBrush}"
                         VerticalContentAlignment="Center"
                         KeyDown="InputBox_KeyDown"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

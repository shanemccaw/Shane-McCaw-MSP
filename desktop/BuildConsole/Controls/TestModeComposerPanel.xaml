<UserControl x:Class="BuildConsole.Controls.TestModeComposerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MantleBrush}"
             Foreground="{StaticResource TextBrush}">

    <Border BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Session Strip -->
                <RowDefinition Height="*"/>    <!-- Scrollable Composer Body -->
                <RowDefinition Height="Auto"/> <!-- Save / Action Bottom Bar -->
                <RowDefinition Height="Auto"/> <!-- Bug List Drawer -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════════
                 1. SESSION STRIP (Top)
                 ══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource CrustBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1" Padding="10,8">
                <StackPanel Orientation="Vertical">
                    <!-- Row 1: Pulse dot, route readout, copy URL, width toggle -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pulse dot -->
                        <Ellipse x:Name="DotSessionPulse" Grid.Column="0" Width="8" Height="8" Fill="#8FC496" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- Route readout -->
                        <TextBlock x:Name="TxtRouteReadout" Grid.Column="1" Text="about:blank"
                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <!-- Copy URL -->
                        <Button x:Name="BtnCopyUrl" Grid.Column="2" Style="{StaticResource IconButton}"
                                Width="22" Height="22" Padding="0" Margin="4,0,2,0"
                                ToolTip="Copy active URL" Click="BtnCopyUrl_Click">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                        </Button>

                        <!-- Width Toggle (420px <-> 540px) -->
                        <Button x:Name="BtnToggleWidth" Grid.Column="3" Style="{StaticResource IconButton}"
                                Width="22" Height="22" Padding="0"
                                ToolTip="Toggle Panel Width (420px / 540px)" Click="BtnToggleWidth_Click">
                            <TextBlock x:Name="IconToggleWidth" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                        </Button>

                        <!-- Exit Test Mode -->
                        <Button x:Name="BtnExitTestMode" Grid.Column="4" Style="{StaticResource IconButton}"
                                Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                ToolTip="Exit Test Mode (Ctrl+Shift+T)" Click="BtnExitTestMode_Click">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource StatusErrorBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Row 2: Timer chip, End Session & Sync, New Session, History, Clear -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Timer chip -->
                        <Button x:Name="BtnTimerToggle" Grid.Column="0" Style="{StaticResource SecondaryButton}"
                                Padding="6,2" Height="22" Margin="0,0,6,0"
                                ToolTip="Click to toggle Page time vs Session total" Click="BtnTimerToggle_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏱" FontSize="9" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtTimerDisplay" Text="00:00" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Session buttons -->
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnEndSessionSync" Style="{StaticResource PrimaryButton}"
                                    FontSize="10" FontWeight="SemiBold" Padding="8,3" Margin="0,0,4,0"
                                    Content="End &amp; Sync" Click="BtnEndSessionSync_Click"
                                    ToolTip="Finalize session, save to disk at /Bugs/&lt;Product&gt;/, and commit &amp; sync to Git (Shift+Click for instant sync)"/>
                            <Button x:Name="BtnNewSession" Style="{StaticResource SecondaryButton}"
                                    FontSize="10" Padding="6,3" Margin="0,0,4,0"
                                    Content="New" Click="BtnNewSession_Click"
                                    ToolTip="Start a fresh testing session"/>
                            <Button x:Name="BtnHistory" Style="{StaticResource SecondaryButton}"
                                    FontSize="10" Padding="6,3" Margin="0,0,4,0"
                                    Content="History" Click="BtnHistory_Click"
                                    ToolTip="View testing session history"/>
                            <Button x:Name="BtnClearSession" Style="{StaticResource SecondaryButton}"
                                    FontSize="10" Padding="6,3"
                                    Content="Clear" Click="BtnClearSession_Click"
                                    ToolTip="Clear current session and drafts"/>
                        </WrapPanel>
                    </Grid>

                    <!-- Row 3: Good checkbox, Auto-clear checkbox -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="ChkGood" Grid.Column="0" Content="Good (confirmed clean)"
                                  FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                  VerticalAlignment="Center" Checked="ChkGood_Checked" Unchecked="ChkGood_Unchecked"
                                  ToolTip="Marks this page as tested and confirmed clean"/>

                        <CheckBox x:Name="ChkAutoClear" Grid.Column="1" Content="Auto-clear on new page"
                                  FontSize="10" Foreground="{StaticResource Subtext0Brush}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="False" ToolTip="Automatically clear bug composer when navigating to a new route"/>
                    </Grid>

                    <!-- Toast Banner -->
                    <Border x:Name="BorderToast" Background="#267C8CF0" BorderBrush="#407C8CF0" BorderThickness="1"
                            CornerRadius="4" Padding="6,3" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtToast" Text="Bug entry saved!" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════
                 2. SCROLLABLE COMPOSER BODY (Center)
                 ══════════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,10,10,6" Orientation="Vertical">

                    <!-- Header & Auto-Save status -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="LOG ISSUE / BUG ENTRY" FontSize="9.5" FontWeight="ExtraBold"
                                   Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSavedStatus" Grid.Column="1" Text="✓ Saved"
                                   FontSize="9" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Severity Dropdown -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Severity:" FontSize="10" Foreground="{StaticResource Subtext0Brush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <ComboBox x:Name="CmbSeverity" Grid.Column="1" Height="24" FontSize="10.5" SelectionChanged="CmbSeverity_SelectionChanged">
                            <ComboBoxItem Content="Blocker"/>
                            <ComboBoxItem Content="Critical"/>
                            <ComboBoxItem Content="Bug" IsSelected="True"/>
                            <ComboBoxItem Content="UI Glitch"/>
                            <ComboBoxItem Content="Functional"/>
                            <ComboBoxItem Content="Low"/>
                        </ComboBox>
                    </Grid>

                    <!-- Notes Mode Tabs & Markdown Formatting Toolbar -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mode tabs -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="BtnNotesPage" Content="📄 Page Notes" Style="{StaticResource IconButton}"
                                    FontSize="9" FontWeight="Bold" Padding="5,2" Margin="0,0,2,0"
                                    Foreground="{StaticResource AccentBrush}" Click="BtnNotesPage_Click"/>
                            <Button x:Name="BtnNotesGlobal" Content="🌐 Global Notes" Style="{StaticResource IconButton}"
                                    FontSize="9" Padding="5,2" Foreground="{StaticResource Subtext0Brush}"
                                    Click="BtnNotesGlobal_Click"/>
                        </StackPanel>

                        <!-- Markdown tools -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,0,4,0">
                            <Button Content="B" FontWeight="Bold" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdBold_Click" ToolTip="Bold (**text**)"/>
                            <Button Content="I" FontStyle="Italic" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdItalic_Click" ToolTip="Italic (*text*)"/>
                            <Button Content="`" FontFamily="Consolas" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdCode_Click" ToolTip="Inline code (`code`)"/>
                            <Button Content="•" Style="{StaticResource IconButton}" FontSize="10" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdList_Click" ToolTip="Bullet list (- item)"/>
                            <Button Content="🔗" Style="{StaticResource IconButton}" FontSize="8" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdLink_Click" ToolTip="Insert link [title](url)"/>
                            <Button x:Name="BtnTogglePreview" Content="👁" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Click="BtnTogglePreview_Click" ToolTip="Toggle Markdown Preview"/>
                        </StackPanel>

                        <!-- Auto-link shots checkbox -->
                        <CheckBox x:Name="ChkAutoLinkShots" Grid.Column="2" Content="Auto-link" FontSize="9"
                                  Foreground="{StaticResource Subtext0Brush}" IsChecked="True" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Notes Box -->
                    <TextBox x:Name="TxtNotesBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="#0A0D12"
                             BorderBrush="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}"
                             FontFamily="Segoe UI" FontSize="11" Padding="8" Margin="0,0,0,4"
                             TextChanged="TxtNotesBox_TextChanged" KeyDown="TxtNotesBox_KeyDown"/>

                    <!-- Live Markdown Preview (toggled by eye) -->
                    <Border x:Name="BorderMarkdownPreview" Background="#0A0D12" BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6" Visibility="Collapsed" MaxHeight="100">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtMarkdownPreview" Text="" TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Subtext0Brush}"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Tags Input & Quick Chips -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tags:" FontSize="10" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtTagsBox" Grid.Column="1" Height="22" Background="#0A0D12"
                                 BorderBrush="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}"
                                 FontSize="10" Padding="4,2" TextChanged="TxtTagsBox_TextChanged"/>
                    </Grid>

                    <!-- Quick Tag Chips -->
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="+ #Auth" Style="{StaticResource SecondaryButton}" FontSize="9" Padding="4,1" Margin="0,0,3,3" Click="BtnTagChip_Click" Tag="#Auth"/>
                        <Button Content="+ #UI" Style="{StaticResource SecondaryButton}" FontSize="9" Padding="4,1" Margin="0,0,3,3" Click="BtnTagChip_Click" Tag="#UI"/>
                        <Button Content="+ #API" Style="{StaticResource SecondaryButton}" FontSize="9" Padding="4,1" Margin="0,0,3,3" Click="BtnTagChip_Click" Tag="#API"/>
                        <Button Content="+ #Checkout" Style="{StaticResource SecondaryButton}" FontSize="9" Padding="4,1" Margin="0,0,3,3" Click="BtnTagChip_Click" Tag="#Checkout"/>
                        <Button Content="+ #Performance" Style="{StaticResource SecondaryButton}" FontSize="9" Padding="4,1" Margin="0,0,3,3" Click="BtnTagChip_Click" Tag="#Performance"/>
                        <Button Content="+ #Form" Style="{StaticResource SecondaryButton}" FontSize="9" Padding="4,1" Margin="0,0,3,3" Click="BtnTagChip_Click" Tag="#Form"/>
                    </WrapPanel>

                    <!-- Steps, Expected, Actual Expander -->
                    <Border BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                        <StackPanel Orientation="Vertical">
                            <Border x:Name="HdrStepsExpander" Background="{StaticResource CrustBrush}" Padding="8,6" Cursor="Hand" MouseLeftButtonDown="HdrStepsExpander_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Steps to Reproduce · Expected · Actual" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IconStepsChevron" Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border x:Name="BodyStepsExpander" Background="{StaticResource CrustBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0" Padding="8" Visibility="Collapsed">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Steps to Reproduce:" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Subtext0Brush}"/>
                                        <Button Content="+ Add Step" Style="{StaticResource IconButton}" FontSize="9" HorizontalAlignment="Right" Padding="4,1" Click="BtnAddStep_Click"/>
                                    </Grid>
                                    <TextBox x:Name="TxtStepsBox" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Background="#0A0D12"
                                             BorderBrush="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}" FontSize="10" Padding="4" Margin="0,0,0,6"/>

                                    <TextBlock Text="Expected Result:" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtExpectedBox" Height="36" AcceptsReturn="True" TextWrapping="Wrap" Background="#0A0D12"
                                             BorderBrush="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}" FontSize="10" Padding="4" Margin="0,0,0,6"/>

                                    <TextBlock Text="Actual Result:" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtActualBox" Height="36" AcceptsReturn="True" TextWrapping="Wrap" Background="#0A0D12"
                                             BorderBrush="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}" FontSize="10" Padding="4"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Screenshot Action Row -->
                    <TextBlock Text="SCREENSHOT &amp; CAPTURE" FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnFullShot" Grid.Column="0" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="0,5" Margin="0,0,2,0" Click="BtnFullShot_Click" ToolTip="Capture full page viewport">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📷" FontSize="9" Margin="0,0,3,0"/>
                                <TextBlock Text="Full"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnRegionShot" Grid.Column="1" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="0,5" Margin="2,0,2,0" Click="BtnRegionShot_Click" ToolTip="Draw a rectangle region to capture">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✂" FontSize="9" Margin="0,0,3,0"/>
                                <TextBlock Text="Region"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnHudShot" Grid.Column="2" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="0,5" Margin="2,0,2,0" Click="BtnHudShot_Click" ToolTip="Capture full window including active HUD">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🪟" FontSize="9" Margin="0,0,3,0"/>
                                <TextBlock Text="HUD"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnDiffShot" Grid.Column="3" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="0,5" Margin="2,0,2,0" Click="BtnDiffShot_Click" ToolTip="Open Visual Diff &amp; comparison window">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⚖" FontSize="9" Margin="0,0,3,0"/>
                                <TextBlock Text="Diff"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnInspectShot" Grid.Column="4" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="0,5" Margin="2,0,0,0" Click="BtnInspectShot_Click" ToolTip="Open DOM Inspector in Diagnostics">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="9" Margin="0,0,3,0"/>
                                <TextBlock Text="Inspect"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Staged Screenshots Strip -->
                    <Border x:Name="BorderStagedShots" Background="#0A0D12" BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Staged Screenshots:" FontSize="9" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,4"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ListStagedScreenshots">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface0Brush}" BorderBrush="{StaticResource Surface1Brush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🖼" FontSize="9" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding FileName}" FontSize="9.5" FontFamily="Consolas" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                                    <Button Content="✕" Style="{StaticResource IconButton}" FontSize="8" Margin="4,0,0,0" Padding="2,0" Click="BtnRemoveStagedShot_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════════════════════════
                 3. SAVE / ACTION BOTTOM BAR
                 ══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="{StaticResource CrustBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnSaveBug" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                            FontSize="11" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0"
                            Content="Save Bug Entry (Ctrl+Enter)" Click="BtnSaveBug_Click"/>

                    <Button x:Name="BtnClearBug" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            FontSize="10.5" Padding="10,6" Content="Clear" Click="BtnClearBug_Click"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════
                 4. BUG LIST DRAWER (Bottom Expandable)
                 ══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="{StaticResource CrustBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Vertical">
                    <!-- Drawer Header -->
                    <Border Padding="10,7" Cursor="Hand" MouseLeftButtonDown="HdrBugDrawer_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🐛" FontSize="10" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TxtBugDrawerTitle" Text="Bugs on this page (0)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <Button x:Name="BtnOpenBugDocument" Content="📄 View in Document" Style="{StaticResource IconButton}" FontSize="9.5" Foreground="{StaticResource MauveBrush}" Padding="4,1" Margin="8,0,0,0" Click="BtnOpenBugDocument_Click" ToolTip="Open Bug Tracker Document View in middle pane"/>
                            </StackPanel>

                            <TextBlock x:Name="IconBugDrawerChevron" Grid.Column="1" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Drawer Content -->
                    <Border x:Name="BodyBugDrawer" MaxHeight="220" Padding="10,0,10,8" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Filter Pills -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="BtnFilterAll" Content="All" Style="{StaticResource IconButton}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Padding="6,2" Margin="0,0,4,0" Click="BtnFilter_Click" Tag="all"/>
                                <Button x:Name="BtnFilterOpen" Content="Open" Style="{StaticResource IconButton}" FontSize="9.5" Foreground="{StaticResource Subtext0Brush}" Padding="6,2" Margin="0,0,4,0" Click="BtnFilter_Click" Tag="open"/>
                                <Button x:Name="BtnFilterResolved" Content="Resolved" Style="{StaticResource IconButton}" FontSize="9.5" Foreground="{StaticResource Subtext0Brush}" Padding="6,2" Click="BtnFilter_Click" Tag="resolved"/>
                            </StackPanel>

                            <!-- Scrollable Bug Cards -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ListBugCards">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface0Brush}" BorderBrush="{StaticResource Surface1Brush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                <StackPanel Orientation="Vertical">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Severity Badge -->
                                                        <Border Background="{Binding SeverityBackground}" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Severity}" FontSize="9" FontWeight="Bold" Foreground="{Binding SeverityForeground}"/>
                                                        </Border>

                                                        <!-- Route / Time -->
                                                        <TextBlock Grid.Column="1" Text="{Binding TimestampDisplay}" FontSize="9" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>

                                                        <!-- Status Toggle (Open/Resolved) -->
                                                        <Button Grid.Column="2" Content="{Binding StatusButtonLabel}" Style="{StaticResource IconButton}"
                                                                FontSize="9" Padding="4,1" Click="BtnToggleBugStatus_Click" Tag="{Binding}"/>
                                                    </Grid>

                                                    <!-- Screenshot Badge if present -->
                                                    <Border Background="#1A38BDF8" BorderBrush="#4038BDF8" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,0,4" HorizontalAlignment="Left" Visibility="{Binding HasScreenshotVisibility}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🖼" FontSize="9" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Element Screenshot Attached" FontSize="8.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Bug Notes Preview -->
                                                    <TextBlock Text="{Binding Notes}" FontSize="10" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                                    <!-- Actions: Copy Markdown, Delete -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="Copy MD" Style="{StaticResource IconButton}" FontSize="8.5" Padding="4,1" Margin="0,0,4,0" Click="BtnCopyBugMd_Click" Tag="{Binding}"/>
                                                        <Button Content="Delete" Style="{StaticResource IconButton}" FontSize="8.5" Foreground="#DC8A8A" Padding="4,1" Click="BtnDeleteBug_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>

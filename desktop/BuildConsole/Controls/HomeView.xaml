<UserControl x:Class="BuildConsole.Controls.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Git #874 Home screen — native WPF landing tab that replaces the old
         hardcoded (non-closable) claude.ai tab. Three roll-up sections in the
         same ADHD "quiet tile / colored-icon row / announce-when-actionable"
         visual language the Build Queue right panel (#874) uses: "Where you
         left off" (persisted last-launch chat tabs), "Running now" (live queue,
         same source as the Build Queue panel), "Done, waiting for you" (done
         builds whose GitHub issue is still open). Rows are built in code-behind
         (HomeView.xaml.cs) so each can carry its real BoardChat / GitHub-number
         identity and click straight through to the originating chat tab. -->
    <UserControl.Resources>
        <!-- Clickable roll-up row — same Mantle/Surface0 hover language as the
             panel's QuietTile, so the whole page reads as one system. -->
        <Style x:Key="HomeRow" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource MantleBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Surface0Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeSectionHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Subtext1Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BaseBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="24,20,24,28">

                <!-- ── Hero ── -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="🏠" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Home" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Pick up where you left off — what's running, and what's waiting on you."
                           FontSize="12" Foreground="{StaticResource Subtext1Brush}"
                           TextWrapping="Wrap" Margin="0,0,0,20"/>

                <!-- ══ 1. WHERE YOU LEFT OFF ══ -->
                <StackPanel Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🕘" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="WHERE YOU LEFT OFF" Style="{StaticResource HomeSectionHeader}"/>
                        <TextBlock x:Name="LeftOffCountText" Text="(0)" FontSize="11" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Subtext1Brush}"/>
                    </StackPanel>
                    <StackPanel x:Name="LeftOffList"/>
                    <TextBlock x:Name="LeftOffEmpty" Text="No chat tabs were open when you last closed the app."
                               FontSize="11" Foreground="{StaticResource Subtext1Brush}"
                               TextWrapping="Wrap" Margin="2,2,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ══ 2. RUNNING NOW ══ -->
                <StackPanel Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="▶" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="#F2CA63"/>
                        <TextBlock Text="RUNNING NOW" Style="{StaticResource HomeSectionHeader}"/>
                        <TextBlock x:Name="RunningCountText" Text="(0)" FontSize="11" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Subtext1Brush}"/>
                    </StackPanel>
                    <StackPanel x:Name="RunningList"/>
                    <TextBlock x:Name="RunningEmpty" Text="Nothing building right now."
                               FontSize="11" Foreground="{StaticResource Subtext1Brush}"
                               TextWrapping="Wrap" Margin="2,2,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ══ 3. DONE, WAITING FOR YOU ══
                     Announces itself (PeachBrush) once count > 0, exactly like the
                     panel's Completed/To-Do tiles (#905/#874): a done build whose
                     issue is still open is an action item (review + close). -->
                <StackPanel Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="DoneIcon" Text="✅" FontSize="13" VerticalAlignment="Center"
                                   Margin="0,0,6,0" Foreground="#7FAE91"/>
                        <TextBlock x:Name="DoneHeaderText" Text="DONE, WAITING FOR YOU"
                                   Style="{StaticResource HomeSectionHeader}"/>
                        <TextBlock x:Name="DoneCountText" Text="(0)" FontSize="11" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Subtext1Brush}"/>
                    </StackPanel>
                    <StackPanel x:Name="DoneList"/>
                    <TextBlock x:Name="DoneEmpty" Text="Nothing done that still has an open GitHub issue."
                               FontSize="11" Foreground="{StaticResource Subtext1Brush}"
                               TextWrapping="Wrap" Margin="2,2,0,0" Visibility="Collapsed"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>

<UserControl x:Class="BuildConsole.Controls.ChatSessionPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BuildConsole.Controls"
             xmlns:conv="clr-namespace:BuildConsole.Converters"
             x:Name="Root"
             FontFamily="{StaticResource ChatPane.UiFont}"
             MinWidth="1" MinHeight="1">

    <UserControl.Resources>
        <conv:FluidSizeConverter x:Key="Fluid"/>
        <conv:FluidHorizontalPaddingConverter x:Key="FluidPad"/>
        <conv:FluidBottomMarginConverter x:Key="FluidGap"/>
        <conv:GlyphKeyConverter x:Key="GlyphKey"/>
        <conv:ComposerModeVisibilityConverter x:Key="ModeVis"/>
        <conv:ParagraphKindToBrushConverter x:Key="KindBrush"/>
        <conv:ParagraphKindToWeightConverter x:Key="KindWeight"/>
        <conv:IsUserMessageTurnConverter x:Key="IsUserMsg"/>
        <conv:StringNonEmptyToVisibilityConverter x:Key="NonEmptyVis"/>
        <conv:StringEmptyToVisibilityConverter x:Key="EmptyVis"/>
        <conv:DiffLineKindToBrushConverter x:Key="DiffFg"/>
        <conv:DiffLineKindToBackgroundConverter x:Key="DiffBg"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Content here was plain TextBlock, so nothing could be selected/copied out of the
             live agent output. Rather than swap to TextBox (which would risk regressing #1026's
             visual redesign across every template here), each copyable block gets a right-click
             "Copy" menu, matching the #945 pattern already established in BuildLogView.xaml.
             Shared handlers live in ChatSessionPane.xaml.cs. -->
        <ContextMenu x:Key="CopyTextMenu">
            <MenuItem Header="Copy" Click="CopyBlockText_Click"/>
        </ContextMenu>

        <!-- ── User message ─────────────────────────────────────────── -->
        <DataTemplate x:Key="UserMessageTemplate">
            <Border BorderBrush="{StaticResource ChatPane.BorderSubtle60}" BorderThickness="0,0,0,1" Padding="0,24,0,26">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Border Width="20" Height="20" CornerRadius="5" Background="#24949CA6">
                            <TextBlock Text="SM" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ChatPane.Muted1}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="YOU" FontWeight="Bold" Foreground="{StaticResource ChatPane.Muted4}" Margin="8,0,0,0"
                                   FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='9.5,12'}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource ChatPane.Text1}" TextWrapping="Wrap" LineHeight="26"
                               ContextMenu="{StaticResource CopyTextMenu}"
                               FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='12.5,17.5'}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ── "CLAUDE" role header (once per assistant run) ───────────── -->
        <DataTemplate x:Key="AssistantTurnStartTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,26,0,0">
                <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource ChatPane.BrandGradient}">
                    <Path Data="{StaticResource Icon.Sparkles}" Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="11" Height="11" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="CLAUDE" FontWeight="Bold" Foreground="{StaticResource ChatPane.AccentText2}" Margin="8,0,0,0"
                           FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='9.5,12'}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ── Assistant paragraph ──────────────────────────────────── -->
        <DataTemplate x:Key="AssistantParagraphTemplate">
            <Grid>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="27"
                           Foreground="{Binding Kind, Converter={StaticResource KindBrush}}"
                           FontWeight="{Binding Kind, Converter={StaticResource KindWeight}}"
                           ContextMenu="{StaticResource CopyTextMenu}"
                           FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='12.5,17.5'}"/>
                <!-- Blinking streaming caret (spec: 1s discrete blink, visible 0-45%). -->
                <Border x:Name="Caret" Width="8" Height="16" Background="{StaticResource ChatPane.CaretBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2" Visibility="Collapsed">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="CaretBlink">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="CaretBlink"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ── Tool-call group (collapsed "Ran N tools" chip) ──────────── -->
        <DataTemplate x:Key="ToolGroupTemplate">
            <StackPanel>
                <Button Click="ToolGroupHeader_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0,7" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{Binding GlyphKey, Converter={StaticResource GlyphKey}}"
                              Stroke="{StaticResource ChatPane.AccentText1}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource ChatPane.Muted1}"
                                   VerticalAlignment="Center" Margin="0,0,9,0"
                                   FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='11,14.5'}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Summary}" FontFamily="{StaticResource ChatPane.MonoFont}"
                                   Foreground="{StaticResource ChatPane.Muted6}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260"
                                   FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='10,13'}"/>
                        <Path x:Name="Chevron" Grid.Column="4" Data="{StaticResource Icon.ChevronDown}" Stroke="{StaticResource ChatPane.Muted4}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="180" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>

                <Border BorderBrush="{StaticResource ChatPane.ToolDetailRule}" BorderThickness="2,0,0,0" Padding="12,8,0,0"
                        Margin="0,6,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemsSource="{Binding Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Per-tool-call detail: the real command/params, its real
                                     output on the next line(s), and a real colored diff for a
                                     file edit — all revealed only when the chip is expanded. -->
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy Tool Call" Click="CopyToolDetail_Click"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <!-- ⚙ ToolName  <real command / file_path / pattern> -->
                                    <TextBlock FontFamily="{StaticResource ChatPane.MonoFont}" TextWrapping="Wrap"
                                               Foreground="{StaticResource ChatPane.Muted3}" Margin="0,0,0,3"
                                               ContextMenu="{StaticResource CopyTextMenu}"
                                               FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='10.5,13.5'}">
                                        <Run Text="⚙  " Foreground="{StaticResource ChatPane.AccentText1}"/>
                                        <Run Text="{Binding ToolName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource ChatPane.Muted1}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding CommandPreview, Mode=OneWay}" Foreground="{StaticResource ChatPane.Muted5}"/>
                                    </TextBlock>

                                    <!-- Real colored diff (Edit / Write / MultiEdit) -->
                                    <Border Visibility="{Binding HasDiff, Converter={StaticResource BoolVis}}"
                                            Background="{StaticResource ChatPane.Surface}" CornerRadius="4" Padding="8,6" Margin="10,1,0,3" MaxHeight="260">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Diff}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Kind, Converter={StaticResource DiffBg}}">
                                                            <TextBlock Text="{Binding Text}" FontFamily="{StaticResource ChatPane.MonoFont}" TextWrapping="Wrap"
                                                                       Foreground="{Binding Kind, Converter={StaticResource DiffFg}}" FontSize="11.5" Padding="2,0"
                                                                       ContextMenu="{StaticResource CopyTextMenu}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Real tool output (filled in when the tool_result event lands) -->
                                    <Border Visibility="{Binding HasOutput, Converter={StaticResource BoolVis}}"
                                            Background="{StaticResource ChatPane.Surface}" CornerRadius="4" Padding="8,6" Margin="10,1,0,0" MaxHeight="180">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding Output}" FontFamily="{StaticResource ChatPane.MonoFont}" TextWrapping="Wrap" FontSize="11.5"
                                                       ContextMenu="{StaticResource CopyTextMenu}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource ChatPane.Muted3}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ChatPane.Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ── Code diff (genuine +/- diff view, not grey prose) ──────── -->
        <DataTemplate x:Key="DiffTemplate">
            <local:DiffView/>
        </DataTemplate>

        <!-- ── Live status line ─────────────────────────────────────── -->
        <DataTemplate x:Key="StatusLineTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,2">
                <Path Data="{StaticResource Icon.Loader2}" Stroke="{StaticResource ChatPane.AccentText1}"
                      StrokeThickness="2.4" StrokeDashArray="8,2.6" Width="14" Height="14" Stretch="Uniform"
                      RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Spinning}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SpinForever">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpinForever"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding ActivityText}" FontFamily="{StaticResource ChatPane.MonoFont}" Foreground="{StaticResource ChatPane.Muted2}"
                           Margin="9,0,0,0"
                           FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='11,15'}"/>
            </StackPanel>
        </DataTemplate>

        <local:TurnTemplateSelector x:Key="TurnSelector"
            UserMessageTemplate="{StaticResource UserMessageTemplate}"
            AssistantTurnStartTemplate="{StaticResource AssistantTurnStartTemplate}"
            AssistantParagraphTemplate="{StaticResource AssistantParagraphTemplate}"
            ToolGroupTemplate="{StaticResource ToolGroupTemplate}"
            DiffTemplate="{StaticResource DiffTemplate}"
            StatusLineTemplate="{StaticResource StatusLineTemplate}"/>
    </UserControl.Resources>

    <Border Background="{Binding ChatBackground, FallbackValue={StaticResource ChatPane.Canvas}, TargetNullValue={StaticResource ChatPane.Canvas}}" 
            BorderBrush="{Binding ChatBorder, FallbackValue={StaticResource ChatPane.Border}, TargetNullValue={StaticResource ChatPane.Border}}" 
            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ Header ═══════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource ChatPane.CanvasChrome}" BorderBrush="{StaticResource ChatPane.BorderSubtle90}"
                    BorderThickness="0,0,0,1" Padding="12,9">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource ChatPane.BrandGradient}">
                            <TextBlock Text="SM" FontSize="10" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Git #1801: long real issue titles (e.g. #1799) were reading as visually bulky
                             on the slot card; TextTrimming+MaxWidth already caps this to one line with an
                             ellipsis, but nothing let Shane read the rest of a truncated title short of
                             opening the issue — the ToolTip below surfaces the untruncated SessionLabel
                             on hover. -->
                        <TextBlock Text="{Binding SessionLabel}" FontWeight="SemiBold" Foreground="{StaticResource ChatPane.Text1}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140"
                                   ToolTip="{Binding SessionLabel}"
                                   FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='12,15'}"/>
                        <!-- Git #1892: GH# is the one thing Shane actually scans for across many running
                             builds — it was reading smaller and dimmer than the title, exactly backwards
                             from the hierarchy he needs. Bumped to match/exceed SessionLabel: bold weight,
                             primary/bright text color, and a font-size range at or above the title's. -->
                        <TextBlock Text="{Binding LocalLabel}" FontWeight="Bold" Foreground="{StaticResource ChatPane.Text1}" Margin="6,1,0,0" VerticalAlignment="Center"
                                   FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='12,15'}"/>
                        <Border Width="1" Height="18" Background="{StaticResource ChatPane.Border}" Margin="12,0"/>
                        <TextBlock Text="{Binding ModelLabel}" Foreground="{StaticResource ChatPane.Muted4}" FontWeight="Medium"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                   FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='10,13'}"/>

                        <!-- Tucked-away reveal of THIS build's original instructions — the full prompt it was
                             started with. Hidden until there are instructions (HasInstructions), collapsed by
                             default: click the little document icon to pop the full prompt in a scrollable,
                             selectable panel. Same "hidden until you ask for it" spirit as the #1012 collapsed
                             tool chips and the per-build checklist column. -->
                        <ToggleButton x:Name="InstructionsButton" Margin="10,0,0,0" VerticalAlignment="Center"
                                      Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="3"
                                      Visibility="{Binding HasInstructions, Converter={StaticResource BoolVis}}"
                                      ToolTip="Show the original instructions this build was started with">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <Path Data="{StaticResource Icon.FileText}" Stroke="{StaticResource ChatPane.Muted4}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChatPane.Surface}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChatPane.Surface}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- The reveal itself. Two-way IsOpen↔IsChecked + StaysOpen=False: clicking away
                             closes the popup AND unchecks the toggle, so the next click reopens cleanly. -->
                        <Popup PlacementTarget="{Binding ElementName=InstructionsButton}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=InstructionsButton, Mode=TwoWay}">
                            <Border Background="{StaticResource ChatPane.Canvas}" BorderBrush="{StaticResource ChatPane.BorderStrong}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MaxWidth="460" MaxHeight="380">
                                <Grid Margin="12,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Original instructions" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource ChatPane.Muted2}" Margin="0,0,0,6"/>
                                    <!-- Read-only TextBox (not TextBlock) so Shane can select + Ctrl+C the real prompt. -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBox Text="{Binding OriginalInstructions, Mode=OneWay}" IsReadOnly="True"
                                                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                                                 Foreground="{StaticResource ChatPane.Text1}" FontSize="12.5"
                                                 VerticalScrollBarVisibility="Disabled"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Status pill & Dismiss button -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border VerticalAlignment="Center" CornerRadius="999" Padding="8,4,10,4"
                                Background="{Binding PillFill}" BorderBrush="{Binding PillBorder}" BorderThickness="1"
                                ToolTip="{Binding PillTooltip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{Binding PillDot}" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PillPulsing}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PillPulse">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PillPulse"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding PillLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding PillText}" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Dismiss button in header when done/terminal -->
                        <Button Visibility="{Binding Mode, Converter={StaticResource ModeVis}, ConverterParameter=Terminal}"
                                Click="DismissButton_Click" ToolTip="Dismiss this build from Build Watch"
                                Margin="8,0,0,0" Height="24" Padding="8,0" Cursor="Hand"
                                Background="{StaticResource Surface0Brush}" BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Dismiss" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Subtext0Brush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Transcript + this build's OWN Task Checklist column ═══════════
                 Git #42/#56: each build's detected checklist now lives in a slim column to
                 the right of THIS build's transcript, scoped to this build alone — the old
                 single shared global Task Checklist panel (which merged every concurrent
                 build's items into one flat list) is gone. Rows are built in code-behind
                 (RefreshChecklist) from the SAME real shared TaskChecklistViewModel /
                 ChecklistExtractor detection, filtered to this pane's build; the column is
                 hidden entirely until this build reports its first checklist item. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,8,0,4" ScrollChanged="TranscriptScroll_ScrollChanged">
                    <Border MaxWidth="800" HorizontalAlignment="Stretch"
                            Padding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource FluidPad}, ConverterParameter='14,36'}">
                        <ItemsControl x:Name="TranscriptItems" ItemsSource="{Binding Turns}" ItemTemplateSelector="{StaticResource TurnSelector}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="{Binding ActualWidth, ElementName=Root, Converter={StaticResource FluidGap}, ConverterParameter='11,22'}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Converter={StaticResource IsUserMsg}}" Value="True">
                                            <Setter Property="Margin" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Border>
                </ScrollViewer>

                <!-- ══ This build's Explicit Progress & ETA Panel ════════════════
                     Explicit structured progress reported via shaneapp://reportProgress / scripts/report-progress.mjs.
                     Shows real N/M step count, visual progress bar, active phase card, step history,
                     and heuristic estimated time remaining. -->
                <Border Grid.Column="1" x:Name="ProgressPanel" Visibility="Collapsed" Width="210"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1,0,0,0">
                    <Grid Margin="10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Title + Pill -->
                            <RowDefinition Height="Auto"/> <!-- Progress Bar -->
                            <RowDefinition Height="Auto"/> <!-- Current Step Label -->
                            <RowDefinition Height="Auto"/> <!-- ETA Badge -->
                            <RowDefinition Height="*"/>    <!-- Steps History -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PROGRESS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="ProgressPill" DockPanel.Dock="Right"
                                    Background="{StaticResource Surface0Brush}"
                                    CornerRadius="3" Padding="5,2" HorizontalAlignment="Right">
                                <TextBlock x:Name="ProgressPercentText" Text="0/0 (0%)"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource BlueBrush}"/>
                            </Border>
                        </DockPanel>

                        <!-- Progress Bar -->
                        <ProgressBar Grid.Row="1" x:Name="ProgressBarIndicator"
                                     Style="{StaticResource ResourceMeterBar}"
                                     Foreground="{StaticResource GreenBrush}"
                                     Height="6" Margin="0,0,0,8"
                                     Minimum="0" Maximum="100" Value="0"/>

                        <!-- Current Step Card -->
                        <Border Grid.Row="2" Background="{StaticResource Surface0Brush}"
                                BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1"
                                CornerRadius="4" Padding="7,6" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="CURRENT PHASE" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="CurrentStepLabelText" Text="Waiting for report…"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap"/>
                                <!-- Git #1206: soft "no update in Xm" notice so a quiet build reads
                                     as honestly-stale rather than looking frozen on its first phase. -->
                                <TextBlock x:Name="StaleNoticeText" Text="" Visibility="Collapsed"
                                           FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource YellowBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Estimated Time Remaining -->
                        <Border Grid.Row="3" Background="{DynamicResource AccentWashLightBrush}"
                                BorderBrush="{StaticResource BlueBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="6,4" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱" FontSize="10" Foreground="{StaticResource BlueBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EtaRemainingText" Text="Calculating est…"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Step History List -->
                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ProgressHistoryRows"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ Composer ═════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="{StaticResource ChatPane.CanvasChrome}" BorderBrush="{StaticResource ChatPane.BorderSubtle90}"
                    BorderThickness="0,1,0,0" Padding="0,9,0,8">
                <Border MaxWidth="800" HorizontalAlignment="Stretch"
                        Padding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource FluidPad}, ConverterParameter='14,36'}">
                    <StackPanel>

                        <!-- Interactive / Continuation: real input shell remains available -->
                        <Border Visibility="{Binding Mode, Converter={StaticResource ModeVis}, ConverterParameter=InteractiveOrTerminal}"
                                BorderBrush="{StaticResource ChatPane.BorderStrong}" BorderThickness="1" CornerRadius="10" Background="{StaticResource ChatPane.Surface}"
                                Padding="10,7,7,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Terminal}" Stroke="{StaticResource ChatPane.Muted7}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,0,7" VerticalAlignment="Bottom"/>
                                <Grid Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding PlaceholderText}" Foreground="{StaticResource ChatPane.Muted7}"
                                               IsHitTestVisible="False" Padding="1,5" VerticalAlignment="Center"
                                               Visibility="{Binding Draft, Converter={StaticResource EmptyVis}}"
                                               FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='12,16.5'}"/>
                                    <TextBox x:Name="ComposerBox" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource ChatPane.Text3}"
                                             CaretBrush="{StaticResource ChatPane.Text3}" TextWrapping="Wrap" AcceptsReturn="False"
                                             MinHeight="26" MaxHeight="120" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                                             Padding="0,5"
                                             PreviewKeyDown="ComposerBox_PreviewKeyDown" TextChanged="ComposerBox_TextChanged" LostKeyboardFocus="ComposerBox_LostKeyboardFocus"
                                             FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='12,16.5'}"/>
                                </Grid>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,0">
                                    <Button x:Name="StopButton" Click="StopButton_Click" IsEnabled="{Binding CanStop}"
                                            Visibility="{Binding CanStop, Converter={StaticResource BoolVis}}"
                                            Height="36" Padding="14,0" Margin="0,0,6,0"
                                            Background="{StaticResource ChatPane.DangerFill}" BorderBrush="{StaticResource ChatPane.DangerBorder}" BorderThickness="1"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Square}" Fill="{StaticResource ChatPane.Danger}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="Stop" Foreground="{StaticResource ChatPane.Danger}" FontWeight="SemiBold" FontSize="13" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SendButton" Click="SendButton_Click" IsEnabled="{Binding CanSend}" Height="36" Padding="16,0"
                                            Background="{StaticResource ChatPane.Primary}" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource ChatPane.Border}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Send" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                            <Path Data="{StaticResource Icon.ArrowRight}" Stroke="White" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Read-only: still running, this app doesn't own its stdin -->
                        <TextBlock Visibility="{Binding Mode, Converter={StaticResource ModeVis}, ConverterParameter=ReadOnlyRunning}"
                                   Text="Streaming output — read-only (not launched by this app instance)" Foreground="{StaticResource ChatPane.Muted6}"
                                   FontStyle="Italic" FontSize="12.5" Margin="2,4"/>

                        <!-- Git #1839 — Adopted after a console restart: streaming + Stop stay, but stdin is gone. -->
                        <Grid Visibility="{Binding Mode, Converter={StaticResource ModeVis}, ConverterParameter=AdoptedReadOnly}" Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{StaticResource ChatPane.Muted6}" FontStyle="Italic" FontSize="12.5"
                                       Text="Adopted after a console restart — its live input channel is gone. Streaming and Stop still work; use Resume Session to talk to it again."/>
                            <!-- Git #1878 — one-click resume, no trip to Build Queue's context menu required. -->
                            <Button Grid.Column="1" Click="ResumeButton_Click"
                                    Height="36" Padding="14,0" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Background="{StaticResource ChatPane.Primary}" BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶ Resume Session" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="StopButton_Click" IsEnabled="{Binding CanStop}"
                                    Visibility="{Binding CanStop, Converter={StaticResource BoolVis}}"
                                    Height="36" Padding="14,0" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Background="{StaticResource ChatPane.DangerFill}" BorderBrush="{StaticResource ChatPane.DangerBorder}" BorderThickness="1"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Square}" Fill="{StaticResource ChatPane.Danger}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stop" Foreground="{StaticResource ChatPane.Danger}" FontWeight="SemiBold" FontSize="13" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Status footer -->
                        <Grid Margin="2,8,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Clock}" Stroke="{StaticResource ChatPane.Muted5}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ElapsedLabel}" Foreground="{StaticResource ChatPane.Muted5}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='10,13'}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TokensLabel}" Foreground="{StaticResource ChatPane.Muted5}" VerticalAlignment="Center"
                                       Visibility="{Binding TokensLabel, Converter={StaticResource NonEmptyVis}}"
                                       FontSize="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Fluid}, ConverterParameter='10,13'}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>

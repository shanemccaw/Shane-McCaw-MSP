<UserControl x:Class="BuildConsole.Controls.ChatDocumentContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <!--
      Git #2548 — Chat Document Container (BuildConsole port of ShaneBuilder's #2209).
      The 5-band chat document shell. The message thread + composer INSIDE the chat are the
      real claude.ai site via WebView2 (injected into ChatBodyHost by OpenChatTab) — not a
      re-implemented transcript. Everything AROUND it here is native WPF chrome: (0) Context
      bar [cool #12151c] / (1) Breadcrumb-Share [warm] / (2) Inspector warning [transient] /
      (3) Body: WebView2 + tool rail [warm] / (4) app-owned Composer [warm]. Only band 0 stays
      on the cool shell palette; every warm band uses the Claude family (README-ClaudeChat.md
      §1). Do NOT harmonise the palette split.
    -->
    <UserControl.Resources>
        <!-- Warm Claude family + cool shell colours, exact hex ported from README-ClaudeChat.md. -->
        <SolidColorBrush x:Key="Cool.CtxBg"        Color="#12151c"/>
        <SolidColorBrush x:Key="Cool.CtxBorder"    Color="#21262d"/>
        <SolidColorBrush x:Key="Cool.Divider"      Color="#262c36"/>
        <SolidColorBrush x:Key="Cool.EpicNum"      Color="#fde047"/>
        <SolidColorBrush x:Key="Cool.Verifying"    Color="#8fa7c4"/>
        <SolidColorBrush x:Key="Cool.InFlight"     Color="#6a8fb5"/>
        <SolidColorBrush x:Key="Cool.Queued"       Color="#8b949e"/>
        <SolidColorBrush x:Key="Cool.Blocked"      Color="#e8746f"/>
        <SolidColorBrush x:Key="Cool.Complete"     Color="#7fb08a"/>
        <SolidColorBrush x:Key="Cool.PillBg"       Color="#1e2233"/>
        <SolidColorBrush x:Key="Cool.PillBorder"   Color="#2e344e"/>
        <SolidColorBrush x:Key="Warm.Chrome"       Color="#1a1a19"/>
        <SolidColorBrush x:Key="Warm.Transcript"   Color="#1e1e1c"/>
        <SolidColorBrush x:Key="Warm.Rail"         Color="#232320"/>
        <SolidColorBrush x:Key="Warm.Border"       Color="#302f2d"/>
        <SolidColorBrush x:Key="Warm.PopBorder"    Color="#35342f"/>
        <SolidColorBrush x:Key="Warm.Accent"       Color="#d97757"/>
        <SolidColorBrush x:Key="Warm.Bubble"       Color="#2a2a27"/>
        <SolidColorBrush x:Key="Warm.Input"        Color="#0d0f10"/>
        <SolidColorBrush x:Key="Warm.TextBright"   Color="#ece9e4"/>
        <SolidColorBrush x:Key="Warm.TextBody"     Color="#dedbd5"/>
        <SolidColorBrush x:Key="Warm.TextMuted"    Color="#c2c0bc"/>
        <SolidColorBrush x:Key="Warm.TextDim"      Color="#7a7975"/>
        <SolidColorBrush x:Key="Warm.TextFaint"    Color="#5a5955"/>
        <SolidColorBrush x:Key="Warm.WrenchAmber"  Color="#e2984a"/>

        <Style x:Key="Ctx.IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2f2f2b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Warm.Transcript}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Band 1 — Context bar (COOL). overflow:visible + ZIndex 40 so the wrench Popup
             paints over the warm body; ClipToBounds stays false. README §2. -->
        <Border Grid.Row="0" Panel.ZIndex="40" x:Name="CtxBarBorder"
                Background="{StaticResource Cool.CtxBg}"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Cool.CtxBorder}"
                SizeChanged="CtxBarBorder_SizeChanged">
            <Grid>
                <!-- background context-used gauge sweep (README §2 "the fill") -->
                <Border x:Name="CtxBarFill" Width="0" HorizontalAlignment="Left" Opacity="0.16"
                        BorderThickness="0,0,1.5,0" Background="{StaticResource Warm.Accent}"
                        BorderBrush="{StaticResource Warm.Accent}"/>
                <Grid Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Epic — DERIVED from the active tab (§11 fix), never hardcoded. -->
                        <TextBlock x:Name="CtxEpicNum" Text="#—" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Cursor="Hand" MouseLeftButtonDown="CtxEpic_Click"
                                   ToolTip="This chat's epic — click to open it in the left panel"
                                   Foreground="{StaticResource Cool.EpicNum}"
                                   FontFamily="Consolas" FontSize="17" FontWeight="ExtraBold"/>
                        <Border Width="1" Height="16" Margin="0,0,10,0" Background="{StaticResource Cool.Divider}"/>
                        <TextBlock x:Name="CtxStatVerifying" Margin="0,0,10,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource Cool.Verifying}"/>
                        <TextBlock x:Name="CtxStatInFlight" Margin="0,0,10,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource Cool.InFlight}"/>
                        <TextBlock x:Name="CtxStatQueued" Margin="0,0,10,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource Cool.Queued}"/>
                        <TextBlock x:Name="CtxStatBlocked" Margin="0,0,10,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource Cool.Blocked}"/>
                        <TextBlock x:Name="CtxStatComplete" Margin="0,0,10,0" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource Cool.Complete}"/>
                        <Border Width="1" Height="16" Margin="0,0,10,0" Background="{StaticResource Cool.Divider}"/>
                        <!-- plan tier pill -->
                        <Border x:Name="CtxPlanPill" Margin="0,0,10,0" VerticalAlignment="Center"
                                Background="{StaticResource Cool.PillBg}" BorderBrush="{StaticResource Cool.PillBorder}"
                                BorderThickness="1" CornerRadius="3" Padding="6,1" Visibility="Collapsed">
                            <TextBlock x:Name="CtxPlanPillText" Text="Pro" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Cool.Verifying}"/>
                        </Border>
                        <!-- context-used gauge (two-part estimate, §2; real tokeniser via ChatContextMeterStore when present) -->
                        <TextBlock x:Name="CtxGauge" Text="≈40k / 300k ctx" VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Warm.TextDim}"
                                   ToolTip="Estimated context used (40k overhead + conversation). Uses the real meter when available."/>
                        <!-- Start New Chat — only appears at ≥75% used (§2). -->
                        <Button x:Name="BtnStartNewChat" Margin="10,0,0,0" Padding="8,2" Height="22"
                                Visibility="Collapsed" Cursor="Hand" BorderThickness="0"
                                ToolTip="Context is getting full — start a fresh chat on this epic"
                                Click="BtnStartNewChat_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#e8746f" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Start New Chat" FontSize="10" FontWeight="ExtraBold" Foreground="#1a0d0d"/>
                        </Button>
                        <TextBlock x:Name="CtxMessages" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontSize="10.5" Foreground="{StaticResource Warm.TextMuted}"/>
                        <TextBlock x:Name="CtxActive" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="10.5" Foreground="{StaticResource Warm.TextDim}"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- ⌸ Detected-in-this-chat toggle (carries an accent dot when undismissed items exist and closed). -->
                        <Grid>
                            <Button x:Name="BtnDetected" Style="{StaticResource Ctx.IconBtn}"
                                    ToolTip="Detected in this chat — mentioned issues + pinned questions"
                                    Click="BtnDetected_Click">
                                <TextBlock x:Name="BtnDetectedGlyph" Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Foreground="{StaticResource Warm.TextMuted}"/>
                            </Button>
                            <Ellipse x:Name="DetectedDot" Width="6" Height="6" Fill="{StaticResource Warm.Accent}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                     Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <!-- ⧉ Claude Floaty -->
                        <Button x:Name="BtnFloaty" Style="{StaticResource Ctx.IconBtn}"
                                ToolTip="Pop this conversation into the always-on-top Claude Floaty"
                                Click="BtnFloaty_Click">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource Warm.TextMuted}"/>
                        </Button>
                        <!-- ⚒ wrench tool menu (always amber, always dotted). -->
                        <Grid>
                            <Button x:Name="BtnWrench" Style="{StaticResource Ctx.IconBtn}"
                                    ToolTip="Chat tools" Click="BtnWrench_Click">
                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Warm.WrenchAmber}"/>
                            </Button>
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Warm.WrenchAmber}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                     IsHitTestVisible="False"/>
                        </Grid>
                        <Popup x:Name="WrenchPopup" PlacementTarget="{Binding ElementName=BtnWrench}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               HorizontalOffset="-160" VerticalOffset="6">
                            <Border Background="{StaticResource Warm.Rail}" CornerRadius="8"
                                    BorderBrush="{StaticResource Warm.PopBorder}" BorderThickness="1"
                                    Padding="5" Width="200">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="10" Opacity="0.5" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel x:Name="WrenchMenuItems"/>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ══ Band 2 — Breadcrumb / Share bar (WARM). Near-replica of claude.ai chrome. -->
        <Border Grid.Row="1" Background="{StaticResource Warm.Chrome}"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Warm.Border}" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A0;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0"
                               VerticalAlignment="Center" Foreground="{StaticResource Warm.TextMuted}"/>
                    <TextBlock Text="Shane McCaw SaaS" VerticalAlignment="Center"
                               FontSize="13" Foreground="{StaticResource Warm.TextMuted}"/>
                    <TextBlock Text="/" Margin="7,0" VerticalAlignment="Center"
                               FontSize="13" Foreground="{StaticResource Warm.TextFaint}"/>
                    <TextBlock x:Name="CrumbChat" Text="Chat" VerticalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonDown="CtxEpic_Click"
                               FontSize="13" FontWeight="Medium" Foreground="{StaticResource Warm.TextBright}"
                               TextDecorations="Underline"/>
                    <TextBlock Text="&#xE70D;" Margin="7,0,0,0" VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource Warm.TextDim}"/>
                </StackPanel>
                <Button x:Name="BtnShare" Grid.Column="1" Cursor="Hand" BorderThickness="0"
                        ToolTip="Copy this conversation's claude.ai share link" Click="BtnShare_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="sb" Background="{StaticResource Warm.Border}" CornerRadius="99" Padding="12,5">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="sb" Property="Background" Value="#3a3935"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Warm.TextMuted}"/>
                        <TextBlock Text="Share" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Warm.TextBody}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Inspector "warning" — floating, non-blocking notice band (README §9). Its own row
             above the body: a WebView2 hosts a native child that paints over any WPF sibling in the
             same cell (airspace), so a floating overlay there would be invisible. -->
        <Border Grid.Row="2" x:Name="InspectorWarningNotice" Visibility="Collapsed"
                Padding="14,8" Background="{StaticResource Warm.Bubble}"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Warm.Border}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="&#xE7BA;" Margin="0,0,8,0" VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#e2b039"/>
                <TextBlock x:Name="InspectorWarningText" Text="Inspector will ask Claude a question in 5s…"
                           VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Warm.TextBright}"/>
            </StackPanel>
        </Border>

        <!-- ══ Band 3+4 — Body: live chat WebView2 (centre) + tool rail (sibling, right). -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RailColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Centre: OpenChatTab injects the real claude.ai WebView2 split grid here. -->
            <Grid x:Name="ChatBodyHost" Grid.Column="0"/>

            <!-- Right: the tool rail. Exactly one panel shows at a time; 0px wide when nothing open. -->
            <Border x:Name="RailBorder" Grid.Column="1" ClipToBounds="True"
                    Background="{StaticResource Warm.Rail}"
                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Warm.Border}">
                <DockPanel Width="280">
                    <!-- Shared header pattern across every future tool panel (§6). -->
                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0"
                            BorderThickness="0,0,0,1" BorderBrush="{StaticResource Warm.Border}">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" x:Name="RailClose" Text="&#xE711;" Cursor="Hand"
                                       FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource Warm.TextDim}"
                                       MouseLeftButtonDown="RailClose_Click"/>
                            <TextBlock DockPanel.Dock="Right" x:Name="RailMaximize" Text="&#xE740;" Cursor="Hand"
                                       Margin="0,0,12,0" Visibility="Collapsed"
                                       ToolTip="Open the full tool (ships as its own Feature)"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource Warm.TextDim}"/>
                            <TextBlock DockPanel.Dock="Right" x:Name="RailRefresh" Text="&#xE72C;" Cursor="Hand"
                                       Margin="0,0,12,0" Visibility="Collapsed"
                                       ToolTip="Refresh detections"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource Warm.TextDim}"
                                       MouseLeftButtonDown="RailRefresh_Click"/>
                            <TextBlock x:Name="RailGlyph" DockPanel.Dock="Left" Text="&#xE9D2;" Margin="0,0,8,0"
                                       VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource Warm.TextMuted}"/>
                            <TextBlock x:Name="RailTitle" Text="Detected in this chat" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="Bold" Foreground="{StaticResource Warm.TextBright}"/>
                        </DockPanel>
                    </Border>

                    <!-- Body: exactly one of these two is visible at a time. -->
                    <Grid>
                        <!-- Detected-in-this-chat: hosts the real ChatDockPanel (ChatDockService data). -->
                        <ScrollViewer x:Name="DetectedScroller" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <!-- Pending cross-epic questions ride above the dock (§7). -->
                                <StackPanel x:Name="CrossEpicCards" Margin="10,10,10,0"/>
                                <ContentControl x:Name="DetectedDockHost"/>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- Tool stub: honest empty body — each tool internal is a sibling Feature under #1202. -->
                        <StackPanel x:Name="ToolStubBody" Visibility="Collapsed" Margin="16" VerticalAlignment="Center">
                            <TextBlock x:Name="ToolStubTitle" Text="Tool" HorizontalAlignment="Center"
                                       FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Warm.TextBright}"/>
                            <TextBlock Text="This tool ships as its own Feature under #1202."
                                       Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                       FontStyle="Italic" FontSize="11" Foreground="{StaticResource Warm.TextDim}"/>
                            <TextBlock Text="The container shell, header and rail behaviour are wired and ready."
                                       Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="10.5" Foreground="{StaticResource Warm.TextFaint}"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ══ Band 5 — app-owned Composer (WARM). The one surface tools write into; never
             auto-sends (§5). Per-tab draft: this composer IS this tab's draft (one container per
             tab). Send injects into the live claude.ai composer via the DOM bridge (§8).
             Git #2678 — collapsed by default: claude.ai's own composer (in the live page above)
             already handles normal typing/sending, so this band has no job until a tool writes a
             draft into it or a cross-epic return address lands here. UpdateComposerBandVisibility
             in the code-behind is the single place that flips this. -->
        <Grid Grid.Row="4" x:Name="ComposerBand" Visibility="Collapsed">
            <Border Background="{StaticResource Warm.Chrome}" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource Warm.Border}" Padding="14,10">
                <Grid HorizontalAlignment="Center" MinWidth="400" MaxWidth="700">
                    <StackPanel>
                        <!-- Cross-epic return-address bar — shows when a question was written into THIS tab (§7). -->
                        <Border x:Name="ComposerReturnBar" Visibility="Collapsed" Margin="0,0,0,8"
                                CornerRadius="6" Padding="9,6" Background="{StaticResource Warm.Bubble}"
                                BorderBrush="{StaticResource Warm.Accent}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE711;" Cursor="Hand" VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{StaticResource Warm.TextDim}"
                                           MouseLeftButtonDown="ComposerReturnClear_Click"/>
                                <TextBlock Text="&#xE72C;" Margin="0,0,7,0" VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Warm.Accent}"/>
                                <TextBlock x:Name="ComposerReturnText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           FontSize="10.5" Foreground="{StaticResource Warm.TextBody}"/>
                            </DockPanel>
                        </Border>
                        <Border CornerRadius="26" Background="{StaticResource Warm.Bubble}"
                                BorderBrush="#3a3a37" BorderThickness="1" Padding="16,8,10,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Bottom" Margin="0,0,10,4"
                                           Foreground="{StaticResource Warm.TextDim}"/>
                                <Button x:Name="BtnComposerSend" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                                        Cursor="Hand" BorderThickness="0" Background="Transparent"
                                        Margin="6,0,0,0" Padding="8,4"
                                        ToolTip="Send this draft to the live claude.ai composer (Enter)"
                                        Click="BtnComposerSend_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="cb" Background="{TemplateBinding Background}" CornerRadius="99" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="cb" Property="Background" Value="#3a3a37"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{StaticResource Warm.Accent}"/>
                                </Button>
                                <TextBox x:Name="ChatComposer" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="22" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0" Padding="0,2" Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Foreground="{StaticResource Warm.TextBright}"
                                         CaretBrush="{StaticResource Warm.Accent}"
                                         FontSize="14"
                                         PreviewKeyDown="ChatComposer_PreviewKeyDown"
                                         TextChanged="ChatComposer_TextChanged"/>
                            </DockPanel>
                        </Border>
                        <!-- Git #2678 — the "Sonnet 5" / "Medium" model/effort labels that used to sit
                             here were static literal XAML text, not bound to any real state: bt_chats
                             (BoardChat, this tab's real backing row) carries no model/effort column, and
                             a chat tab isn't 1:1 with a queued build's model/effort selection, so
                             there is no live per-tab value to bind to. Dropped rather than left fake —
                             the real live model/effort picker already lives in claude.ai's own composer
                             on the page above. -->
                        <TextBlock Margin="4,6,0,0"
                                   Text="Claude is AI and can make mistakes. Please double-check responses."
                                   FontSize="11" Foreground="{StaticResource Warm.TextDim}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inspector "blocking" — covers ONLY the composer band (§9). Native WPF over a native
                 band, so no airspace problem; the transcript above stays readable. -->
            <Border x:Name="InspectorBlockingOverlay" Visibility="Collapsed" Background="#e1141412">
                <Border Background="#e0141412">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center"
                                Background="{StaticResource Warm.Bubble}"
                                BorderBrush="{StaticResource Warm.Accent}" BorderThickness="1">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Warm.Accent}"/>
                        </Border>
                        <TextBlock Text="Inspector is asking Claude a question…" Margin="0,8,0,2"
                                   HorizontalAlignment="Center" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{StaticResource Warm.TextBright}"/>
                        <TextBlock Text="You'll get control back once Claude responds"
                                   HorizontalAlignment="Center" FontSize="10.5"
                                   Foreground="{StaticResource Warm.TextMuted}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>

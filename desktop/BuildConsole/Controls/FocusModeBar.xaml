<UserControl x:Class="BuildConsole.Controls.FocusModeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!-- Focus Mode strip — a single in-window bar (NOT a window). Collapsed to one
         line normally; grows a second row of quick on-milestone tasks during build
         downtime. Docked at the top of the main content by MainWindow.InitFocusMode. -->
    <Border x:Name="RootBorder"
            Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface1Brush}"
            BorderThickness="0,0,0,1"
            Effect="{StaticResource SoftRowShadow}">
        <StackPanel>
            <!-- ===== main strip ===== -->
            <Grid Height="34" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- FOCUS label -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="FOCUS" FontWeight="Bold" FontSize="10.5"
                               Foreground="{StaticResource BlueBrush}"
                               Margin="6,0,12,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- inactive: milestone picker -->
                <StackPanel x:Name="PickerPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="MilestoneCombo" Width="280" Height="24" FontSize="11"
                              VerticalContentAlignment="Center"
                              ToolTip="Pick the one milestone you're working — everything else gets hidden."/>
                    <Button x:Name="StartFocusBtn" Content="Focus this" Height="24" Margin="8,0,0,0"
                            Padding="12,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                            Style="{StaticResource PrimaryButton}" Click="StartFocusBtn_Click"/>
                </StackPanel>

                <!-- active: milestone + progress -->
                <StackPanel x:Name="ActivePanel" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="8,2"
                            Cursor="Hand" MouseLeftButtonUp="ActiveTitle_Click"
                            Effect="{StaticResource BlueGlowFaint}"
                            ToolTip="Open this milestone's detail tab">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ActiveTitle" FontWeight="SemiBold" FontSize="11.5"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                       MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <!-- progress track -->
                    <Border Background="{StaticResource Surface2Brush}" Width="120" Height="6"
                            CornerRadius="3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border x:Name="ProgressFill" Background="{StaticResource GreenBrush}" Width="0"
                                Height="6" CornerRadius="3" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock x:Name="ProgressText" FontSize="10.5" Foreground="{StaticResource Subtext1Brush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- middle: ETA + points + latest achievement -->
                <StackPanel x:Name="MiddlePanel" Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="EtaText" FontSize="10.5" Foreground="{StaticResource BlueBrush}"
                               VerticalAlignment="Center"/>
                    <!-- Git #2708 — swaps IN for PointsChip/AchvChip (not stacked alongside them) whenever
                         there's a real unrestored last-session tab set waiting; swaps back out once those
                         tabs are reopened (or the user starts using the app normally — see OpenChatTab). -->
                    <Border x:Name="OpenLastTabsChip" Background="{StaticResource Surface0Brush}" CornerRadius="9"
                            Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                            Visibility="Collapsed" MouseLeftButtonUp="OpenLastTabsChip_Click"
                            Effect="{StaticResource BlueGlowFaint}"
                            ToolTip="Reopen every chat tab left open from your last session">
                        <TextBlock x:Name="OpenLastTabsText" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource BlueBrush}"/>
                    </Border>
                    <Border x:Name="PointsChip" Background="{StaticResource Surface0Brush}" CornerRadius="9"
                            Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="PointsText" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource YellowBrush}"/>
                    </Border>
                    <Border x:Name="AchvChip" Background="{StaticResource Surface0Brush}" CornerRadius="9"
                            Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                            Visibility="Collapsed" MouseLeftButtonUp="AchvChip_Click"
                            ToolTip="Your Focus achievements">
                        <TextBlock x:Name="AchvText" FontSize="10.5" Foreground="{StaticResource Subtext1Brush}"/>
                    </Border>
                    <!-- In-Progress quick chats -->
                    <StackPanel x:Name="InProgressStrip" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="⚡" FontSize="11" Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="In Progress:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <StackPanel x:Name="InProgressList" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- right: hidden count + exit -->
                <StackPanel x:Name="RightPanel" Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="HiddenText" FontSize="10.5" Foreground="{StaticResource Subtext0Brush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="ImmersiveBtn" Content="⛶ Immersive" Height="24" Margin="0,0,8,0" Padding="12,0"
                            FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                            Style="{StaticResource PrimaryButton}" Click="ImmersiveBtn_Click"
                            ToolTip="Zoom into a dedicated full-screen view of just this epic (Ctrl+Shift+F)"/>
                    <Button x:Name="ExitBtn" Content="Exit focus" Height="24" Padding="10,0" FontSize="11"
                            Cursor="Hand" Foreground="{StaticResource TextBrush}"
                            Background="{StaticResource Surface1Brush}" BorderThickness="0"
                            Click="ExitBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- The old full-width "Live checklist" band that lived here was REMOVED: it rendered a
                 floating aggregate at the top of the window (above the Chats sidebar's own header),
                 duplicating — and misplacing — the per-build checklist that #42/#56 already shows
                 inside each build's OWN Build Watch square (ChatSessionPane's right-hand column).
                 A build's detected steps now appear only in that build's own pane, never floating
                 up here in the Focus strip. Detection/tracking (ChecklistExtractor / the shared
                 TaskChecklistViewModel) is unchanged — only this stray render was dropped. -->

            <!-- The downtime "quick wins while you wait" band that lived here (#1874) was REMOVED:
                 it had no close affordance and appeared exactly when all 8 build slots were busy —
                 the moment Shane had the least room. The context capture/auto-restore behind it is
                 also gone (see FocusModeService); this bar no longer snapshots or rearranges tabs. -->
        </StackPanel>
    </Border>
</UserControl>

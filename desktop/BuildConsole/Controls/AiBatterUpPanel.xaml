<UserControl x:Class="BuildConsole.Controls.AiBatterUpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BuildConsole.Controls"
             MinWidth="220"
             MaxHeight="260">

    <!--
        Git #1710 — additive "AI Batter Up" review panel: agent-filed findings awaiting
        Shane's Yes/No, per CLAUDE.md's "Board status" routing rule. Separate from
        #1709's BatterUpPanel above it (that one reads plain "Batter Up" and auto-queues;
        this one reads "AI Batter Up" and only promotes/demotes the board status). Yes
        never launches or queues anything directly — it only flips Status to real
        "Batter Up", which #1709's panel picks up on its own next refresh. This is the
        one human gate in the whole #1708 design.
    -->
    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">

            <!-- Header — Git #1816: this panel's own BtnRefresh is gone; refreshing is now
                 the Build Queue header's single shared icon (BuildQueuePanel.xaml
                 BtnRefreshGitHubTiles), which cascades here via BoardRefreshCompleted
                 (#1813). TxtCount also carries the "no items" empty-state note inline now,
                 so an empty panel never grows past this one header row.

                 Git #1863 — TxtFilter fits into this same column-1 slot next to TxtCount
                 (same overlay-placeholder trick as the Build Queue's #950 QueueSearchBox,
                 shrunk down since there's no row to spare here). It's display-only — see
                 TxtFilter_TextChanged — and is hidden whenever TxtCount reads "none open"
                 (RefreshAsync) so an empty panel doesn't reserve space for a box with
                 nothing to filter. -->
            <Grid DockPanel.Dock="Top" Margin="10,8,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔍 AI Batter Up"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>

                <DockPanel Grid.Column="1" Margin="8,0,0,0" LastChildFill="False">
                    <TextBlock x:Name="TxtCount" DockPanel.Dock="Right"
                               Foreground="{StaticResource Subtext0Brush}" FontSize="11"
                               VerticalAlignment="Center" Text=""/>

                    <Grid x:Name="FilterBoxHost" DockPanel.Dock="Left" Margin="0,0,6,0"
                          Visibility="Collapsed">
                        <TextBox x:Name="TxtFilter"
                                 Width="70" Height="18"
                                 Padding="4,0,4,0" FontSize="10.5"
                                 VerticalContentAlignment="Center"
                                 Background="{StaticResource Surface0Brush}"
                                 TextChanged="TxtFilter_TextChanged"/>
                        <TextBlock IsHitTestVisible="False"
                                   Text="Search #"
                                   FontSize="10.5"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Foreground="{StaticResource Subtext1Brush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtFilter}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <ToggleButton x:Name="BtnCollapse" Grid.Column="2"
                              Style="{StaticResource ExpandCollapseToggleStyle}"
                              Cursor="Hand"
                              IsChecked="True" Click="BtnCollapse_Click"/>
            </Grid>

            <ScrollViewer x:Name="RowsScroller" DockPanel.Dock="Top"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="220"
                          Visibility="Collapsed">
                <!-- Git #1803 — cards are built in code-behind (BuildAiBatterUpCard), the same way
                     BuildQueuePanel builds BuildQueueCard, so this row carries the exact same
                     critter-avatar/card-border language, with Yes/No as real in-card footer
                     actions instead of a DataTemplate text row with bare buttons. -->
                <StackPanel x:Name="RowsList" Margin="4,0,4,6"/>
            </ScrollViewer>

            <!-- Git #1816 — reserved only for the rarer no-PAT/error messages now; the plain
                 "zero items" case is shown inline in TxtCount above instead, so the common
                 empty state no longer reserves this block's own margin/wrap space. -->
            <TextBlock x:Name="TxtEmpty" DockPanel.Dock="Top" Margin="10,4,10,10"
                       Foreground="{StaticResource Subtext0Brush}" FontSize="11.5"
                       TextWrapping="Wrap" Text=""
                       Visibility="Collapsed"/>

        </DockPanel>
    </Border>
</UserControl>

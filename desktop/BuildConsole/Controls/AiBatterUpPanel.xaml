<UserControl x:Class="BuildConsole.Controls.AiBatterUpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BuildConsole.Controls"
             MinWidth="220"
             MaxHeight="260">

    <!--
        Git #1710 — additive "AI Batter Up" review panel: agent-filed findings awaiting
        Shane's Yes/No, per CLAUDE.md's "Board status" routing rule. Separate from
        #1709's BatterUpPanel above it (that one reads plain "Batter Up" and auto-queues;
        this one reads "AI Batter Up" and only promotes/demotes the board status). Yes
        never launches or queues anything directly — it only flips Status to real
        "Batter Up", which #1709's panel picks up on its own next refresh. This is the
        one human gate in the whole #1708 design.
    -->
    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="10,8,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔍 AI Batter Up"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="TxtCount" Grid.Column="1" Margin="8,0,0,0"
                           Foreground="{StaticResource Subtext0Brush}" FontSize="11"
                           VerticalAlignment="Center" Text=""/>

                <Button x:Name="BtnRefresh" Grid.Column="2" Content="⟳" Padding="6,2" Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource Subtext0Brush}" Cursor="Hand"
                        ToolTip="Refresh AI Batter Up now" Click="BtnRefresh_Click"/>

                <ToggleButton x:Name="BtnCollapse" Grid.Column="3" Content="▾" Padding="6,2"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource Subtext0Brush}" Cursor="Hand"
                              IsChecked="False" Click="BtnCollapse_Click"/>
            </Grid>

            <ScrollViewer x:Name="RowsScroller" DockPanel.Dock="Top"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="220">
                <ItemsControl x:Name="RowsList" Margin="4,0,4,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1"
                                    Padding="6,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding HeaderText}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                               Foreground="{StaticResource Subtext0Brush}"
                                               TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Yes" Padding="10,2" Margin="0,0,6,0"
                                                Background="{StaticResource GreenBrush}"
                                                Foreground="White" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Promote to Batter Up"
                                                Tag="{Binding}" Click="BtnYes_Click"/>
                                        <Button Content="No" Padding="10,2"
                                                Background="{StaticResource Surface0Brush}"
                                                Foreground="{StaticResource TextBrush}" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Decline to Backlog"
                                                Tag="{Binding}" Click="BtnNo_Click"/>
                                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0"
                                                   FontSize="10.5" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Subtext0Brush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="TxtEmpty" DockPanel.Dock="Top" Margin="10,4,10,10"
                       Foreground="{StaticResource Subtext0Brush}" FontSize="11.5"
                       TextWrapping="Wrap" Text="No open issues in AI Batter Up."/>

        </DockPanel>
    </Border>
</UserControl>

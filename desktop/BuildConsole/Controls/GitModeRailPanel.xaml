<UserControl x:Class="BuildConsole.Controls.GitModeRailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CrustBrush}"
             Foreground="{StaticResource TextBrush}">

    <Border BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,1,0">
        <Grid>
            <!-- ══════════════════════════════════════════════════════════════
                 1. COLLAPSED RAIL (48px wide) — mirrors TestModeDiagnosticsPanel
                 ══════════════════════════════════════════════════════════════ -->
            <Grid x:Name="RailCollapsed" Width="48" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Expand toggle button -->
                <Border Grid.Row="0" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                    <Button x:Name="BtnExpandRail"
                            Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right"
                            Width="24" Height="24"
                            Margin="0,0,6,0"
                            Padding="0"
                            ToolTip="Expand Git Mode (300px)"
                            Click="BtnExpandRail_Click">
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFontFamily}" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource Subtext0Brush}"/>
                    </Button>
                </Border>

                <!-- Vertical Icon Rail -->
                <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,8,0,8">
                    <!-- Git Mode glyph (non-interactive) -->
                    <Viewbox Width="20" Height="20" Margin="0,0,0,8">
                        <Path Fill="{StaticResource MauveBrush}"
                              Data="M21 8.25C21 6.1815 19.3185 4.5 17.25 4.5C15.1815 4.5 13.5 6.1815 13.5 8.25C13.5 10.023 14.739 11.5035 16.395 11.892C16.116 12.819 15.2655 13.5 14.25 13.5H9.75C8.9025 13.5 8.1285 13.7925 7.5 14.268V7.4235C9.21 7.0755 10.5 5.5605 10.5 3.75C10.5 1.6815 8.8185 0 6.75 0C4.6815 0 3 1.6815 3 3.75C3 5.562 4.29 7.0755 6 7.4235V16.575C4.29 16.923 3 18.438 3 20.2485C3 22.317 4.6815 23.9985 6.75 23.9985C8.8185 23.9985 10.5 22.317 10.5 20.2485C10.5 18.4755 9.261 16.995 7.605 16.6065C7.884 15.6795 8.7345 14.9985 9.75 14.9985H14.25C16.0845 14.9985 17.61 13.6725 17.931 11.9295C19.674 11.607 21 10.0845 21 8.25ZM4.5 3.75C4.5 2.5095 5.5095 1.5 6.75 1.5C7.9905 1.5 9 2.5095 9 3.75C9 4.9905 7.9905 6 6.75 6C5.5095 6 4.5 4.9905 4.5 3.75ZM9 20.25C9 21.4905 7.9905 22.5 6.75 22.5C5.5095 22.5 4.5 21.4905 4.5 20.25C4.5 19.0095 5.5095 18 6.75 18C7.9905 18 9 19.0095 9 20.25ZM17.25 10.5C16.0095 10.5 15 9.4905 15 8.25C15 7.0095 16.0095 6 17.25 6C18.4905 6 19.5 7.0095 19.5 8.25C19.5 9.4905 18.4905 10.5 17.25 10.5Z"/>
                    </Viewbox>

                    <!-- Open Dependency Graph -->
                    <Button x:Name="RailBtnGraph" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,0,3"
                            ToolTip="Open Dependency Graph" Click="RailBtnGraph_Click">
                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFontFamily}" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource BlueBrush}"/>
                    </Button>

                    <!-- Refresh Board -->
                    <Button x:Name="RailBtnRefresh" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,0,3"
                            ToolTip="Refresh Git Board" Click="RailBtnRefresh_Click">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource Subtext0Brush}"/>
                    </Button>
                </StackPanel>

                <!-- Exit Git Mode (bottom) -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0" Padding="0,6">
                    <Button x:Name="RailBtnExit" Style="{StaticResource IconButton}" Width="32" Height="32" HorizontalAlignment="Center"
                            ToolTip="Exit Git Mode (Ctrl+Shift+G)" Click="RailBtnExit_Click">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource RedBrush}"/>
                    </Button>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════
                 2. EXPANDED PANEL (300px wide)
                 ══════════════════════════════════════════════════════════════ -->
            <Grid x:Name="PanelExpanded" Width="300" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Strip -->
                <Border Grid.Row="0" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1" Padding="10,0,8,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Fill="{StaticResource MauveBrush}"
                                  Data="M21 8.25C21 6.1815 19.3185 4.5 17.25 4.5C15.1815 4.5 13.5 6.1815 13.5 8.25C13.5 10.023 14.739 11.5035 16.395 11.892C16.116 12.819 15.2655 13.5 14.25 13.5H9.75C8.9025 13.5 8.1285 13.7925 7.5 14.268V7.4235C9.21 7.0755 10.5 5.5605 10.5 3.75C10.5 1.6815 8.8185 0 6.75 0C4.6815 0 3 1.6815 3 3.75C3 5.562 4.29 7.0755 6 7.4235V16.575C4.29 16.923 3 18.438 3 20.2485C3 22.317 4.6815 23.9985 6.75 23.9985C8.8185 23.9985 10.5 22.317 10.5 20.2485C10.5 18.4755 9.261 16.995 7.605 16.6065C7.884 15.6795 8.7345 14.9985 9.75 14.9985H14.25C16.0845 14.9985 17.61 13.6725 17.931 11.9295C19.674 11.607 21 10.0845 21 8.25Z"/>
                        </Viewbox>

                        <TextBlock Grid.Column="1" Text="GIT MODE" FontSize="{StaticResource CaptionFontSize}" FontWeight="ExtraBold"
                                   Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>

                        <Button x:Name="BtnCollapseRail" Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Width="24" Height="24"
                                Padding="0"
                                ToolTip="Collapse Git Mode Rail (48px)"
                                Click="BtnCollapseRail_Click">
                            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFontFamily}" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource Subtext0Brush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" Orientation="Vertical">
                        <TextBlock Text="Browse the real Git Board epic/issue tree in the left sidebar. Selecting an issue shows its details on the right; open the interactive Dependency Graph in its own tab."
                                   FontSize="{StaticResource CaptionFontSize}"
                                   Foreground="{StaticResource Subtext0Brush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <Button x:Name="BtnOpenGraph"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Left"
                                Padding="10,6"
                                Margin="0,0,0,8"
                                Click="RailBtnGraph_Click"
                                ToolTip="Open (or focus) the Dependency Graph document tab">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFontFamily}" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource BlueBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Open Dependency Graph" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnRefreshBoard"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Left"
                                Padding="10,6"
                                Margin="0,0,0,8"
                                Click="RailBtnRefresh_Click"
                                ToolTip="Refresh the Git Board tree from GitHub / Postgres">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Refresh Git Board" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Dependency-edge legend -->
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="GRAPH LEGEND" FontSize="{StaticResource CaptionFontSize}" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="{StaticResource RedBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Hard Block" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="{StaticResource YellowBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Soft Block" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="{StaticResource GreenBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Resolved (Closed)" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource MauveBrush}" Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="AI / Agent" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Exit footer -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0" Padding="12,8">
                    <Button x:Name="BtnExitGitMode"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="RailBtnExit_Click"
                            ToolTip="Exit Git Mode (Ctrl+Shift+G)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,6,0" Foreground="{StaticResource RedBrush}"/>
                            <TextBlock Text="Exit Git Mode" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="BuildConsole.Controls.BugsDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BaseBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Title & Filter Bar -->
            <RowDefinition Height="*"/>    <!-- Main Split: Grouped List Left, Details Right -->
        </Grid.RowDefinitions>

        <!-- 1. Header & Filter Bar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <DockPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🐞" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Bug Tracker" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauveBrush}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBugCount" Text="0 Bugs" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCleanFiles" Content="🧹 Clean Up Files" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0" Click="BtnCleanFiles_Click" ToolTip="Purge old resolved screenshots and orphan capture files from disk"/>
                    <Button x:Name="BtnRefresh" Content="⟳ Refresh &amp; Sync" Style="{StaticResource SecondaryButton}" Padding="10,4" Click="BtnRefresh_Click"/>
                </StackPanel>
            </DockPanel>

            <!-- Filters Bar -->
            <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <WrapPanel VerticalAlignment="Center">
                    <!-- Status Filters (Open default) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Status:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton x:Name="RadioFilterOpen" Content="Open Only" IsChecked="True" GroupName="StatusFilter" Margin="0,0,8,0" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Checked="Filter_Changed"/>
                        <RadioButton x:Name="RadioFilterClosed" Content="Closed / Resolved" GroupName="StatusFilter" Margin="0,0,8,0" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Checked="Filter_Changed"/>
                        <RadioButton x:Name="RadioFilterAll" Content="All Bugs" GroupName="StatusFilter" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Checked="Filter_Changed"/>
                    </StackPanel>

                    <!-- Site Dropdown -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Site:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ComboSiteFilter" Width="140" Height="26" FontSize="11" SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <!-- Epic Dropdown -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Epic:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ComboEpicFilter" Width="140" Height="26" FontSize="11" SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Search:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtSearch" Width="180" Height="26" FontSize="11" VerticalContentAlignment="Center" TextChanged="Filter_Changed" Padding="4,0"/>
                    </StackPanel>
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- 2. Main Workspace Split: Left Grouped List, Right Detail Pane -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>   <!-- Grouped Bug List -->
                <ColumnDefinition Width="Auto"/> <!-- GridSplitter -->
                <ColumnDefinition Width="3*"/>   <!-- Bug Detail & Verification -->
            </Grid.ColumnDefinitions>

            <!-- Left: Grouped Bug List -->
            <Border Grid.Column="0" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock Text="Bugs Grouped by Site / Epic" DockPanel.Dock="Top" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Subtext0Brush}" Margin="4,0,0,8"/>
                    
                    <ListBox x:Name="LstBugs" Background="Transparent" BorderThickness="0" SelectionChanged="LstBugs_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="10,8" Margin="0,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Row: Bug #, Git Issue #, Status & Severity Badges -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BugNumber, StringFormat='BUG-{0}'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource MauveBrush}" Margin="0,0,8,0"/>
                                                
                                                <!-- Git Issue Tag -->
                                                <Border Background="{StaticResource BlueBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" Visibility="{Binding HasGitIssue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding GitIssueNumber, StringFormat='#{0}'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CrustBrush}"/>
                                                </Border>

                                                <!-- Severity Badge -->
                                                <Border Background="{StaticResource PeachBrush}" CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource CrustBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <Border DockPanel.Dock="Right" Background="{StaticResource GreenBrush}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CrustBrush}"/>
                                            </Border>
                                        </DockPanel>

                                        <!-- Title / Summary -->
                                        <TextBlock Grid.Row="1" Text="{Binding DisplayTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                        <!-- Subtitle: Site / Epic & Date -->
                                        <DockPanel Grid.Row="2">
                                            <TextBlock Text="{Binding SiteEpicSummary}" FontSize="10.5" Foreground="{StaticResource Subtext0Brush}"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- Right: Selected Bug Detail & Verification Panel -->
            <Border Grid.Column="2" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlDetailContainer">
                        <!-- Empty State when nothing selected -->
                        <TextBlock x:Name="TxtEmptyDetail" Text="Select a bug from the list to review details and re-run test verification." FontSize="12" Foreground="{StaticResource Subtext0Brush}" HorizontalAlignment="Center" Margin="0,60,0,0"/>

                        <!-- Bug Detail Content -->
                        <StackPanel x:Name="PnlBugDetails" Visibility="Collapsed">
                            <!-- Action Bar: Re-run Test & Status Toggle -->
                            <Border Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnRerunTest" Content="▶ Re-run Test to Verify" Style="{StaticResource PrimaryButton}" Padding="12,6" FontWeight="Bold" Click="BtnRerunTest_Click" Margin="0,0,12,0"/>
                                        <Button x:Name="BtnToggleStatus" Content="Mark as Resolved" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="BtnToggleStatus_Click"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Git Issue #:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtGitIssueInput" Width="70" Height="26" FontSize="11" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,6,0"/>
                                        <Button x:Name="BtnSaveGitIssue" Content="Save" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="BtnSaveGitIssue_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Bug Title & Badges Header -->
                            <StackPanel Margin="0,0,0,16">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtDetailBugNum" Text="BUG-0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource MauveBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border x:Name="BdrDetailSeverity" Background="{StaticResource PeachBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="TxtDetailSeverity" Text="BUG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CrustBrush}"/>
                                    </Border>
                                    <Border x:Name="BdrDetailStatus" Background="{StaticResource GreenBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtDetailStatus" Text="OPEN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CrustBrush}"/>
                                    </Border>
                                </DockPanel>

                                <TextBlock x:Name="TxtDetailTitle" Text="Bug Title" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtDetailMeta" Text="Site / Epic details" FontSize="11.5" Foreground="{StaticResource Subtext1Brush}"/>
                            </StackPanel>

                            <!-- Status/Verification Banner -->
                            <Border x:Name="BdrBanner" Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,16" Visibility="Collapsed">
                                <TextBlock x:Name="TxtBanner" Text="" FontSize="11.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Markdown Notes / Summary -->
                            <TextBlock Text="Notes / Summary" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14">
                                <TextBox x:Name="TxtDetailNotes" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                            </Border>

                            <!-- Steps to Reproduce -->
                            <TextBlock Text="Steps to Reproduce" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14">
                                <TextBox x:Name="TxtDetailSteps" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="11.5"/>
                            </Border>

                            <!-- Expected vs Actual -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Expected Behavior" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,4"/>
                                    <Border Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="4" Padding="8" Height="70">
                                        <TextBox x:Name="TxtDetailExpected" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Actual Behavior" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,4"/>
                                    <Border Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="4" Padding="8" Height="70">
                                        <TextBox x:Name="TxtDetailActual" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Diagnostics / Reproduction Events -->
                            <TextBlock Text="Automated Reproduction &amp; Diagnostics" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14">
                                <TextBox x:Name="TxtDetailDiagnostics" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Subtext1Brush}" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

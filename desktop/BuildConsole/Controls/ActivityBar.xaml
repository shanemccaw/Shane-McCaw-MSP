<UserControl x:Class="BuildConsole.Controls.ActivityBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48">

    <Border Background="{StaticResource CrustBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="False">

            <!-- ── Top icons: Chats, Explorer, Search, Git ── -->
            <StackPanel DockPanel.Dock="Top">

                <RadioButton x:Name="BtnChats"
                             GroupName="ActivityBar"
                             Style="{StaticResource ActivityBarButton}"
                             IsChecked="True"
                             Checked="Btn_Checked" Tag="Chats"
                             ToolTip="Chats">
                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                </RadioButton>

                <RadioButton x:Name="BtnExplorer"
                             GroupName="ActivityBar"
                             Style="{StaticResource ActivityBarButton}"
                             Checked="Btn_Checked" Tag="Explorer"
                             ToolTip="Explorer">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                </RadioButton>

                <RadioButton x:Name="BtnSearch"
                             GroupName="ActivityBar"
                             Style="{StaticResource ActivityBarButton}"
                             Checked="Btn_Checked" Tag="Search"
                             ToolTip="Search">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                </RadioButton>

                <RadioButton x:Name="BtnGit"
                             GroupName="ActivityBar"
                             Style="{StaticResource ActivityBarButton}"
                             Checked="Btn_Checked" Tag="Git"
                             ToolTip="Source Control">
                    <!-- Git #867's emoji fallback is gone — Segoe MDL2/Fluent genuinely
                         has no branch/git glyph (confirmed against Microsoft's own icon
                         list), so this reproduces VS Code's real "source-control" codicon
                         as vector geometry instead (same path data as the codicon SVG,
                         24x24 viewBox). Path.Fill isn't an inherited property like
                         TextBlock.Foreground, so it's bound explicitly to the RadioButton's
                         Foreground to track the ActivityBarButton style's checked/hover triggers. -->
                    <Viewbox Width="18" Height="18">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              Data="M21 8.25C21 6.1815 19.3185 4.5 17.25 4.5C15.1815 4.5 13.5 6.1815 13.5 8.25C13.5 10.023 14.739 11.5035 16.395 11.892C16.116 12.819 15.2655 13.5 14.25 13.5H9.75C8.9025 13.5 8.1285 13.7925 7.5 14.268V7.4235C9.21 7.0755 10.5 5.5605 10.5 3.75C10.5 1.6815 8.8185 0 6.75 0C4.6815 0 3 1.6815 3 3.75C3 5.562 4.29 7.0755 6 7.4235V16.575C4.29 16.923 3 18.438 3 20.2485C3 22.317 4.6815 23.9985 6.75 23.9985C8.8185 23.9985 10.5 22.317 10.5 20.2485C10.5 18.4755 9.261 16.995 7.605 16.6065C7.884 15.6795 8.7345 14.9985 9.75 14.9985H14.25C16.0845 14.9985 17.61 13.6725 17.931 11.9295C19.674 11.607 21 10.0845 21 8.25ZM4.5 3.75C4.5 2.5095 5.5095 1.5 6.75 1.5C7.9905 1.5 9 2.5095 9 3.75C9 4.9905 7.9905 6 6.75 6C5.5095 6 4.5 4.9905 4.5 3.75ZM9 20.25C9 21.4905 7.9905 22.5 6.75 22.5C5.5095 22.5 4.5 21.4905 4.5 20.25C4.5 19.0095 5.5095 18 6.75 18C7.9905 18 9 19.0095 9 20.25ZM17.25 10.5C16.0095 10.5 15 9.4905 15 8.25C15 7.0095 16.0095 6 17.25 6C18.4905 6 19.5 7.0095 19.5 8.25C19.5 9.4905 18.4905 10.5 17.25 10.5Z"/>
                    </Viewbox>
                </RadioButton>

                <RadioButton x:Name="BtnIssues"
                             GroupName="ActivityBar"
                             Style="{StaticResource ActivityBarButton}"
                             Checked="Btn_Checked" Tag="Issues"
                             ToolTip="Git Milestones, Epics &amp; Issues Tracker">
                    <TextBlock Text="🎯" FontSize="16"/>
                </RadioButton>

                <RadioButton x:Name="BtnAutomation"
                             GroupName="ActivityBar"
                             Style="{StaticResource ActivityBarButton}"
                             Checked="Btn_Checked" Tag="Automation"
                             ToolTip="UI Automation Suite">
                    <!-- Play glyph (E768) with a Bug glyph (EBE8) badged into the
                         corner — both real, verified Segoe MDL2 Assets glyphs — for
                         a run-tests/debug-tests look, matching how test runners
                         (VS Code's Test Explorer) badge a bug icon onto the run
                         affordance for "debug test" actions. -->
                    <Grid Width="18" Height="18">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                </RadioButton>

                <RadioButton x:Name="BtnGraphApi"
                             GroupName="ActivityBar"
                             Style="{StaticResource ActivityBarButton}"
                             Checked="Btn_Checked" Tag="GraphApi"
                             ToolTip="Microsoft Graph API Panel">
                    <TextBlock Text="&#xE9A1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource BlueBrush}"/>
                </RadioButton>

                <!-- Separator -->
                <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="8,6"/>

                <!-- ── Quick Nav Icons ── -->
                <Button Style="{StaticResource IconButton}"
                        Width="48" Height="44"
                        ToolTip="Admin Center"
                        Click="QuickNav_Click"
                        Tag="http://localhost:5174">
                    <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PeachBrush}"/>
                </Button>

                <Button Style="{StaticResource IconButton}"
                        Width="48" Height="44"
                        ToolTip="Customer Portal"
                        Click="QuickNav_Click"
                        Tag="http://localhost:5175">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource MauveBrush}"/>
                </Button>

                <Button Style="{StaticResource IconButton}"
                        Width="48" Height="44"
                        ToolTip="Marketing Site"
                        Click="QuickNav_Click"
                        Tag="http://localhost:5173">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource GreenBrush}"/>
                </Button>

                <!-- Separator -->
                <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="8,6"/>

                <!-- Git #821 - Shane: opens the Replit workspace dashboard; that tab gets a Play/Pause "keep alive" toggle (see OpenWebTab). -->
                <Button Style="{StaticResource IconButton}"
                        Width="48" Height="44"
                        ToolTip="Replit Workspace"
                        Click="QuickNav_Click"
                        Tag="https://replit.com/@shanemccaw/Shane-McCaw-Consulting">
                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PeachBrush}"/>
                </Button>

                <!-- Separator -->
                <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="8,6"/>

                <!-- Git #864 - Shane: "a icon based popout panel with web site tools like:
                     LinkedIn, Google Analytics, Microsoft Clarity... a configuration in the
                     settings might actually be better." ONE icon (not another hardcoded
                     QuickNav button per tool) that opens a small anchored Popup listing
                     whatever's configured in Settings > Web Tools. -->
                <Button x:Name="BtnWebTools"
                        Style="{StaticResource IconButton}"
                        Width="48" Height="44"
                        ToolTip="Web Tools"
                        Click="BtnWebTools_Click">
                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BlueBrush}"/>
                </Button>

                <Popup x:Name="WebToolsPopup"
                       PlacementTarget="{Binding ElementName=BtnWebTools}"
                       Placement="Right"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{StaticResource MantleBrush}"
                            BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4"
                            MinWidth="180">
                        <StackPanel x:Name="WebToolsList"/>
                    </Border>
                </Popup>

                <!-- Separator -->
                <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="8,6"/>

                <!-- Git #937 — Shane: "a floaty sticky notes." Toggles the
                     always-on-top Sticky Notes window open/closed. A plain
                     Button (not a workspace RadioButton) since it opens a
                     separate top-level window, not a LeftSidebar view. -->
                <Button x:Name="BtnStickyNotes"
                        Style="{StaticResource IconButton}"
                        Width="48" Height="44"
                        ToolTip="Sticky Notes (always-on-top floaty)"
                        Click="BtnStickyNotes_Click">
                    <TextBlock Text="&#x1F5D2;" FontSize="16"/>
                </Button>

                <!-- Git #973 — Shane: "pre-fill and then I'd press the actual
                     schedule button." Toggles the always-on-top LinkedIn post
                     composer floaty; Send pre-fills LinkedIn's real compose box
                     (Shane presses Schedule/Post himself). Same plain-Button
                     shape as Sticky Notes above (a separate top-level window,
                     not a LeftSidebar view). -->
                <Button x:Name="BtnLinkedInComposer"
                        Style="{StaticResource IconButton}"
                        Width="48" Height="44"
                        ToolTip="LinkedIn Post pre-fill (always-on-top floaty)"
                        Click="BtnLinkedInComposer_Click">
                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource BlueBrush}"/>
                </Button>

                <!-- Git #980 — Shane: "a floaty panel so I can put it off to
                     another monitor and watch as it progresses." Toggles the
                     independent 8-slot Build Watch window (a separate top-level
                     window, so a plain Button like the two floaties above, not a
                     LeftSidebar workspace RadioButton). -->
                <Button x:Name="BtnBuildWatch"
                        Style="{StaticResource IconButton}"
                        Width="48" Height="44"
                        ToolTip="Build Watch — 8-slot live build monitor (floaty)"
                        Click="BtnBuildWatch_Click">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource GreenBrush}"/>
                </Button>

                <!-- Git #2110 — Dynamic Build Queue Map (Phase 2): a floaty, live-updating
                     visual map of the whole build queue — every item a node, blocker
                     relationships as connector lines, deadlock loops flagged unmissably,
                     errors distinct, real age per item. Separate top-level window (a
                     movable "watch on another monitor" panel, same shape as Build Watch
                     above), so a plain Button raising a toggle event, not a workspace
                     RadioButton. -->
                <Button x:Name="BtnBuildQueueMap"
                        Style="{StaticResource IconButton}"
                        Width="48" Height="44"
                        ToolTip="Build Queue Map — live visual map of the queue: blockers, deadlocks, errors, age (floaty)"
                        Click="BtnBuildQueueMap_Click">
                    <TextBlock Text="&#x1F5FA;" FontSize="16"/>
                </Button>

                <!-- Git #1472 — Shane: per-page checkbox + notes + fast WebView2 screenshots
                     with history, for testing pages in the WebView2 tab. A NEW standalone
                     floaty, separate from Sticky Notes above. -->
                <Button x:Name="BtnVisualTestTracker"
                        Style="{StaticResource IconButton}"
                        Width="48" Height="44"
                        ToolTip="Visual Test Tracker — per-page checkbox/notes + screenshot history (floaty)"
                        Click="BtnVisualTestTracker_Click">
                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource BlueBrush}"/>
                </Button>

                <!-- Separator -->
                <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="8,6"/>

                <!-- Shelf — Shane: right-click any editor tab → "Shelve Tab" to set it
                     aside without killing it. The tab leaves the tab bar but its real
                     content keeps running genuinely alive off-screen (a DIRECT reuse of
                     the #972/#982 PinnedHostCanvas + ParkOffscreen keep-alive, generalized
                     to ANY tab — see MainWindow.ShelvedTabs.cs). This ONE icon opens an
                     anchored popout listing everything currently shelved (real icon +
                     title per item), each entry one click away from restoring as a live
                     tab. MainWindow owns the shelved-tab state and hands us the rows to
                     host — same owner/host split as the Web Tools popout above. The badge
                     shows how many tabs are parked so they're never invisibly lost. -->
                <Button x:Name="BtnShelf"
                        Style="{StaticResource IconButton}"
                        Width="48" Height="44"
                        ToolTip="Shelf — tabs set aside &amp; kept alive in the background (right-click a tab → Shelve Tab)"
                        Click="BtnShelf_Click">
                    <Grid Width="24" Height="24">
                        <TextBlock Text="&#x1F5C3;" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="ShelfCountBadge" Visibility="Collapsed"
                                Background="{StaticResource RedBrush}" CornerRadius="7"
                                MinWidth="14" Height="14" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0">
                            <TextBlock x:Name="ShelfCountText" Text="0" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource CrustBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>

                <Popup x:Name="ShelfPopup"
                       PlacementTarget="{Binding ElementName=BtnShelf}"
                       Placement="Right"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{StaticResource MantleBrush}"
                            BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4"
                            MinWidth="220" MaxWidth="340">
                        <StackPanel>
                            <TextBlock Text="🗃 SHELF" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Subtext0Brush}"
                                       Margin="8,6,8,6"/>
                            <StackPanel x:Name="ShelfList"/>
                        </StackPanel>
                    </Border>
                </Popup>

            </StackPanel>

            <!-- ── Bottom icon: Settings ── -->
            <StackPanel DockPanel.Dock="Bottom">
                <RadioButton x:Name="BtnSettings"
                             GroupName="ActivityBar"
                             Style="{StaticResource ActivityBarButton}"
                             Checked="Btn_Checked" Tag="Settings"
                             ToolTip="Settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                </RadioButton>
            </StackPanel>

        </DockPanel>
    </Border>
</UserControl>

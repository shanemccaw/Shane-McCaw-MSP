<UserControl x:Class="BuildConsole.Controls.GitBoardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="360"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Hover row style -->
        <Style x:Key="InteractiveRowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Status Pill Style Helper -->
        <Style x:Key="StatusPillBase" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True" Margin="8,6">
        
        <!-- ══════════════════════════════════════════════════════════════
             TOP HEADER SECTION
             ══════════════════════════════════════════════════════════════ -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            
            <!-- 1. Search Bar -->
            <Grid Margin="0,0,0,8">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource SearchTextBox}"
                         Height="28" Padding="26,4,24,4" FontSize="11.5"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource Surface0Brush}"
                         BorderBrush="{StaticResource Surface1Brush}"
                         BorderThickness="1"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- Search Icon -->
                <TextBlock Text="🔍" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           IsHitTestVisible="False" Foreground="{StaticResource TextDisabledBrush}"/>
                <!-- Watermark -->
                <TextBlock IsHitTestVisible="False"
                           Text="Search issues, features, epics"
                           FontSize="11.5" Margin="28,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Foreground="{StaticResource TextDisabledBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- 2. Working Banner -->
            <Border x:Name="WorkingBannerCard"
                    Background="#1A2D23"
                    BorderBrush="{StaticResource StatusRunningBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8,6"
                    Margin="0,0,0,8"
                    Cursor="Hand"
                    Visibility="Visible"
                    MouseLeftButtonUp="WorkingBannerCard_MouseLeftButtonUp"
                    ToolTip="Click to locate and expand the active working epic">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="◎" FontSize="13" Foreground="#FAB387" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding WorkingBanner.DisplayText, FallbackValue='WORKING: #1202 — Epic: Build Console'}"
                               FontWeight="Bold" FontSize="11"
                               Foreground="{StaticResource StatusRunningBrush}"
                               TextWrapping="Wrap" TextTrimming="None"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               Margin="4,0,8,0"/>

                    <Border Grid.Column="2"
                            Background="{StaticResource StatusRunningBrush}"
                            CornerRadius="3" Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="LOCATE ➔"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource CrustBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Milestone Summary -->
            <Border Background="{StaticResource Surface0Brush}"
                    CornerRadius="5"
                    Padding="8,6"
                    Margin="0,0,0,8"
                    BorderBrush="{StaticResource BorderDividerBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="⚯" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
                            <TextBlock Text="{Binding MilestoneSummary.Title, FallbackValue='v1.1 · Monitoring &amp; Launch'}"
                                       FontWeight="Bold" FontSize="11.5"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" TextTrimming="None"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="●" FontSize="9" Foreground="{StaticResource StatusSuccessBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MilestoneSummary.ProgressDisplay, FallbackValue='60% (96/158)'}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource BlueBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Milestone Progress Bar -->
                    <ProgressBar Value="{Binding MilestoneSummary.ProgressPercent, FallbackValue=60}"
                                 Maximum="100" Height="4" Margin="0,6,0,2"
                                 Foreground="{StaticResource StatusSuccessBrush}"
                                 Background="{StaticResource Surface1Brush}"/>
                </StackPanel>
            </Border>

            <!-- 4. Gate Banner -->
            <Border x:Name="GateBannerCard"
                    Background="#1F1A2E"
                    BorderBrush="{StaticResource MauveBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,7"
                    Margin="0,0,0,8"
                    Cursor="Hand"
                    MouseLeftButtonUp="GateBannerCard_MouseLeftButtonUp"
                    ToolTip="Release gate blocker. Click to open issue detail">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🛡" FontSize="14" Foreground="{StaticResource MauveBrush}" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="6,0,8,0">
                        <TextBlock Text="{Binding GateBanner.HeaderText, FallbackValue='GATE · BLOCKS RELEASE'}"
                                   FontSize="9" FontWeight="Bold" Foreground="{StaticResource MauveBrush}"/>
                        <TextBlock Text="{Binding GateBanner.SubtitleText, FallbackValue='Validating Prerequisites'}"
                                   FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" TextTrimming="None"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding GateBanner.FractionText, FallbackValue='7/8'}"
                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauveBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 5. Epics Section Header Toggle -->
            <Border Style="{StaticResource InteractiveRowBorder}" MouseLeftButtonUp="EpicsSectionHeader_Click" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IsEpicsExpanded, Converter={StaticResource BoolToVis}}" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtEpicsChevron" Text="▾" FontSize="11" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="⚡" FontSize="11" Margin="0,0,4,0" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Epics" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalEpicsCount, StringFormat=' ({0})'}" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════════════════
             MIDDLE SECTION: SCROLLABLE, VIRTUALIZED EPICS LIST
             ══════════════════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <ItemsControl ItemsSource="{Binding FilteredEpics}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- ── EPIC CARD CONTAINER ── -->
                        <Border Background="Transparent"
                                BorderBrush="{StaticResource BorderDividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,3,0,4"
                                Margin="0,0,0,2">
                            <StackPanel>
                                
                                <!-- Epic Header Row -->
                                <Border Style="{StaticResource InteractiveRowBorder}" MouseLeftButtonUp="EpicRow_Click">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>  <!-- Chevron -->
                                            <ColumnDefinition Width="16"/>  <!-- Icon -->
                                            <ColumnDefinition Width="*"/>   <!-- Title & Number -->
                                            <ColumnDefinition Width="Auto"/> <!-- Progress Badge -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Chevron -->
                                        <TextBlock Grid.Column="0" Text="{Binding ChevronIcon}"
                                                   FontSize="10" Foreground="{StaticResource TextDisabledBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Lightning Icon -->
                                        <TextBlock Grid.Column="1" Text="⚡"
                                                   FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Number + Title (Wrapped naturally, no truncation) -->
                                        <TextBlock Grid.Column="2" Margin="4,0,6,0" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" TextTrimming="None" HorizontalAlignment="Stretch">
                                            <Run Text="{Binding NumberDisplay}" FontWeight="Bold" Foreground="#FAB387"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        </TextBlock>

                                        <!-- Progress Pill -->
                                        <Border Grid.Column="3" Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Nested Features List (Visible when Epic is Expanded) -->
                                <ItemsControl ItemsSource="{Binding FilteredFeatures}"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                              Margin="14,2,0,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,1,0,2">
                                                
                                                <!-- Feature Row -->
                                                <Border Style="{StaticResource InteractiveRowBorder}" MouseLeftButtonUp="FeatureRow_Click">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="12"/> <!-- Chevron if has issues -->
                                                            <ColumnDefinition Width="16"/> <!-- Cube icon -->
                                                            <ColumnDefinition Width="*"/>  <!-- Title -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Badges -->
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding ChevronIcon}"
                                                                   Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}"
                                                                   FontSize="9" Foreground="{StaticResource TextDisabledBrush}"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="1" Text="⬡" FontSize="11" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>

                                                        <!-- Feature Title (Wrapped naturally, no truncation) -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                                   FontSize="11" Foreground="{StaticResource TextBrush}"
                                                                   TextWrapping="Wrap" TextTrimming="None"
                                                                   HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                                   Margin="4,0,4,0"/>

                                                        <!-- Progress & Status Pills -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Blocker count (e.g. 1b) -->
                                                            <TextBlock Text="{Binding BlockerBadge}"
                                                                       Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVis}}"
                                                                       FontWeight="Bold" FontSize="10" Foreground="#F38BA8"
                                                                       Margin="0,0,4,0" VerticalAlignment="Center"/>

                                                            <!-- Progress text (e.g. 89% (8/9)) -->
                                                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProgressText}" FontSize="9.5" Foreground="{StaticResource Subtext0Brush}"/>
                                                            </Border>

                                                            <!-- Status Pill (ACTIVE, FOCUS, UNASSIGNED) -->
                                                            <Border x:Name="PillBorder" Margin="4,0,2,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusPillBase}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="ACTIVE">
                                                                                <Setter Property="Background" Value="#1A2D23"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="FOCUS">
                                                                                <Setter Property="Background" Value="#33CBA6F7"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource MauveBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="UNASSIGNED">
                                                                                <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource Surface2Brush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="ACTIVE">
                                                                                    <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="FOCUS">
                                                                                    <Setter Property="Foreground" Value="{StaticResource MauveBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="UNASSIGNED">
                                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <!-- Count badge (e.g. 1, 3) -->
                                                            <TextBlock Text="{Binding Count}" FontSize="10" Foreground="{StaticResource TextDisabledBrush}"
                                                                       VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Nested Issues List (Visible when Feature is Expanded) -->
                                                <ItemsControl ItemsSource="{Binding FilteredIssues}"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                              Margin="22,2,0,2">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource InteractiveRowBorder}" MouseLeftButtonUp="IssueRow_Click" Margin="0,1">
                                                                <Grid HorizontalAlignment="Stretch">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="14"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Status Dot -->
                                                                    <TextBlock Grid.Column="0" Text="●" FontSize="9"
                                                                               Foreground="{Binding StatusDotColor}"
                                                                               VerticalAlignment="Top" Margin="0,2,0,0"/>

                                                                    <!-- Issue Text (Wrapped naturally, no truncation) -->
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding DisplayText}"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               TextWrapping="Wrap" TextTrimming="None"
                                                                               HorizontalAlignment="Stretch"
                                                                               Margin="2,0,0,0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

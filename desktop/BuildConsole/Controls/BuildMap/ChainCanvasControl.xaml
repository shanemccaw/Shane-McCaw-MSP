<UserControl x:Class="BuildConsole.Controls.BuildMap.ChainCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">

    <!--
        Git #2477 — Build Chain Map canvas: auto-layout stage + node rendering, recreated from
        BuildMap/README.md ("Canvas geometry", "Nodes") and `Build Chain Map.dc.html`. All geometry
        comes from Services/BuildMap/ChainLayout.cs — no positioning math lives in this control.

        Layer order inside the stage (bottom → top): epic-tree rail, EdgeLayerHost (empty here —
        Git #2478's blocked_by edge layer draws into it, under the nodes, exactly like the
        prototype's SVG layer), then the node layer (epic card, feature headers, issue rows,
        sentinel cards, gate pills).

        Zoom (0.35–1.6) is a uniform LayoutTransform scale on the stage with origin 0,0 — WPF's
        LayoutTransform sizes the scroll extent to W·z × H·z automatically, matching the
        prototype's `transform: scale(z)` + explicitly sized scroll container.
    -->

    <ScrollViewer x:Name="Scroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
        <ScrollViewer.Background>
            <!-- Canvas #0a0d12 with the 22px dot grid: radial-gradient(#141a22 1px, transparent 1px) -->
            <DrawingBrush TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#0a0d12">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,22,22"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#141a22">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ScrollViewer.Background>

        <Canvas x:Name="Stage" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent">
            <Canvas.LayoutTransform>
                <ScaleTransform x:Name="StageScale" ScaleX="1" ScaleY="1"/>
            </Canvas.LayoutTransform>

            <Canvas x:Name="RailLayer" Canvas.Left="0" Canvas.Top="0"/>
            <Canvas x:Name="EdgeLayerHost" Canvas.Left="0" Canvas.Top="0"/>
            <Canvas x:Name="NodeLayer" Canvas.Left="0" Canvas.Top="0"/>
        </Canvas>
    </ScrollViewer>
</UserControl>

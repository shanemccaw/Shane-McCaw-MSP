<UserControl x:Class="BuildConsole.Controls.StartupLoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CrustBrush}">

    <!-- Shane: "maybe the home screen is a really pretty animated loading thing…
         like Donald Duck running across the screen until the connections to all
         the apis are made." No licensed characters available, so this is an
         ORIGINAL plucky egg-shaped runner ("Sprocket") sprinting in place while
         the world scrolls past under it — the classic side-scroller "hero runs,
         world moves" read of running-across-the-screen — with legs pumping, a
         bob, speed lines and dust puffs. Below it: the honest, real per-connection
         progress list this whole screen is actually waiting on. -->

    <UserControl.Resources>
        <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0.4,1">
            <GradientStop Color="#F9E2AF" Offset="0"/>
            <GradientStop Color="#FAB387" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#89B4FA" Offset="0"/>
            <GradientStop Color="#CBA6F7" Offset="1"/>
        </LinearGradientBrush>

        <!-- Character bob + gentle forward lean/sway -->
        <Storyboard x:Key="BobStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CharBob" Storyboard.TargetProperty="Y"
                             From="0" To="-14" Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CharSway" Storyboard.TargetProperty="X"
                             From="-8" To="8" Duration="0:0:0.76">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CharLean" Storyboard.TargetProperty="Angle"
                             From="-3" To="5" Duration="0:0:0.76">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Legs pump in opposite phase -->
        <Storyboard x:Key="LegStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="FrontLegRotate" Storyboard.TargetProperty="Angle"
                             From="-36" To="32" Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BackLegRotate" Storyboard.TargetProperty="Angle"
                             From="32" To="-36" Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Little wing flap -->
        <Storyboard x:Key="WingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="WingRotate" Storyboard.TargetProperty="Angle"
                             From="10" To="-24" Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Scrolling ground dashes: one pitch (72px) of leftward travel, looped -->
        <Storyboard x:Key="GroundStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="GroundScroll" Storyboard.TargetProperty="X"
                             From="0" To="-72" Duration="0:0:0.38"/>
        </Storyboard>

        <!-- Speed lines whooshing past behind the runner -->
        <Storyboard x:Key="SpeedStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Speed1T" Storyboard.TargetProperty="X" From="560" To="-160" Duration="0:0:0.75"/>
            <DoubleAnimation Storyboard.TargetName="Speed1" Storyboard.TargetProperty="(UIElement.Opacity)" From="0" To="0.8" Duration="0:0:0.38" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Speed2T" Storyboard.TargetProperty="X" From="560" To="-160" Duration="0:0:0.95" BeginTime="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="Speed2" Storyboard.TargetProperty="(UIElement.Opacity)" From="0" To="0.6" Duration="0:0:0.48" BeginTime="0:0:0.2" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Speed3T" Storyboard.TargetProperty="X" From="560" To="-160" Duration="0:0:0.85" BeginTime="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="Speed3" Storyboard.TargetProperty="(UIElement.Opacity)" From="0" To="0.5" Duration="0:0:0.42" BeginTime="0:0:0.4" AutoReverse="True"/>
        </Storyboard>

        <!-- Dust puffs kicked up at the feet -->
        <Storyboard x:Key="DustStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="DustScale" Storyboard.TargetProperty="ScaleX" From="0.2" To="1.5" Duration="0:0:0.55"/>
            <DoubleAnimation Storyboard.TargetName="DustScale" Storyboard.TargetProperty="ScaleY" From="0.2" To="1.5" Duration="0:0:0.55"/>
            <DoubleAnimation Storyboard.TargetName="DustPuff" Storyboard.TargetProperty="(UIElement.Opacity)" From="0.6" To="0" Duration="0:0:0.55"/>
            <DoubleAnimation Storyboard.TargetName="DustTranslate" Storyboard.TargetProperty="X" From="0" To="-48" Duration="0:0:0.55"/>
        </Storyboard>

        <!-- Floating ambient stars -->
        <Storyboard x:Key="StarStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Star1T" Storyboard.TargetProperty="X" From="560" To="-60" Duration="0:0:3.2"/>
            <DoubleAnimation Storyboard.TargetName="Star2T" Storyboard.TargetProperty="X" From="560" To="-60" Duration="0:0:2.6" BeginTime="0:0:1.0"/>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource BobStoryboard}"/>
            <BeginStoryboard Storyboard="{StaticResource LegStoryboard}"/>
            <BeginStoryboard Storyboard="{StaticResource WingStoryboard}"/>
            <BeginStoryboard Storyboard="{StaticResource GroundStoryboard}"/>
            <BeginStoryboard Storyboard="{StaticResource SpeedStoryboard}"/>
            <BeginStoryboard Storyboard="{StaticResource DustStoryboard}"/>
            <BeginStoryboard Storyboard="{StaticResource StarStoryboard}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.ClearTypeHint="Enabled">
        <!-- Soft radial-ish vignette backdrop -->
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.38" Center="0.5,0.38" RadiusX="0.8" RadiusY="0.95">
                <GradientStop Color="{DynamicResource CardBackgroundColor}" Offset="0"/>
                <GradientStop Color="{DynamicResource AppBackgroundColor}" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="580">

            <!-- Wordmark + Badge -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                <TextBlock Text="BuildConsole"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
                <Border Background="{DynamicResource Surface0Brush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                </Border>
            </StackPanel>
            
            <TextBlock x:Name="PhraseText" Text="Warming up the flux capacitor…"
                       FontSize="13" Foreground="{StaticResource Subtext1Brush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>

            <!-- ── The runner stage ──────────────────────────────────────── -->
            <Canvas x:Name="Stage" Width="560" Height="170" Margin="0,12,0,8" ClipToBounds="True">

                <!-- Speed lines (behind everything) -->
                <Rectangle x:Name="Speed1" Canvas.Top="55" Width="130" Height="3" RadiusX="1.5" RadiusY="1.5"
                           Fill="{StaticResource Surface2Brush}" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="Speed1T" X="560"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="Speed2" Canvas.Top="85" Width="100" Height="2" RadiusX="1" RadiusY="1"
                           Fill="{StaticResource Surface1Brush}" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="Speed2T" X="560"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="Speed3" Canvas.Top="115" Width="150" Height="3" RadiusX="1.5" RadiusY="1.5"
                           Fill="{StaticResource Surface2Brush}" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="Speed3T" X="560"/></Rectangle.RenderTransform>
                </Rectangle>

                <!-- Floating ambient sparkles -->
                <TextBlock x:Name="Star1" Text="✨" FontSize="12" Canvas.Top="25" Opacity="0.6">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="Star1T" X="560"/></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="Star2" Text="⚡" FontSize="11" Canvas.Top="70" Opacity="0.5">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="Star2T" X="560"/></TextBlock.RenderTransform>
                </TextBlock>

                <!-- Ground line + scrolling dashes -->
                <Line X1="0" Y1="148" X2="560" Y2="148" Stroke="{StaticResource Surface1Brush}" StrokeThickness="2"/>
                <Canvas Canvas.Top="154">
                    <Canvas.RenderTransform><TranslateTransform x:Name="GroundScroll" X="0"/></Canvas.RenderTransform>
                    <!-- tiled dashes: pitch 72, drawn well past the 560 width so the -72 loop is seamless -->
                    <Rectangle Canvas.Left="0"   Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Surface1Brush}"/>
                    <Rectangle Canvas.Left="72"  Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Surface1Brush}"/>
                    <Rectangle Canvas.Left="144" Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Surface1Brush}"/>
                    <Rectangle Canvas.Left="216" Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Surface1Brush}"/>
                    <Rectangle Canvas.Left="288" Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Surface1Brush}"/>
                    <Rectangle Canvas.Left="360" Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Surface1Brush}"/>
                    <Rectangle Canvas.Left="432" Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Surface1Brush}"/>
                    <Rectangle Canvas.Left="504" Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Surface1Brush}"/>
                    <Rectangle Canvas.Left="576" Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource Surface1Brush}"/>
                </Canvas>

                <!-- Dust puff at the feet -->
                <Ellipse x:Name="DustPuff" Canvas.Left="238" Canvas.Top="130" Width="26" Height="16"
                         Fill="{StaticResource Surface2Brush}" Opacity="0">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="DustScale" ScaleX="0.2" ScaleY="0.2" CenterX="13" CenterY="8"/>
                            <TranslateTransform x:Name="DustTranslate" X="0"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- ── Sprocket, the runner ── centered around x≈280, feet at y≈148 -->
                <Canvas x:Name="Character" Canvas.Left="248" Canvas.Top="36">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="CharLean" Angle="0" CenterX="32" CenterY="60"/>
                            <TranslateTransform x:Name="CharBob" Y="0"/>
                            <TranslateTransform x:Name="CharSway" X="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- Back leg (behind body) -->
                    <Rectangle Canvas.Left="26" Canvas.Top="74" Width="9" Height="34" RadiusX="4.5" RadiusY="4.5"
                               Fill="#E8A33C">
                        <Rectangle.RenderTransform><RotateTransform x:Name="BackLegRotate" Angle="20" CenterX="4.5" CenterY="2"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Back foot -->
                    <Ellipse Canvas.Left="18" Canvas.Top="104" Width="22" Height="9" Fill="#FAB387">
                        <Ellipse.RenderTransform><RotateTransform Angle="20" CenterX="-8" CenterY="-30"/></Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Body -->
                    <Ellipse Canvas.Left="6" Canvas.Top="20" Width="66" Height="80" Fill="{StaticResource BodyBrush}"
                             Stroke="#E8A33C" StrokeThickness="1.5"/>
                    <!-- Belly highlight -->
                    <Ellipse Canvas.Left="18" Canvas.Top="46" Width="34" Height="46" Fill="#FDF3D0" Opacity="0.65"/>

                    <!-- Wing -->
                    <Path Fill="#F2C766" Data="M 44,44 C 66,40 74,58 60,74 C 52,66 46,56 44,44 Z">
                        <Path.RenderTransform><RotateTransform x:Name="WingRotate" Angle="0" CenterX="46" CenterY="46"/></Path.RenderTransform>
                    </Path>

                    <!-- Head tuft (duck-ish, original) -->
                    <Path Fill="#F2C766" Data="M 40,14 C 44,4 54,6 52,16 C 60,10 66,18 58,24 C 52,18 46,20 40,14 Z"/>

                    <!-- Eye -->
                    <Ellipse Canvas.Left="46" Canvas.Top="30" Width="16" Height="16" Fill="White"/>
                    <Ellipse Canvas.Left="52" Canvas.Top="34" Width="7" Height="8" Fill="#11111B"/>
                    <Ellipse Canvas.Left="53.5" Canvas.Top="35" Width="2.5" Height="2.5" Fill="White"/>

                    <!-- Beak -->
                    <Polygon Points="60,42 84,46 60,52" Fill="#FF9E3D" Stroke="#E8822A" StrokeThickness="0.75"/>

                    <!-- Rosy cheek -->
                    <Ellipse Canvas.Left="44" Canvas.Top="44" Width="10" Height="6" Fill="#F38BA8" Opacity="0.5"/>

                    <!-- Front leg (in front of body) -->
                    <Rectangle Canvas.Left="40" Canvas.Top="74" Width="9" Height="34" RadiusX="4.5" RadiusY="4.5"
                               Fill="#F2B24A">
                        <Rectangle.RenderTransform><RotateTransform x:Name="FrontLegRotate" Angle="-20" CenterX="4.5" CenterY="2"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Front foot -->
                    <Ellipse Canvas.Left="44" Canvas.Top="104" Width="22" Height="9" Fill="#FF9E3D">
                        <Ellipse.RenderTransform><RotateTransform Angle="-20" CenterX="0" CenterY="-30"/></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Canvas>

            <!-- ── Honest per-connection progress ────────────────────────── -->
            <Border Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1"
                    CornerRadius="10" Padding="18,12" Width="490" HorizontalAlignment="Center">
                <StackPanel>
                    <!-- Header with count & progress bar -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Initializing Subsystems"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext0Brush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProgressCounterText"
                                   Text="0 ready"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BlueBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Progress bar -->
                    <Border Height="4" Background="{StaticResource Surface0Brush}" CornerRadius="2" Margin="0,0,0,10" ClipToBounds="True">
                        <Border x:Name="ProgressBarFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="{StaticResource BlueBrush}"
                                CornerRadius="2"/>
                    </Border>

                    <StackPanel x:Name="ConnectionList"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

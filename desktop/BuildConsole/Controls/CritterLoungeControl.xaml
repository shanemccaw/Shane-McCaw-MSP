<UserControl x:Class="BuildConsole.Controls.CritterLoungeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="172"
             Cursor="Hand"
             MouseLeftButtonDown="Lounge_MouseLeftButtonDown"
             ToolTip="Critter Lounge Theater — click to interact with the critters or change scenes! 🎭">
    <UserControl.Resources>
        <!-- Theatrical Crimson Velvet Gradient for Curtains -->
        <LinearGradientBrush x:Key="CurtainVelvetBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#5A0E1A" Offset="0.0"/>
            <GradientStop Color="#8B1E2D" Offset="0.2"/>
            <GradientStop Color="#B91C1C" Offset="0.5"/>
            <GradientStop Color="#7F1D1D" Offset="0.8"/>
            <GradientStop Color="#450A0A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Gold Tassel Brush -->
        <LinearGradientBrush x:Key="GoldFringeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FDE047" Offset="0.0"/>
            <GradientStop Color="#CA8A04" Offset="1.0"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0"
            ClipToBounds="True">
        <Grid x:Name="StageRoot">
            <!-- ── SCENE BACKGROUND CANVAS ── -->
            <Canvas x:Name="BackgroundCanvas" IsHitTestVisible="False"/>

            <!-- ── ACTIVE STAGE CRITTERS & PROPS CANVAS ── -->
            <Canvas x:Name="LoungeCanvas" ClipToBounds="True"/>

            <!-- ── FOREGROUND FX CANVAS (Fireworks, Sparks, Confetti, Speed Lines) ── -->
            <Canvas x:Name="FxCanvas" IsHitTestVisible="False"/>

            <!-- ── TOP THEATRICAL VALANCE SWAG ── -->
            <Border VerticalAlignment="Top" Height="14" IsHitTestVisible="False">
                <Grid>
                    <Path Data="M 0,0 L 800,0 L 800,10 C 600,14 400,6 200,14 C 100,10 0,12 0,10 Z"
                          Fill="{StaticResource CurtainVelvetBrush}"/>
                    <!-- Gold trim line on valance -->
                    <Path Data="M 0,10 C 100,12 200,14 400,6 C 600,14 800,10 800,10"
                          Stroke="{StaticResource GoldFringeBrush}"
                          StrokeThickness="1.5"/>
                </Grid>
            </Border>

            <!-- ── THEATER CURTAINS (FOR SCENE TRANSITIONS) ── -->
            <Grid x:Name="CurtainContainer" IsHitTestVisible="False" Panel.ZIndex="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Curtain Panel -->
                <Border x:Name="LeftCurtain" Grid.Column="0"
                        HorizontalAlignment="Left"
                        Width="0"
                        Background="{StaticResource CurtainVelvetBrush}"
                        BorderBrush="#CA8A04"
                        BorderThickness="0,0,2,0">
                    <!-- Pleat shadow effect -->
                    <Border Background="#20000000" HorizontalAlignment="Right" Width="8"/>
                </Border>

                <!-- Right Curtain Panel -->
                <Border x:Name="RightCurtain" Grid.Column="1"
                        HorizontalAlignment="Right"
                        Width="0"
                        Background="{StaticResource CurtainVelvetBrush}"
                        BorderBrush="#CA8A04"
                        BorderThickness="2,0,0,0">
                    <!-- Pleat shadow effect -->
                    <Border Background="#20000000" HorizontalAlignment="Left" Width="8"/>
                </Border>
            </Grid>

            <!-- ── HEADER CONTROLS & SCENE BADGE ── -->
            <DockPanel VerticalAlignment="Top" Margin="8,6,8,0" Panel.ZIndex="200">
                <!-- Scene Badge -->
                <Border x:Name="SceneBadge"
                        Background="{DynamicResource BaseBrush}"
                        BorderBrush="{StaticResource BlueBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="7,2"
                        Opacity="0.92"
                        Cursor="Hand"
                        MouseLeftButtonUp="SceneBadge_Click"
                        ToolTip="Click to switch to the next scene! 🎭">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SceneIcon" Text="🏖️ " FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SceneTitleText" Text="SUNNY BEACH LOUNGE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SceneSubText" Text=" · chilling 🍹" FontSize="9" Foreground="{StaticResource PeachBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons: Next Scene & Cheer -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="BtnNextScene"
                            Style="{StaticResource IconButton}"
                            ToolTip="Next Scene 🎬"
                            Padding="5,2"
                            Margin="0,0,4,0"
                            Click="BtnNextScene_Click">
                        <TextBlock Text="🎬" FontSize="11"/>
                    </Button>

                    <Button x:Name="BtnCheer"
                            Style="{StaticResource IconButton}"
                            ToolTip="Cheer &amp; Action! ✨"
                            Padding="5,2"
                            Click="BtnCheer_Click">
                        <TextBlock x:Name="CheerBtnIcon" Text="🎉" FontSize="11"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="BuildConsole.Controls.DispatchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BuildConsole.Controls"
             MinWidth="220">

    <!--
        Git #1779 — a third, explicit entry point into the SAME launch pipeline #1709's Batter
        Up panel and #1710's AI Batter Up panel already feed: type an issue number, hit
        Dispatch, and it fetches that one real issue DIRECTLY (bypassing the "Batter Up" board
        status gate entirely, by design — typing a number and hitting the button IS the
        explicit approval). Reuses BatterUpQueueService.FindBuildCommentAsync for the BUILD:
        comment parse and BuildQueuePostgresClient.QueueBuildAsync for the actual queue insert —
        no second parser, no second launch mechanism. Never touches BatterUpPanel,
        AiBatterUpPanel, or BuildQueuePanel's own Queue/Send to Builder/Cancel actions.
    -->
    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="0,0,0,1">
        <StackPanel Margin="10,8,10,8">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="🎯 Dispatch" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCountdown" FontSize="11.5" Margin="8,0,0,0"
                           Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="#" FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource Subtext0Brush}" Margin="0,0,2,0"/>

                <TextBox x:Name="TxtIssueNumber" Grid.Column="1" Margin="0,0,6,0"
                         VerticalContentAlignment="Center" FontSize="12"
                         Background="{StaticResource Surface0Brush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource Surface1Brush}"
                         ToolTip="Issue number — fetched and queued directly, regardless of board status"
                         KeyDown="TxtIssueNumber_KeyDown"/>

                <Button x:Name="BtnDispatch" Grid.Column="2" Content="Dispatch" Padding="10,4"
                        Click="BtnDispatch_Click"/>
            </Grid>

            <TextBlock x:Name="TxtStatus" Margin="0,6,0,0" FontSize="11.5"
                       TextWrapping="Wrap" Text=""
                       Foreground="{StaticResource Subtext0Brush}"
                       Visibility="Collapsed"/>

            <!--
                Git #1966 — the dedup guard's dead end: an inline override alongside the
                existing "already tracked" status message, not a replacement for it. Never
                duplicates the tracked row; ForceDispatchAsync supersedes it first.
            -->
            <Button x:Name="BtnForceDispatch" Content="Dispatch anyway" Padding="10,4"
                    Margin="0,6,0,0" HorizontalAlignment="Left" FontSize="11.5"
                    Background="{StaticResource Surface0Brush}"
                    Foreground="{StaticResource PeachBrush}"
                    BorderBrush="{StaticResource PeachBrush}"
                    ToolTip="Supersede the tracked row and queue a fresh dispatch"
                    Visibility="Collapsed"
                    Click="BtnForceDispatch_Click"/>

        </StackPanel>
    </Border>
</UserControl>

<UserControl x:Class="BuildConsole.Controls.NotificationTrayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Git #3879 — the real Notification Tray "single box" (Sims-style): a Popup-hostable
         UserControl, same real content-only shape as WebToolsList/ShelfList in ActivityBar.xaml
         (the sibling issue #3880 hosts this inside its own bell-icon Popup, same convention as
         BtnWebTools/BtnShelf — this control doesn't own the Popup or the icon that opens it). -->
    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="4"
            MinWidth="300" MaxWidth="360">
        <StackPanel>

            <!-- Header: title + Clear All -->
            <Grid Margin="8,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="NOTIFICATIONS" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource Subtext0Brush}"
                           VerticalAlignment="Center"/>

                <Button x:Name="BtnClearAll" Grid.Column="1"
                        Content="Clear All"
                        Style="{StaticResource IconButton}"
                        FontSize="10"
                        Padding="6,3"
                        ToolTip="Clear every non-bookmarked notification — bookmarked entries stay"
                        Click="BtnClearAll_Click"/>
            </Grid>

            <Border Height="1" Background="{StaticResource Surface0Brush}" Margin="8,0,8,4"/>

            <!-- Real history list — populated in code-behind from NotificationHistoryStore.All,
                 newest first. Capped height with a scrollbar so a long history doesn't push the
                 popout off-screen. -->
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="HistoryList"/>
            </ScrollViewer>

        </StackPanel>
    </Border>
</UserControl>

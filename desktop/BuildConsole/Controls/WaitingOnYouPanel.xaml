<UserControl x:Class="BuildConsole.Controls.WaitingOnYouPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BuildConsole.Controls"
             MinWidth="320">

    <!--
        Git #4202 — Shane: "How do I track this. How do I know what's waiting for me... Maybe
        it's not a chat thing. It's a missing view I need." A real, persistent, always-current
        read of every open issue genuinely blocked on Shane himself, repo-wide (never scoped to
        one Epic) — replacing the one-off manual chat sweep that prompted this issue. Two clearly
        separated real sections (never merged into one list, per the issue's own ask): "Needs your
        action" (the real `Shane To-Do` label) and "Needs your decision" (the real "Ask Shane"
        board column) — genuinely different asks, do something vs. decide something. Same
        plain-document, read-only style as WhatsRemainingPanel (#4149): a document, not a
        card-shell UI like the queue panels.
    -->
    <DockPanel Background="{StaticResource MantleBrush}" LastChildFill="True">

        <Grid DockPanel.Dock="Top" Margin="14,10,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="⏳ Waiting On You"
                       FontWeight="SemiBold" FontSize="14"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="TxtCount" Grid.Column="1" Margin="10,0,0,0"
                       Foreground="{StaticResource Subtext0Brush}" FontSize="11.5"
                       VerticalAlignment="Center" Text=""/>

            <Button x:Name="BtnRefresh" Grid.Column="2"
                    Style="{StaticResource IconButton}"
                    ToolTip="Refresh from the local mirror"
                    Click="BtnRefresh_Click"
                    Margin="8,0,0,0"
                    Padding="6,4">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"/>
            </Button>
        </Grid>

        <TextBlock x:Name="TxtEmpty" DockPanel.Dock="Top" Margin="14,4,14,10"
                   Foreground="{StaticResource Subtext0Brush}" FontSize="11.5"
                   TextWrapping="Wrap" Text=""
                   Visibility="Collapsed"/>

        <ScrollViewer x:Name="RowsScroller" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsList" Margin="10,0,10,10"/>
        </ScrollViewer>

    </DockPanel>
</UserControl>

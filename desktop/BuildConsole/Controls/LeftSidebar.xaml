<UserControl x:Class="BuildConsole.Controls.LeftSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180">

    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">

            <!-- ── Section header ── -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <DockPanel>
                    <TextBlock x:Name="HeaderTitle"
                               Text="CHATS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext1Brush}"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="BtnNewItem"
                                Style="{StaticResource IconButton}"
                                ToolTip="New Chat"
                                Padding="4">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Collapse All"
                                Padding="4"
                                Click="CollapseAll_Click">
                            <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ══════════════════════════════════
                 CHATS VIEW
                 ══════════════════════════════════ -->
            <Grid x:Name="ChatsView" DockPanel.Dock="Top">
                <DockPanel>
                    <!-- Search box -->
                    <Border DockPanel.Dock="Top"
                            Padding="8,6">
                        <TextBox x:Name="ChatSearch"
                                 Height="26"
                                 Padding="6,4"
                                 FontSize="12"
                                 Text="">
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <!-- Chat tree -->
                    <ScrollViewer DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,4">
                        <TreeView x:Name="ChatsTree" BorderThickness="0">

                            <!-- ══ EPIC: Platform Build ══ In Progress -->
                            <TreeViewItem IsExpanded="True">
                                <TreeViewItem.Header>
                                    <DockPanel>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource BlueBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <Border DockPanel.Dock="Right" Background="#1A89B4FA" CornerRadius="3"
                                                Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="In Progress" FontSize="10" Foreground="{StaticResource BlueBrush}"/>
                                        </Border>
                                        <TextBlock Text="Platform Build" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </TreeViewItem.Header>
                                <TreeViewItem>
                                    <TreeViewItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{StaticResource BlueBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="IDE-style layout for BuildConsole" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TreeViewItem.Header>
                                </TreeViewItem>
                            </TreeViewItem>

                            <!-- ══ EPIC: MSP Platform ══ In Progress -->
                            <TreeViewItem IsExpanded="True" Margin="0,4,0,0">
                                <TreeViewItem.Header>
                                    <DockPanel>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource MauveBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <Border DockPanel.Dock="Right" Background="#1ACBA6F7" CornerRadius="3"
                                                Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="In Progress" FontSize="10" Foreground="{StaticResource MauveBrush}"/>
                                        </Border>
                                        <TextBlock Text="MSP Platform" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </TreeViewItem.Header>
                                <TreeViewItem>
                                    <TreeViewItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{StaticResource MauveBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Stripe integration for resellers" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TreeViewItem.Header>
                                </TreeViewItem>
                            </TreeViewItem>

                            <!-- ══ EPIC: Alert Engine ══ Blocked -->
                            <TreeViewItem IsExpanded="True" Margin="0,4,0,0">
                                <TreeViewItem.Header>
                                    <DockPanel>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource RedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <Border DockPanel.Dock="Right" Background="#1AF38BA8" CornerRadius="3"
                                                Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Blocked" FontSize="10" Foreground="{StaticResource RedBrush}"/>
                                        </Border>
                                        <TextBlock Text="Alert Engine" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </TreeViewItem.Header>
                                <TreeViewItem>
                                    <TreeViewItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{StaticResource RedBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Alert engine migration planning" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TreeViewItem.Header>
                                </TreeViewItem>
                            </TreeViewItem>

                            <!-- ══ EPIC: Eyecons Admin ══ Pending -->
                            <TreeViewItem IsExpanded="False" Margin="0,4,0,0">
                                <TreeViewItem.Header>
                                    <DockPanel>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource Subtext1Brush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <Border DockPanel.Dock="Right" Background="#15585B70" CornerRadius="3"
                                                Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Pending" FontSize="10" Foreground="{StaticResource Subtext1Brush}"/>
                                        </Border>
                                        <TextBlock Text="Eyecons Admin" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </TreeViewItem.Header>
                                <TreeViewItem>
                                    <TreeViewItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{StaticResource Subtext1Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Admin panel layout fixes" FontSize="13"
                                                       Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TreeViewItem.Header>
                                </TreeViewItem>
                            </TreeViewItem>

                            <!-- ══ EPIC: MSP Database Schema ══ Done -->
                            <TreeViewItem IsExpanded="False" Margin="0,4,0,0">
                                <TreeViewItem.Header>
                                    <DockPanel>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <Border DockPanel.Dock="Right" Background="#15A6E3A1" CornerRadius="3"
                                                Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Done" FontSize="10" Foreground="{StaticResource GreenBrush}"/>
                                        </Border>
                                        <TextBlock Text="MSP Database Schema" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Subtext1Brush}"
                                                   TextDecorations="Strikethrough" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </TreeViewItem.Header>
                                <TreeViewItem>
                                    <TreeViewItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{StaticResource GreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="MSP Platform database schema" FontSize="13"
                                                       Foreground="{StaticResource Subtext1Brush}"
                                                       TextDecorations="Strikethrough" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TreeViewItem.Header>
                                </TreeViewItem>
                            </TreeViewItem>

                        </TreeView>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 EXPLORER VIEW
                 ══════════════════════════════════ -->
            <!-- ══════════════════════════════════
                 EXPLORER VIEW (C:\Source\ShaneMcCawConsulting\Shane-McCaw-MSP)
                 ══════════════════════════════════ -->
            <!-- ══════════════════════════════════
                 EXPLORER VIEW (Dynamic File Explorer for C:\Source\ShaneMcCawConsulting\Shane-McCaw-MSP)
                 ══════════════════════════════════ -->
            <Grid x:Name="ExplorerView" Visibility="Collapsed">
                <DockPanel>
                    <!-- Workspace path header strip -->
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource Surface0Brush}"
                            Padding="8,6"
                            BorderBrush="{StaticResource Surface1Brush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource PeachBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Shane-McCaw-MSP"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="C:\Source\..."
                                       FontSize="10"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- TreeView of Repository Files -->
                    <ScrollViewer DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,4">
                        <TreeView x:Name="ExplorerTree"
                                  BorderThickness="0"
                                  SelectedItemChanged="ExplorerTree_SelectedItemChanged"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 SEARCH VIEW
                 ══════════════════════════════════ -->
            <Grid x:Name="SearchView" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="8,8">
                        <TextBox Height="26" Padding="6,4" FontSize="12"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Type to search chats…"
                               Foreground="{StaticResource Subtext1Brush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0"/>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 GIT VIEW
                 ══════════════════════════════════ -->
            <Grid x:Name="GitView" Visibility="Collapsed">
                <DockPanel>
                    <!-- Branch badge -->
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource Surface0Brush}"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE869;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{StaticResource BlueBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="main" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Border>
                    <!-- Staged changes placeholder -->
                    <TreeViewItem DockPanel.Dock="Top" Header="STAGED (0)" IsExpanded="True"/>
                    <TreeViewItem DockPanel.Dock="Top" Header="CHANGES (0)" IsExpanded="True"/>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 SETTINGS VIEW
                 ══════════════════════════════════ -->
            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <StackPanel Margin="12">
                    <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Claude endpoint" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                    <TextBox Text="https://claude.ai" Height="26" FontSize="12" Margin="0,0,0,12"/>
                    <TextBlock Text="API base URL" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                    <TextBox Text="http://localhost:3000" Height="26" FontSize="12" Margin="0,0,0,12"/>
                    <TextBlock Text="Theme" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>
                    <ComboBox Height="26" FontSize="12">
                        <ComboBoxItem Content="Catppuccin Mocha" IsSelected="True"/>
                        <ComboBoxItem Content="Catppuccin Latte"/>
                        <ComboBoxItem Content="One Dark Pro"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

        </DockPanel>
    </Border>
</UserControl>

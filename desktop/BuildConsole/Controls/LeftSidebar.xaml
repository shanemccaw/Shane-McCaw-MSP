<UserControl x:Class="BuildConsole.Controls.LeftSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180">

    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">

            <!-- ── Section header ── -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle"
                                   Text="CHATS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext1Brush}"
                                   VerticalAlignment="Center"/>

                        <!-- shaneapp:// protocol live execution indicator -->
                        <Border x:Name="ShaneAppIndicator"
                                Background="#33A6E3A1"
                                BorderBrush="{StaticResource GreenBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                ToolTip="shaneapp:// is executing — Click to open live streaming console"
                                MouseLeftButtonUp="ShaneAppIndicator_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ShaneAppIndicatorDot" Text="●" FontSize="9" Foreground="{StaticResource GreenBrush}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ShaneAppIndicatorLabel" Text="RUNNING" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="BtnNewItem"
                                Style="{StaticResource IconButton}"
                                ToolTip="New Chat"
                                Padding="4"
                                Click="BtnNewItem_Click">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnRefreshGitBoard"
                                Style="{StaticResource IconButton}"
                                ToolTip="Refresh Git Board"
                                Padding="4"
                                Visibility="Collapsed"
                                Click="BtnRefreshGitBoard_Click">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Collapse All"
                                Padding="4"
                                Click="CollapseAll_Click">
                            <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnPinSidebar"
                                Style="{StaticResource IconButton}"
                                ToolTip="Pin / Collapse Panel"
                                Padding="4"
                                Margin="2,0,0,0"
                                Click="BtnPinSidebar_Click">
                            <TextBlock x:Name="PinSidebarIcon" Text="📌" FontSize="11" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ══════════════════════════════════
                 CHATS VIEW
                 ══════════════════════════════════ -->
            <Grid x:Name="ChatsView" DockPanel.Dock="Top">
                <DockPanel>
                    <!-- Git #2104 — Pinned Questions (Phase 1 of #2036). One card per open
                         question, its own inline reply field; sending resolves the pin by
                         posting the reply into the REAL originating chat via the #2059
                         WebView2 bridge (SendToChatAsync — the specific chat, never "whatever's
                         active"). Basic/default styling — real Design output is pending #2102
                         and does not block this build. Collapsed entirely when there are no
                         open pins so a quiet Chats panel stays quiet. -->
                    <Border x:Name="PinnedQuestionsSection" DockPanel.Dock="Top" Padding="8,6,8,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="📌 PINNED QUESTIONS" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Subtext0Brush}" Margin="2,0,0,4"/>
                            <StackPanel x:Name="PinnedQuestionsHost"/>
                        </StackPanel>
                    </Border>

                    <!-- Chats tree redesign — mirrors #984's UI Automation manifest tree
                         (Shane's favourite panel): the same overlay-placeholder search box
                         above the tree, color-coded-by-epic groups, count badges, and a
                         collapsed-by-default layout. Search box uses the exact overlay-
                         placeholder trick #984's ManifestSearchBox / #950's QueueSearchBox use. -->
                    <Border DockPanel.Dock="Top" Padding="8,6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ChatSearch"
                                         Style="{StaticResource SearchTextBox}"
                                         Height="26" Padding="6,4,24,4" FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Background="{StaticResource Surface0Brush}"
                                         TextChanged="ChatSearch_TextChanged"/>
                                <TextBlock IsHitTestVisible="False"
                                           Text="Search chats (title or epic)"
                                           FontSize="12" Margin="8,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Foreground="{StaticResource Subtext1Brush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ChatSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Git #1629 — the Chats panel's own manual refresh. Always a real
                                     fetch + guaranteed repaint (forceFresh bypasses the unchanged-
                                     signature short-circuit); see BtnRefreshChats_Click. -->
                                <Button x:Name="BtnRefreshChats"
                                        Grid.Column="1"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Refresh Chats — always re-fetches and repaints"
                                        Padding="4"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="BtnRefreshChats_Click">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                            <!-- Git: Chats panel Archive — reversible soft-hide. Off by default
                                 (archived chats stay out of the normal view); checking this shows
                                 ONLY the archived ones, mirroring the Git Board's closed-filter toggle
                                 shape, so Shane can find and unarchive one without losing anything. -->
                            <CheckBox x:Name="ChatShowArchived"
                                      Content="Show Archived"
                                      FontSize="11"
                                      Margin="2,6,0,0"
                                      Foreground="{StaticResource Subtext1Brush}"
                                      Checked="ChatShowArchived_Changed"
                                      Unchecked="ChatShowArchived_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Chat tree (populated live from GET /extension/board — see code-behind) -->
                    <ScrollViewer DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,4">
                        <Grid>
                            <!-- Legacy TreeView kept (hidden) so existing keyboard-nav / focus
                                 references still resolve; the visible UI is the card host below. -->
                            <TreeView x:Name="ChatsTree" Visibility="Collapsed" BorderThickness="0" SelectedItemChanged="ChatsTree_SelectedItemChanged" SizeChanged="ChatsTree_SizeChanged"/>
                            <StackPanel x:Name="ChatsHost"/>
                            <TextBlock x:Name="TxtNoChats" Text="No chats linked yet." FontSize="10" Foreground="{StaticResource Subtext0Brush}" Margin="12,6,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 EXPLORER VIEW
                 ══════════════════════════════════ -->
            <!-- ══════════════════════════════════
                 EXPLORER VIEW (C:\Source\ShaneMcCawConsulting\Shane-McCaw-MSP)
                 ══════════════════════════════════ -->
            <!-- ══════════════════════════════════
                 EXPLORER VIEW (Dynamic File Explorer for C:\Source\ShaneMcCawConsulting\Shane-McCaw-MSP)
                 ══════════════════════════════════ -->
            <Grid x:Name="ExplorerView" Visibility="Collapsed">
                <DockPanel>
                    <!-- Workspace path header strip -->
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource Surface0Brush}"
                            Padding="8,6"
                            BorderBrush="{StaticResource Surface1Brush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource PeachBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Shane-McCaw-MSP"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="C:\Source\..."
                                       FontSize="10"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- TreeView of Repository Files -->
                    <ScrollViewer x:Name="ExplorerScrollViewer"
                                  DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="0,4">
                        <TreeView x:Name="ExplorerTree"
                                  BorderThickness="0"
                                  PreviewMouseWheel="ExplorerTree_PreviewMouseWheel"
                                  SelectedItemChanged="ExplorerTree_SelectedItemChanged"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 SEARCH VIEW (Full-Text File Content Search)
                 ══════════════════════════════════ -->
            <Grid x:Name="SearchView" Visibility="Collapsed">
                <DockPanel Margin="10,8">
                    <StackPanel DockPanel.Dock="Top">

                        <!-- Main Search Input Box with Embedded Icon & Clean Dark Toggle -->
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                            <DockPanel HorizontalAlignment="Stretch">
                                <ToggleButton x:Name="BtnMatchCase" DockPanel.Dock="Right" Content="Aa" ToolTip="Match Case" Width="28" Height="24"
                                              Background="Transparent" BorderThickness="0" Foreground="{StaticResource Subtext0Brush}"
                                              FontWeight="Bold" FontSize="11" Margin="4,0,0,0" Cursor="Hand">
                                    <ToggleButton.Style>
                                        <Style TargetType="{x:Type ToggleButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Grid HorizontalAlignment="Stretch">
                                    <TextBlock Text="Search (e.g. function, class, TODO)..." FontSize="12" Foreground="{StaticResource OverlayBrush}"
                                               VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInputBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="11" Margin="4,0,6,0" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="SearchInputBox"
                                                 Style="{StaticResource SearchTextBox}"
                                                 Height="24" FontSize="12" Padding="2,2,18,2" HorizontalAlignment="Stretch" MinWidth="140"
                                                 VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextBrush}" KeyDown="SearchInputBox_KeyDown"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Files to Include Filter Box with Watermark -->
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,8">
                            <Grid HorizontalAlignment="Stretch">
                                <TextBlock Text="files to include (e.g. *.cs, *.ts)" FontSize="11" Foreground="{StaticResource OverlayBrush}"
                                           VerticalAlignment="Center" Margin="22,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchIncludesBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📂" FontSize="10" Margin="4,0,6,0" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SearchIncludesBox"
                                             Style="{StaticResource SearchTextBox}"
                                             Height="22" FontSize="11" Padding="2,1,18,1" HorizontalAlignment="Stretch" MinWidth="140"
                                             VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Search & Clear Action Buttons — Git #2000: BtnClearSearch stays a
                             standalone full-width button, NOT consolidated onto the shared
                             SearchTextBox ✕. It clears BOTH SearchInputBox and
                             SearchIncludesBox together AND resets SearchResultsTree /
                             SearchSummaryText back to the pre-search empty state
                             (BtnClearSearch_Click) — a whole-form reset, not "clear one
                             box's typed text" the inline ✕ is for. SearchInputBox and
                             SearchIncludesBox each still got their own inline ✕ above. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnExecuteSearch" Grid.Column="0" Content="🔍 Search" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,3,0" Height="28" Click="BtnExecuteSearch_Click"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="1" Content="🗑 Clear" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="3,0,0,0" Height="28" Click="BtnClearSearch_Click"/>
                        </Grid>

                        <!-- Live Results Summary Badge -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                            <TextBlock x:Name="SearchSummaryText" Text="Enter search query &amp; press Enter" FontSize="11" Foreground="{StaticResource Subtext0Brush}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Full Width High Contrast Results Tree -->
                    <TreeView x:Name="SearchResultsTree"
                              BorderThickness="0"
                              Background="Transparent"
                              HorizontalContentAlignment="Stretch"
                              SelectedItemChanged="SearchResultsTree_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Matches}">
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,3">
                                    <Border DockPanel.Dock="Right" Background="{StaticResource Surface0Brush}" CornerRadius="3" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding MatchCountStr}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📄 " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel HorizontalAlignment="Stretch" Margin="0,2">
                                            <Border DockPanel.Dock="Left" Background="{StaticResource Surface0Brush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding LineNumberStr}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PeachBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 GIT SOURCE CONTROL & GRAPH VIEW
                 ══════════════════════════════════ -->
            <Grid x:Name="GitView" Visibility="Collapsed">
                <DockPanel Margin="8,6">
                    <StackPanel DockPanel.Dock="Top">
                        <!-- Active Branch Badge & Sync Status -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                            <DockPanel HorizontalAlignment="Stretch">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="↻" ToolTip="Refresh Git Status" Click="BtnGitRefresh_Click" Margin="2,0"/>
                                    <Button Style="{StaticResource IconButton}" Content="⬇" ToolTip="Git Pull" Click="BtnGitPull_Click" Margin="2,0"/>
                                    <Button Style="{StaticResource IconButton}" Content="⬆" ToolTip="Git Push" Click="BtnGitPush_Click" Margin="2,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔀 " FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GitBranchText" Text="main" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Git #1898 — real branch list (local + remote-tracking), collapsed by
                             default; expand to see/switch. Populated by PopulateGitBranches(). -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="BRANCHES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="BtnGitBranchesToggle" DockPanel.Dock="Right"
                                                  Style="{StaticResource ExpandCollapseToggleStyle}"
                                                  IsChecked="True" Click="BtnGitBranchesToggle_Click"
                                                  ToolTip="Show/hide branch list"/>
                                </DockPanel>
                                <StackPanel x:Name="GitBranchListHost" Visibility="Collapsed" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Commit Message Container -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="4" Margin="0,0,0,6">
                            <TextBox x:Name="GitCommitMsgBox" Height="44" FontSize="11" Padding="6,4" AcceptsReturn="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                     VerticalContentAlignment="Top" KeyDown="GitCommitMsgBox_KeyDown"/>
                        </Border>

                        <!-- Git #2575 — "Commit & Push": stage whatever's currently checked (if
                             anything), commit with the message box's contents, then push, in one
                             click. Chains the existing real command paths (BtnGitCommitAndPush_Click). -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnGitCommit" Grid.Column="0" Content="✓ Commit" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,4,0" Click="BtnGitCommit_Click"/>
                            <Button x:Name="BtnGitCommitAndPush" Grid.Column="1" Content="✓⬆ Commit &amp; Push" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="4,0,0,0" ToolTip="Stage checked files (if any), commit, then push" Click="BtnGitCommitAndPush_Click"/>
                        </Grid>

                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                            <TextBlock x:Name="GitStatusSummaryText" Text="SOURCE CONTROL" FontSize="11" Foreground="{StaticResource Subtext1Brush}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Git #860 (Git panel Phase 2) — ONE scrollable panel: Changes on top,
                         rendered commit Graph below. Both refresh together off #859's watcher.
                         Git #1898 — the Graph section is now independently collapsible
                         (BtnGitGraphToggle / GitGraphHost) so Changes can be viewed without it;
                         both still refresh from the same trigger, only the Graph's visibility is gated. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- ── CHANGES section ── -->
                            <!-- Git #2535 — "Stage All" bulk action (git add -A) so a multi-file
                                 check-in no longer needs N per-row right-clicks. -->
                            <DockPanel Margin="2,0,0,4" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="CHANGES" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                <Button x:Name="BtnGitStageAll" DockPanel.Dock="Right" Content="＋ Stage All"
                                        Style="{StaticResource IconButton}" FontSize="10" Padding="6,2"
                                        ToolTip="Stage all changes (git add -A)" Click="BtnGitStageAll_Click"/>
                                <!-- Git #2575 — stages only the checked subset (checkboxes added per
                                     unstaged row in CreateGitFileTreeItem); disabled until at least
                                     one row is checked. -->
                                <Button x:Name="BtnGitStageSelected" DockPanel.Dock="Right" Content="Stage Selected"
                                        Style="{StaticResource IconButton}" FontSize="10" Padding="6,2" Margin="0,0,6,0"
                                        IsEnabled="False"
                                        ToolTip="Stage only the checked files (git add per file)" Click="BtnGitStageSelected_Click"/>
                            </DockPanel>
                            <TreeView x:Name="GitChangesTree"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      SelectedItemChanged="GitChangesTree_SelectedItemChanged">
                                <TreeView.Resources>
                                    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="True"/>
                                    </Style>
                                </TreeView.Resources>
                            </TreeView>

                            <!-- ── GRAPH section (real rendered commit DAG — see PopulateGitGraph) ──
                                 Git #1898 — collapsible, collapsed by default (Shane: "I never use
                                 the commit graph, I want it out of the way"). Still built/refreshed
                                 off the same trigger as Changes; only its visibility is gated. -->
                            <Border Background="{StaticResource Surface0Brush}" Height="1" Margin="0,8,0,8"/>
                            <DockPanel LastChildFill="False" Margin="2,0,0,4">
                                <TextBlock x:Name="GitGraphHeaderText" DockPanel.Dock="Left" Text="COMMIT GRAPH" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="BtnGitGraphToggle" DockPanel.Dock="Right"
                                              Style="{StaticResource ExpandCollapseToggleStyle}"
                                              IsChecked="True" Click="BtnGitGraphToggle_Click"
                                              ToolTip="Show/hide commit graph"/>
                            </DockPanel>
                            <StackPanel x:Name="GitGraphHost" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 GIT MILESTONES, EPICS & ISSUES (ADHD TRACKER)
                 ══════════════════════════════════ -->
            <Grid x:Name="IssuesView" Visibility="Collapsed">
                <DockPanel Margin="8,6">
                    <StackPanel DockPanel.Dock="Top">
                        <!-- ADHD Visual Stats Chips -->
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="0,0,3,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="MILESTONES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}"/>
                                        <TextBlock x:Name="IssueStatMilestones" Text="3 Active" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="3,0,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="EPICS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}"/>
                                        <TextBlock x:Name="IssueStatEpics" Text="8 Active" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauveBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="0,3,3,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔥" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="OPEN ISSUES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}"/>
                                        <TextBlock x:Name="IssueStatOpen" Text="12 Pending" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PeachBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="3,3,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" FontSize="14" Margin="0,0,6,0" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="CLOSED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}"/>
                                        <TextBlock x:Name="IssueStatClosed" Text="28 Done" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Git #834 — real GitHub issue search (number or title, all states via the
                             Search Issues API), not the old fake local-only "Quick Add". -->
                        <TextBox x:Name="QuickAddIssueBox" Height="26" FontSize="11" Padding="6,2" Margin="0,0,0,6"
                                 KeyDown="QuickAddIssueBox_KeyDown" TextChanged="QuickAddIssueBox_TextChanged"/>

                        <!-- Active Working Epic Jump Bar -->
                        <Border x:Name="ActiveWorkingEpicBar"
                                Background="#1A2D23"
                                BorderBrush="{StaticResource GreenBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="7,4"
                                Margin="0,0,0,6"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                ToolTip="Click to expand parent milestone and select your active working epic"
                                MouseLeftButtonUp="ActiveWorkingEpicBar_Click">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Background="{StaticResource GreenBrush}"
                                        CornerRadius="3"
                                        Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="LOCATE ➔"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource CrustBrush}"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎯 " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ActiveWorkingEpicText"
                                               Text="WORKING: Epic"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GreenBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Git #2538 — GATE card(s). A release-gating issue (title starts
                             "GATE:") in the currently-shown milestone(s) is surfaced here as a
                             prominent purple-bordered card with its real completion fraction
                             (sub-issue rollup, or a "- [ ]"/"- [x]" checklist parse of its body),
                             so a release blocker is never buried mid-tree. Populated by
                             RenderGateCards(); collapsed entirely when there are no open GATE
                             issues in view. Clicking a card opens that issue's detail tab. -->
                        <StackPanel x:Name="GateCardHost" Margin="0,0,0,8" Visibility="Collapsed"/>

                        <!-- Filter Chips -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="All" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0" Click="IssueFilter_Click" Tag="All"/>
                                <Button Content="🔥 Priority" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0" Click="IssueFilter_Click" Tag="Priority"/>
                                <Button Content="🎯 Milestones" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0" Click="IssueFilter_Click" Tag="Milestones"/>
                                <Button Content="⚡ Epics" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0" Click="IssueFilter_Click" Tag="Epics"/>
                                <Button Content="🟢 Done" Style="{StaticResource SecondaryButton}" Padding="8,2" Click="IssueFilter_Click" Tag="Done"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Git #1635 — critter-crossing loading strip: shown for the real
                             duration of a manual Git Board refresh (IssueChompAnimation.
                             StartRefreshLoadingStrip / StopRefreshLoadingStrip, now shared via
                             LeftSidebar.RefreshGitBoardWithLoadingFeedbackAsync — see Git #1836),
                             dismissed the moment it genuinely completes rather than on a fixed
                             timer. Collapsed otherwise.
                             Git #1836 — Height was 22, but StartRefreshLoadingStrip scales the
                             critter (native canvas up to 60x56) by 0.34 about its own center,
                             which lands its visible band roughly 16-36px down from this Border's
                             top — a 22px strip clipped everything below the critter's head. 56px
                             (matching the largest native critter height) comfortably fits the
                             full critter with breathing room above and below. -->
                        <Border x:Name="GitRefreshLoadingStrip"
                                Height="56"
                                Background="{StaticResource Surface0Brush}"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <Canvas x:Name="GitRefreshStripCanvas" ClipToBounds="True"/>
                        </Border>

                        <!-- Git #1785 — one-time legend for the Git Board tree's status
                             dots, rendered once here (not per-row/per-group) now that the
                             dots below carry no text. Must be kept in sync by hand with
                             CreateStatusDot's actual colors/hollow-vs-solid treatment in
                             LeftSidebar.xaml.cs — there is no shared source of truth
                             between this static legend and the dots it describes.
                             "Waiting for input" is intentionally NOT listed: it isn't an
                             actual dot anywhere in this tree today (that indicator exists
                             only on Build Queue cards, keyed to a live build session, with
                             no wiring to a GitIssue) — filed as its own finding rather than
                             a legend entry for a dot that never renders. -->
                        <Border Margin="0,0,0,8" Padding="6,4" Background="{StaticResource Surface0Brush}" CornerRadius="4">
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,2">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Working" FontSize="9.5" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,2">
                                    <Ellipse Width="8" Height="8" Fill="#FAB387" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="In Flight" FontSize="9.5" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,2">
                                    <Ellipse Width="8" Height="8" Stroke="#FAB387" StrokeThickness="1.5" Fill="Transparent" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="In Flight ↓ (descendant)" FontSize="9.5" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Ellipse Width="8" Height="8" Fill="#F38BA8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Blocked" FontSize="9.5" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </StackPanel>

                    <!-- Milestones / Epics / Issues Tree -->
                    <TreeView x:Name="IssuesTree"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="IssuesTree_SelectedItemChanged"
                              SizeChanged="IssuesTree_SizeChanged">
                        <TreeView.Resources>
                            <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>

                    <!-- Git #2061 — Git Board issue-hover quick-action popover. Hovering a Git
                         Board issue row (IssuesTree, CreateIssueHeader) shows this instead of a
                         plain tooltip: a state-aware card (status pill/title/snippet, same as
                         before) plus ONE contextual primary action matching that issue's real
                         associated build state (Queued/In progress-In flight/Done/Failed), not a
                         generic summary every time. Must live inside THIS Grid (IssuesView), not
                         a sibling tab's — a Popup nested under a Visibility="Collapsed" ancestor
                         won't render when opened. PlacementTarget is set per-hover in code-behind
                         (ShowIssueHoverPopup) to the actual hovered row element. Same
                         StaysOpen="True" + explicit Opened/Closed dismissal pattern as
                         ManifestStepsPopup elsewhere in this file (Git #988) — a hover popover
                         additionally closes on MouseLeave (debounced) rather than only on
                         outside-click.
                         Git #2081 — widened (was MaxWidth 380, no height cap) and body wrapped in
                         a ScrollViewer to fit the new full relationship picture (blocked-by AND
                         the reverse blocking direction, both with real titles, capped list length
                         — see LoadIssueRelationshipsAsync) without letting a long dependency chain
                         grow the popup into a full panel. Same ScrollViewer pattern as
                         ManifestStepsFlyoutList above. -->
                    <Popup x:Name="IssueHoverPopup"
                           Placement="Right"
                           StaysOpen="True"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           Opened="IssueHoverPopup_Opened"
                           Closed="IssueHoverPopup_Closed">
                        <Border x:Name="IssueHoverPopupBorder"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                MinWidth="280" MaxWidth="440" MaxHeight="520"
                                MouseEnter="IssueHoverPopup_MouseEnter"
                                MouseLeave="IssueHoverPopup_MouseLeave">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="IssueHoverPopupBody"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </DockPanel>
            </Grid>
            <!-- Git #954 (Epic #803) — the sidebar's Settings view is now just a
                 category navigation list. Shane: "The left panel can be used for
                 navigation inside the settings page." Every real field moved out to
                 the native SettingsTabView tab (Controls/SettingsTabView.xaml);
                 clicking a category here opens (or focuses) that tab and scrolls to
                 the matching section via MainWindow.OpenSettingsTab. No settings
                 content lives in the sidebar anymore — one source of truth, the tab. -->
            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,10">
                    <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,4"/>
                    <TextBlock Text="Pick a section to open the full Settings tab there."
                               FontSize="10" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap" Margin="4,0,0,10"/>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="General" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="General" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Claude endpoint, Theme" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="Credentials" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔑" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Credentials" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="GitHub PAT, Zoho API Token" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="TestEnvironment" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧪" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Test Environment" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Manifest {{NAME}} variables" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="ChatIntegration" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Chat Integration" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="New Chat Project URL" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="WebTools" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Web Tools" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="ActivityBar popout links" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="ReplitWatcher" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔁" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Replit Watcher" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Interval, selector, URLs" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ══════════════════════════════════
                 UI AUTOMATION VIEW
                 ══════════════════════════════════ -->
            <Grid x:Name="AutomationView" Visibility="Collapsed">
                <DockPanel Margin="10,8">
                    <!-- Git #952 — fixed top region: Play, Available Tests header, and the API/Graph
                         badges (now moved ABOVE the list).
                         Git #963 — Record/Clear Actions/Target URL box removed (Shane never records
                         manually; Play now resolves its target from the loaded manifest's own baseUrl). -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <!-- Target Environment Selection for Shane's manual runs -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Target Environment" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                                    <Border x:Name="TargetEnvWarningBadge" Background="{StaticResource PeachBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right" Visibility="Collapsed">
                                        <TextBlock x:Name="TargetEnvWarningText" Text="⚠️ NON-DEV" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CrustBrush}"/>
                                    </Border>
                                </DockPanel>
                                <ComboBox x:Name="ComboTargetEnvironment" Height="26" FontSize="11" SelectionChanged="ComboTargetEnvironment_SelectionChanged">
                                    <ComboBoxItem Content="🟢 Dev (Local)" IsSelected="True" Tag="Dev"/>
                                    <ComboBoxItem Content="⚠️ Staging (Replit)" Tag="Staging"/>
                                    <ComboBoxItem Content="🚨 Production (Live)" Tag="Production"/>
                                </ComboBox>

                                <!-- Manual, Shane-only deploy of origin/main to the Staging (Replit) server:
                                     SSH pull -> #911 migrations+restart -> #805 confirm -> toast. Deliberately
                                     separate from the selector above and from any automatic path; Shane clicks
                                     this himself, then switches the selector to Staging to run tests. -->
                                <Button x:Name="BtnDeployToStaging" Content="🚀 Deploy to Staging"
                                        Margin="0,8,0,0" Height="28" FontSize="11" FontWeight="SemiBold"
                                        Background="{StaticResource SapphireBrush}" Foreground="{StaticResource CrustBrush}"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="BtnDeployToStaging_Click"
                                        ToolTip="Deliberately deploy the latest origin/main to the Staging (Replit) server: SSH git pull, apply pending migration SQL, restart, and confirm — then notify. No tests run automatically."/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnPlayTest" Content="▶ Play Test" Click="BtnPlayTest_Click"/>

                        <!-- Git #869 (Epic #803) — in-panel list instead of an OS OpenFileDialog; enumerates test-manifests/*.json directly, populated on view-load/refresh, selecting an item opens the steps flyout -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Available Tests" FontSize="11" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnRefreshManifests" Grid.Column="1" Content="⟳" Padding="6,2" Click="BtnRefreshManifests_Click" ToolTip="Refresh test list"/>
                        </Grid>

                        <!-- Git #952 — apiTests/graphTests counts from the selected manifest, now directly ABOVE the test list -->
                        <Grid x:Name="ManifestBadgesRow" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,4" Margin="0,0,3,0">
                                <TextBlock x:Name="ApiTestsBadge" Text="API: 0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,4" Margin="3,0,0,0">
                                <TextBlock x:Name="GraphTestsBadge" Text="Graph: 0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MauveBrush}" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Git #952 — "Recorded Test Actions" stays dedicated to the live Record workflow.
                         Docked to the bottom (bounded height) so the Available Tests list dominates the panel.
                         Declared list-first so the header docks ABOVE the list (DockPanel edge ordering). -->
                    <ListBox x:Name="AutomationStepsList" DockPanel.Dock="Bottom" MaxHeight="180" Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,4" Margin="0,2">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding IndexStr}" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                                            <TextBlock Text="{Binding ActionTypeUpper}" FontWeight="SemiBold" Foreground="{StaticResource PeachBrush}" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Selector}" FontSize="11" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Value}" FontSize="10" Foreground="{StaticResource Subtext0Brush}" TextTrimming="CharacterEllipsis" Visibility="{Binding ValueVisibility}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="RecordedActionsHeader" DockPanel.Dock="Bottom" Text="Recorded Test Actions" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" Margin="0,8,0,4"/>

                    <!-- Git #984 — Available Tests as a collapsed-by-default, color-coded-by-area TreeView
                         (was a flat ListBox), with a search box above it. Fills all remaining vertical
                         space as the DockPanel's last (LastChildFill) child. The tree is built in
                         code-behind (PopulateManifestsList/RenderManifestTree) so leaves can carry #983's
                         relative-path Tag and each area gets a stable palette color. -->
                    <DockPanel Margin="0,4,0,0">
                        <!-- Git #984 — search box, same overlay-placeholder trick as the Build Queue's #950
                             search (QueueSearchBox). Filters the tree to manifests whose filename or area
                             matches; matching areas auto-expand, non-matching hide; clearing restores the
                             collapsed-by-default state. -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBox x:Name="ManifestSearchBox"
                                     Style="{StaticResource SearchTextBox}"
                                     Height="26" Padding="6,4,24,4" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource Surface0Brush}"
                                     TextChanged="ManifestSearchBox_TextChanged"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="Search tests (#git, name, area)"
                                       FontSize="12" Margin="8,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{StaticResource Subtext1Brush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ManifestSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid>
                            <TreeView x:Name="ManifestFilesTree"
                                      BorderThickness="0" Padding="0,2"
                                      Background="{StaticResource BaseBrush}"
                                      SelectedItemChanged="ManifestFilesTree_SelectedItemChanged"
                                      MouseDoubleClick="ManifestFilesTree_MouseDoubleClick"/>
                            <TextBlock x:Name="TxtNoManifests" Text="No test manifests found in test-manifests/." FontSize="10" Foreground="{StaticResource Subtext0Brush}" Margin="4,6,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </DockPanel>

                <!-- Git #952 — steps flyout (WPF Popup, same pattern as #864's Web Tools popout).
                     Opens when a manifest is clicked in ManifestFilesTree (#984) and lists that manifest's
                     apiTests / graphTests / postGraphApiTests / zohoTests / powerShellVerify / uiSteps.
                     Placement=Right flies it out beside the sidebar.
                     Separate from "Recorded Test Actions", which is untouched by manifest selection.
                     Git #988 — StaysOpen="False" caused a show-then-instant-close race: the same click that
                     selects a tree item and opens the popup was itself being read as an "outside click" by
                     WPF's automatic StaysOpen=False detection. Now StaysOpen="True" with explicit dismissal
                     (Opened/Closed below) instead of relying on that automatic mechanism. -->
                <Popup x:Name="ManifestStepsPopup"
                       PlacementTarget="{Binding ElementName=ManifestFilesTree}"
                       Placement="Right"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Opened="ManifestStepsPopup_Opened"
                       Closed="ManifestStepsPopup_Closed">
                    <Border Background="{StaticResource MantleBrush}"
                            BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            MinWidth="340" MaxWidth="460" MaxHeight="620">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,178,0">
                                    <TextBlock x:Name="ManifestStepsFlyoutTitle" Text="Test Steps" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ManifestStepsFlyoutSubtitle" Text="" FontSize="10" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <!-- Opens Test History filtered to just this manifest's own run history. -->
                                    <Button x:Name="BtnOpenManifestHistory" Content="🕒 History" Padding="8,2" Margin="0,0,6,0" Click="BtnOpenManifestHistory_Click" ToolTip="Open Test History filtered to this manifest's own runs"/>
                                    <!-- Opens the fuller Manifest Viewer (raw JSON tree + workflow chart) for the selected manifest. -->
                                    <Button x:Name="BtnOpenManifestViewer" Content="⤢ View" Padding="8,2" Margin="0,0,6,0" Click="BtnOpenManifestViewer_Click" ToolTip="Open the Manifest Viewer — raw JSON and a workflow chart of this manifest"/>
                                    <Button x:Name="BtnCloseStepsFlyout" Content="✕" Padding="6,2" Click="BtnCloseStepsFlyout_Click" ToolTip="Close"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ManifestStepsFlyoutList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- ══════════════════════════════════
                 MICROSOFT GRAPH API VIEW
                 ══════════════════════════════════ -->
            <Grid x:Name="GraphApiView" Visibility="Collapsed">
                <DockPanel Margin="10,8">
                    <!-- Search box -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox x:Name="GraphApiSearchBox"
                                 Style="{StaticResource SearchTextBox}"
                                 Height="26" Padding="6,4,24,4" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Background="{StaticResource Surface0Brush}"
                                 TextChanged="GraphApiSearchBox_TextChanged"/>
                        <TextBlock IsHitTestVisible="False"
                                   Text="Search APIs..."
                                   FontSize="12" Margin="8,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="{StaticResource Subtext1Brush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=GraphApiSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TreeView x:Name="GraphApiTree"
                              BorderThickness="0" Padding="0,2"
                              Background="{StaticResource BaseBrush}"
                              SelectedItemChanged="GraphApiTree_SelectedItemChanged"/>
                </DockPanel>
            </Grid>

        </DockPanel>
    </Border>
</UserControl>

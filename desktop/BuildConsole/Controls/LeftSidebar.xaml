<UserControl x:Class="BuildConsole.Controls.LeftSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180">

    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">

            <!-- ── Section header ── -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <DockPanel>
                    <TextBlock x:Name="HeaderTitle"
                               Text="CHATS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext1Brush}"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="BtnNewItem"
                                Style="{StaticResource IconButton}"
                                ToolTip="New Chat"
                                Padding="4"
                                Click="BtnNewItem_Click">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnRefreshGitBoard"
                                Style="{StaticResource IconButton}"
                                ToolTip="Refresh Git Board"
                                Padding="4"
                                Visibility="Collapsed"
                                Click="BtnRefreshGitBoard_Click">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Collapse All"
                                Padding="4"
                                Click="CollapseAll_Click">
                            <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnPinSidebar"
                                Style="{StaticResource IconButton}"
                                ToolTip="Pin / Collapse Panel"
                                Padding="4"
                                Margin="2,0,0,0"
                                Click="BtnPinSidebar_Click">
                            <TextBlock x:Name="PinSidebarIcon" Text="📌" FontSize="11" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ══════════════════════════════════
                 CHATS VIEW
                 ══════════════════════════════════ -->
            <Grid x:Name="ChatsView" DockPanel.Dock="Top">
                <DockPanel>
                    <!-- Search box -->
                    <Border DockPanel.Dock="Top"
                            Padding="8,6">
                        <TextBox x:Name="ChatSearch"
                                 Height="26"
                                 Padding="6,4"
                                 FontSize="12"
                                 Text="">
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <!-- Chat tree (populated live from GET /extension/board — see code-behind) -->
                    <ScrollViewer DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,4">
                        <TreeView x:Name="ChatsTree" BorderThickness="0" SelectedItemChanged="ChatsTree_SelectedItemChanged" SizeChanged="ChatsTree_SizeChanged"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 EXPLORER VIEW
                 ══════════════════════════════════ -->
            <!-- ══════════════════════════════════
                 EXPLORER VIEW (C:\Source\ShaneMcCawConsulting\Shane-McCaw-MSP)
                 ══════════════════════════════════ -->
            <!-- ══════════════════════════════════
                 EXPLORER VIEW (Dynamic File Explorer for C:\Source\ShaneMcCawConsulting\Shane-McCaw-MSP)
                 ══════════════════════════════════ -->
            <Grid x:Name="ExplorerView" Visibility="Collapsed">
                <DockPanel>
                    <!-- Workspace path header strip -->
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource Surface0Brush}"
                            Padding="8,6"
                            BorderBrush="{StaticResource Surface1Brush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource PeachBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Shane-McCaw-MSP"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="C:\Source\..."
                                       FontSize="10"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- TreeView of Repository Files -->
                    <ScrollViewer x:Name="ExplorerScrollViewer"
                                  DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="0,4">
                        <TreeView x:Name="ExplorerTree"
                                  BorderThickness="0"
                                  PreviewMouseWheel="ExplorerTree_PreviewMouseWheel"
                                  SelectedItemChanged="ExplorerTree_SelectedItemChanged"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 SEARCH VIEW (Full-Text File Content Search)
                 ══════════════════════════════════ -->
            <Grid x:Name="SearchView" Visibility="Collapsed">
                <DockPanel Margin="10,8">
                    <StackPanel DockPanel.Dock="Top">

                        <!-- Main Search Input Box with Embedded Icon & Clean Dark Toggle -->
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                            <DockPanel HorizontalAlignment="Stretch">
                                <ToggleButton x:Name="BtnMatchCase" DockPanel.Dock="Right" Content="Aa" ToolTip="Match Case" Width="28" Height="24"
                                              Background="Transparent" BorderThickness="0" Foreground="{StaticResource Subtext0Brush}"
                                              FontWeight="Bold" FontSize="11" Margin="4,0,0,0" Cursor="Hand">
                                    <ToggleButton.Style>
                                        <Style TargetType="{x:Type ToggleButton}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Grid HorizontalAlignment="Stretch">
                                    <TextBlock Text="Search (e.g. function, class, TODO)..." FontSize="12" Foreground="{StaticResource OverlayBrush}"
                                               VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInputBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="11" Margin="4,0,6,0" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="SearchInputBox" Height="24" FontSize="12" Padding="2,2" HorizontalAlignment="Stretch" MinWidth="140"
                                                 VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextBrush}" KeyDown="SearchInputBox_KeyDown"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Files to Include Filter Box with Watermark -->
                        <Border Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,8">
                            <Grid HorizontalAlignment="Stretch">
                                <TextBlock Text="files to include (e.g. *.cs, *.ts)" FontSize="11" Foreground="{StaticResource OverlayBrush}"
                                           VerticalAlignment="Center" Margin="22,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchIncludesBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📂" FontSize="10" Margin="4,0,6,0" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SearchIncludesBox" Height="22" FontSize="11" Padding="2,1" HorizontalAlignment="Stretch" MinWidth="140"
                                             VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Search & Clear Action Buttons -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnExecuteSearch" Grid.Column="0" Content="🔍 Search" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,3,0" Height="28" Click="BtnExecuteSearch_Click"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="1" Content="🗑 Clear" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="3,0,0,0" Height="28" Click="BtnClearSearch_Click"/>
                        </Grid>

                        <!-- Live Results Summary Badge -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                            <TextBlock x:Name="SearchSummaryText" Text="Enter search query &amp; press Enter" FontSize="11" Foreground="{StaticResource Subtext0Brush}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Full Width High Contrast Results Tree -->
                    <TreeView x:Name="SearchResultsTree"
                              BorderThickness="0"
                              Background="Transparent"
                              HorizontalContentAlignment="Stretch"
                              SelectedItemChanged="SearchResultsTree_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Matches}">
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,3">
                                    <Border DockPanel.Dock="Right" Background="{StaticResource Surface0Brush}" CornerRadius="3" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding MatchCountStr}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📄 " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel HorizontalAlignment="Stretch" Margin="0,2">
                                            <Border DockPanel.Dock="Left" Background="{StaticResource Surface0Brush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding LineNumberStr}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PeachBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 GIT SOURCE CONTROL & GRAPH VIEW
                 ══════════════════════════════════ -->
            <Grid x:Name="GitView" Visibility="Collapsed">
                <DockPanel Margin="8,6">
                    <StackPanel DockPanel.Dock="Top">
                        <!-- Active Branch Badge & Sync Status -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                            <DockPanel HorizontalAlignment="Stretch">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="↻" ToolTip="Refresh Git Status" Click="BtnGitRefresh_Click" Margin="2,0"/>
                                    <Button Style="{StaticResource IconButton}" Content="⬇" ToolTip="Git Pull" Click="BtnGitPull_Click" Margin="2,0"/>
                                    <Button Style="{StaticResource IconButton}" Content="⬆" ToolTip="Git Push" Click="BtnGitPush_Click" Margin="2,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔀 " FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GitBranchText" Text="main" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Commit Message Container -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="4" Margin="0,0,0,6">
                            <TextBox x:Name="GitCommitMsgBox" Height="44" FontSize="11" Padding="6,4" AcceptsReturn="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                     VerticalContentAlignment="Top" KeyDown="GitCommitMsgBox_KeyDown"/>
                        </Border>

                        <Button x:Name="BtnGitCommit" Content="✓ Commit" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="BtnGitCommit_Click"/>

                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                            <TextBlock x:Name="GitStatusSummaryText" Text="SOURCE CONTROL" FontSize="11" Foreground="{StaticResource Subtext1Brush}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Git #860 (Git panel Phase 2) — ONE scrollable panel: Changes on top,
                         rendered commit Graph below, both always visible together (replaced the
                         old Changes/Graph tab-toggle). Both refresh together off #859's watcher. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- ── CHANGES section ── -->
                            <TextBlock Text="CHANGES" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Subtext0Brush}" Margin="2,0,0,4"/>
                            <TreeView x:Name="GitChangesTree"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      SelectedItemChanged="GitChangesTree_SelectedItemChanged">
                                <TreeView.Resources>
                                    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="True"/>
                                    </Style>
                                </TreeView.Resources>
                            </TreeView>

                            <!-- ── GRAPH section (real rendered commit DAG — see PopulateGitGraph) ── -->
                            <Border Background="{StaticResource Surface0Brush}" Height="1" Margin="0,8,0,8"/>
                            <TextBlock x:Name="GitGraphHeaderText" Text="COMMIT GRAPH" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Subtext0Brush}" Margin="2,0,0,4"/>
                            <StackPanel x:Name="GitGraphHost"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ══════════════════════════════════
                 GIT MILESTONES, EPICS & ISSUES (ADHD TRACKER)
                 ══════════════════════════════════ -->
            <Grid x:Name="IssuesView" Visibility="Collapsed">
                <DockPanel Margin="8,6">
                    <StackPanel DockPanel.Dock="Top">
                        <!-- ADHD Visual Stats Chips -->
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="0,0,3,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="MILESTONES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}"/>
                                        <TextBlock x:Name="IssueStatMilestones" Text="3 Active" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="3,0,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="EPICS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}"/>
                                        <TextBlock x:Name="IssueStatEpics" Text="8 Active" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauveBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="0,3,3,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔥" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="OPEN ISSUES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}"/>
                                        <TextBlock x:Name="IssueStatOpen" Text="12 Pending" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PeachBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="6" Padding="8,6" Margin="3,3,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" FontSize="14" Margin="0,0,6,0" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="CLOSED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}"/>
                                        <TextBlock x:Name="IssueStatClosed" Text="28 Done" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Git #834 — real GitHub issue search (number or title, all states via the
                             Search Issues API), not the old fake local-only "Quick Add". -->
                        <TextBox x:Name="QuickAddIssueBox" Height="26" FontSize="11" Padding="6,2" Margin="0,0,0,6"
                                 KeyDown="QuickAddIssueBox_KeyDown" TextChanged="QuickAddIssueBox_TextChanged"/>

                        <!-- Filter Chips -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="All" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0" Click="IssueFilter_Click" Tag="All"/>
                                <Button Content="🔥 Priority" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0" Click="IssueFilter_Click" Tag="Priority"/>
                                <Button Content="🎯 Milestones" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0" Click="IssueFilter_Click" Tag="Milestones"/>
                                <Button Content="⚡ Epics" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0" Click="IssueFilter_Click" Tag="Epics"/>
                                <Button Content="🟢 Done" Style="{StaticResource SecondaryButton}" Padding="8,2" Click="IssueFilter_Click" Tag="Done"/>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Milestones / Epics / Issues Tree -->
                    <TreeView x:Name="IssuesTree"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="IssuesTree_SelectedItemChanged"
                              SizeChanged="IssuesTree_SizeChanged">
                        <TreeView.Resources>
                            <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Grid>
            <!-- Git #954 (Epic #803) — the sidebar's Settings view is now just a
                 category navigation list. Shane: "The left panel can be used for
                 navigation inside the settings page." Every real field moved out to
                 the native SettingsTabView tab (Controls/SettingsTabView.xaml);
                 clicking a category here opens (or focuses) that tab and scrolls to
                 the matching section via MainWindow.OpenSettingsTab. No settings
                 content lives in the sidebar anymore — one source of truth, the tab. -->
            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,10">
                    <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,4"/>
                    <TextBlock Text="Pick a section to open the full Settings tab there."
                               FontSize="10" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap" Margin="4,0,0,10"/>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="General" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="General" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Claude endpoint, Theme" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="Credentials" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔑" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Credentials" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="GitHub PAT, Zoho API Token" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="TestEnvironment" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧪" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Test Environment" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Manifest {{NAME}} variables" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="ChatIntegration" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Chat Integration" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="New Chat Project URL" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="WebTools" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Web Tools" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="ActivityBar popout links" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" HorizontalContentAlignment="Left"
                            Padding="10,8" Margin="0,0,0,4" Tag="ReplitWatcher" Click="SidebarSettingsCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔁" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Replit Watcher" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Interval, selector, URLs" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ══════════════════════════════════
                 UI AUTOMATION VIEW
                 ══════════════════════════════════ -->
            <Grid x:Name="AutomationView" Visibility="Collapsed">
                <DockPanel Margin="10,8">
                    <!-- Git #952 — fixed top region: Play, Available Tests header, and the API/Graph
                         badges (now moved ABOVE the list).
                         Git #963 — Record/Clear Actions/Target URL box removed (Shane never records
                         manually; Play now resolves its target from the loaded manifest's own baseUrl). -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="BtnPlayTest" Content="▶ Play Test" Click="BtnPlayTest_Click"/>

                        <!-- Git #869 (Epic #803) — in-panel list instead of an OS OpenFileDialog; enumerates test-manifests/*.json directly, populated on view-load/refresh, selecting an item opens the steps flyout -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Available Tests" FontSize="11" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnRefreshManifests" Grid.Column="1" Content="⟳" Padding="6,2" Click="BtnRefreshManifests_Click" ToolTip="Refresh test list"/>
                        </Grid>

                        <!-- Git #952 — apiTests/graphTests counts from the selected manifest, now directly ABOVE the test list -->
                        <Grid x:Name="ManifestBadgesRow" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,4" Margin="0,0,3,0">
                                <TextBlock x:Name="ApiTestsBadge" Text="API: 0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,4" Margin="3,0,0,0">
                                <TextBlock x:Name="GraphTestsBadge" Text="Graph: 0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MauveBrush}" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Git #952 — "Recorded Test Actions" stays dedicated to the live Record workflow.
                         Docked to the bottom (bounded height) so the Available Tests list dominates the panel.
                         Declared list-first so the header docks ABOVE the list (DockPanel edge ordering). -->
                    <ListBox x:Name="AutomationStepsList" DockPanel.Dock="Bottom" MaxHeight="180" Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,4" Margin="0,2">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding IndexStr}" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                                            <TextBlock Text="{Binding ActionTypeUpper}" FontWeight="SemiBold" Foreground="{StaticResource PeachBrush}" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Selector}" FontSize="11" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Value}" FontSize="10" Foreground="{StaticResource Subtext0Brush}" TextTrimming="CharacterEllipsis" Visibility="{Binding ValueVisibility}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="RecordedActionsHeader" DockPanel.Dock="Bottom" Text="Recorded Test Actions" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" Margin="0,8,0,4"/>

                    <!-- Git #984 — Available Tests as a collapsed-by-default, color-coded-by-area TreeView
                         (was a flat ListBox), with a search box above it. Fills all remaining vertical
                         space as the DockPanel's last (LastChildFill) child. The tree is built in
                         code-behind (PopulateManifestsList/RenderManifestTree) so leaves can carry #983's
                         relative-path Tag and each area gets a stable palette color. -->
                    <DockPanel Margin="0,4,0,0">
                        <!-- Git #984 — search box, same overlay-placeholder trick as the Build Queue's #950
                             search (QueueSearchBox). Filters the tree to manifests whose filename or area
                             matches; matching areas auto-expand, non-matching hide; clearing restores the
                             collapsed-by-default state. -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBox x:Name="ManifestSearchBox"
                                     Height="26" Padding="6,4" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource Surface0Brush}"
                                     TextChanged="ManifestSearchBox_TextChanged"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="Search tests (name or area)"
                                       FontSize="12" Margin="8,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{StaticResource Subtext1Brush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ManifestSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid>
                            <TreeView x:Name="ManifestFilesTree"
                                      BorderThickness="0" Padding="0,2"
                                      Background="{StaticResource BaseBrush}"
                                      SelectedItemChanged="ManifestFilesTree_SelectedItemChanged"/>
                            <TextBlock x:Name="TxtNoManifests" Text="No test manifests found in test-manifests/." FontSize="10" Foreground="{StaticResource Subtext0Brush}" Margin="4,6,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </DockPanel>

                <!-- Git #952 — steps flyout (WPF Popup, same pattern as #864's Web Tools popout).
                     Opens when a manifest is clicked in ManifestFilesTree (#984) and lists that manifest's
                     apiTests / graphTests / postGraphApiTests / zohoTests / powerShellVerify / uiSteps.
                     Placement=Right flies it out beside the sidebar.
                     Separate from "Recorded Test Actions", which is untouched by manifest selection.
                     Git #988 — StaysOpen="False" caused a show-then-instant-close race: the same click that
                     selects a tree item and opens the popup was itself being read as an "outside click" by
                     WPF's automatic StaysOpen=False detection. Now StaysOpen="True" with explicit dismissal
                     (Opened/Closed below) instead of relying on that automatic mechanism. -->
                <Popup x:Name="ManifestStepsPopup"
                       PlacementTarget="{Binding ElementName=ManifestFilesTree}"
                       Placement="Right"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Opened="ManifestStepsPopup_Opened"
                       Closed="ManifestStepsPopup_Closed">
                    <Border Background="{StaticResource MantleBrush}"
                            BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            MinWidth="340" MaxWidth="460" MaxHeight="620">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="ManifestStepsFlyoutTitle" Text="Test Steps" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ManifestStepsFlyoutSubtitle" Text="" FontSize="10" Foreground="{StaticResource Subtext0Brush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="BtnCloseStepsFlyout" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="6,2" Click="BtnCloseStepsFlyout_Click" ToolTip="Close"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ManifestStepsFlyoutList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>

        </DockPanel>
    </Border>
</UserControl>

<UserControl x:Class="BuildConsole.Controls.FocusImmersiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:BuildConsole.Controls"
             mc:Ignorable="d"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown"
             d:DesignWidth="1200" d:DesignHeight="800">
    <!-- The dedicated, immersive full-screen Focus view (Shane's "video-game-esque zoom in on
         only what I'm working"). NOT a filtered version of the normal layout — a purpose-built
         arrangement of exactly four things about the ONE focused Epic (= the active focus
         milestone; there's no client-side epic→child linkage, so its child issues are the
         milestone's issues, real GitHub epics surfaced first): the Epic itself + progress/game
         layer up top, its child issues on the left, the live Claude build ("chat") driving it in
         the centre, and the game/achievements rail on the right. A cute companion layer
         (ctrl:FocusCharacterLayer) floats over the top for ambient life + real-event celebrations.
         The static skeleton is here; every dynamic list is populated in FocusImmersiveView.xaml.cs. -->
    <Grid Background="{StaticResource CrustBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= EPIC HEADER + game layer ================= -->
        <Border Grid.Row="0" Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface1Brush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎯" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FOCUS EPIC" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource BlueBrush}" Margin="1,0,0,1"/>
                            <TextBlock x:Name="EpicTitleText" FontSize="25" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                       Cursor="Hand" MouseLeftButtonUp="EpicTitle_Click"
                                       ToolTip="Open this epic's milestone detail tab"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- progress bar + numbers + honest ETA -->
                    <Grid Margin="2,14,40,0" MaxWidth="720" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ProgressBar x:Name="EpicProgressBar" Height="12" Minimum="0" Maximum="100" Value="0"
                                         Background="{StaticResource Surface1Brush}"
                                         Foreground="{StaticResource GreenBrush}" BorderThickness="0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock x:Name="EpicProgressText" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Subtext1Brush}"/>
                                <TextBlock x:Name="EpicEtaText" FontSize="12.5" Margin="14,0,0,0"
                                           Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- game chips + exit -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="10" Padding="12,4" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="PointsText" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource YellowBrush}" Text="⭐ 0 pts"/>
                        </Border>
                        <Button x:Name="ExitButton" Content="✕ Exit focus" Height="30" Padding="14,0" FontSize="12"
                                Cursor="Hand" Foreground="{StaticResource TextBrush}"
                                Background="{StaticResource Surface1Brush}" BorderThickness="0"
                                Click="ExitButton_Click"/>
                    </StackPanel>
                    <Border x:Name="AchievementChip" Background="{StaticResource Surface0Brush}" CornerRadius="10"
                            Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Right" Cursor="Hand"
                            Visibility="Collapsed" MouseLeftButtonUp="AchievementChip_Click"
                            ToolTip="Your Focus achievements">
                        <TextBlock x:Name="AchievementChipText" FontSize="11.5" Foreground="{StaticResource Subtext1Brush}"/>
                    </Border>
                    <TextBlock Text="Ctrl+Shift+F or Esc to leave focus" FontSize="10"
                               Foreground="{StaticResource Subtext0Brush}" HorizontalAlignment="Right" Margin="0,8,2,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= THREE COLUMNS ================= -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ==== LEFT: the Epic's children ==== -->
            <Border Grid.Column="0" Background="{StaticResource BaseBrush}"
                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12,16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧩" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CHILDREN" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ChildrenCountText" FontSize="11" Margin="7,0,0,0"
                                       Foreground="{StaticResource OverlayBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- local #47 refinement — drill breadcrumb: shown only when narrowed to ONE epic's
                         children. Back returns to the full milestone-wide list; "open" opens the epic
                         itself (its chat / live build) so drilling never removes that access. -->
                    <Border x:Name="DrillBreadcrumb" DockPanel.Dock="Top" Padding="12,0,12,8" Visibility="Collapsed">
                        <StackPanel>
                            <Button x:Name="DrillBackButton" Content="← Back to all children" HorizontalAlignment="Left"
                                    Padding="6,3" FontSize="11" Cursor="Hand" BorderThickness="0"
                                    Background="Transparent" Foreground="{StaticResource BlueBrush}"
                                    Click="DrillBack_Click"
                                    ToolTip="Show every child under this milestone again"/>
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="5" Padding="9,6" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚡" FontSize="12.5"
                                               Foreground="{StaticResource BlueBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DrillEpicTitleText" Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="DrillOpenEpicButton" Grid.Column="2" Content="open ▸" Padding="7,2" FontSize="10.5"
                                            Cursor="Hand" BorderThickness="0" Margin="8,0,0,0"
                                            Background="{StaticResource Surface1Brush}" Foreground="{StaticResource TextBrush}"
                                            Click="DrillOpenEpic_Click"
                                            ToolTip="Open this epic itself — its live build or linked chat"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                        <StackPanel x:Name="ChildrenList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ==== CENTRE: the live Claude build running the epic ==== -->
            <Border Grid.Column="1" Background="{StaticResource CrustBrush}">
                <DockPanel>
                    <!-- IN PROGRESS CHATS DOCK (quick switcher while in Focus mode) -->
                    <Border x:Name="InProgressDock" DockPanel.Dock="Top" Background="{StaticResource MantleBrush}"
                            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1" Padding="16,8"
                            Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="⚡" FontSize="12.5" Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="IN PROGRESS" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="InProgressChips" VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Padding="20,12,20,8"
                            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🤖" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CLAUDE ON THIS EPIC" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CentreStatusText" FontSize="11" Margin="8,0,0,0"
                                           Foreground="{StaticResource OverlayBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- one chip per on-epic build; selecting one streams its live transcript below -->
                            <WrapPanel x:Name="BuildChips" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- send box for the selected owned interactive build -->
                    <Border DockPanel.Dock="Bottom" Padding="16,10" Background="{StaticResource MantleBrush}"
                            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInput" Grid.Column="0" MinHeight="30" FontSize="12.5"
                                     Background="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource Surface2Brush}" BorderThickness="1" Padding="10,6"
                                     VerticalContentAlignment="Center" TextWrapping="Wrap" AcceptsReturn="False"
                                     IsEnabled="False" KeyDown="ChatInput_KeyDown"
                                     ToolTip="Send a message into the running build (Enter to send)"/>
                            <Button x:Name="SendButton" Grid.Column="1" Content="Send ▸" Height="32" Margin="8,0,0,0"
                                    Padding="14,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                    Foreground="{StaticResource CrustBrush}" Background="{StaticResource BlueBrush}"
                                    BorderThickness="0" IsEnabled="False" Click="SendButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- the live transcript / empty state fills the middle -->
                    <Grid>
                        <ScrollViewer x:Name="TranscriptScroller" VerticalScrollBarVisibility="Auto" Padding="20,12">
                            <StackPanel x:Name="TranscriptPanel"/>
                        </ScrollViewer>
                        <!-- calm empty state (no build running for this epic) with quick wins -->
                        <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="520" Visibility="Collapsed">
                            <TextBlock Text="🌙" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyStateTitle" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Subtext1Brush}" HorizontalAlignment="Center"
                                       TextAlignment="Center" Margin="0,10,0,0"
                                       Text="No build is running on this epic right now."/>
                            <TextBlock x:Name="EmptyStateHint" FontSize="12" Foreground="{StaticResource Subtext0Brush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,14"
                                       TextWrapping="Wrap"
                                       Text="Pick a child on the left to start one — or grab a quick win while you wait:"/>
                            <WrapPanel x:Name="SuggestionsPanel" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- local #47: a linked child's real Claude chat loads here IN PLACE
                             (the same WebView2 session the normal tabs use), so clicking a
                             child that has a chat stays immersive instead of dropping back to
                             the normal tab layout. Hidden until a chat is actually loaded. -->
                        <Border x:Name="ChatHost" Visibility="Collapsed"
                                Background="{StaticResource CrustBrush}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ==== RIGHT: game / progress / achievements rail ==== -->
            <Border Grid.Column="2" Background="{StaticResource BaseBrush}"
                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="🏅 PROGRESS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Subtext0Brush}"/>
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="8" Padding="14,12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="RailPointsText" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource YellowBrush}" Text="⭐ 0 pts"/>
                                <TextBlock x:Name="RailPaceText" FontSize="11.5" Foreground="{StaticResource Subtext1Brush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RailChecklistText" FontSize="11.5" Foreground="{StaticResource GreenBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <TextBlock x:Name="RailQueuedText" FontSize="11.5" Foreground="{StaticResource PeachBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🏆 ACHIEVEMENTS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Subtext0Brush}" Margin="0,18,0,0"/>
                        <StackPanel x:Name="AchievementsList" Margin="0,8,0,0"/>
                        <TextBlock x:Name="NoAchievementsText" FontSize="11.5" Foreground="{StaticResource Subtext0Brush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="None yet — close an issue under this epic to earn your first."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= playful companion layer (floats over all) ================= -->
        <ctrl:FocusCharacterLayer x:Name="CharacterLayer" Grid.Row="0" Grid.RowSpan="2"/>
    </Grid>
</UserControl>

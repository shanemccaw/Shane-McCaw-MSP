<UserControl x:Class="BuildConsole.Controls.LogViewerDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Log Viewer — full document tab. Port of ShaneBuilder's LogViewerDock
        (desktop/ShaneBuilder/MainWindow.xaml:2395-2574, code-behind
        MainWindow.xaml.cs:7488-8424) into BuildConsole per Git #2786, a
        sub-issue of #2784 (Feature: Log Viewer). Reads the real multi-source
        contract ported in #2785 (Services/LogService.cs) — same
        Sources/Archive rail, filter bar (search/regex/exclude/HIGHLIGHT/
        saved filters/level pills/history scrubber), center stream, right
        inspector (filter chips, line detail, scratch pad) and COLD/BURST
        (30s, self-cancels)/LIVE streaming model as the original.

        BuildConsole has no ShaneBuilder-style single-XAML-file
        visibility-toggled dock — documents are real UserControls hosted as
        TabItem.Content in EditorTabs (precedent: Controls/SqlDocumentView.xaml,
        opened via MainWindow.OpenSqlRunnerTab()). This follows that same
        pattern; see OpenLogViewerTab() in MainWindow.xaml.cs.

        LogPeekPanel (the 280px chat-dock flyout) is explicitly OUT of scope —
        that is #2784's own item 3, a separate sibling issue, not this one.

        Resource keys are BuildConsole's real Catppuccin palette
        (Themes/DarkTheme.xaml / Colors.xaml / Typography.xaml), not
        ShaneBuilder's "Brush.*"/"FontFamily.*" keys, which do not exist here.
    -->
    <Grid Background="{StaticResource CrustBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,10" Background="{StaticResource MantleBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Surface0Brush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="LogViewerStreamSwitch" Orientation="Horizontal" Margin="0,0,10,0"/>
                    <TextBlock x:Name="LogViewerStatusPill" VerticalAlignment="Center" Padding="8,3"
                               FontFamily="Cascadia Code, Consolas, Courier New" FontSize="10"
                               FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,12,0" Fill="{StaticResource SkyBrush}"/>
                    <TextBlock Text="Log Viewer" FontSize="{StaticResource SubHeaderFontSize}"
                               FontWeight="ExtraBold" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left rail — Sources / Archive -->
            <Border Grid.Column="0" Background="{StaticResource MantleBrush}"
                    BorderThickness="0,0,1,0" BorderBrush="{StaticResource Surface1Brush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,0">
                        <Button x:Name="BtnLogViewerRailSources" Content="Sources" Width="Auto" Height="26" Padding="10,0" Margin="0,0,4,0"
                                Style="{StaticResource IconButton}" Click="BtnLogViewerRailSources_Click" FontSize="10.5"/>
                        <Button x:Name="BtnLogViewerRailArchive" Content="Archive" Width="Auto" Height="26" Padding="10,0"
                                Style="{StaticResource IconButton}" Click="BtnLogViewerRailArchive_Click" FontSize="10.5"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LogViewerRailContent" Margin="8"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Center — filter bar + scrubber + stream -->
            <DockPanel Grid.Column="1">
                <Border x:Name="LogViewerArchiveBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                        Padding="14,8" Background="{StaticResource BaseBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource PeachBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Back to live sources" Cursor="Hand"
                                   MouseLeftButtonDown="LogViewerCloseArchiveBanner_Click"
                                   Foreground="{StaticResource PeachBrush}" FontSize="10.5" FontWeight="Bold"/>
                        <TextBlock x:Name="LogViewerArchiveBannerText"
                                   FontFamily="Cascadia Code, Consolas, Courier New" FontSize="10.5"
                                   Foreground="{StaticResource PeachBrush}"/>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Padding="12,10" BorderThickness="0,0,0,1"
                        BorderBrush="{StaticResource Surface0Brush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,6,0">
                                <TextBox x:Name="LogViewerSearchBox" Height="28"
                                         FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11.5"
                                         TextChanged="LogViewerSearchBox_TextChanged"/>
                                <TextBlock x:Name="LogViewerSearchPlaceholder" Text="Search (plain text)…" Margin="9,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11.5"
                                           Foreground="{StaticResource Subtext0Brush}"/>
                            </Grid>
                            <Button x:Name="BtnLogViewerRegex" Grid.Column="1" Content=".*" Width="30" Height="28" Margin="0,0,6,0"
                                    Style="{StaticResource IconButton}" Click="BtnLogViewerRegex_Click"
                                    ToolTip="Treat search as a regular expression"
                                    FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11"/>
                            <Grid Grid.Column="2">
                                <TextBox x:Name="LogViewerExcludeBox" Height="28"
                                         FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11"
                                         Foreground="{StaticResource RedBrush}"
                                         TextChanged="LogViewerExcludeBox_TextChanged"/>
                                <TextBlock x:Name="LogViewerExcludePlaceholder" Text="exclude, comma, separated…" Margin="9,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" FontSize="11"
                                           Foreground="{StaticResource Subtext0Brush}"/>
                            </Grid>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Button x:Name="BtnLogViewerHighlight" Content="HIGHLIGHT" Height="24" Padding="10,0" Margin="0,0,10,0"
                                    Style="{StaticResource IconButton}" Width="Auto"
                                    Click="BtnLogViewerHighlight_Click" FontSize="9" FontWeight="ExtraBold"/>
                            <StackPanel x:Name="LogViewerSavedFilters" Orientation="Horizontal" Margin="0,0,10,0"/>
                            <TextBlock Text="save current" Cursor="Hand" VerticalAlignment="Center"
                                       MouseLeftButtonDown="LogViewerSaveCurrentFilter_Click"
                                       Foreground="{StaticResource BlueBrush}" FontSize="9.5" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel x:Name="LogViewerLevelPills" Orientation="Horizontal" Margin="0,0,0,7"/>

                        <DockPanel>
                            <TextBlock x:Name="LogViewerScrubberReadout" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontFamily="Cascadia Code, Consolas, Courier New" FontSize="9.5"
                                       Foreground="{StaticResource Subtext0Brush}"/>
                            <Slider x:Name="LogViewerScrubber" Minimum="0" Maximum="1440" Value="0"
                                    ValueChanged="LogViewerScrubber_ValueChanged"
                                    ToolTip="History scrubber — minutes back from now"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LogViewerLinesPanel" Margin="10,6"/>
                </ScrollViewer>
            </DockPanel>

            <!-- Right inspector -->
            <Border Grid.Column="2" Background="{StaticResource MantleBrush}"
                    BorderThickness="1,0,0,0" BorderBrush="{StaticResource Surface1Brush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="11,9" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource Surface0Brush}">
                        <StackPanel>
                            <TextBlock Text="ACTIVE FILTERS" Margin="0,0,0,6" FontSize="9"
                                       FontWeight="ExtraBold" Foreground="{StaticResource Subtext0Brush}"/>
                            <WrapPanel x:Name="LogViewerFilterChips"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer DockPanel.Dock="Top" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LogViewerLineDetail" Margin="11,9"/>
                    </ScrollViewer>

                    <Border DockPanel.Dock="Bottom" Padding="11,9" BorderThickness="0,1,0,0"
                            BorderBrush="{StaticResource Surface0Brush}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock DockPanel.Dock="Left" Text="SCRATCH PAD" VerticalAlignment="Center"
                                           FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource Subtext0Brush}"/>
                                <TextBlock x:Name="LogViewerScratchCopy" Text="copy" HorizontalAlignment="Right" Cursor="Hand"
                                           Margin="0,0,10,0" MouseLeftButtonDown="LogViewerScratchCopy_Click"
                                           Foreground="{StaticResource BlueBrush}" FontSize="9.5" FontWeight="Bold"/>
                                <TextBlock x:Name="LogViewerScratchSendToChat" Text="send to chat" HorizontalAlignment="Right" Cursor="Hand"
                                           MouseLeftButtonDown="LogViewerScratchSendToChat_Click"
                                           Foreground="{StaticResource BlueBrush}" FontSize="9.5" FontWeight="Bold"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LogViewerScratchPad" Margin="11,8"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="BuildConsole.Controls.SqlRunnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- connection bar -->
            <RowDefinition Height="*"/>      <!-- editor + results -->
            <RowDefinition Height="Auto"/>   <!-- action bar -->
        </Grid.RowDefinitions>

        <!-- ── Connection bar ── -->
        <Border Grid.Row="0"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <!-- Connect button -->
                <Button DockPanel.Dock="Right"
                        Content="Connect"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        Click="Connect_Click"/>
                <!-- Status indicator -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Ellipse x:Name="ConnDot"
                             Width="8" Height="8"
                             Fill="{StaticResource Surface2Brush}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"/>
                    <TextBlock x:Name="ConnStatus"
                               Text="Disconnected"
                               FontSize="11"
                               Foreground="{StaticResource Subtext1Brush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Database ComboBox -->
                <ComboBox DockPanel.Dock="Right"
                          Width="160"
                          Height="26"
                          Margin="8,0,0,0"
                          FontSize="12">
                    <ComboBoxItem Content="(select database)" IsSelected="True"/>
                    <ComboBoxItem Content="eyecons_dev"/>
                    <ComboBoxItem Content="eyecons_staging"/>
                    <ComboBoxItem Content="msp_dev"/>
                </ComboBox>
                <!-- Server TextBox -->
                <TextBox Height="26"
                         FontSize="12"
                         Text="localhost:5432"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ── Editor + Results ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>   <!-- query editor -->
                <ColumnDefinition Width="4"/>    <!-- splitter -->
                <ColumnDefinition Width="3*"/>   <!-- results -->
            </Grid.ColumnDefinitions>

            <!-- Query editor -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{StaticResource MantleBrush}"
                        Padding="6,4">
                    <TextBlock Text="SQL Query"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext1Brush}"/>
                </Border>
                <TextBox x:Name="QueryEditor"
                         Grid.Row="1"
                         Style="{StaticResource EditorTextBox}"
                         Text="-- Write your SQL query here&#x0A;SELECT *&#x0A;FROM public.users&#x0A;LIMIT 100;"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Grid>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"/>

            <!-- Results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{StaticResource MantleBrush}"
                        Padding="6,4">
                    <DockPanel>
                        <TextBlock Text="Results"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext1Brush}"/>
                        <TextBlock x:Name="RowCountLabel"
                                   DockPanel.Dock="Right"
                                   Text="No results"
                                   FontSize="11"
                                   Foreground="{StaticResource Subtext1Brush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
                <!-- Columns generated at runtime from the real result set's own fields (SqlRunnerView.xaml.cs's RenderResults) — a query can return anything, not a fixed shape. -->
                <DataGrid x:Name="ResultsGrid"
                          Grid.Row="1"
                          IsReadOnly="True"
                          AutoGenerateColumns="True"
                          BorderThickness="0"/>
            </Grid>
        </Grid>

        <!-- ── Action bar ── -->
        <Border Grid.Row="2"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,1,0,0"
                Padding="8,5">
            <DockPanel>
                <Button Content="⚡ Execute  F5"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"
                        Click="Execute_Click"/>
                <Button Content="Format"
                        Padding="8,4"
                        Margin="0,0,8,0"/>
                <Button Content="Clear"
                        Padding="8,4"/>
                <!-- Git #940 — enabled only when the results grid actually has rows; sends a
                     markdown table of the current result set into the active Claude.ai chat. -->
                <Button x:Name="SendToChatButton"
                        Content="💬 Send to Chat"
                        Padding="8,4"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        ToolTip="Send these results as a markdown table into the currently active Claude.ai chat tab"
                        Click="SendToChat_Click"/>
                <TextBlock x:Name="ExecStatus"
                           DockPanel.Dock="Right"
                           Text="Ready"
                           FontSize="11"
                           Foreground="{StaticResource Subtext1Brush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

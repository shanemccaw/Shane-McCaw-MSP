<UserControl x:Class="BuildConsole.Controls.ServiceLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource CrustBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>  <!-- Context header & actions -->
            <RowDefinition Height="*"/>   <!-- Live log output stream -->
        </Grid.RowDefinitions>

        <!-- ── Header Bar ── -->
        <Border Grid.Row="0"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="10,0">
            <DockPanel VerticalAlignment="Center">

                <!-- Service Status Dot -->
                <Ellipse x:Name="StatusDot"
                         Width="8" Height="8"
                         Fill="{StaticResource Surface2Brush}"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"/>

                <!-- Service Icon & Name -->
                <TextBlock x:Name="ServiceIconText"
                           Text="🌐"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <TextBlock x:Name="ServiceTitleText"
                           Text="SERVICE NAME"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <!-- Port & Directory Badge -->
                <Border Background="{StaticResource Surface0Brush}"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ServicePortText"
                               Text=":5173"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource BlueBrush}"/>
                </Border>

                <TextBlock x:Name="ServicePathText"
                           Text="artifacts/..."
                           FontSize="11"
                           Foreground="{StaticResource Subtext0Brush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="300"
                           Margin="0,0,10,0"/>

                <!-- Right Action Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Start Button -->
                    <Button x:Name="BtnStartService"
                            Content="▶ Start"
                            Style="{StaticResource ChipButton}"
                            Height="24"
                            Padding="8,0"
                            Margin="0,0,6,0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BtnStartService_Click"
                            ToolTip="Start this service process"/>

                    <!-- Stop Button -->
                    <Button x:Name="BtnStopService"
                            Content="⏹ Stop"
                            Style="{StaticResource ChipButton}"
                            Height="24"
                            Padding="8,0"
                            Margin="0,0,6,0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BtnStopService_Click"
                            ToolTip="Stop this service process"/>

                    <!-- Open in Browser Button -->
                    <Button x:Name="BtnBrowseService"
                            Content="🌐 Browse"
                            Style="{StaticResource ChipButton}"
                            Height="24"
                            Padding="8,0"
                            Margin="0,0,6,0"
                            FontSize="11"
                            Cursor="Hand"
                            Click="BtnBrowseService_Click"
                            ToolTip="Open in default browser"/>

                    <!-- Pause/Resume Button -->
                    <Button x:Name="BtnPauseLog"
                            Content="⏸ Pause"
                            Style="{StaticResource ChipButton}"
                            Height="24"
                            Padding="8,0"
                            Margin="0,0,6,0"
                            FontSize="11"
                            Cursor="Hand"
                            Click="BtnPauseLog_Click"
                            ToolTip="Pause/Resume scrolling"/>

                    <!-- Clear Log Button -->
                    <Button x:Name="BtnClearLog"
                            Content="⟳ Clear"
                            Style="{StaticResource ChipButton}"
                            Height="24"
                            Padding="6,0"
                            FontSize="11"
                            Cursor="Hand"
                            Click="BtnClearLog_Click"
                            ToolTip="Clear visible log buffer"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ── Live Log Stream Output ── -->
        <TextBox Grid.Row="1"
                 x:Name="LogOutputBox"
                 IsReadOnly="True"
                 Style="{StaticResource TerminalOutputBox}"
                 Text="[Service] Waiting for output…"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>

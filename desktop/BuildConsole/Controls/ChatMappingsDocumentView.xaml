<UserControl x:Class="BuildConsole.Controls.ChatMappingsDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BaseBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Action toolbar -->
            <RowDefinition Height="*"/>    <!-- Datagrid -->
        </Grid.RowDefinitions>

        <!-- Action toolbar -->
        <Border Grid.Row="0" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="💬 Chat Database Mappings" FontSize="14" FontWeight="Bold" Foreground="{StaticResource MauveBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnReload" Content="↻ Refresh" Style="{StaticResource IconButton}" Padding="8,4" Margin="0,0,12,0" Click="BtnReload_Click"/>
                    <TextBlock Text="Filter:" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtFilter" Style="{StaticResource SearchTextBox}" Width="200" Padding="6,4,24,4" TextChanged="TxtFilter_TextChanged" Margin="0,0,12,0"/>
                    <!-- Shane, 2026-08-30 — "I change the Linked Issue number, and they do not
                         save state when I leave the box... Just give me a button I can click
                         save next to the filter." A per-cell LostFocus save can miss (a DataGrid
                         row losing keyboard focus while switching tabs/panes doesn't always fire
                         it reliably) — this is the explicit, unconditional backstop: force-saves
                         every field (title/category/epic/issues) on every row whose in-memory
                         value differs from what was last actually written. See BtnSaveAll_Click. -->
                    <Button x:Name="BtnSaveAll" Content="💾 Save Changes" Style="{StaticResource IconButton}" Padding="8,4" Foreground="{StaticResource GreenBrush}" Click="BtnSaveAll_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" Text="Loading chats..." Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Datagrid -->
        <DataGrid Grid.Row="1" x:Name="MappingsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Background="Transparent"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource Surface0Brush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{StaticResource MantleBrush}"
                  Foreground="{StaticResource TextBrush}"
                  RowHeaderWidth="0"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  Padding="8">
            <DataGrid.Resources>
                <!-- Modern header style -->
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="{StaticResource MantleBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource MauveBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Surface0Brush}"/>
                </Style>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <!-- Chat Title — Shane: "I need a way to change the name of the chat title." -->
                <DataGridTemplateColumn Header="Chat Title" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💬" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource BlueBrush}"/>
                                <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         LostFocus="TitleTextBox_LostFocus"
                                         VerticalAlignment="Center"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Claude URL / Conversation ID -->
                <DataGridTemplateColumn Header="Claude Chat Link" Width="1.5*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayUrl}" Style="{StaticResource IconButton}" Foreground="{StaticResource SapphireBrush}" Click="BtnOpenClaude_Click" HorizontalAlignment="Left" ToolTip="Open this chat in a new tab"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Linked Epic (combobox) -->
                <DataGridTemplateColumn Header="Linked Epic" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=EpicsList}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding LinkedEpic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="EpicComboBox_SelectionChanged"
                                      DropDownClosed="EpicComboBox_DropDownClosed"
                                      LostFocus="EpicComboBox_LostFocus"
                                      IsEditable="True"
                                      IsReadOnly="False"
                                      TextSearch.TextPath="DisplayName"
                                      StaysOpenOnEdit="True"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Associated Issues (textbox) -->
                <DataGridTemplateColumn Header="Linked Issues/Milestones (comma list)" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding AssociatedIssuesString, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     LostFocus="IssuesTextBox_LostFocus"
                                     VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Account — Shane: "select which account the link belongs too... Primary
                     or Secondary." Real bt_chats.account column (Git #1480). -->
                <DataGridTemplateColumn Header="Account" Width="0.8*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding Account, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="AccountComboBox_SelectionChanged"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="Primary" Tag="primary"/>
                                <ComboBoxItem Content="Secondary" Tag="secondary"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Category (textbox) -->
                <DataGridTemplateColumn Header="Category" Width="1*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     LostFocus="CategoryTextBox_LostFocus"
                                     VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Actions -->
                <DataGridTemplateColumn Header="Actions" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑️ Delete" 
                                    Style="{StaticResource IconButton}" 
                                    Foreground="{StaticResource RedBrush}" 
                                    Click="BtnDeleteChat_Click"
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

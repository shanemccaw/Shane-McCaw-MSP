<UserControl x:Class="BuildConsole.Controls.ApiRunnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource MauveBrush}"/>
                        <TextBlock Text="API Endpoint Runner &amp; Explorer" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Scan routes dynamically from the local API server, filter by URL, and execute requests with inline response details."
                               FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnRescan" Style="{StaticResource SecondaryButton}" Content="⟳ Rescan Endpoints" VerticalAlignment="Center" Padding="12,6" Click="BtnRescan_Click"/>
            </Grid>
        </Border>

        <!-- Main Body split in two columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left pane: Endpoint list -->
            <Grid Grid.Column="0" Background="{StaticResource CrustBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <Grid Grid.Row="0" Margin="12,12,12,6">
                    <TextBox Grid.Row="0" x:Name="TxtSearch" Height="30" Padding="6,4"
                             VerticalContentAlignment="Center" FontSize="12"
                             Background="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1"
                             GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Grid.Row="0" x:Name="SearchPlaceholder" IsHitTestVisible="False" Text="🔍 Search endpoints..."
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"
                               Foreground="{StaticResource OverlayBrush}" FontSize="12"/>
                </Grid>

                <!-- Endpoint list -->
                <ListView Grid.Row="1" x:Name="LstEndpoints" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="LstEndpoints_SelectionChanged" Padding="6">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Padding" Value="6,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" Width="55" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Method}" Value="GET">
                                                    <Setter Property="Background" Value="#25A6E3A1"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Method}" Value="POST">
                                                    <Setter Property="Background" Value="#257C8CF0"/> <!-- Git #2126: was #2589B4FA (Blue wash) -->
                                                    <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Method}" Value="PUT">
                                                    <Setter Property="Background" Value="#25FAB387"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource PeachBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Method}" Value="PATCH">
                                                    <Setter Property="Background" Value="#25FAB387"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource PeachBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Method}" Value="DELETE">
                                                    <Setter Property="Background" Value="#25F38BA8"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Method}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Method}" Value="GET">
                                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Method}" Value="POST">
                                                        <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Method}" Value="PUT">
                                                        <Setter Property="Foreground" Value="{StaticResource PeachBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Method}" Value="PATCH">
                                                        <Setter Property="Foreground" Value="{StaticResource PeachBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Method}" Value="DELETE">
                                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Route}" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SourceFile}" Foreground="{StaticResource Subtext1Brush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Count -->
                <TextBlock Grid.Row="2" x:Name="TxtEndpointCount" Margin="12" FontSize="11" Foreground="{StaticResource Subtext0Brush}" HorizontalAlignment="Left" Text="0 endpoints loaded"/>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Surface0Brush}"/>

            <!-- Right pane: Runner -->
            <Grid Grid.Column="2" Background="{StaticResource BaseBrush}">
                <Grid x:Name="GridRunnerPlaceholder" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-40,0,0">
                        <TextBlock Text="⚡" FontSize="48" Foreground="{StaticResource OverlayBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select an API endpoint to execute" FontSize="14" Foreground="{StaticResource Subtext0Brush}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="GridRunnerContent" Visibility="Collapsed" Padding="20">
                    <StackPanel>
                        <!-- Selected route metadata -->
                        <Border CornerRadius="6" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock x:Name="TxtSelectedMethod" Text="GET" FontWeight="Bold" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSelectedRoute" Text="/api/route" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" x:Name="TxtSelectedFile" Text="File: admin-build-tracker.ts" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Base Server URL -->
                        <TextBlock Text="API SERVER BASE URL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OverlayBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBaseUrl" Style="{StaticResource EditorTextBox}" Margin="0,0,0,14" VerticalContentAlignment="Center" Padding="8,6" FontSize="12"/>

                        <!-- Authorization (Bearer Token) -->
                        <TextBlock Text="AUTHORIZATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OverlayBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- masked input -->
                            <PasswordBox x:Name="TxtBearerToken" Grid.Column="0"
                                         Height="30" Padding="8,0" FontSize="12" FontFamily="Consolas"
                                         Background="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1"
                                         VerticalContentAlignment="Center"
                                         PasswordChar="●"/>
                            <!-- plain-text mirror (shown when eye is toggled) -->
                            <TextBox x:Name="TxtBearerTokenPlain" Grid.Column="0"
                                     Height="30" Padding="8,6" FontSize="12" FontFamily="Consolas"
                                     Background="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1"
                                     Visibility="Collapsed"
                                     TextChanged="TxtBearerTokenPlain_TextChanged"/>
                            <Button x:Name="BtnToggleBearerToken" Grid.Column="1" Content="👁" ToolTip="Show / hide token"
                                    Width="30" Height="30" Margin="4,0,0,0" Padding="0"
                                    Click="BtnToggleBearerToken_Click"/>
                            <Button x:Name="BtnClearBearerToken" Grid.Column="2" Content="✕" ToolTip="Clear token"
                                    Width="30" Height="30" Margin="4,0,0,0" Padding="0"
                                    Click="BtnClearBearerToken_Click"/>
                        </Grid>

                        <!-- Quick-Login expander: auto-fills token via POST /api/auth/login -->
                        <Expander x:Name="ExpQuickLogin" Header="🔑  Get Token via Login" Foreground="{StaticResource Subtext0Brush}" FontSize="11"
                                  Margin="0,0,0,14" Background="Transparent" BorderThickness="0">
                            <Border Background="{StaticResource MantleBrush}" CornerRadius="4" Padding="12,10" Margin="0,6,0,0"
                                    BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Calls POST /api/auth/login and auto-fills the Bearer token above." FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="EMAIL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OverlayBrush}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtLoginEmail" Style="{StaticResource EditorTextBox}" Height="28" Padding="8,4" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OverlayBrush}" Margin="0,0,0,3"/>
                                            <PasswordBox x:Name="TxtLoginPassword" Height="28" Padding="8,0" FontSize="12"
                                                         Background="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}"
                                                         BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1"
                                                         VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel>
                                        <Button x:Name="BtnQuickLogin" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}"
                                                Content="🔑 Login &amp; Fill Token" Padding="12,6" Click="BtnQuickLogin_Click"/>
                                        <TextBlock x:Name="TxtLoginStatus" Margin="12,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Subtext0Brush}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Query parameters -->
                        <TextBlock Text="QUERY PARAMETERS (Key=Value, one per line or raw ?a=b)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OverlayBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtQueryParams" Style="{StaticResource EditorTextBox}" Height="50" Margin="0,0,0,14" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" FontSize="12" FontFamily="Consolas"/>

                        <!-- Request body (JSON) -->
                        <TextBlock x:Name="LblRequestBody" Text="REQUEST BODY (JSON)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OverlayBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRequestBody" Style="{StaticResource EditorTextBox}" Height="110" Margin="0,0,0,16" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" FontSize="12" FontFamily="Consolas"/>

                        <!-- Actions row -->
                        <Button x:Name="BtnExecute" Style="{StaticResource PrimaryButton}" Content="⚡ Send Request" FontSize="13" Padding="20,10" HorizontalAlignment="Left" Click="BtnExecute_Click" Margin="0,0,0,20"/>

                        <!-- Execution Results panel -->
                        <Border x:Name="PanelResponse" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Surface0Brush}" Padding="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="RESPONSE DETAILS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OverlayBrush}" Margin="0,0,0,10"/>
                                
                                <!-- Metadata row (status, time) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border x:Name="BorderHttpStatus" CornerRadius="3" Padding="8,4" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtHttpStatus" Text="200 OK" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <TextBlock x:Name="TxtElapsed" Text="45ms" Foreground="{StaticResource Subtext0Brush}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Response Headers -->
                                <Expander Header="Response Headers" Foreground="{StaticResource Subtext0Brush}" FontSize="11" Margin="0,0,0,10" Background="Transparent" BorderThickness="0">
                                    <TextBox x:Name="TxtHeaders" Style="{StaticResource TerminalOutputBox}" Margin="0,6,0,0" Height="100" TextWrapping="Wrap" IsReadOnly="True" FontSize="11"/>
                                </Expander>

                                <!-- Response Body -->
                                <TextBlock Text="RESPONSE BODY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OverlayBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtResponseBody" Style="{StaticResource TerminalOutputBox}" Height="300" TextWrapping="Wrap" IsReadOnly="True" FontSize="12" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

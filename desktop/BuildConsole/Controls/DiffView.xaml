<UserControl x:Class="BuildConsole.Controls.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             MinWidth="1" MinHeight="1"
             Loaded="OnLoaded"
             DataContextChanged="OnDataContextChanged">

    <!--
      One detected code diff, rendered as a real AvalonEdit diff view (per-line
      green/red backgrounds + a diff-aware line-number gutter + underlying-language
      syntax highlighting are all attached in code-behind). Chrome mirrors the chat
      pane's own dark palette (ChatPaneBrushes.xaml) so it reads as part of the same
      surface, while the rounded card + ± glyph + green/red stat counts keep it
      visually distinct from the grey narrative-text and tool-chip bubbles.
    -->
    <Border Background="{StaticResource ChatPane.Surface}"
            BorderBrush="{StaticResource ChatPane.BorderStrong}"
            BorderThickness="1" CornerRadius="8" ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: ± glyph + file path + "+A −R" stats -->
            <Border Grid.Row="0" Background="{StaticResource ChatPane.CanvasChrome}"
                    BorderBrush="{StaticResource ChatPane.BorderSubtle90}" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0" Padding="11,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#177;" FontFamily="{StaticResource ChatPane.MonoFont}"
                               FontWeight="Bold" FontSize="13" Foreground="{StaticResource ChatPane.AccentText1}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="FileNameText" Text="Code change"
                               FontFamily="{StaticResource ChatPane.MonoFont}" FontSize="11.5"
                               Foreground="{StaticResource ChatPane.Muted2}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="AddStatText" Text="+0" FontFamily="{StaticResource ChatPane.MonoFont}"
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ChatPane.Success}"/>
                        <TextBlock x:Name="RemoveStatText" Text="&#8722;0" FontFamily="{StaticResource ChatPane.MonoFont}"
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ChatPane.Danger}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The diff body. Highlighting / line-number margin / row backgrounds are
                 all wired in OnLoaded. ShowLineNumbers stays off — the custom gutter
                 shows real diff-aware file line numbers instead. -->
            <avalonedit:TextEditor x:Name="Editor" Grid.Row="1"
                                   IsReadOnly="True"
                                   Background="Transparent"
                                   Foreground="{StaticResource ChatPane.Text3}"
                                   FontFamily="Cascadia Code, Menlo, Consolas"
                                   FontSize="12.5"
                                   Padding="4,6,8,6"
                                   ShowLineNumbers="False"
                                   WordWrap="False"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   IsHitTestVisible="True"/>
        </Grid>
    </Border>
</UserControl>

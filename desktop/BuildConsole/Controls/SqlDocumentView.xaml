<UserControl x:Class="BuildConsole.Controls.SqlDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">

    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- editor + results -->
            <RowDefinition Height="Auto"/>   <!-- action bar -->
        </Grid.RowDefinitions>

        <!-- ── Editor + Results ── -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>   <!-- query editor -->
                <RowDefinition Height="4"/>    <!-- splitter -->
                <RowDefinition Height="3*"/>   <!-- results -->
            </Grid.RowDefinitions>

            <!-- Query editor -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{StaticResource MantleBrush}"
                        Padding="6,4">
                    <TextBlock Text="SQL Query"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext1Brush}"/>
                </Border>
                <avalonedit:TextEditor x:Name="QueryEditor"
                                       Grid.Row="1"
                                       Background="{StaticResource CrustBrush}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="13"
                                       Padding="8"
                                       ShowLineNumbers="True"
                                       LineNumbersForeground="{StaticResource Surface2Brush}"
                                       WordWrap="False"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <GridSplitter Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"/>

            <!-- Results panel -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- header bar -->
                    <RowDefinition Height="*"/>       <!-- content -->
                </Grid.RowDefinitions>

                <!-- Results header bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,1,0,0"
                        Padding="6,5">
                    <DockPanel>
                        <TextBlock Text="Results"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext1Brush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="RowCountLabel"
                                       Text="No results"
                                       FontSize="11"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Button x:Name="CopyTableBtn"
                                    Content="⎘ Copy CSV"
                                    Padding="7,3"
                                    Margin="0,0,5,0"
                                    FontSize="11"
                                    IsEnabled="False"
                                    ToolTip="Copy all results as CSV"
                                    Click="CopyTableBtn_Click"/>
                            <Button x:Name="CopyJsonBtn"
                                    Content="⎘ Copy JSON"
                                    Padding="7,3"
                                    Margin="0,0,10,0"
                                    FontSize="11"
                                    IsEnabled="False"
                                    ToolTip="Copy all results as JSON"
                                    Click="CopyJsonBtn_Click"/>
                            <Border CornerRadius="10"
                                    Background="{StaticResource Surface0Brush}"
                                    Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="ViewTableBtn"
                                                  Content="Table"
                                                  Padding="10,3"
                                                  FontSize="11"
                                                  IsChecked="True"
                                                  Click="ViewTableBtn_Click"/>
                                    <ToggleButton x:Name="ViewJsonBtn"
                                                  Content="JSON"
                                                  Padding="10,3"
                                                  FontSize="11"
                                                  IsChecked="False"
                                                  Click="ViewJsonBtn_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Table view: one DataGrid per statement, stacked -->
                <ScrollViewer x:Name="TableScrollView"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="{StaticResource BaseBrush}">
                    <StackPanel x:Name="ResultsStack"/>
                </ScrollViewer>

                <!-- JSON view -->
                <avalonedit:TextEditor x:Name="JsonView"
                                       Grid.Row="1"
                                       Background="{StaticResource CrustBrush}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="12"
                                       Padding="8"
                                       IsReadOnly="True"
                                       WordWrap="False"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"
                                       Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- ── Action bar ── -->
        <Border Grid.Row="1"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,1,0,0"
                Padding="8,5">
            <DockPanel>
                <Button Content="⚡ Execute  F5"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"
                        Click="Execute_Click"/>
                <!-- Close button (only visible when inline) -->
                <Button x:Name="CloseInlineBtn"
                        Content="✕ Close"
                        Style="{StaticResource IconButton}"
                        Foreground="{StaticResource RedBrush}"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="CloseInline_Click"/>
                <Button Content="Format"
                        Padding="8,4"
                        Margin="0,0,8,0"/>
                <Button Content="Clear"
                        Padding="8,4"/>
                <Button x:Name="SendToChatButton"
                        Content="💬 Send to Chat"
                        Padding="8,4"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        ToolTip="Send these results as a markdown table into the currently active Claude.ai chat tab"
                        Click="SendToChat_Click"/>
                <TextBlock x:Name="ExecStatus"
                           DockPanel.Dock="Right"
                           Text="Ready"
                           FontSize="11"
                           Foreground="{StaticResource Subtext1Brush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="BuildConsole.Controls.SqlDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:BuildConsole.Controls"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">

    <UserControl.Resources>
        <Style x:Key="SegmentedToggleBtn" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Subtext0Brush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueBrush}"/>
                                <Setter Property="Foreground" Value="#11111B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SapphireBrush}"/>
                                <Setter Property="Foreground" Value="#11111B"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- top action toolbar -->
            <RowDefinition Height="*"/>      <!-- editor + results -->
        </Grid.RowDefinitions>

        <!-- ── Top Action Toolbar ── -->
        <Border Grid.Row="0"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="⚡ Execute  F5"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Click="Execute_Click"/>
                    <Button x:Name="SendToChatButton"
                            Content="💬 Send to Chat"
                            Padding="8,4"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            ToolTip="Send these results into the currently active Claude.ai chat tab"
                            Click="SendToChat_Click"/>
                    <Button Content="Format"
                            Padding="8,4"
                            Margin="0,0,8,0"/>
                    <Button Content="Clear"
                            Padding="8,4"
                            Margin="0,0,8,0"/>
                    <!-- Close button (only visible when inline) -->
                    <Button x:Name="CloseInlineBtn"
                            Content="✕ Close"
                            Style="{StaticResource IconButton}"
                            Foreground="{StaticResource RedBrush}"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="CloseInline_Click"/>
                </StackPanel>

                <TextBlock x:Name="ExecStatus"
                           DockPanel.Dock="Right"
                           Text="Ready"
                           FontSize="11"
                           Foreground="{StaticResource Subtext1Brush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- ── Editor + Results ── -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>   <!-- query editor -->
                <RowDefinition Height="4"/>    <!-- splitter -->
                <RowDefinition Height="3*"/>   <!-- results -->
            </Grid.RowDefinitions>

            <!-- Query editor -->
            <Grid Grid.Row="0">
                <!-- Ambient Sailor Duck Watermark when editor is sparse/empty -->
                <ctrl:SailorDuckWatermarkControl x:Name="SqlDuckWatermark"
                                                 MascotSize="220"
                                                 WatermarkOpacity="0.18"
                                                 CustomText="Captain Donald ready for queries! ⚓"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"/>

                <avalonedit:TextEditor x:Name="QueryEditor"
                                       Background="Transparent"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="13"
                                       Padding="8"
                                       ShowLineNumbers="True"
                                       LineNumbersForeground="{StaticResource Surface2Brush}"
                                       WordWrap="False"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <GridSplitter Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"/>

            <!-- Results panel -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- header bar -->
                    <RowDefinition Height="*"/>       <!-- content -->
                </Grid.RowDefinitions>

                <!-- Results header bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,1,0,0"
                        Padding="6,5">
                    <DockPanel>
                        <TextBlock Text="Results"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext1Brush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="RowCountLabel"
                                       Text="No results"
                                       FontSize="11"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Button x:Name="CopyTableBtn"
                                    Content="⎘ Copy CSV"
                                    Padding="7,3"
                                    Margin="0,0,5,0"
                                    FontSize="11"
                                    IsEnabled="False"
                                    ToolTip="Copy all results as CSV"
                                    Click="CopyTableBtn_Click"/>
                            <Button x:Name="CopyJsonBtn"
                                    Content="⎘ Copy JSON"
                                    Padding="7,3"
                                    Margin="0,0,10,0"
                                    FontSize="11"
                                    IsEnabled="False"
                                    ToolTip="Copy all results as JSON"
                                    Click="CopyJsonBtn_Click"/>
                            <Border CornerRadius="8"
                                    Background="{StaticResource MantleBrush}"
                                    BorderBrush="{StaticResource Surface0Brush}"
                                    BorderThickness="1"
                                    Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="ViewTableBtn"
                                                  Content="Table"
                                                  Style="{StaticResource SegmentedToggleBtn}"
                                                  IsChecked="True"
                                                  Click="ViewTableBtn_Click"/>
                                    <ToggleButton x:Name="ViewJsonBtn"
                                                  Content="JSON"
                                                  Style="{StaticResource SegmentedToggleBtn}"
                                                  IsChecked="False"
                                                  Click="ViewJsonBtn_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Table view: one DataGrid per statement, stacked -->
                <ScrollViewer x:Name="TableScrollView"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="{StaticResource BaseBrush}">
                    <StackPanel x:Name="ResultsStack"/>
                </ScrollViewer>

                <!-- JSON view -->
                <avalonedit:TextEditor x:Name="JsonView"
                                       Grid.Row="1"
                                       Background="{StaticResource CrustBrush}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="12"
                                       Padding="8"
                                       IsReadOnly="True"
                                       WordWrap="False"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"
                                       Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

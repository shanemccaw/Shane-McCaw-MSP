<UserControl x:Class="BuildConsole.Controls.IssueDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource CrustBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>  <!-- context header -->
            <RowDefinition Height="*"/>   <!-- body + comments -->
        </Grid.RowDefinitions>

        <!-- ── Context header ── -->
        <Border Grid.Row="0"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="10,0">
            <DockPanel VerticalAlignment="Center">

                <Border x:Name="NumberBadge"
                        Background="{StaticResource Surface0Brush}"
                        CornerRadius="3"
                        Padding="6,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="NumberBadgeText"
                               Text=""
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource PeachBrush}"/>
                </Border>

                <TextBlock x:Name="TitleLabel"
                           Text="SELECT AN ISSUE"
                           FontSize="12"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>

                <Border x:Name="StateBadge"
                        DockPanel.Dock="Right"
                        Background="{StaticResource Surface0Brush}"
                        CornerRadius="3"
                        Padding="6,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                    <TextBlock x:Name="StateBadgeText"
                               Text=""
                               FontSize="11"
                               Foreground="{StaticResource Subtext1Brush}"/>
                </Border>

            </DockPanel>
        </Border>

        <!-- ── Real issue body + comment thread (Git #840 — fetched via GitHubApiClient GET /issues/{n} + GET /issues/{n}/comments) ── -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12">
            <StackPanel x:Name="ContentPanel">

                <TextBlock x:Name="LoadingText"
                           Text=""
                           FontSize="12"
                           Foreground="{StaticResource Subtext1Brush}"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="BodyLabel"
                           Text="DESCRIPTION"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Subtext0Brush}"
                           Margin="0,0,0,4"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="BodyText"
                           Text=""
                           FontSize="12"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <TextBlock x:Name="CommentsLabel"
                           Text="COMMENTS"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Subtext0Brush}"
                           Margin="0,0,0,4"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="CommentsList"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Empty state overlay -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.4">
            <TextBlock Text="&#xE8A4;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="32"
                       Foreground="{StaticResource Surface2Brush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Click an issue in the Git Board tree to see its real description and comments"
                       FontSize="12"
                       Foreground="{StaticResource Subtext1Brush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

    </Grid>
</UserControl>

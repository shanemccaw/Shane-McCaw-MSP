<UserControl x:Class="BuildConsole.Controls.IssueDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:BuildConsole.Controls">

    <Grid Background="{StaticResource CrustBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>  <!-- context header -->
            <RowDefinition Height="*"/>   <!-- body + comments -->
        </Grid.RowDefinitions>

        <!-- ── Context header ── -->
        <Border Grid.Row="0"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="10,0">
            <DockPanel VerticalAlignment="Center">

                <Border x:Name="NumberBadge"
                        Background="{StaticResource Surface0Brush}"
                        CornerRadius="3"
                        Padding="6,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="NumberBadgeText"
                               Text=""
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource PeachBrush}"/>
                </Border>

                <TextBox x:Name="TitleLabel"
                         Text="SELECT AN ISSUE"
                         FontSize="12"
                         Foreground="{StaticResource TextBrush}"
                         VerticalAlignment="Center"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         Margin="0,0,0,0"/>

                <Border x:Name="StateBadge"
                        DockPanel.Dock="Right"
                        Background="{StaticResource Surface0Brush}"
                        CornerRadius="3"
                        Padding="6,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                    <TextBlock x:Name="StateBadgeText"
                               Text=""
                               FontSize="11"
                               Foreground="{StaticResource Subtext1Brush}"/>
                </Border>

            </DockPanel>
        </Border>

        <!-- ── Real issue body + comment thread (Left) and Actions Column (Right) ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="340" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">

                <!-- Shane, 2026-08-30 — "I should be able to respond to the issue and post
                     a comment directly to it." Docked at the bottom (not inside the
                     scrolling body/comments area below) so it stays put regardless of scroll
                     position — a real compose box, not a read-only view. Posts via the new
                     GitHubApiClient.AddIssueCommentAsync and appends the result to
                     CommentsList immediately rather than waiting on a full reload. -->
                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,1,0,0"
                        Padding="10">
                    <DockPanel>
                        <Button x:Name="BtnPostComment"
                                DockPanel.Dock="Right"
                                Content="Post Comment"
                                Padding="10,0"
                                Margin="8,0,0,0"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource BlueBrush}"
                                Foreground="{StaticResource CrustBrush}"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnPostComment_Click"/>
                        <TextBox x:Name="CommentBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="52"
                                 MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource Surface0Brush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource Surface1Brush}"
                                 BorderThickness="1"
                                 Padding="6"
                                 FontSize="12"/>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12">
                    <StackPanel x:Name="ContentPanel">

                        <TextBlock x:Name="LoadingText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="{StaticResource Subtext1Brush}"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="EpicLabel"
                                   Text="PARENT EPIC"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext0Brush}"
                                   Margin="0,0,0,4"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="EpicText"
                                   FontSize="12"
                                   Margin="0,0,0,16"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="BodyLabel"
                                   Text="DESCRIPTION"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext0Brush}"
                                   Margin="0,0,0,4"
                                   Visibility="Collapsed"/>
                        <RichTextBox x:Name="BodyText"
                                     IsReadOnly="True"
                                     IsDocumentEnabled="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Margin="0,0,0,16"/>

                        <TextBlock x:Name="CommentsLabel"
                                   Text="COMMENTS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext0Brush}"
                                   Margin="0,0,0,4"
                                   Visibility="Collapsed"/>

                        <ItemsControl x:Name="CommentsList"/>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Surface0Brush}"/>

            <!-- Shane, 2026-08-30 — this column shows one of two things, toggled by
                 ShowChatInsteadOfActions: the original SQL-migration/test-manifest
                 ActionsPanel (default, used by the Git Board's detail tabs), or — for
                 Batter Up / AI Batter Up's document tabs — a live Claude.ai chat resolved
                 by walking up the issue's parent-epic chain (see RenderChatColumn). Only
                 one is ever visible; the other's content is simply not built. -->
            <Grid Grid.Column="2">
                <ScrollViewer x:Name="ActionsScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{StaticResource MantleBrush}"
                              Padding="10">
                    <StackPanel x:Name="ActionsPanel"/>
                </ScrollViewer>

                <Border x:Name="ChatColumnHost"
                        Background="{StaticResource CrustBrush}"
                        Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- Empty state / sparse document overlay with Donald Duck in sailboat -->
        <ctrl:SailorDuckWatermarkControl x:Name="EmptyState"
                                         Grid.Row="1"
                                         MascotSize="260"
                                         WatermarkOpacity="0.85"
                                         CustomText="Ahoy! Select an issue from the Git Board to inspect details ⛵"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>

    </Grid>
</UserControl>

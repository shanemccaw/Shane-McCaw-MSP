<UserControl x:Class="BuildConsole.Controls.IssueDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:BuildConsole.Controls">

    <Grid Background="{StaticResource CrustBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>  <!-- context header -->
            <RowDefinition Height="*"/>   <!-- body + comments -->
        </Grid.RowDefinitions>

        <!-- ── Context header ── -->
        <Border Grid.Row="0"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="10,0">
            <DockPanel VerticalAlignment="Center">

                <Border x:Name="NumberBadge"
                        Background="{StaticResource Surface0Brush}"
                        CornerRadius="3"
                        Padding="6,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="NumberBadgeText"
                               Text=""
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource PeachBrush}"/>
                </Border>

                <TextBox x:Name="TitleLabel"
                         Text="SELECT AN ISSUE"
                         FontSize="12"
                         Foreground="{StaticResource TextBrush}"
                         VerticalAlignment="Center"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         Margin="0,0,0,0"/>

                <Border x:Name="StateBadge"
                        DockPanel.Dock="Right"
                        Background="{StaticResource Surface0Brush}"
                        CornerRadius="3"
                        Padding="6,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                    <TextBlock x:Name="StateBadgeText"
                               Text=""
                               FontSize="11"
                               Foreground="{StaticResource Subtext1Brush}"/>
                </Border>

            </DockPanel>
        </Border>

        <!-- ── Real issue body + comment thread (Left) and Actions Column (Right) ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="340" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12">
                <StackPanel x:Name="ContentPanel">

                    <TextBlock x:Name="LoadingText"
                               Text=""
                               FontSize="12"
                               Foreground="{StaticResource Subtext1Brush}"
                               Visibility="Collapsed"/>

                    <TextBlock x:Name="EpicLabel"
                               Text="PARENT EPIC"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext0Brush}"
                               Margin="0,0,0,4"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="EpicText"
                               FontSize="12"
                               Margin="0,0,0,16"
                               Visibility="Collapsed"/>

                    <TextBlock x:Name="BodyLabel"
                               Text="DESCRIPTION"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext0Brush}"
                               Margin="0,0,0,4"
                               Visibility="Collapsed"/>
                    <RichTextBox x:Name="BodyText"
                                 IsReadOnly="True"
                                 IsDocumentEnabled="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="0,0,0,16"/>

                    <TextBlock x:Name="CommentsLabel"
                               Text="COMMENTS"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext0Brush}"
                               Margin="0,0,0,4"
                               Visibility="Collapsed"/>

                    <ItemsControl x:Name="CommentsList"/>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Surface0Brush}"/>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource MantleBrush}"
                          Padding="10">
                <StackPanel x:Name="ActionsPanel"/>
            </ScrollViewer>
        </Grid>

        <!-- Empty state / sparse document overlay with Donald Duck in sailboat -->
        <ctrl:SailorDuckWatermarkControl x:Name="EmptyState"
                                         Grid.Row="1"
                                         MascotSize="260"
                                         WatermarkOpacity="0.85"
                                         CustomText="Ahoy! Select an issue from the Git Board to inspect details ⛵"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>

    </Grid>
</UserControl>

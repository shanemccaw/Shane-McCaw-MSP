<Window x:Class="BuildConsole.ApiHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Helper"
        Width="440" Height="620"
        MinWidth="380" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header strip: title + close, doubles as drag handle -->
            <Border x:Name="HeaderStrip" Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="10,6,8,6"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x26A1;" FontSize="13"
                               Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Grid.Column="1" Text="API Helper — Test Accounts &amp; Page Actions"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <Button x:Name="BtnClose" Grid.Column="2"
                            Content="&#x2715;"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="5,2,5,2"
                            ToolTip="Close"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Active Page Context Strip -->
            <Border Grid.Row="1" Background="{StaticResource Surface0Brush}" Padding="10,6,10,6" Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Target Page:" FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource Subtext1Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ActivePageText" Grid.Column="1" Text="No active page connected"
                               FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,6,10,10">

                    <!-- Status Notification Message -->
                    <Border x:Name="StatusBanner" Background="{StaticResource Surface1Brush}"
                            CornerRadius="4" Padding="8,6,8,6" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock x:Name="StatusMessageText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"/>
                    </Border>

                    <!-- SECTION 1: CREATE TEST ACCOUNT VIA API -->
                    <Border Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="CREATE TEST ACCOUNT (BYPASS PAYMENTS)"
                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Provisions a user account via API with chosen Tenant &amp; Role without Stripe checkouts or form requirements."
                                       FontSize="10" Foreground="{StaticResource Subtext1Brush}" TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <!-- Email Row -->
                            <TextBlock Text="Email Address:" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtEmail" Grid.Column="0" Height="26"
                                         FontSize="11" Padding="4,2,4,2"
                                         Background="{StaticResource Surface0Brush}"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource Surface1Brush}"
                                         VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnRandomEmail" Grid.Column="1"
                                        Content="🎲 Random" Style="{StaticResource IconButton}"
                                        FontSize="10" Padding="8,2,8,2" Margin="4,0,0,0"
                                        ToolTip="Generate unique random test email"
                                        Click="BtnRandomEmail_Click"/>
                            </Grid>

                            <!-- Password & Name Row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Password:" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtPassword" Text="TestPass123!" Height="26"
                                             FontSize="11" Padding="4,2,4,2"
                                             Background="{StaticResource Surface0Brush}"
                                             Foreground="{StaticResource TextBrush}"
                                             BorderBrush="{StaticResource Surface1Brush}"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Display Name:" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtName" Text="Test User" Height="26"
                                             FontSize="11" Padding="4,2,4,2"
                                             Background="{StaticResource Surface0Brush}"
                                             Foreground="{StaticResource TextBrush}"
                                             BorderBrush="{StaticResource Surface1Brush}"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Tenant & RBAC Role Row -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Associated Tenant:" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CmbTenant" Height="26"
                                              FontSize="11"
                                              Background="{StaticResource Surface0Brush}"
                                              Foreground="{StaticResource TextBrush}"
                                              BorderBrush="{StaticResource Surface1Brush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RBAC Role:" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CmbRole" Height="26"
                                              FontSize="11"
                                              Background="{StaticResource Surface0Brush}"
                                              Foreground="{StaticResource TextBrush}"
                                              BorderBrush="{StaticResource Surface1Brush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Create Account Button -->
                            <Button x:Name="BtnCreateAccount"
                                    Content="⚡ Create Test Account via API"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="12,6,12,6"
                                    FontWeight="SemiBold"
                                    Click="BtnCreateAccount_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: PAGE ACTIONS ON ACTIVE TAB -->
                    <Border Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PAGE ACTIONS (ACTIVE BROWSER TAB)"
                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Directly manipulate the active page using this test account's credentials or tokens:"
                                       FontSize="10" Foreground="{StaticResource Subtext1Brush}" TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <!-- Fill Login Form Buttons -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnFillLoginForm" Grid.Column="0"
                                        Content="🔑 Fill Login Form"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,5,8,5"
                                        ToolTip="Injects email &amp; password into React form inputs on the active page"
                                        Click="BtnFillLoginForm_Click"/>
                                <Button x:Name="BtnFillAndSubmit" Grid.Column="2"
                                        Content="🚀 Fill &amp; Submit Login"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,5,8,5"
                                        ToolTip="Fills email &amp; password and triggers form submission"
                                        Click="BtnFillAndSubmit_Click"/>
                            </Grid>

                            <!-- Direct Login (Bypass Form) -->
                            <Button x:Name="BtnDirectLogin"
                                    Content="⚡ Direct Login (Bypass Form &amp; Navigate)"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,5,8,5"
                                    Margin="0,0,0,6"
                                    ToolTip="Authenticates via API, injects session cookies into WebView2, and navigates directly to the portal"
                                    Click="BtnDirectLogin_Click"/>

                            <!-- Navigation & Utility -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnNavigatePortal" Grid.Column="0"
                                        Content="🌐 Go to /portal-v2"
                                        Style="{StaticResource IconButton}"
                                        Padding="8,5,8,5"
                                        ToolTip="Navigates the active tab to /portal/{slug}/portal-v2"
                                        Click="BtnNavigatePortal_Click"/>
                                <Button x:Name="BtnCopyCredentials" Grid.Column="2"
                                        Content="📋 Copy Credentials"
                                        Style="{StaticResource IconButton}"
                                        Padding="8,5,8,5"
                                        ToolTip="Copies email and password to clipboard"
                                        Click="BtnCopyCredentials_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 3: RECENT TEST ACCOUNTS -->
                    <Border Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="1" CornerRadius="5" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RECENT TEST ACCOUNTS"
                                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource Subtext1Brush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnClearRecents" Grid.Column="1"
                                        Content="Clear" Style="{StaticResource IconButton}"
                                        FontSize="10" Padding="6,1,6,1"
                                        Click="BtnClearRecents_Click"/>
                            </Grid>

                            <StackPanel x:Name="RecentAccountsPanel"/>

                            <TextBlock x:Name="NoRecentsText" Text="No recent test accounts yet."
                                       FontSize="10" Foreground="{StaticResource Subtext1Brush}"
                                       Margin="2,4,2,2"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

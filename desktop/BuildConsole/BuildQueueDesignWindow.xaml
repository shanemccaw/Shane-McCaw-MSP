<Window x:Class="BuildConsole.BuildQueueDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Build Queue — Design Canvas"
        Icon="app.ico"
        Width="720" Height="900"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource AppBackgroundBrush}">

    <!-- ══════════════════════════════════════════════════════════════════════
         Git #2135 (Epic #1788 — Build Console → Build Queue Panel) — a NEW,
         genuinely ISOLATED redesign-scaffold window for the Build Queue.

         Why this window exists: the real BuildQueuePanel (Controls/) is actively
         managing a large live queue right now, so it cannot be Shane's design
         sandbox. This window is that sandbox — Shane edits THIS file's XAML
         directly to iterate the new Build Queue look, with ZERO risk to the
         running panel. Isolation guarantee: every visual style/template below is
         defined LOCALLY in this window's own Resources and keyed to THIS window
         only. The single thing shared with the rest of the app is the #2126
         color/typography TOKEN dictionary (Themes/Colors.xaml + Typography.xaml,
         merged app-wide in App.xaml) — pure Color/Brush/Double values, no styles
         — referenced by DynamicResource. Editing a card style here can therefore
         never leak into BuildQueuePanel; only editing a shared TOKEN would, which
         is a deliberately global change anyway.

         Data is REAL from day one: the code-behind reads the exact same live
         queue every other panel reads — BuildQueuePostgresClient.GetQueueAsync()
         — and projects it into the view-models the templates below bind to. No
         fixture/mock content. Read-only for v1 (no actions/drag) — see the
         class-doc tradeoff note.

         The design reflects the confirmed spec (issue #2135 + the contract pack,
         docs/buildconsole-contract-pack.md): Build-Set collapsed/expanded groups,
         per-group ("epic") color coding, dimmed blocker ghost cards, the 2-line
         ellipsis / dense-card rule, and the dark-only, accents-on-text-not-fills
         color discipline.
         ══════════════════════════════════════════════════════════════════════ -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Chevron for a collapsible Build-Set group header. A borderless
             ToggleButton bound TwoWay to the group's IsExpanded; rotates the
             glyph on check. Freely restyle. ── -->
        <Style x:Key="GroupChevron" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <TextBlock x:Name="Glyph" Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── A small status/label chip. ── -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ══ CARD TEMPLATE — one queue item. Bound to a QueueCardVm. ══
             A dark muted card (CardBackgroundBrush) with a thin left accent bar
             in the item's group ("epic") color; the accent colors text/borders
             only, never a saturated fill (contract-pack color discipline). -->
        <DataTemplate x:Key="CardTemplate">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,7"
                    Opacity="{Binding CardOpacity}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left accent bar — the group/status color. -->
                    <Border Grid.Column="0"
                            Background="{Binding AccentBrush}"
                            CornerRadius="6,0,0,6"/>

                    <StackPanel Grid.Column="1" Margin="11,8,11,9">
                        <!-- Row 1 — id + status badge -->
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding IdLabel}"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}"
                                    BorderBrush="{Binding StatusBrush}">
                                <TextBlock Text="{Binding StatusLabel}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding StatusBrush}"/>
                            </Border>
                        </DockPanel>

                        <!-- Row 2 — title (2 lines max, ellipsis — density rule) -->
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{DynamicResource BodyFontSize}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="38"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>

                        <!-- Row 3 — meta (model · effort · account · pid) -->
                        <TextBlock Text="{Binding MetaLine}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>

                        <!-- Row 4 — dimmed blocker ghost cards (#2062 spirit):
                             one per declared blocker, showing the blocker's real
                             title/state when it is itself a queue item here. -->
                        <ItemsControl ItemsSource="{Binding Blockers}"
                                      Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVis}}"
                                      Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,3"
                                            Margin="0,0,0,4"
                                            Opacity="{Binding GhostOpacity}">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="{Binding NumberLabel}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding StateBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,7,0"/>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding StateLabel}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="7,0,0,0"/>
                                            <TextBlock Text="{Binding TitleLabel}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ══ GROUP TEMPLATE — one Build Set (collapsed/expanded). ══
             Bound to a BuildSetGroupVm. Collapsed: just the header row (chevron,
             set name in the group color, member/status summary). Expanded: the
             header plus the nested card list. -->
        <DataTemplate x:Key="GroupTemplate">
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,12">
                <StackPanel>
                    <!-- Header row (click anywhere toggles via the chevron binding) -->
                    <Grid Margin="10,9,12,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton Grid.Column="0"
                                      Style="{StaticResource GroupChevron}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>

                        <!-- Group color swatch -->
                        <Border Grid.Column="1" Width="10" Height="10"
                                CornerRadius="3"
                                Background="{Binding AccentBrush}"
                                VerticalAlignment="Center"
                                Margin="2,0,9,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding Name}"
                                   FontSize="{DynamicResource SubHeaderFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding SummaryLabel}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </Grid>

                    <!-- Expanded card list -->
                    <ItemsControl ItemsSource="{Binding Items}"
                                  ItemTemplate="{StaticResource CardTemplate}"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                  Margin="12,0,12,10"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ── Header ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}"
                             Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="BUILD QUEUE"
                               FontSize="{DynamicResource SubHeaderFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Chip}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            Margin="10,0,0,0">
                        <TextBlock Text="DESIGN CANVAS"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="GeneratedText"
                               Text=""
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ToggleButton x:Name="AutoRefreshToggle"
                                  Content="Live"
                                  IsChecked="True"
                                  Padding="9,3"
                                  FontSize="11"
                                  Margin="0,0,6,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  ToolTip="Auto-refresh from the live queue every few seconds"
                                  Checked="AutoRefreshToggle_Changed"
                                  Unchecked="AutoRefreshToggle_Changed"/>
                    <Button x:Name="BtnRefresh"
                            Content="Refresh"
                            Padding="9,3"
                            FontSize="11"
                            ToolTip="Refresh from the live queue now"
                            Click="BtnRefresh_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Summary strip ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource BorderDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <TextBlock x:Name="SummaryText"
                       Text="Loading…"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ── The grouped queue (scrollable) ── -->
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14,12,14,14">
                <ItemsControl x:Name="GroupsList"
                              ItemTemplate="{StaticResource GroupTemplate}"/>
            </ScrollViewer>
            <TextBlock x:Name="EmptyOverlay"
                       Text=""
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       TextAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

    </DockPanel>
</Window>

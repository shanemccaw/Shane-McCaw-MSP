<Window x:Class="BuildConsole.VisualTestTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Test Tracker"
        Width="490" Height="720"
        MinWidth="380" MinHeight="110"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Session Indicator & Page Strip -->
                <RowDefinition Height="*"/>    <!-- Main Workspace (Collapsible) -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER STRIP (Drag Handle + Title + API Helper + Minimize + Close) -->
            <Border x:Name="HeaderStrip" Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="8,5,6,5"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#x1F4F7;" FontSize="13"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Visual Test Tracker"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>

                    <!-- API Helper Button -->
                    <Button x:Name="BtnApiHelper" Grid.Column="2"
                            Content="⚡ API Helper"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="6,2,6,2"
                            Margin="0,0,4,0"
                            Foreground="{StaticResource AccentBrush}"
                            ToolTip="Open API Helper to create test accounts &amp; interact with the page"
                            Click="BtnApiHelper_Click"/>

                    <!-- Minimize / Collapse Toggle Button -->
                    <Button x:Name="BtnToggleCollapse" Grid.Column="3"
                            Content="▲ Mini"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="5,2,5,2"
                            Margin="0,0,4,0"
                            ToolTip="Toggle compact mini-bar / full workspace"
                            Click="BtnToggleCollapse_Click"/>

                    <!-- Close Button -->
                    <Button x:Name="BtnClose" Grid.Column="4"
                            Content="&#x2715;"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="4,2,4,2"
                            ToolTip="Close (reopen from ActivityBar)"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 2. SESSION INDICATOR STRIP (Shows which page / tab is being tested) -->
            <Border Grid.Row="1" Background="{StaticResource Surface0Brush}" Padding="8,4,8,4" Margin="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top row: Status pulse dot + Page Route + Timer -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pulse dot (Green = Active, Amber = Idle) -->
                        <Ellipse x:Name="SessionPulseDot" Grid.Column="0" Width="8" Height="8"
                                 Fill="{StaticResource StatusSuccessBrush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <TextBlock x:Name="SessionIndicatorText" Grid.Column="1"
                                   Text="No tracked tab active — navigate a watched tab"
                                   FontSize="11" FontFamily="Consolas" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="SessionTimerText" Grid.Column="2"
                                   Text="⏱ 00:00" FontSize="10"
                                   Foreground="{StaticResource Subtext1Brush}"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sub row: Clean Checkbox + Inline Status Message -->
                    <Grid Grid.Row="1" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="GoodCheckBox" Grid.Column="0"
                                  Content="Good (confirmed clean)"
                                  Foreground="{StaticResource TextBrush}"
                                  FontSize="11"
                                  IsEnabled="False"
                                  Checked="GoodCheckBox_Changed"
                                  Unchecked="GoodCheckBox_Changed"/>

                        <TextBlock x:Name="InlineMessage" Grid.Column="1"
                                   FontSize="10" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource Subtext1Brush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. MAIN WORKSPACE (Collapsible when in mini mode) -->
            <Grid x:Name="MainWorkspaceGrid" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Draft / Entry Composer -->
                    <RowDefinition Height="*"/>    <!-- Bug List -->
                </Grid.RowDefinitions>

                <!-- DRAFT / ENTRY COMPOSER SECTION (Crash-Safe Auto-Save) -->
                <Border Grid.Row="0" Background="{StaticResource BaseBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,0,0,1" Padding="8,6,8,8">
                    <StackPanel>
                        <!-- Composer Header with Auto-Save Badge & Severity -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="LOG ISSUE / BUG ENTRY"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="AutoSaveIndicator" Grid.Column="1"
                                       Text="✓ Saved" FontSize="9"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <!-- Severity Selector -->
                            <ComboBox x:Name="CmbSeverity" Grid.Column="2" Height="22" Width="105"
                                      FontSize="10" Background="{StaticResource Surface0Brush}"
                                      Foreground="{StaticResource TextBrush}"
                                      BorderBrush="{StaticResource Surface1Brush}"
                                      SelectionChanged="CmbSeverity_SelectionChanged">
                                <ComboBoxItem Content="Blocker"/>
                                <ComboBoxItem Content="Critical"/>
                                <ComboBoxItem Content="Bug" IsSelected="True"/>
                                <ComboBoxItem Content="UI Glitch"/>
                                <ComboBoxItem Content="Functional"/>
                                <ComboBoxItem Content="Low"/>
                            </ComboBox>
                        </Grid>

                        <!-- Notes Mode Tabs & Markdown Formatting Toolbar -->
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Page Notes vs Global Notes Tab Selector -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="BtnTabNotesPage" Content="📄 Page Notes"
                                        Style="{StaticResource IconButton}" FontSize="9" FontWeight="SemiBold"
                                        Padding="5,1,5,1" Margin="0,0,2,0" Foreground="{StaticResource AccentBrush}"
                                        Click="BtnTabNotes_Click" Tag="page"
                                        ToolTip="Notes scoped to this specific page/route"/>
                                <Button x:Name="BtnTabNotesGlobal" Content="🌐 Global Notes"
                                        Style="{StaticResource IconButton}" FontSize="9"
                                        Padding="5,1,5,1" Foreground="{StaticResource Subtext1Brush}"
                                        Click="BtnTabNotes_Click" Tag="global"
                                        ToolTip="Global scratchpad shared across all pages and sessions"/>
                            </StackPanel>

                            <!-- Markdown Formatting Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,0,4,0">
                                <Button Content="B" FontWeight="Bold" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdFormat_Click" Tag="bold" ToolTip="Bold (**text**)"/>
                                <Button Content="I" FontStyle="Italic" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdFormat_Click" Tag="italic" ToolTip="Italic (*text*)"/>
                                <Button Content="`" FontFamily="Consolas" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdFormat_Click" Tag="code" ToolTip="Inline code (`code`)"/>
                                <Button Content="•" Style="{StaticResource IconButton}" FontSize="10" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdFormat_Click" Tag="list" ToolTip="Bullet list (- item)"/>
                                <Button Content="🔗" Style="{StaticResource IconButton}" FontSize="8" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdFormat_Click" Tag="link" ToolTip="Insert link [title](url)"/>
                                <Button x:Name="BtnTogglePreview" Content="👁" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Click="BtnTogglePreview_Click" ToolTip="Toggle Markdown Preview"/>
                            </StackPanel>

                            <!-- Auto-Link Shots Checkbox -->
                            <CheckBox x:Name="AutoLinkShotsCheckBox" Grid.Column="2"
                                      Content="Auto-link shots" FontSize="9"
                                      Foreground="{StaticResource Subtext1Brush}"
                                      IsChecked="True" VerticalAlignment="Center"
                                      ToolTip="Automatically insert markdown link in notes when capturing screenshots"/>
                        </Grid>

                        <!-- Notes TextBox (Auto-Saved on Keystroke, Ctrl+Enter commits) -->
                        <TextBox x:Name="NotesBox"
                                 Height="52"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource Surface0Brush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource Surface1Brush}"
                                 BorderThickness="1"
                                 FontSize="11"
                                 Padding="5"
                                 IsEnabled="False"
                                 TextChanged="Field_TextChanged"
                                 ToolTip="Enter notes (Markdown supported). Press Ctrl+Enter to save."/>

                        <!-- Markdown Preview Box (Toggleable via 👁) -->
                        <Border x:Name="NotesPreviewContainer"
                                Background="{StaticResource Surface0Brush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Height="52"
                                Visibility="Collapsed"
                                Margin="0,0,0,2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="NotesPreviewText"
                                           FontSize="11"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Tags & Categories Input Strip -->
                        <Grid Margin="0,4,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🏷 Tags:" FontSize="10" Foreground="{StaticResource Subtext1Brush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>

                            <TextBox x:Name="TagsBox" Grid.Column="1"
                                     Height="22" FontSize="10"
                                     Background="{StaticResource Surface0Brush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource Surface1Brush}"
                                     BorderThickness="1"
                                     Padding="4,2,4,2"
                                     IsEnabled="False"
                                     TextChanged="Field_TextChanged"
                                     ToolTip="Tags/categories (e.g. Auth, UI, API, Checkout)"/>
                        </Grid>

                        <!-- Quick Tag Chips Strip -->
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="+ #Auth" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="Auth"/>
                            <Button Content="+ #UI" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="UI"/>
                            <Button Content="+ #API" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="API"/>
                            <Button Content="+ #Checkout" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="Checkout"/>
                            <Button Content="+ #Performance" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="Performance"/>
                            <Button Content="+ #Form" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="Form"/>
                        </WrapPanel>

                        <!-- Structured Fields Expander (Steps to Reproduce, Expected vs Actual) -->
                        <Expander x:Name="DetailsExpander"
                                  Header="Detailed Fields (Steps to Reproduce, Expected vs Actual)"
                                  FontSize="10" Foreground="{StaticResource Subtext1Brush}"
                                  Margin="0,0,0,4" IsExpanded="False">
                            <StackPanel Margin="0,3,0,1">
                                <!-- Steps Header with Quick Add Step and Import Auto Steps -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Steps to Reproduce:" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnAddStep" Content="+ Add Step"
                                                Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,0"
                                                Foreground="{StaticResource AccentBrush}"
                                                ToolTip="Increment and append the next numbered step"
                                                Click="BtnAddStep_Click"/>
                                        <Button x:Name="BtnImportAutoSteps" Content="📥 Import Auto Steps"
                                                Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1"
                                                Foreground="{StaticResource StatusSuccessBrush}"
                                                ToolTip="Import captured user clicks, inputs, and actions into editable steps"
                                                Click="BtnImportAutoSteps_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="StepsBox" Height="42"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource Surface0Brush}"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource Surface1Brush}"
                                         FontSize="10" Padding="4"
                                         IsEnabled="False"
                                         TextChanged="Field_TextChanged"
                                         ToolTip="Numbered steps (e.g. 1. Go to /login&#x0a;2. Click Sign In)"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Expected Behavior:" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="ExpectedBox" Height="36"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Background="{StaticResource Surface0Brush}"
                                                 Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource Surface1Brush}"
                                                 FontSize="10" Padding="4"
                                                 IsEnabled="False"
                                                 TextChanged="Field_TextChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Actual Behavior:" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="ActualBox" Height="36"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Background="{StaticResource Surface0Brush}"
                                                 Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource Surface1Brush}"
                                                 FontSize="10" Padding="4"
                                                 IsEnabled="False"
                                                 TextChanged="Field_TextChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Live Telemetry Diagnostics Strip -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,3,6,3" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TelemetryConsoleBadge" Text="🔴 0 errors" FontSize="9"
                                               Foreground="{StaticResource Subtext1Brush}" Margin="0,0,6,0"
                                               ToolTip="Console errors, warnings, and unhandled exceptions in WebView2"/>
                                    <TextBlock x:Name="TelemetryNetworkBadge" Text="⚡ 0 net fail" FontSize="9"
                                               Foreground="{StaticResource Subtext1Brush}" Margin="0,0,6,0"
                                               ToolTip="HTTP 4xx/5xx network failures and API requests"/>
                                    <TextBlock x:Name="TelemetryPerfBadge" Text="⏱ 0ms" FontSize="9"
                                               Foreground="{StaticResource Subtext1Brush}" Margin="0,0,6,0"
                                               ToolTip="Page load time and Largest Contentful Paint (LCP)"/>
                                    <TextBlock x:Name="TelemetryEventsBadge" Text="👣 0 events" FontSize="9"
                                               Foreground="{StaticResource Subtext1Brush}"
                                               ToolTip="Recent user interaction events recorded"/>
                                </StackPanel>

                                <TextBlock x:Name="TelemetryEnvBadge" Grid.Column="1"
                                           Text="Auto-Metadata Ready" FontSize="9"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           ToolTip="URL, OS, Viewport, User Agent, Title auto-collected on save"/>
                            </Grid>
                        </Border>

                        <!-- Capture Buttons Strip -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnCaptureFull" Grid.Column="0"
                                    Content="📷 Full Page"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="10" Padding="4,4,4,4"
                                    IsEnabled="False"
                                    ToolTip="Capture full scrollable WebView2 page"
                                    Click="BtnCaptureFull_Click"/>

                            <Button x:Name="BtnCaptureRegion" Grid.Column="2"
                                    Content="✂ Region..."
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="10" Padding="4,4,4,4"
                                    IsEnabled="False"
                                    ToolTip="Select and crop on-screen region"
                                    Click="BtnCaptureRegion_Click"/>

                            <Button x:Name="BtnCaptureWpfWindow" Grid.Column="4"
                                    Content="🪟 Window HUD"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="10" Padding="4,4,4,4"
                                    IsEnabled="False"
                                    ToolTip="Capture full WPF window with HUD and overlays"
                                    Click="BtnCaptureWpfWindow_Click"/>
                        </Grid>

                        <!-- Staged Screenshots Preview Bar (Attachments for current draft) -->
                        <Border x:Name="StagedScreenshotsContainer"
                                Background="{StaticResource Surface0Brush}"
                                CornerRadius="4" Padding="4" Margin="0,2,0,5"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="ATTACHMENTS FOR THIS ENTRY:" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource Subtext1Brush}" Margin="2,0,0,4"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="StagedThumbnailsPanel" Orientation="Horizontal"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons: Save Entry & Clear Draft -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnSaveEntry" Grid.Column="0"
                                    Content="💾 Save Bug Entry (Ctrl+Enter)"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="10,5,10,5"
                                    FontWeight="SemiBold"
                                    FontSize="11"
                                    IsEnabled="False"
                                    Click="BtnSaveEntry_Click"/>

                            <Button x:Name="BtnClearDraft" Grid.Column="1"
                                    Content="Clear"
                                    Style="{StaticResource IconButton}"
                                    Padding="8,5,8,5" Margin="4,0,0,0"
                                    FontSize="10"
                                    ToolTip="Reset current entry notes &amp; attachments"
                                    Click="BtnClearDraft_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BUG LIST SECTION -->
                <Grid Grid.Row="1" Margin="8,6,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Filter & Export Bar -->
                        <RowDefinition Height="*"/>    <!-- Entries ScrollView -->
                    </Grid.RowDefinitions>

                    <!-- Filter & Export Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="BugCountHeader" Grid.Column="0"
                                   Text="BUG LIST (0)"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Subtext1Brush}"
                                   VerticalAlignment="Center"/>

                        <!-- Filter buttons (All / Open / Resolved) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="BtnFilterAll" Content="All"
                                    Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,2,0"
                                    Click="BtnFilter_Click" Tag="All"/>
                            <Button x:Name="BtnFilterOpen" Content="Open"
                                    Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,2,0"
                                    Click="BtnFilter_Click" Tag="Open"/>
                            <Button x:Name="BtnFilterResolved" Content="Resolved"
                                    Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1"
                                    Click="BtnFilter_Click" Tag="Resolved"/>
                        </StackPanel>

                        <!-- Copy All Markdown -->
                        <Button x:Name="BtnCopyAllMarkdown" Grid.Column="2"
                                Content="📋 Copy Report"
                                Style="{StaticResource IconButton}"
                                FontSize="9" Padding="5,2,5,2"
                                ToolTip="Copy Markdown bug report of all entries on this page"
                                Click="BtnCopyAllMarkdown_Click"/>
                    </Grid>

                    <!-- Scrollable Entries List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BugListPanel"/>
                    </ScrollViewer>

                    <TextBlock x:Name="BugListEmptyText" Grid.Row="1"
                               Margin="8,16,8,8"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{StaticResource Subtext1Brush}"
                               VerticalAlignment="Top"
                               Text="No bug entries recorded for this page yet. Enter notes and capture screenshots above to log an issue."
                               Visibility="Visible"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

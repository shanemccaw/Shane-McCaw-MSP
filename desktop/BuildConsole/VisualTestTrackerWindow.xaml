<Window x:Class="BuildConsole.VisualTestTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Test Tracker"
        Width="490" Height="720"
        MinWidth="380" MinHeight="110"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Row 1: HUD Options Drawer (Transparency & Auto-Hide) -->
                <RowDefinition Height="Auto"/> <!-- Row 2: Session Indicator & Page Strip -->
                <RowDefinition Height="*"/>    <!-- Row 3: Main Workspace (Collapsible) -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER STRIP (Drag Handle + Title + API Helper + Pin + HUD + Minimize + Close) -->
            <Border x:Name="HeaderStrip" Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="8,5,6,5"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#x1F4F7;" FontSize="13"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Visual Test Tracker"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>

                    <!-- API Helper Button -->
                    <Button x:Name="BtnApiHelper" Grid.Column="2"
                            Content="⚡ API Helper"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="5,2,5,2"
                            Margin="0,0,3,0"
                            Foreground="{StaticResource AccentBrush}"
                            ToolTip="Open API Helper to create test accounts &amp; interact with the page"
                            Click="BtnApiHelper_Click"/>

                    <!-- Pin-to-Corner Button -->
                    <Button x:Name="BtnPinCorner" Grid.Column="3"
                            Content="📌 Pin"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="5,2,5,2"
                            Margin="0,0,3,0"
                            ToolTip="Cycle pin window to screen corner (Ctrl+Shift+P)"
                            Click="BtnPinCorner_Click"/>

                    <!-- HUD Options Drawer Toggle Button -->
                    <Button x:Name="BtnHudOptions" Grid.Column="4"
                            Content="🎛 HUD"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="5,2,5,2"
                            Margin="0,0,3,0"
                            ToolTip="Toggle HUD transparency slider and auto-hide settings"
                            Click="BtnHudOptions_Click"/>

                    <!-- Minimize / Collapse Toggle Button -->
                    <Button x:Name="BtnToggleCollapse" Grid.Column="5"
                            Content="▲ Mini"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="5,2,5,2"
                            Margin="0,0,3,0"
                            ToolTip="Toggle compact mini-bar / full workspace (Ctrl+Shift+M)"
                            Click="BtnToggleCollapse_Click"/>

                    <!-- Close Button -->
                    <Button x:Name="BtnClose" Grid.Column="6"
                            Content="&#x2715;"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="4,2,4,2"
                            ToolTip="Close (reopen from ActivityBar)"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- HUD OPTIONS DRAWER (Transparency slider & Idle auto-hide) -->
            <Border x:Name="HudOptionsDrawer" Grid.Row="1"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,5,8,5"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Opacity:" FontSize="9" Foreground="{StaticResource Subtext1Brush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <Slider x:Name="SliderOpacity" Grid.Column="1"
                            Minimum="0.3" Maximum="1.0" Value="1.0"
                            SmallChange="0.05" LargeChange="0.1"
                            VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip="HUD opacity (smart hover restores 100%)"
                            ValueChanged="SliderOpacity_ValueChanged"/>

                    <TextBlock x:Name="TxtOpacityPercent" Grid.Column="2"
                               Text="100%" FontSize="9" FontFamily="Consolas"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <CheckBox x:Name="ChkAutoHide" Grid.Column="3"
                              Content="Auto-hide when idle" FontSize="9"
                              Foreground="{StaticResource Subtext1Brush}"
                              VerticalAlignment="Center"
                              ToolTip="Dims HUD to 20% when mouse is idle for 3s, wakes up on hover"
                              Checked="ChkAutoHide_Changed"
                              Unchecked="ChkAutoHide_Changed"/>
                </Grid>
            </Border>

            <!-- 2. SESSION INDICATOR STRIP (Shows which page / tab is being tested) -->
            <Border Grid.Row="2" Background="{StaticResource Surface0Brush}" Padding="8,4,8,4" Margin="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top row: Status pulse dot + Page Route + Copy URL + Timer & Session Controls -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pulse dot (Green = Active, Amber = Idle) -->
                        <Ellipse x:Name="SessionPulseDot" Grid.Column="0" Width="8" Height="8"
                                 Fill="{StaticResource StatusSuccessBrush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SessionIndicatorText" Grid.Column="0"
                                       Text="No tracked tab active — navigate a watched tab"
                                       FontSize="11" FontFamily="Consolas" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>

                            <!-- Quick Copy URL Button -->
                            <Button x:Name="BtnCopyUrl" Grid.Column="1"
                                    Content="🔗" Style="{StaticResource IconButton}"
                                    FontSize="9" Width="18" Height="18" Padding="0" Margin="4,0,4,0"
                                    ToolTip="Copy active page URL (Ctrl+Shift+U)"
                                    Click="BtnCopyUrl_Click"/>
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Floating Stopwatch Timer (Click to toggle Page time vs Session time) -->
                            <Button x:Name="BtnToggleTimerMode"
                                    Style="{StaticResource IconButton}"
                                    Padding="4,1,4,1" Margin="2,0,6,0"
                                    ToolTip="Click to toggle Page time vs Session time"
                                    Click="BtnToggleTimerMode_Click">
                                <TextBlock x:Name="SessionTimerText"
                                           Text="⏱ 00:00" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Button>

                            <!-- Start New Test Session Button -->
                            <Button x:Name="BtnNewSession"
                                    Content="▶ New Session"
                                    Style="{StaticResource IconButton}"
                                    FontSize="9" Padding="5,2,5,2" Margin="0,0,3,0"
                                    Foreground="{StaticResource AccentBrush}"
                                    ToolTip="Archive current session and start a fresh test session for this page"
                                    Click="BtnNewSession_Click"/>

                            <!-- Session History Button -->
                            <Button x:Name="BtnSessionHistory"
                                    Content="📜 History"
                                    Style="{StaticResource IconButton}"
                                    FontSize="9" Padding="5,2,5,2" Margin="0,0,3,0"
                                    ToolTip="View all past testing sessions, duration, and audit logs"
                                    Click="BtnSessionHistory_Click"/>

                            <!-- Clear Session Button -->
                            <Button x:Name="BtnClearSession"
                                    Content="🧹 Clear"
                                    Style="{StaticResource IconButton}"
                                    FontSize="9" Padding="4,2,4,2"
                                    ToolTip="Clear current session draft fields, staged screenshots, and telemetry"
                                    Click="BtnClearSession_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Sub row: Clean Checkbox + Auto-Clear Checkbox + Inline Status Message -->
                    <Grid Grid.Row="1" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="GoodCheckBox" Grid.Column="0"
                                  Content="Good (confirmed clean)"
                                  Foreground="{StaticResource TextBrush}"
                                  FontSize="10" Margin="0,0,10,0"
                                  IsEnabled="False"
                                  Checked="GoodCheckBox_Changed"
                                  Unchecked="GoodCheckBox_Changed"/>

                        <CheckBox x:Name="ChkAutoClear" Grid.Column="1"
                                  Content="Auto-clear on new session"
                                  Foreground="{StaticResource Subtext1Brush}"
                                  FontSize="10" IsChecked="False"
                                  ToolTip="When enabled, starting a new session clears drafts automatically"/>

                        <TextBlock x:Name="InlineMessage" Grid.Column="2"
                                   FontSize="10" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource Subtext1Brush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. MAIN WORKSPACE (Collapsible when in mini mode) -->
            <Grid x:Name="MainWorkspaceGrid" Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Draft / Entry Composer -->
                    <RowDefinition Height="*"/>    <!-- Bug List -->
                </Grid.RowDefinitions>

                <!-- DRAFT / ENTRY COMPOSER SECTION (Crash-Safe Auto-Save) -->
                <Border Grid.Row="0" Background="{StaticResource BaseBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,0,0,1" Padding="8,6,8,8">
                    <StackPanel>
                        <!-- Composer Header with Auto-Save Badge & Severity -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="LOG ISSUE / BUG ENTRY"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="AutoSaveIndicator" Grid.Column="1"
                                       Text="✓ Saved" FontSize="9"
                                       Foreground="{StaticResource Subtext1Brush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <!-- Severity Selector -->
                            <ComboBox x:Name="CmbSeverity" Grid.Column="2" Height="22" Width="105"
                                      FontSize="10" Background="{StaticResource Surface0Brush}"
                                      Foreground="{StaticResource TextBrush}"
                                      BorderBrush="{StaticResource Surface1Brush}"
                                      SelectionChanged="CmbSeverity_SelectionChanged">
                                <ComboBoxItem Content="Blocker"/>
                                <ComboBoxItem Content="Critical"/>
                                <ComboBoxItem Content="Bug" IsSelected="True"/>
                                <ComboBoxItem Content="UI Glitch"/>
                                <ComboBoxItem Content="Functional"/>
                                <ComboBoxItem Content="Low"/>
                            </ComboBox>
                        </Grid>

                        <!-- Notes Mode Tabs & Markdown Formatting Toolbar -->
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Page Notes vs Global Notes Tab Selector -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="BtnTabNotesPage" Content="📄 Page Notes"
                                        Style="{StaticResource IconButton}" FontSize="9" FontWeight="SemiBold"
                                        Padding="5,1,5,1" Margin="0,0,2,0" Foreground="{StaticResource AccentBrush}"
                                        Click="BtnTabNotes_Click" Tag="page"
                                        ToolTip="Notes scoped to this specific page/route"/>
                                <Button x:Name="BtnTabNotesGlobal" Content="🌐 Global Notes"
                                        Style="{StaticResource IconButton}" FontSize="9"
                                        Padding="5,1,5,1" Foreground="{StaticResource Subtext1Brush}"
                                        Click="BtnTabNotes_Click" Tag="global"
                                        ToolTip="Global scratchpad shared across all pages and sessions"/>
                            </StackPanel>

                            <!-- Markdown Formatting Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,0,4,0">
                                <Button Content="B" FontWeight="Bold" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdFormat_Click" Tag="bold" ToolTip="Bold (**text**)"/>
                                <Button Content="I" FontStyle="Italic" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdFormat_Click" Tag="italic" ToolTip="Italic (*text*)"/>
                                <Button Content="`" FontFamily="Consolas" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdFormat_Click" Tag="code" ToolTip="Inline code (`code`)"/>
                                <Button Content="•" Style="{StaticResource IconButton}" FontSize="10" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdFormat_Click" Tag="list" ToolTip="Bullet list (- item)"/>
                                <Button Content="🔗" Style="{StaticResource IconButton}" FontSize="8" Width="18" Height="18" Padding="0" Margin="0,0,1,0" Click="BtnMdFormat_Click" Tag="link" ToolTip="Insert link [title](url)"/>
                                <Button x:Name="BtnTogglePreview" Content="👁" Style="{StaticResource IconButton}" FontSize="9" Width="18" Height="18" Padding="0" Click="BtnTogglePreview_Click" ToolTip="Toggle Markdown Preview"/>
                            </StackPanel>

                            <!-- Auto-Link Shots Checkbox -->
                            <CheckBox x:Name="AutoLinkShotsCheckBox" Grid.Column="2"
                                      Content="Auto-link shots" FontSize="9"
                                      Foreground="{StaticResource Subtext1Brush}"
                                      IsChecked="True" VerticalAlignment="Center"
                                      ToolTip="Automatically insert markdown link in notes when capturing screenshots"/>
                        </Grid>

                        <!-- Notes TextBox (Auto-Saved on Keystroke, Ctrl+Enter commits) -->
                        <TextBox x:Name="NotesBox"
                                 Height="52"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource Surface0Brush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource Surface1Brush}"
                                 BorderThickness="1"
                                 FontSize="11"
                                 Padding="5"
                                 IsEnabled="False"
                                 TextChanged="Field_TextChanged"
                                 ToolTip="Enter notes (Markdown supported). Press Ctrl+Enter to save."/>

                        <!-- Markdown Preview Box (Toggleable via 👁) -->
                        <Border x:Name="NotesPreviewContainer"
                                Background="{StaticResource Surface0Brush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Height="52"
                                Visibility="Collapsed"
                                Margin="0,0,0,2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="NotesPreviewText"
                                           FontSize="11"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Tags & Categories Input Strip -->
                        <Grid Margin="0,4,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🏷 Tags:" FontSize="10" Foreground="{StaticResource Subtext1Brush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>

                            <TextBox x:Name="TagsBox" Grid.Column="1"
                                     Height="22" FontSize="10"
                                     Background="{StaticResource Surface0Brush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource Surface1Brush}"
                                     BorderThickness="1"
                                     Padding="4,2,4,2"
                                     IsEnabled="False"
                                     TextChanged="Field_TextChanged"
                                     ToolTip="Tags/categories (e.g. Auth, UI, API, Checkout)"/>
                        </Grid>

                        <!-- Quick Tag Chips Strip -->
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="+ #Auth" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="Auth"/>
                            <Button Content="+ #UI" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="UI"/>
                            <Button Content="+ #API" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="API"/>
                            <Button Content="+ #Checkout" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="Checkout"/>
                            <Button Content="+ #Performance" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="Performance"/>
                            <Button Content="+ #Form" Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,2" Click="QuickTag_Click" Tag="Form"/>
                        </WrapPanel>

                        <!-- Structured Fields Expander (Steps to Reproduce, Expected vs Actual) -->
                        <Expander x:Name="DetailsExpander"
                                  Header="Detailed Fields (Steps to Reproduce, Expected vs Actual)"
                                  FontSize="10" Foreground="{StaticResource Subtext1Brush}"
                                  Margin="0,0,0,4" IsExpanded="False">
                            <StackPanel Margin="0,3,0,1">
                                <!-- Steps Header with Quick Add Step and Import Auto Steps -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Steps to Reproduce:" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnAddStep" Content="+ Add Step"
                                                Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,3,0"
                                                Foreground="{StaticResource AccentBrush}"
                                                ToolTip="Increment and append the next numbered step"
                                                Click="BtnAddStep_Click"/>
                                        <Button x:Name="BtnImportAutoSteps" Content="📥 Import Auto Steps"
                                                Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1"
                                                Foreground="{StaticResource StatusSuccessBrush}"
                                                ToolTip="Import captured user clicks, inputs, and actions into editable steps"
                                                Click="BtnImportAutoSteps_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="StepsBox" Height="42"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource Surface0Brush}"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource Surface1Brush}"
                                         FontSize="10" Padding="4"
                                         IsEnabled="False"
                                         TextChanged="Field_TextChanged"
                                         ToolTip="Numbered steps (e.g. 1. Go to /login&#x0a;2. Click Sign In)"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Expected Behavior:" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="ExpectedBox" Height="36"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Background="{StaticResource Surface0Brush}"
                                                 Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource Surface1Brush}"
                                                 FontSize="10" Padding="4"
                                                 IsEnabled="False"
                                                 TextChanged="Field_TextChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Actual Behavior:" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="ActualBox" Height="36"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Background="{StaticResource Surface0Brush}"
                                                 Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource Surface1Brush}"
                                                 FontSize="10" Padding="4"
                                                 IsEnabled="False"
                                                 TextChanged="Field_TextChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Live Telemetry Diagnostics Strip -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,3,6,3" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TelemetryConsoleBadge" Text="🔴 0 errors" FontSize="9"
                                               Foreground="{StaticResource Subtext1Brush}" Margin="0,0,3,0"
                                               ToolTip="Console errors, warnings, and unhandled exceptions in WebView2"/>
                                    <Button x:Name="BtnCopyConsoleErrors" Content="📋 Errors"
                                            Style="{StaticResource IconButton}" FontSize="8"
                                            Padding="3,1,3,1" Margin="0,0,6,0"
                                            Foreground="{StaticResource StatusWarningBrush}"
                                            ToolTip="Copy all captured console errors &amp; stack traces (Ctrl+Shift+C)"
                                            Click="BtnCopyConsoleErrors_Click"/>
                                    <TextBlock x:Name="TelemetryNetworkBadge" Text="⚡ 0 net fail" FontSize="9"
                                               Foreground="{StaticResource Subtext1Brush}" Margin="0,0,6,0"
                                               ToolTip="HTTP 4xx/5xx network failures and API requests"/>
                                    <TextBlock x:Name="TelemetryPerfBadge" Text="⏱ 0ms" FontSize="9"
                                               Foreground="{StaticResource Subtext1Brush}" Margin="0,0,6,0"
                                               ToolTip="Page load time and Largest Contentful Paint (LCP)"/>
                                    <TextBlock x:Name="TelemetryEventsBadge" Text="👣 0 events" FontSize="9"
                                               Foreground="{StaticResource Subtext1Brush}" Margin="0,0,6,0"
                                               ToolTip="Recent user interaction events recorded"/>
                                    <TextBlock x:Name="TelemetryCdpBadge" Text="🌐 CDP Active" FontSize="9"
                                               Foreground="{StaticResource AccentBrush}"
                                               ToolTip="Chrome DevTools Protocol actively capturing engine console, network, and error events"/>
                                </StackPanel>

                                <TextBlock x:Name="TelemetryEnvBadge" Grid.Column="1"
                                           Text="Auto-Metadata Ready" FontSize="9"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           ToolTip="URL, OS, Viewport, User Agent, Title auto-collected on save"/>
                            </Grid>
                        </Border>

                        <!-- Capture & Inspect Buttons Strip -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnCaptureFull" Grid.Column="0"
                                    Content="📷 Full"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="10" Padding="2,4,2,4"
                                    IsEnabled="False"
                                    ToolTip="Capture full scrollable WebView2 page (Ctrl+Shift+F)"
                                    Click="BtnCaptureFull_Click"/>

                            <Button x:Name="BtnCaptureRegion" Grid.Column="2"
                                    Content="✂ Region"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="10" Padding="2,4,2,4"
                                    IsEnabled="False"
                                    ToolTip="Select and crop on-screen region (Ctrl+Shift+S)"
                                    Click="BtnCaptureRegion_Click"/>

                            <Button x:Name="BtnCaptureWpfWindow" Grid.Column="4"
                                    Content="🪟 HUD"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="10" Padding="2,4,2,4"
                                    IsEnabled="False"
                                    ToolTip="Capture full WPF window with HUD and overlays (Ctrl+Shift+W)"
                                    Click="BtnCaptureWpfWindow_Click"/>

                            <Button x:Name="BtnInspectDom" Grid.Column="6"
                                    Content="🔍 Inspect"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="10" Padding="2,4,2,4"
                                    IsEnabled="False"
                                    ToolTip="Interactive DOM element inspector (Ctrl+Shift+I)"
                                    Click="BtnInspectDom_Click"/>
                        </Grid>

                        <!-- DOM Inspector Drawer (Interactive CDP element inspection) -->
                        <Border x:Name="DomInspectorDrawer"
                                Background="{StaticResource Surface0Brush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4" Padding="6" Margin="0,0,0,5"
                                Visibility="Collapsed">
                            <StackPanel>
                                <!-- Header with Tag, Dimensions, Re-inspect, and Close -->
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="DOM:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtDomElementTag" Text="&lt;BUTTON&gt;" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtDomDimensions" Text="120 × 36 px" FontSize="9" Foreground="{StaticResource Subtext1Brush}"/>
                                    </StackPanel>

                                    <Button x:Name="BtnDomReinspect" Grid.Column="1"
                                            Content="🔍 Pick Another" Style="{StaticResource IconButton}"
                                            FontSize="8" Padding="4,1,4,1" Margin="0,0,3,0"
                                            ToolTip="Select another element to inspect"
                                            Click="BtnDomReinspect_Click"/>

                                    <Button x:Name="BtnDomClose" Grid.Column="2"
                                            Content="✕" Style="{StaticResource IconButton}"
                                            FontSize="9" Width="16" Height="16" Padding="0"
                                            ToolTip="Close DOM Inspector"
                                            Click="BtnDomClose_Click"/>
                                </Grid>

                                <!-- Selector Display with Copy -->
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="TxtDomSelector" Grid.Column="0"
                                             IsReadOnly="True" FontSize="9" FontFamily="Consolas"
                                             Background="{StaticResource BaseBrush}" Foreground="{StaticResource TextBrush}"
                                             BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1"
                                             Padding="3,2,3,2"
                                             ToolTip="Unique CSS Selector"/>

                                    <Button x:Name="BtnCopyDomSelector" Grid.Column="1"
                                            Content="📋 Copy Sel" Style="{StaticResource IconButton}"
                                            FontSize="8" Padding="4,1,4,1" Margin="3,0,0,0"
                                            ToolTip="Copy CSS selector to clipboard"
                                            Click="BtnCopyDomSelector_Click"/>
                                </Grid>

                                <!-- OuterHTML Preview Block -->
                                <TextBox x:Name="TxtDomOuterHtml"
                                         IsReadOnly="True" Height="36" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontSize="9" FontFamily="Consolas"
                                         Background="{StaticResource BaseBrush}" Foreground="{StaticResource Subtext1Brush}"
                                         BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1"
                                         Padding="3,2,3,2" Margin="0,0,0,4"
                                         ToolTip="Sanitized Outer HTML"/>

                                <!-- Action Buttons: Insert to Repro Steps, Insert to Notes, Copy HTML -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BtnInsertDomToSteps" Grid.Column="0"
                                            Content="+ Add to Repro Steps" Style="{StaticResource IconButton}"
                                            FontSize="8" Padding="3,2,3,2" Foreground="{StaticResource AccentBrush}"
                                            ToolTip="Insert interaction step with this element into Steps to Reproduce"
                                            Click="BtnInsertDomToSteps_Click"/>

                                    <Button x:Name="BtnInsertDomToNotes" Grid.Column="2"
                                            Content="+ Add to Notes" Style="{StaticResource IconButton}"
                                            FontSize="8" Padding="3,2,3,2" Foreground="{StaticResource TextBrush}"
                                            ToolTip="Insert selector and details into Notes"
                                            Click="BtnInsertDomToNotes_Click"/>

                                    <Button x:Name="BtnCopyDomHtml" Grid.Column="4"
                                            Content="📋 HTML" Style="{StaticResource IconButton}"
                                            FontSize="8" Padding="4,2,4,2"
                                            ToolTip="Copy Outer HTML"
                                            Click="BtnCopyDomHtml_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Staged Screenshots Preview Bar (Attachments for current draft) -->
                        <Border x:Name="StagedScreenshotsContainer"
                                Background="{StaticResource Surface0Brush}"
                                CornerRadius="4" Padding="4" Margin="0,2,0,5"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="ATTACHMENTS FOR THIS ENTRY:" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource Subtext1Brush}" Margin="2,0,0,4"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="StagedThumbnailsPanel" Orientation="Horizontal"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons: Save Entry & Clear Draft -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnSaveEntry" Grid.Column="0"
                                    Content="💾 Save Bug Entry (Ctrl+Enter)"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="10,5,10,5"
                                    FontWeight="SemiBold"
                                    FontSize="11"
                                    IsEnabled="False"
                                    Click="BtnSaveEntry_Click"/>

                            <Button x:Name="BtnClearDraft" Grid.Column="1"
                                    Content="Clear"
                                    Style="{StaticResource IconButton}"
                                    Padding="8,5,8,5" Margin="4,0,0,0"
                                    FontSize="10"
                                    ToolTip="Reset current entry notes &amp; attachments"
                                    Click="BtnClearDraft_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BUG LIST SECTION -->
                <Grid Grid.Row="1" Margin="8,6,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Filter & Export Bar -->
                        <RowDefinition Height="*"/>    <!-- Entries ScrollView -->
                    </Grid.RowDefinitions>

                    <!-- Filter & Export Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="BugCountHeader" Grid.Column="0"
                                   Text="BUG LIST (0)"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Subtext1Brush}"
                                   VerticalAlignment="Center"/>

                        <!-- Filter buttons (All / Open / Resolved) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="BtnFilterAll" Content="All"
                                    Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,2,0"
                                    Click="BtnFilter_Click" Tag="All"/>
                            <Button x:Name="BtnFilterOpen" Content="Open"
                                    Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1" Margin="0,0,2,0"
                                    Click="BtnFilter_Click" Tag="Open"/>
                            <Button x:Name="BtnFilterResolved" Content="Resolved"
                                    Style="{StaticResource IconButton}" FontSize="9" Padding="4,1,4,1"
                                    Click="BtnFilter_Click" Tag="Resolved"/>
                        </StackPanel>

                        <!-- Actions: Export to /Bugs/ & Copy Markdown -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnExportJson"
                                    Content="📦 Export to /Bugs/"
                                    Style="{StaticResource IconButton}"
                                    FontSize="9" Padding="5,2,5,2" Margin="0,0,4,0"
                                    Foreground="{StaticResource AccentBrush}"
                                    ToolTip="Export bug reports to local repo /Bugs/ (MSP_Console, Portal, Admin-Panel, Marketing, etc.) as JSON"
                                    Click="BtnExportJson_Click"/>
                            <Button x:Name="BtnCopyAllMarkdown"
                                    Content="📋 Copy Report"
                                    Style="{StaticResource IconButton}"
                                    FontSize="9" Padding="5,2,5,2"
                                    ToolTip="Copy Markdown bug report of all entries on this page"
                                    Click="BtnCopyAllMarkdown_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable Entries List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BugListPanel"/>
                    </ScrollViewer>

                    <TextBlock x:Name="BugListEmptyText" Grid.Row="1"
                               Margin="8,16,8,8"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{StaticResource Subtext1Brush}"
                               VerticalAlignment="Top"
                               Text="No bug entries recorded for this page yet. Enter notes and capture screenshots above to log an issue."
                               Visibility="Visible"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="BuildConsole.VisualTestTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Test Tracker"
        Width="380" Height="560"
        MinWidth="320" MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Git #1472 — always-on-top floaty, separate window from StickyNotesWindow
         (Sticky Notes stays untouched). Same borderless-Window + header-drag shape
         as Sticky Notes (#937) / Build Watch (#980). -->
    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header strip: title + close, doubles as the drag handle -->
            <Border x:Name="HeaderStrip" Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="8,5,6,5"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F4F7;" FontSize="13"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Visual Test Tracker"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <Button x:Name="BtnClose" Grid.Column="2"
                            Content="&#x2715;"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="4,1,4,1"
                            ToolTip="Close (reopen from the ActivityBar)"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Auto-filled, read-only page path -->
            <TextBlock x:Name="PagePathText" Grid.Row="1"
                       Margin="8,8,8,2"
                       FontSize="12" FontFamily="Consolas"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}"
                       Text="No tracked tab active — navigate a watched tab to a configured base URL."/>

            <!-- Good/Bad checkbox -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,4,8,2">
                <CheckBox x:Name="GoodCheckBox"
                          Content="Good (confirmed clean)"
                          Foreground="{StaticResource TextBrush}"
                          FontSize="12"
                          IsEnabled="False"
                          Checked="GoodCheckBox_Changed"
                          Unchecked="GoodCheckBox_Changed"/>
            </StackPanel>

            <!-- Notes -->
            <TextBox x:Name="NotesBox" Grid.Row="3"
                     Margin="8,4,8,4"
                     Height="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource BaseBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource Surface0Brush}"
                     BorderThickness="1"
                     FontSize="12"
                     Padding="6"
                     IsEnabled="False"
                     TextChanged="NotesBox_TextChanged"/>

            <!-- Capture buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="8,0,8,4">
                <Button x:Name="BtnCaptureFull"
                        Content="Capture full page"
                        Style="{StaticResource PrimaryButton}"
                        Padding="10,5,10,5"
                        Margin="0,0,6,0"
                        IsEnabled="False"
                        Click="BtnCaptureFull_Click"/>
                <Button x:Name="BtnCaptureRegion"
                        Content="Capture region…"
                        Style="{StaticResource IconButton}"
                        Padding="10,5,10,5"
                        IsEnabled="False"
                        Click="BtnCaptureRegion_Click"/>
            </StackPanel>

            <!-- Inline status/error message -->
            <TextBlock x:Name="InlineMessage" Grid.Row="5"
                       Margin="8,0,8,4"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{StaticResource Subtext1Brush}"/>

            <!-- Gallery — newest first -->
            <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                <StackPanel x:Name="GalleryPanel" Margin="8,0,8,0"/>
            </ScrollViewer>

            <TextBlock x:Name="GalleryEmptyText" Grid.Row="6"
                       Margin="8,4,8,4"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Subtext1Brush}"
                       VerticalAlignment="Top"
                       Text="No screenshots for this page yet."
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>

<Window x:Class="BuildConsole.BuildWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Build Watch"
        Icon="app.ico"
        Width="900" Height="560"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        WindowStyle="None"
        StateChanged="Window_StateChanged">

    <!-- Git #1006 — same custom title bar treatment as MainWindow (Git #894):
         WindowStyle="None" + WindowChrome keeps real OS drag/resize/snap
         behavior while a plain WPF Border replaces the native caption. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Git #980 — Shane: "This should be a floaty panel so I can put it off to
         another monitor and watch as it progresses... 8 total builds running at
         once... 8 squares each can contain a build output... When one is done...
         a green overlay or something around the completed one." A genuine
         independent top-level Window (not docked inside MainWindow): draggable to
         any monitor, resizable, position/size persisted in BuildConsoleSettings.
         Normal window chrome (not the borderless #937 floaty shape) precisely
         because Shane wants a real, movable, resizable "watch on another monitor"
         window, not a small always-on-top sticky. -->
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Build Watch" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Subtext1Brush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                        <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    <Border Background="{StaticResource BaseBrush}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- col0: header/banner/slot-grid (existing content, default column 0)
                 col1: drag-to-resize splitter   col2: Task Checklist side panel -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="270" MinWidth="170"/>
            </Grid.ColumnDefinitions>

            <!-- Header: title + live counts + colour legend -->
            <Grid Grid.Row="0" Margin="2,0,2,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F5A5;" FontSize="16" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Build Watch" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="Subtitle" Margin="12,0,0,0" FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Subtext1Brush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,4,0"
                             Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="done" Margin="0,0,12,0" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Subtext1Brush}"/>
                    <Ellipse Width="10" Height="10" Margin="0,0,4,0"
                             Fill="{StaticResource RedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="failed" Margin="0,0,12,0" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Subtext1Brush}"/>
                    <Ellipse Width="10" Height="10" Margin="0,0,4,0"
                             Fill="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="running" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Subtext1Brush}"/>
                </StackPanel>
            </Grid>

            <!-- Waiting-for-a-slot banner (only visible when >8 builds run at once) -->
            <Border x:Name="WaitingBannerBorder" Grid.Row="1"
                    Background="{StaticResource Surface0Brush}"
                    BorderBrush="{StaticResource PeachBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="8,5" Margin="2,0,2,8"
                    Visibility="Collapsed">
                <TextBlock x:Name="WaitingBanner" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource PeachBrush}"/>
            </Border>

            <!-- Slot grid. 8 slot visuals are built once in code-behind, but the
                 Rows/Columns are recomputed from the real current count of active
                 (occupied) slots on every occupancy change (see ReflowSlotGrid) so
                 the window shows exactly as many squares as there are live builds:
                 1→1x1 (full window), 2→1x2, 3-4→2x2, 5-6→2x3, 7-8→2x4 (the true
                 max). The Rows/Columns below are only the initial fallback. -->
            <UniformGrid x:Name="SlotGrid" Grid.Row="2" Grid.Column="0" Rows="2" Columns="4"/>

            <!-- Drag-to-resize handle between the slot grid and the checklist panel. -->
            <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                          Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource Surface0Brush}" ShowsPreview="True"/>

            <!-- ── Task Checklist side panel ─────────────────────────────────────
                 A live checklist extracted from each build's OWN reported progress:
                 genuine checklist markers (☐/☑/✓/✔ or "- [ ]"/"- [x]") the agent
                 prints become rows here — pending (☐) until the agent reports the
                 same item done, then flipped to a green ✔. Attributed per build so
                 the 8 concurrent squares don't blur together. Bound to
                 _checklist (TaskChecklistViewModel) via ChecklistPanel.DataContext. -->
            <Border x:Name="ChecklistPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="1" CornerRadius="6" Margin="4,0,2,0">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="&#x1F5D2;" FontSize="14" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Task Checklist" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="11"
                               Margin="0,0,0,6"
                               Foreground="{StaticResource Subtext1Brush}"/>

                    <!-- Empty state (shown until the first marker is detected) -->
                    <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="11"
                               VerticalAlignment="Top" Margin="0,8,0,0"
                               Foreground="{StaticResource OverlayBrush}"
                               Text="Nothing yet. Checklist items appear here as a build reports them — e.g. &#x2610; a task, or &#x2011; [ ] a task.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- The live item list -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Checkbox glyph — hollow box while pending, a real
                                             green check once the agent reports it done. -->
                                        <TextBlock x:Name="GlyphText" Grid.Column="0"
                                                   Text="{Binding Glyph}" FontSize="13"
                                                   Margin="0,0,7,0" VerticalAlignment="Top"
                                                   Foreground="{StaticResource Subtext1Brush}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="ItemText" Text="{Binding Text}"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding BuildLabel}" FontSize="10"
                                                       Margin="0,1,0,0"
                                                       Foreground="{StaticResource OverlayBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter TargetName="GlyphText" Property="Foreground"
                                                    Value="{StaticResource GreenBrush}"/>
                                            <Setter TargetName="ItemText" Property="Foreground"
                                                    Value="{StaticResource Subtext1Brush}"/>
                                            <Setter TargetName="ItemText" Property="TextDecorations"
                                                    Value="Strikethrough"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
    </DockPanel>
</Window>

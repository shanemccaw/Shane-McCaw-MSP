<Window x:Class="BuildConsole.TestRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Test Runner"
        WindowState="Maximized"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="180" MinHeight="80"/>
        </Grid.RowDefinitions>

        <!-- ── Status header ── -->
        <Border Grid.Row="0"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <DockPanel>
                        <TextBlock Text="TEST RUNNER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                        <TextBlock x:Name="TxtStatusBadge" Text="● IDLE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtRunLabel" Text="No run yet." FontSize="11" Foreground="{StaticResource Subtext0Brush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSummary" Text="0 pass / 0 warn / 0 crash" FontSize="11" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <!-- Git #966 — opens the click-through screenshot review gallery for the last run; disabled until a run captures at least one screenshot. -->
                    <Button x:Name="BtnScreenshots" Content="📷 Screenshots" IsEnabled="False" Margin="0,0,8,0" Click="BtnScreenshots_Click"/>
                    <Button x:Name="BtnClear" Content="Clear" Click="BtnClear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Left (steps) / Center (browser) / Right (results) ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="380" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: dynamic step list ── -->
            <DockPanel Grid.Column="0" LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,0,1,1"
                        Padding="10,6">
                    <TextBlock Text="Test Steps" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}"/>
                </Border>

                <TextBlock x:Name="TxtNoSteps"
                           DockPanel.Dock="Top"
                           Text="No manifest loaded yet."
                           FontSize="11"
                           Foreground="{StaticResource Subtext0Brush}"
                           Margin="10,10"
                           Visibility="Visible"/>

                <ListBox x:Name="StepsList"
                         BorderThickness="0,0,1,0"
                         BorderBrush="{StaticResource Surface0Brush}"
                         Background="{StaticResource BaseBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource MauveBrush}"
                                               Margin="8,8,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="8,5" Margin="6,2">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusGlyph}" FontWeight="Bold" Foreground="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Surface0Brush}"/>

            <!-- ── Center: live UI run WebView2 ── -->
            <DockPanel Grid.Column="2" LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <TextBlock Text="Live UI Test View" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}"/>
                </Border>

                <Grid>
                    <wv2:WebView2 x:Name="RunnerWebView"/>
                    <TextBlock x:Name="TxtNoUiSteps"
                               Text="This run has no uiSteps — nothing to show here."
                               FontSize="12"
                               Foreground="{StaticResource Subtext0Brush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Surface0Brush}"/>

            <!-- ── Right: telemetry / results card stream ── -->
            <DockPanel Grid.Column="4" LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1,0,0,1"
                        Padding="10,6">
                    <TextBlock Text="Results" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}"/>
                </Border>

                <ScrollViewer x:Name="TelemetryScroller" VerticalScrollBarVisibility="Auto" Padding="10,6">
                    <StackPanel x:Name="TelemetryLogContainer"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource Surface0Brush}"/>

        <!-- ── Bottom: flat-text console log (Git #869) — accumulates the same telemetry stream feeding the right-panel result cards, for one-click Copy into a Claude Code prompt ── -->
        <DockPanel Grid.Row="3" LastChildFill="True">
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Console Output" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnCopyConsole" Grid.Column="1" Content="Copy" Padding="10,2" Click="BtnCopyConsole_Click"/>
                </Grid>
            </Border>

            <TextBox x:Name="ConsoleOutputBox"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     FontFamily="Consolas"
                     FontSize="11"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="{StaticResource BaseBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderThickness="0"
                     Padding="8,6"/>
        </DockPanel>

        <!-- ── Git #966: screenshot review gallery ── the click-through of the last run's captured
             screenshots opened by BtnScreenshots now lives in its own real top-level Window
             (ScreenshotGalleryWindow), not an overlay Grid here, so it renders ABOVE the Live UI Test
             View WebView2 above instead of behind it (the WPF+WebView2 airspace problem). ── -->
    </Grid>
</Window>

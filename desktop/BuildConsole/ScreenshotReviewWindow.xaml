<Window x:Class="BuildConsole.ScreenshotReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Screenshot Review"
        Width="1140" Height="880"
        MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None"
        StateChanged="Window_StateChanged">

    <!-- Git #1006 — same custom title bar treatment as MainWindow (Git #894). -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Screenshot Review" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Subtext1Brush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                        <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header: subject + counter + needs-review chip ── -->
        <Border Grid.Row="0"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Text="Screenshot Review"/>
                    <TextBlock x:Name="SubjectText" FontSize="12" Margin="0,3,0,0"
                               Foreground="{StaticResource Subtext0Brush}" Text=""/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="DiffChip" CornerRadius="4" Padding="8,3" Margin="0,0,12,0"
                            Background="{StaticResource Surface0Brush}">
                        <TextBlock x:Name="DiffChipText" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Text=""/>
                    </Border>
                    <TextBlock x:Name="CounterText" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource Subtext1Brush}" Text="0 / 0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Baseline vs This run ── -->
        <Grid Grid.Row="1" Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Baseline -->
            <Border Grid.Column="0" Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Surface0Brush}" Padding="10,6">
                        <TextBlock Text="BASELINE (source of truth)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext0Brush}"/>
                    </Border>
                    <Grid>
                        <Image x:Name="BaselineImage" Stretch="Uniform" Margin="8"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <!-- Git #1017 — heavy-mouse-user right-click menu, same pattern as #945. -->
                            <Image.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy Image" Click="CopyBaselineImage_Click"/>
                                </ContextMenu>
                            </Image.ContextMenu>
                        </Image>
                        <TextBlock x:Name="BaselineEmptyText" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                   Foreground="{StaticResource PeachBrush}"
                                   Text="No baseline yet — this run will set it on Approve."/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- This run -->
            <Border Grid.Column="2" Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Surface0Brush}" Padding="10,6">
                        <TextBlock Text="THIS RUN" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext0Brush}"/>
                    </Border>
                    <Grid>
                        <Image x:Name="CurrentImage" Stretch="Uniform" Margin="8"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <!-- Git #1017 — heavy-mouse-user right-click menu, same pattern as #945. -->
                            <Image.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy Image" Click="CopyCurrentImage_Click"/>
                                </ContextMenu>
                            </Image.ContextMenu>
                        </Image>
                        <TextBlock x:Name="CurrentEmptyText" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                   Foreground="{StaticResource RedBrush}" Visibility="Collapsed" Text=""/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Narration ── -->
        <Border Grid.Row="2" Margin="16,12,16,0" Padding="14,10"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="NarrationStep" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BlueBrush}" Text=""/>
                    <Border x:Name="VerdictChip" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                            Background="{StaticResource Surface0Brush}">
                        <TextBlock x:Name="VerdictText" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Text=""/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="NarrationWhat" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" Text=""/>
                <TextBlock x:Name="NarrationDiff" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Subtext0Brush}" Text=""/>
            </StackPanel>
        </Border>

        <!-- ── Nav ── -->
        <Grid Grid.Row="3" Margin="16,10,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PrevButton" Grid.Column="0" Content="◀ Prev" MinWidth="90"
                    Style="{StaticResource SecondaryButton}" Click="PrevButton_Click"/>
            <Button x:Name="NextButton" Grid.Column="2" Content="Next ▶" MinWidth="90"
                    Style="{StaticResource SecondaryButton}" Click="NextButton_Click"/>
        </Grid>

        <!-- ── Compose (Report issue) + end actions ── -->
        <Border Grid.Row="4" Margin="16,12,16,16" Padding="14,12"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Report / note (sent to the active Claude chat — you review &amp; press Enter yourself):"
                           FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,6"/>
                <TextBox x:Name="ComposeBox" MinHeight="84" MaxHeight="150"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource Surface0Brush}"
                         Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1" Padding="8"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource Subtext0Brush}" Text=""/>
                    <Button x:Name="ReportButton" Grid.Column="1" Content="🐞 Report issue"
                            MinWidth="130" Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}" Click="ReportButton_Click"/>
                    <Button x:Name="ApproveButton" Grid.Column="2" Content="✅ Approve &amp; set baseline"
                            MinWidth="190"
                            Style="{StaticResource PrimaryButton}" Click="ApproveButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>

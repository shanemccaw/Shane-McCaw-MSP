<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- Git #1866 — the desktop screen-clipping tool needs System.Drawing
         (Graphics.CopyFromScreen / Bitmap) and the OLE clipboard's multi-format
         DataObject path. UseWindowsForms pulls both from the in-box Windows
         Desktop framework (no NuGet). This does NOT change the app's DPI
         awareness or WPF behaviour — it only makes those in-box assemblies
         referenceable. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon (exe/taskbar/Explorer icon, via ApplicationIcon above) — also
         embedded as a WPF Resource so Window.Icon="app.ico" can reference it
         from XAML. Matches the in-app "Antigravity" logo mark (blue triangle
         on CrustBrush). -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- Direct local Postgres client for shaneapp://executeSql — lets BuildConsole
         run SQL through its OWN local DB connection (LocalSqlExecutor), with zero
         round-trip to the deployed Replit dev api-server. 7.0.x targets net7.0
         directly, matching this app's TFM. -->
    <PackageReference Include="Npgsql" Version="7.0.7" />
    <!-- Real system-wide CPU % for the bottom-panel resource meters (Processor/%
         Processor Time/_Total). Not in the .NET base class libraries since
         .NET Core — Windows-only, which is fine, this app is Windows-only WPF. -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="7.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL syntax-highlighting definition, loaded at runtime by SqlRunnerView
         via Assembly.GetManifestResourceStream (Git #939). -->
    <EmbeddedResource Include="Controls\SqlSyntax.xshd" />
    <!-- JSON syntax-highlighting definition, loaded the same way by the Manifest
         Viewer's raw-JSON tab (ManifestViewerWindow). -->
    <EmbeddedResource Include="Controls\JsonSyntax.xshd" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-completion sound. Real "taskCompleted.mp3" copied from Shane's
         actual local Antigravity IDE install (a VS Code fork) — its stock
         accessibility-signal completion sound — bundled here as BuildConsole's
         own local copy so playback never depends on Antigravity's install path
         at runtime (BuildCompletionSoundService falls back to this file when
         Settings has no custom BuildCompleteSoundPath). -->
    <None Include="Assets\Sounds\taskCompleted.mp3" CopyToOutputDirectory="PreserveNewest" />
    <!-- Git #2149 — vendored xterm.js terminal surface for the embedded Claude
         Code terminal (Controls/ClaudeTerminalView). Served to the WebView2 via
         SetVirtualHostNameToFolderMapping, so it must sit alongside the exe. -->
    <None Include="Assets\xterm\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ════════════════════════════════════════════════════════════════════
       Version build-number embedding.

       Before every compile, writes GeneratedBuildInfo.g.cs into the
       intermediate (obj) folder carrying the git commit count for this app's
       own folder as a const, then adds it to @(Compile). VersionInfo.RunningBuild
       reads that const, so a running instance knows the exact build it was
       compiled from (v{Major}.{Minor}.{build}) even after the local repo moves on.

       - Same git command VersionInfo.GetCurrentBuild() runs at runtime, so the
         two numbers are directly comparable.
       - Run from the repo root ($(MSBuildProjectDirectory) up two levels) so the
         desktop/BuildConsole pathspec resolves regardless of where
         `dotnet build` was invoked from.
       - WriteOnlyWhenDifferent keeps the file's timestamp (and thus CoreCompile's
         up-to-date check) stable when the number hasn't changed — no needless rebuilds.
       - git failures (not a repo / git not on PATH) degrade to build number 0
         via ContinueOnError rather than breaking the build.
       ════════════════════════════════════════════════════════════════════ -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-list --count HEAD -- desktop/BuildConsole"
          WorkingDirectory="$(MSBuildProjectDirectory)\..\.."
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitBuildCountRaw" />
      <Output TaskParameter="ExitCode" PropertyName="_GitBuildCountExit" />
    </Exec>
    <PropertyGroup>
      <_GitBuildCount Condition="'$(_GitBuildCountExit)' == '0' and '$(_GitBuildCountRaw)' != ''">$(_GitBuildCountRaw.Trim())</_GitBuildCount>
      <_GitBuildCount Condition="'$(_GitBuildCount)' == ''">0</_GitBuildCount>
      <_GeneratedBuildInfoPath>$(IntermediateOutputPath)GeneratedBuildInfo.g.cs</_GeneratedBuildInfoPath>
    </PropertyGroup>
    <ItemGroup>
      <!-- Each Include is one line of the generated file; the ';' after the const
           is escaped as %3B so MSBuild doesn't treat it as an item separator. -->
      <_GeneratedBuildInfoLine Include="// &lt;auto-generated&gt; Regenerated each build by the GenerateBuildInfo target in BuildConsole.csproj." />
      <_GeneratedBuildInfoLine Include="// Value = git rev-list --count HEAD -- desktop/BuildConsole at build time. Do not edit or commit (lives under obj/)." />
      <_GeneratedBuildInfoLine Include="namespace BuildConsole.Services" />
      <_GeneratedBuildInfoLine Include="{" />
      <_GeneratedBuildInfoLine Include="    internal static class GeneratedBuildInfo" />
      <_GeneratedBuildInfoLine Include="    {" />
      <_GeneratedBuildInfoLine Include="        public const int BuildNumber = $(_GitBuildCount)%3B" />
      <_GeneratedBuildInfoLine Include="    }" />
      <_GeneratedBuildInfoLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_GeneratedBuildInfoPath)"
                      Lines="@(_GeneratedBuildInfoLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_GeneratedBuildInfoPath)" />
      <FileWrites Include="$(_GeneratedBuildInfoPath)" />
    </ItemGroup>
  </Target>

</Project>

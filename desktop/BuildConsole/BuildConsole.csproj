<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- Git #989 — claude.exe itself owns no window (attached to its parent's
         console), so a real live-updated title (e.g. Send-to-Builder's
         "✳ 989") only exists on an ANCESTOR process (cmd.exe/powershell.exe).
         Process has no parent-PID API; WMI's Win32_Process is the standard
         way to walk that chain. -->
    <PackageReference Include="System.Management" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL syntax-highlighting definition, loaded at runtime by SqlRunnerView
         via Assembly.GetManifestResourceStream (Git #939). -->
    <EmbeddedResource Include="Controls\SqlSyntax.xshd" />
  </ItemGroup>

</Project>

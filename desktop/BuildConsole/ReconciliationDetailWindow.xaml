<Window x:Class="BuildConsole.ReconciliationDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-Reconciled Builds"
        Width="620" Height="520"
        MinWidth="480" MinHeight="320"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Git #3518 — the click-through detail for the persistent "N builds were auto-reconciled" toast.
         Lists every real row FalseDoneReconciler acted on (newest first), each traceable to its real
         GitHub issue and labelled with WHAT happened (BLOCKED reset vs. false-done revert vs. false-done
         reset) and WHY — so an automated cancel of real, dispatched work is never invisible again. Same
         borderless dark-themed chrome as MissingVariableWindow; the header strip is the drag handle. -->
    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header strip / drag handle -->
            <Border x:Name="HeaderStrip" Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="10,7,8,7"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE895;"
                               FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{StaticResource PeachBrush}"/>
                    <TextBlock Grid.Column="1" Text="Auto-Reconciled Builds"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <Button x:Name="BtnClose" Grid.Column="2"
                            Content="&#x2715;"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="6,2,6,2"
                            ToolTip="Close"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Summary line -->
            <TextBlock x:Name="SummaryText" Grid.Row="1"
                       Margin="12,10,12,6"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource Subtext0Brush}"/>

            <!-- The per-item list -->
            <ScrollViewer Grid.Row="2" Margin="8,0,8,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,4,4,4"
                                    Background="{StaticResource BaseBrush}"
                                    BorderBrush="{StaticResource Surface0Brush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Accent bar keyed to the action kind -->
                                    <Border Grid.Column="0"
                                            Background="{Binding Accent}"
                                            CornerRadius="5,0,0,5"/>

                                    <Grid Grid.Column="1" Margin="10,8,10,9">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Title row: issue link + action + timestamp -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="{Binding IssueLabel}"
                                                    Tag="{Binding IssueNumber}"
                                                    Style="{StaticResource IconButton}"
                                                    Padding="0"
                                                    Margin="0,0,8,0"
                                                    FontWeight="Bold"
                                                    FontSize="13"
                                                    Foreground="{StaticResource BlueBrush}"
                                                    Cursor="Hand"
                                                    ToolTip="Open this issue on GitHub"
                                                    Click="OpenIssue_Click"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ActionLabel}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Accent}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding When}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Subtext0Brush}"/>
                                        </Grid>

                                        <!-- Reason -->
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,5,0,0"
                                                   Text="{Binding Reason}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="12,8,12,12">
                <TextBlock x:Name="FooterHint"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           FontSize="11"
                           Foreground="{StaticResource Subtext0Brush}"
                           Text="These items were auto-corrected — none were relaunched. Re-dispatch any from Backlog."/>
                <Button x:Name="BtnDone"
                        Content="Got it"
                        Style="{StaticResource PrimaryButton}"
                        Padding="14,5,14,5"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

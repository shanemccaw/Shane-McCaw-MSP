<Window x:Class="BuildConsole.WpfTesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WPF Tester"
        Icon="app.ico"
        Height="920" Width="1480"
        MinWidth="1000" MinHeight="600"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ToolCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- TITLE BAR -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1" Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
                    <TextBlock Text="&#x1F9EA;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="WPF Control Tester" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock x:Name="TxtRenderStatus" Text="Ready" FontSize="11" Foreground="{StaticResource StatusSuccessBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="0,0,16,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="Control:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbControlPicker" Width="220" Height="26"
                              SelectionChanged="CmbControlPicker_SelectionChanged"
                              VerticalContentAlignment="Center" FontSize="11"/>

                    <Separator Width="1" Height="20" Background="{StaticResource Surface1Brush}" Margin="12,0"/>

                    <TextBlock Text="W:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxtOverrideWidth" Width="54" Height="26" Text="Auto" FontSize="11"
                             VerticalContentAlignment="Center" TextChanged="TxtOverrideDimension_TextChanged"
                             ToolTip="Preview width (Auto = fill panel)"/>
                    <TextBlock Text="H:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="TxtOverrideHeight" Width="54" Height="26" Text="Auto" FontSize="11"
                             VerticalContentAlignment="Center" TextChanged="TxtOverrideDimension_TextChanged"
                             ToolTip="Preview height (Auto = fill panel)"/>

                    <Separator Width="1" Height="20" Background="{StaticResource Surface1Brush}" Margin="12,0"/>

                    <TextBlock Text="BG:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbBgOverride" Width="110" Height="26" FontSize="11"
                              VerticalContentAlignment="Center" SelectionChanged="CmbBgOverride_SelectionChanged">
                        <ComboBoxItem Content="Default (Base)" IsSelected="True" Tag="default"/>
                        <ComboBoxItem Content="Checkerboard" Tag="checker"/>
                        <ComboBoxItem Content="White" Tag="white"/>
                        <ComboBoxItem Content="Black" Tag="black"/>
                    </ComboBox>

                    <Separator Width="1" Height="20" Background="{StaticResource Surface1Brush}" Margin="12,0"/>

                    <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Padding="10,4" Margin="0,0,8,0"
                            Background="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1" ToolTip="Reload control">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F504;" Margin="0,0,5,0"/>
                            <TextBlock Text="Reload" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnScreenshot" Click="BtnScreenshot_Click" Padding="10,4"
                            Background="{StaticResource Surface0Brush}" Foreground="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1"
                            ToolTip="Save PNG snapshot to Desktop">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4F7;" Margin="0,0,5,0"/>
                            <TextBlock Text="Screenshot" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Caption Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                        <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="240" MaxWidth="460"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: INSPECTOR -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDividerBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>

                        <!-- Control Info -->
                        <Border Style="{StaticResource ToolCard}">
                            <StackPanel>
                                <TextBlock Text="CONTROL INFO" FontWeight="SemiBold" FontSize="10"
                                           Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Name:" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Top" Margin="0,2"/>
                                    <TextBlock x:Name="TxtInfoName" Grid.Column="1" Text="—" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="1" Text="Type:" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Top" Margin="0,2"/>
                                    <TextBlock x:Name="TxtInfoType" Grid.Row="1" Grid.Column="1" Text="—" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="2" Text="Actual size:" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" Margin="0,2"/>
                                    <TextBlock x:Name="TxtInfoSize" Grid.Row="2" Grid.Column="1" Text="—" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="3" Text="Visuals:" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" Margin="0,2"/>
                                    <TextBlock x:Name="TxtInfoVisuals" Grid.Row="3" Grid.Column="1" Text="—" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Live Dimensions -->
                        <Border Style="{StaticResource ToolCard}">
                            <StackPanel>
                                <TextBlock Text="LIVE DIMENSIONS" FontWeight="SemiBold" FontSize="10"
                                           Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Actual Width" FontSize="10" Foreground="{StaticResource TextDisabledBrush}"/>
                                        <TextBlock x:Name="TxtLiveWidth" Text="—" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Actual Height" FontSize="10" Foreground="{StaticResource TextDisabledBrush}"/>
                                        <TextBlock x:Name="TxtLiveHeight" Text="—" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauveBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <Separator Margin="0,8" Background="{StaticResource Surface1Brush}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Desired W" FontSize="10" Foreground="{StaticResource TextDisabledBrush}"/>
                                        <TextBlock x:Name="TxtDesiredWidth" Text="—" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Desired H" FontSize="10" Foreground="{StaticResource TextDisabledBrush}"/>
                                        <TextBlock x:Name="TxtDesiredHeight" Text="—" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Visual Tree -->
                        <Border Style="{StaticResource ToolCard}">
                            <StackPanel>
                                <TextBlock Text="VISUAL TREE" FontWeight="SemiBold" FontSize="10"
                                           Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,8"/>
                                <TreeView x:Name="VisualTree" MinHeight="140" MaxHeight="240"
                                          Background="Transparent" BorderThickness="0" FontSize="11"
                                          SelectedItemChanged="VisualTree_SelectedItemChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Selected Element Properties -->
                        <Border Style="{StaticResource ToolCard}">
                            <StackPanel>
                                <TextBlock Text="SELECTED ELEMENT" FontWeight="SemiBold" FontSize="10"
                                           Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtSelectedElement" Text="(none)" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtSelectedProperties" Text=""
                                               FontFamily="Cascadia Code, Consolas" FontSize="10"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Width Presets -->
                        <Border Style="{StaticResource ToolCard}">
                            <StackPanel>
                                <TextBlock Text="WIDTH PRESETS" FontWeight="SemiBold" FontSize="10"
                                           Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="280" Tag="280" Margin="0,0,4,4" Padding="10,3" FontSize="11" Click="SizePreset_Click"/>
                                    <Button Content="360" Tag="360" Margin="0,0,4,4" Padding="10,3" FontSize="11" Click="SizePreset_Click"/>
                                    <Button Content="480" Tag="480" Margin="0,0,4,4" Padding="10,3" FontSize="11" Click="SizePreset_Click"/>
                                    <Button Content="640" Tag="640" Margin="0,0,4,4" Padding="10,3" FontSize="11" Click="SizePreset_Click"/>
                                    <Button Content="Fill" Tag="Auto" Margin="0,0,4,4" Padding="10,3" FontSize="11" Click="SizePreset_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource Surface0Brush}" ResizeBehavior="PreviousAndNext"/>

            <!-- CENTER: RENDER CANVAS -->
            <Border Grid.Column="2" x:Name="RenderArea" Background="{StaticResource BaseBrush}">
                <Grid>
                    <Border x:Name="RenderHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                            SizeChanged="RenderHost_SizeChanged"/>

                    <StackPanel x:Name="PnlEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Visible">
                        <TextBlock Text="&#x1F9EA;" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                        <TextBlock Text="Select a control to render" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Use the dropdown in the toolbar to pick any BuildConsole UserControl."
                                   FontSize="12" Foreground="{StaticResource TextDisabledBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
                    </StackPanel>

                    <Border x:Name="PnlError" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#3A1818" BorderBrush="{StaticResource StatusFailedBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel>
                            <TextBlock Text="&#x26A0; Render Error" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource StatusFailedBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtErrorMessage" Text="" FontFamily="Cascadia Code, Consolas" FontSize="11"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" MaxWidth="500"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource Surface0Brush}" ResizeBehavior="PreviousAndNext"/>

            <!-- RIGHT: EVENT LOG -->
            <Border Grid.Column="4" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDividerBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderDividerBrush}"
                            BorderThickness="0,0,0,1" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Event Log" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Clear" Click="BtnClearLog_Click" Padding="8,2" FontSize="10"
                                    Background="{StaticResource Surface0Brush}" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1"/>
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="10,4"
                            BorderBrush="{StaticResource BorderDividerBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtLogCount" Text="0 events" FontSize="10" Foreground="{StaticResource TextDisabledBrush}"/>
                            <TextBlock Text=" • " Foreground="{StaticResource TextDisabledBrush}" FontSize="10"/>
                            <TextBlock x:Name="TxtLogLastTime" Text="—" FontSize="10" Foreground="{StaticResource TextDisabledBrush}"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LstEventLog">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" Margin="0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Background" Value="#2A1010"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Background" Value="#2A2010"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                                        <Setter Property="Background" Value="#102010"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding TimeStr}" FontSize="9"
                                                           Foreground="{StaticResource TextDisabledBrush}"
                                                           FontFamily="Cascadia Code, Consolas" Margin="0,0,6,0"/>
                                                <Border CornerRadius="2" Padding="4,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                    <Setter Property="Background" Value="#5A1010"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                    <Setter Property="Background" Value="#5A4010"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                                                    <Setter Property="Background" Value="#105A10"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Level}" FontSize="9" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                        <Setter Property="Foreground" Value="{StaticResource StatusFailedBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                        <Setter Property="Foreground" Value="#F9E2AF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                                                        <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="10.5"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>

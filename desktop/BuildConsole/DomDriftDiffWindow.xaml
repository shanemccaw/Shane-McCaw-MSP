<Window x:Class="BuildConsole.DomDriftDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DOM Mutation Drift Viewer"
        Icon="app.ico"
        Height="700" Width="1100"
        MinWidth="800" MinHeight="500"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <!-- Custom Dark Title Bar -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="-1"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True">
        <!-- ── Title Bar ── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="DOM Mutation Drift &amp; Regression Viewer"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="CloseBtn_Click" Style="{StaticResource IconButton}" Content="✕" Width="36" Height="36" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Summary Bar -->
                <RowDefinition Height="*"/>    <!-- Drift Items List -->
                <RowDefinition Height="Auto"/> <!-- Bottom Action Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Summary Bar -->
            <Border Grid.Row="0" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="TxtPageRoute" Text="Route: /" FontSize="14" FontWeight="Bold" Foreground="{StaticResource MauveBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtBaselineAge" Text="Baseline recorded: 7 days ago" FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Total Drift Count -->
                        <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtTotalDrift" Text="0 Total Drifts" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        </Border>

                        <!-- Added Badge -->
                        <Border Background="#1A22C55E" BorderBrush="#4022C55E" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtAddedCount" Text="0 Added" FontSize="11" FontWeight="Bold" Foreground="#22C55E"/>
                        </Border>

                        <!-- Modified Badge -->
                        <Border Background="#1AEAB308" BorderBrush="#40EAB308" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtModifiedCount" Text="0 Modified" FontSize="11" FontWeight="Bold" Foreground="#EAB308"/>
                        </Border>

                        <!-- Removed Badge -->
                        <Border Background="#1AEF4444" BorderBrush="#40EF4444" BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <TextBlock x:Name="TxtRemovedCount" Text="0 Removed" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Drift List -->
            <Border Grid.Row="1" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock Text="Detected DOM Mutations &amp; Structure Drift" DockPanel.Dock="Top" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Subtext0Brush}" Margin="4,0,0,8"/>

                    <ListBox x:Name="LstDriftItems" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="10,8" Margin="0,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 1: Action Badge, Tag, Selector -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{Binding ActionBadgeColor}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding ActionDisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CrustBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Tag, StringFormat='&lt;{0}&gt;'}" FontSize="11.5" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource MauveBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Selector}" FontSize="11.5" FontFamily="Consolas" Foreground="{StaticResource TextBrush}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Timestamp}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                                        </DockPanel>

                                        <!-- Row 2: Target description / Attribute name -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Subtext1Brush}" Margin="0,0,0,4"/>

                                        <!-- Row 3: Old vs New values -->
                                        <Grid Grid.Row="2" Visibility="{Binding HasValueDiffVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{StaticResource BaseBrush}" CornerRadius="3" Padding="6,4">
                                                <TextBlock Text="{Binding OldValue, StringFormat='Baseline: {0}'}" FontSize="10.5" FontFamily="Consolas" Foreground="#EF4444" TextTrimming="CharacterEllipsis"/>
                                            </Border>

                                            <TextBlock Grid.Column="1" Text=" ➔ " FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Subtext1Brush}"/>

                                            <Border Grid.Column="2" Background="{StaticResource BaseBrush}" CornerRadius="3" Padding="6,4">
                                                <TextBlock Text="{Binding NewValue, StringFormat='Live: {0}'}" FontSize="10.5" FontFamily="Consolas" Foreground="#22C55E" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 3. Bottom Action Bar -->
            <Border Grid.Row="2" Background="{StaticResource BaseBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnAcceptUpdateBaseline" Content="✓ Accept Drift &amp; Update Baseline" Style="{StaticResource PrimaryButton}" Padding="12,6" FontWeight="Bold" Margin="0,0,10,0" Click="BtnAcceptUpdateBaseline_Click"/>
                        <Button x:Name="BtnCreateBugReport" Content="🐛 File Bug Report from Drift" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="BtnCreateBugReport_Click"/>
                    </StackPanel>

                    <Button Content="Close" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="12,6" Click="CloseBtn_Click"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>

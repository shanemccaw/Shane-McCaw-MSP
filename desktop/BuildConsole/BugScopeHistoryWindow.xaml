<Window x:Class="BuildConsole.BugScopeHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bug History"
        Width="520" Height="480"
        MinWidth="420" MinHeight="320"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Git #3984 — a real, reusable scoped bug-history detail view: "clicking the icon opens a
         clean detail view listing every bug/GitHub issue/closing build tied to" the clicked scope.
         Deliberately generic over its list of entries + a scope-description header so #3983
         (element-level) can open this SAME window against a (page_id, selector) query instead of
         building a second one, per that issue's own instruction to reuse #3984's component (or,
         since #3983 landed first in a given install, the reverse) — same data shape either way. -->
    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Scope description -->
                <RowDefinition Height="*"/>    <!-- Bug list -->
            </Grid.RowDefinitions>

            <!-- 1. Header strip: title + drag handle + close -->
            <Border x:Name="HeaderStrip" Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="10,6,8,6"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🐞" FontSize="13"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtWindowTitle" Grid.Column="1" Text="Bug History"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <Button x:Name="BtnClose" Grid.Column="2"
                            Content="✕"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="5,2,5,2"
                            ToolTip="Close"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 2. Scope description -->
            <Border Grid.Row="1" Background="{StaticResource Surface0Brush}"
                    BorderBrush="{StaticResource Surface1Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,6,12,6">
                <TextBlock x:Name="TxtScopeDescription" Text="Scope"
                           FontSize="11" Foreground="{StaticResource Subtext1Brush}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- 3. Scrollable bug list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8,12,8">
                <StackPanel>
                    <TextBlock x:Name="TxtEmpty"
                               Text="No bugs recorded for this scope."
                               FontSize="11" FontStyle="Italic"
                               Foreground="{StaticResource Subtext1Brush}"
                               TextAlignment="Center"
                               Margin="0,30,0,0"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="BugCardsPanel"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

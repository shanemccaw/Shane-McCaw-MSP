<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════
         Git #2126 — SHELL REDESIGN, real final color values.
         Single source of truth for the new dark theme. Every value below is
         copied verbatim from #2126's issue body — do not deviate or
         re-derive. Informed by Apple HIG / Fluent 2 (desaturate for dark
         mode, brighten the accent slightly rather than inverting light-mode
         values so it stays visible without vibrating).

         Themes/DarkTheme.xaml (the app's existing merged theme, referenced
         from every panel) is retargeted to pull its core structural brushes
         from here — see the "Git #2126 retarget" comment blocks in that
         file. This dictionary is not itself referenced from XAML views;
         DarkTheme.xaml's existing brush keys are, so re-theming here
         cascades automatically without a rename across the app.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Backgrounds (layered, not flat) -->
    <Color x:Key="AppBackgroundColor">#0D1117</Color>
    <Color x:Key="PanelBackgroundColor">#161B22</Color>
    <Color x:Key="CardBackgroundColor">#1C2128</Color>
    <Color x:Key="BorderColor">#30363D</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush"   Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderDividerBrush"   Color="{StaticResource BorderColor}"/>

    <!-- Text (never pure white) -->
    <Color x:Key="TextPrimaryColor">#C9D1D9</Color>
    <Color x:Key="TextSecondaryColor">#8B949E</Color>
    <Color x:Key="TextDisabledColor">#6E7681</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="{StaticResource TextDisabledColor}"/>
    <!-- Primary aliases available unconditionally across all dictionary merge states -->
    <SolidColorBrush x:Key="TextBrush"     Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="{StaticResource TextSecondaryColor}"/>

    <!-- Accent (interactive elements, links, selected state) -->
    <Color x:Key="AccentColor">#7C8CF0</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <!-- Low-opacity accent washes for hover/selection fills — same two tiers
         already in use app-wide before this redesign (10% / 20%), just
         recolored onto the new Accent hue so selection/hover reads
         consistently with the new solid AccentBrush instead of the old
         Catppuccin blue. -->
    <SolidColorBrush x:Key="AccentWashLightBrush"  Color="#1A7C8CF0"/>
    <SolidColorBrush x:Key="AccentWashBrush"       Color="#2A7C8CF0"/>
    <SolidColorBrush x:Key="AccentWashMediumBrush" Color="#337C8CF0"/>

    <!-- Contrast text for use on top of a bright accent fill (e.g. a checked
         segmented-toggle chip whose background is BlueBrush/SapphireBrush) —
         needs a genuine opaque near-black, not TextPrimaryColor, or the text
         reads muddy against the light accent. Git #4220: this is the exact
         pre-Git-#2126 Catppuccin Crust base value (#11111B) that had no
         surviving brush after CrustBrush itself was remapped to #CC0D1117
         (same role, different value, plus alpha) — named for its actual
         role here rather than reusing the Crust name. -->
    <Color x:Key="OnAccentTextColor">#11111B</Color>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="{StaticResource OnAccentTextColor}"/>

    <!-- Status colors (desaturated, never neon, brightened slightly for
         consistency with the accent's treatment) -->
    <Color x:Key="StatusSuccessColor">#8FC496</Color>
    <Color x:Key="StatusErrorColor">#DC8A8A</Color>
    <Color x:Key="StatusWarningColor">#D4A56C</Color>
    <Color x:Key="StatusRunningColor">#79B3C8</Color>

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}"/>
    <SolidColorBrush x:Key="StatusErrorBrush"   Color="{StaticResource StatusErrorColor}"/>
    <SolidColorBrush x:Key="StatusFailedBrush"  Color="{StaticResource StatusErrorColor}"/> <!-- alias for compatibility -->
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}"/>
    <SolidColorBrush x:Key="StatusRunningBrush" Color="{StaticResource StatusRunningColor}"/>

    <!-- Low-opacity success wash, same treatment as the accent washes above
         — used by the same handful of selection/highlight fills that were
         previously composited against the old Catppuccin green. -->
    <SolidColorBrush x:Key="StatusSuccessWashLightBrush"  Color="#1A8FC496"/>
    <SolidColorBrush x:Key="StatusSuccessWashMediumBrush" Color="#338FC496"/>

    <!-- Same low-opacity wash treatment for Error/Warning, so row/badge
         backgrounds that need a status tint have a real brush instead of a
         raw hex literal (Git #4200). -->
    <SolidColorBrush x:Key="StatusErrorWashLightBrush"    Color="#1ADC8A8A"/>
    <SolidColorBrush x:Key="StatusErrorWashMediumBrush"   Color="#33DC8A8A"/>
    <SolidColorBrush x:Key="StatusWarningWashLightBrush"  Color="#1AD4A56C"/>
    <SolidColorBrush x:Key="StatusWarningWashMediumBrush" Color="#33D4A56C"/>

    <!-- Git #4210 — HomeView's status-badge backgrounds. These are opaque
         solids, not compositable washes like the ones immediately above, so
         they're distinct brushes rather than a reuse of StatusXWashBrush at
         a different alpha. Exact values already in live use in
         HomeView.xaml/.xaml.cs's ColorConverter.ConvertFromString calls. -->
    <SolidColorBrush x:Key="StatusSuccessBadgeBrush" Color="#1E3A2F"/>
    <SolidColorBrush x:Key="StatusWarningBadgeBrush" Color="#3E2E1E"/>
    <SolidColorBrush x:Key="StatusErrorBadgeBrush"   Color="#3E1E1E"/>
    <SolidColorBrush x:Key="StatusRunningBadgeBrush" Color="#2A2B3D"/>
    <SolidColorBrush x:Key="StatusActiveBadgeBrush"  Color="#1E2A3A"/>
    <SolidColorBrush x:Key="StatusWarningBadgeAltBrush" Color="#3E2723"/>

    <!-- Opaque dark banner backgrounds for a solid Border filled behind a
         StatusError/WarningBrush border+text (not a semi-transparent wash
         composited over a panel — these need to read as a solid card, e.g.
         BuildQueuePanel.xaml's OrphanRecoveryBanner / BuildSetFilterWarningPopup).
         Git #4214: exact values from that issue's own evidence, no existing
         brush covered this opaque-banner role. -->
    <SolidColorBrush x:Key="StatusErrorBannerBackgroundBrush"   Color="#3A1E26"/>
    <SolidColorBrush x:Key="StatusWarningBannerBackgroundBrush" Color="#3A3200"/>

    <!-- Git #4205 — modal/overlay dim "scrim" brushes. Hue-independent (black at
         two fixed opacities), so these live here rather than under a hue section.
         Values are the two real tiers already in use app-wide before this issue —
         confirmed at MainWindow.xaml's TabSwitcherOverlay/DockGuideOverlay and
         RegionSelectOverlayWindow.xaml — named verbatim, not retuned. -->
    <SolidColorBrush x:Key="ScrimBrush"      Color="#95000000"/> <!-- ~58% full-dim -->
    <SolidColorBrush x:Key="ScrimLightBrush" Color="#40000000"/> <!-- ~25% light-dim -->
    <SolidColorBrush x:Key="ScrimMediumBrush" Color="#80000000"/> <!-- ~50% mid-dim; Git #4217 -->


    <!-- ══════════════════════════════════════════════════════════════════
         Git #4225 — Build Map canvas palette (LocalMapWindow.xaml,
         BuildChainMapWindow.xaml, Controls/BuildMap/LocalMapCanvasControl.xaml,
         Controls/BuildMap/ChainCanvasControl.xaml). A distinct GitHub-dark
         hue, deliberately its own design language rather than this app's
         Catppuccin-derived chrome above (see BuildChainMapWindow.xaml's own
         header comment) — named here so raw hex literals map to real,
         Theme-Editor-visible brushes instead of being untracked strings.
         Values are copied verbatim from #4225's evidence table; do not
         re-derive or substitute an inexact existing brush.
         ══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="BuildMapCanvasBackgroundColor">#0a0d12</Color>
    <Color x:Key="BuildMapButtonBackgroundColor">#0f1319</Color>
    <Color x:Key="BuildMapSurfaceBackgroundColor">#0d1117</Color>
    <Color x:Key="BuildMapGridDotColor">#141a22</Color>
    <Color x:Key="BuildMapBorderColor">#21262d</Color>
    <Color x:Key="BuildMapButtonHoverBackgroundColor">#161c25</Color>
    <Color x:Key="BuildMapTextPrimaryColor">#c9d1d9</Color>
    <Color x:Key="BuildMapTextSecondaryColor">#8b949e</Color>
    <Color x:Key="BuildMapTextTertiaryColor">#576069</Color>
    <Color x:Key="BuildMapAccentColor">#6a8fb5</Color>
    <Color x:Key="BuildMapAccentBackgroundColor">#1d3450</Color>
    <Color x:Key="BuildMapTextHeadingColor">#e6edf3</Color>

    <SolidColorBrush x:Key="BuildMapCanvasBackgroundBrush"      Color="{StaticResource BuildMapCanvasBackgroundColor}"/>
    <SolidColorBrush x:Key="BuildMapButtonBackgroundBrush"      Color="{StaticResource BuildMapButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="BuildMapSurfaceBackgroundBrush"     Color="{StaticResource BuildMapSurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="BuildMapGridDotBrush"                Color="{StaticResource BuildMapGridDotColor}"/>
    <SolidColorBrush x:Key="BuildMapBorderBrush"                 Color="{StaticResource BuildMapBorderColor}"/>
    <SolidColorBrush x:Key="BuildMapButtonHoverBackgroundBrush" Color="{StaticResource BuildMapButtonHoverBackgroundColor}"/>
    <SolidColorBrush x:Key="BuildMapTextPrimaryBrush"            Color="{StaticResource BuildMapTextPrimaryColor}"/>
    <SolidColorBrush x:Key="BuildMapTextSecondaryBrush"          Color="{StaticResource BuildMapTextSecondaryColor}"/>
    <SolidColorBrush x:Key="BuildMapTextTertiaryBrush"           Color="{StaticResource BuildMapTextTertiaryColor}"/>
    <SolidColorBrush x:Key="BuildMapAccentBrush"                 Color="{StaticResource BuildMapAccentColor}"/>
    <SolidColorBrush x:Key="BuildMapAccentBackgroundBrush"       Color="{StaticResource BuildMapAccentBackgroundColor}"/>
    <SolidColorBrush x:Key="BuildMapTextHeadingBrush"            Color="{StaticResource BuildMapTextHeadingColor}"/>

</ResourceDictionary>

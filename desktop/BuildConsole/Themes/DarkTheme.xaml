<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:behaviors="clr-namespace:BuildConsole.Behaviors">

    <!-- ══════════════════════════════════════════════════════════════════
         PALETTE — Git #2126 retarget (2026-08-31)

         The structural/semantic brushes below (backgrounds, text hierarchy,
         accent, and the four status colors used with a genuine status
         meaning — see StartupLoadingView.xaml.cs) now pull their Color from
         Themes/Colors.xaml, the new single source of truth, instead of the
         literal Catppuccin Mocha hex they carried before. Every consumer in
         the app already references these SAME key names via StaticResource,
         so this alone re-themes the whole app without a rename sweep.

         Crust/Mantle/Base keep their original alpha channel (CC/CC/66) —
         that transparency is a distinct, pre-existing window-chrome effect
         unrelated to this issue — with only the RGB swapped to the new
         Colors.xaml value (WPF Color can't compose "resource RGB + literal
         alpha" in one attribute, so these three stay literal computed hex;
         every other retargeted brush below references the Colors.xaml
         resource directly).

         NOT retargeted, left exactly as-is (Catppuccin Mocha originals):
         Surface0/1/2Brush (hover/pressed tiers — #2126 defines one flat
         Border/divider tone, not a 3-tier hover system, and inventing tiers
         beyond the given values would be re-deriving them) and Mauve/Green/
         Red/Peach/Yellow/Sky/Sapphire/Lavender/Teal/Pink/Flamingo/Rosewater/
         MaroonBrush — audited and found to be used for BOTH genuine status
         semantics (e.g. PeachBrush as LeftSidebar's TargetEnvWarningBadge,
         GreenBrush as HomeView's ClaudeStatusDot) AND purely decorative,
         non-status accents at other call sites (e.g. PeachBrush as
         GraphApiDocumentView's "Execute" CTA button, HomeView's "Quick Win"
         badge; YellowBrush as FocusModeBar's "In Progress" lightning icon).
         Blanket-retargeting these to the four new status colors would
         silently recolor the decorative uses too. Filed as a follow-up
         finding (see bookend) for a site-by-site pass instead of guessing
         here. -->
    <SolidColorBrush x:Key="CrustBrush"    Color="#CC0D1117"/> <!-- was #CC11111B; Colors.xaml AppBackgroundColor + orig CC alpha -->
    <SolidColorBrush x:Key="MantleBrush"   Color="#CC161B22"/> <!-- was #CC181825; Colors.xaml PanelBackgroundColor + orig CC alpha -->
    <SolidColorBrush x:Key="BaseBrush"     Color="#661C2128"/> <!-- was #661E1E2E; Colors.xaml CardBackgroundColor + orig 66 alpha -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#313244"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#45475A"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#585B70"/>
    <SolidColorBrush x:Key="OverlayBrush"  Color="{StaticResource TextDisabledColor}"/>  <!-- was #6C7086 -->
    <SolidColorBrush x:Key="TextBrush"     Color="{StaticResource TextPrimaryColor}"/>    <!-- was #CDD6F4 -->
    <SolidColorBrush x:Key="Subtext0Brush" Color="{StaticResource TextSecondaryColor}"/>  <!-- was #BAC2DE -->
    <SolidColorBrush x:Key="Subtext1Brush" Color="{StaticResource TextSecondaryColor}"/>  <!-- was #A6ADC8 -->
    <SolidColorBrush x:Key="BlueBrush"     Color="{StaticResource AccentColor}"/>         <!-- was #89B4FA -->
    <SolidColorBrush x:Key="MauveBrush"    Color="#CBA6F7"/>
    <SolidColorBrush x:Key="GreenBrush"    Color="#A6E3A1"/>
    <SolidColorBrush x:Key="RedBrush"      Color="#F38BA8"/>
    <SolidColorBrush x:Key="PeachBrush"    Color="#FAB387"/>
    <SolidColorBrush x:Key="YellowBrush"   Color="#F9E2AF"/>
    <SolidColorBrush x:Key="SkyBrush"       Color="#89DCEB"/>
    <SolidColorBrush x:Key="SapphireBrush"  Color="#74C7EC"/>
    <SolidColorBrush x:Key="LavenderBrush"  Color="#B4BEFE"/>
    <SolidColorBrush x:Key="TealBrush"      Color="#94E2D5"/>
    <SolidColorBrush x:Key="PinkBrush"      Color="#F5C2E7"/>
    <SolidColorBrush x:Key="FlamingoBrush"  Color="#F2CDCD"/>
    <SolidColorBrush x:Key="RosewaterBrush" Color="#F5E0DC"/>
    <SolidColorBrush x:Key="MaroonBrush"    Color="#EBA0AC"/>

    <!-- Status-semantic brushes StatusSuccessBrush/StatusErrorBrush/
         StatusWarningBrush/StatusRunningBrush are declared once, in
         Themes/Colors.xaml — used ONLY where a call site genuinely means
         "success/error/warning/running", never as a decorative substitute
         for the Catppuccin accents above. Not redeclared here to avoid a
         duplicate resource key across the two merged dictionaries. -->

    <!-- ══════════════════════════════════════════════════════════════════
         AMBIENCE — shared soft depth-shadows, muted accent glows, and
         dark-to-dark gradient sheens for the whole-app polish pass.

         Design constraints (Shane is ADHD, sensitive to bright/harsh light —
         "Dark color. Bright hurts my eyes. Pinks are bad."): everything here
         is deliberately LOW-intensity. Shadows are near-black at low opacity
         (real layering, no glare). Glows are ShadowDepth=0 haloes in the
         palette's already-muted COOL accents only — Blue #89B4FA, Green
         #A6E3A1, Lavender #B4BEFE — at 0.20–0.34 opacity. No pinks, mauves,
         reds, peaches or yellows are used as glow colours anywhere in the
         persistent chrome. Gradients stay dark-to-dark (a whisper of top
         light), never a bright-to-dark ramp. When in doubt: fainter.

         These are Freezable resources shared by reference wherever a purely
         static effect is wanted; interactive elements that animate a glow
         in/out on hover/state use their own inline effect + storyboard so
         the shared frozen instances are never mutated.
         ══════════════════════════════════════════════════════════════════ -->
    <!-- Depth shadows (near-black, drop below) -->
    <DropShadowEffect x:Key="SoftRowShadow"   Color="#000000" BlurRadius="8"  ShadowDepth="1.5" Direction="270" Opacity="0.26"/>
    <DropShadowEffect x:Key="SoftCardShadow"  Color="#000000" BlurRadius="16" ShadowDepth="3"   Direction="270" Opacity="0.34"/>

    <!-- Muted accent glows (halo — ShadowDepth 0 — for genuinely active/important elements only) -->
    <DropShadowEffect x:Key="BlueGlowFaint" Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.22"/> <!-- Git #2126: was #89B4FA -->
    <DropShadowEffect x:Key="BlueGlowSoft"  Color="{StaticResource AccentColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.32"/> <!-- Git #2126: was #89B4FA -->
    <DropShadowEffect x:Key="GreenGlowSoft" Color="#A6E3A1" BlurRadius="16" ShadowDepth="0" Opacity="0.30"/>

    <!-- Per-instance ambient blue glow for CTA buttons — x:Shared="False" hands each
         button its OWN effect instance so a hover storyboard animating one never
         mutates the others. Rest state is a whisper (0.22); hover eases it warmer. -->
    <DropShadowEffect x:Key="CtaAmbientGlow" x:Shared="False" Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.22"/> <!-- Git #2126: was #89B4FA -->

    <!-- Dark-to-dark gradient sheens (a whisper of top light, no bright ramp) -->
    <LinearGradientBrush x:Key="CardSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F2030" Offset="0"/>
        <GradientStop Color="#191926" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FocusCardSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#20263B" Offset="0"/>
        <GradientStop Color="#1A1E2E" Offset="1"/>
    </LinearGradientBrush>

    <!-- ══════════════════════════════════════════════════════════════════
         WINDOW
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource BaseBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="{StaticResource BodyFontSize}"/> <!-- Git #2126: was 13 -->
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         CUSTOM TITLE BAR CAPTION BUTTONS (Git #894, shared Git #1006) —
         minimize/maximize-restore/close for any WindowStyle="None" window.
         Flush against the true window edge (no rounded corners, full
         CaptionHeight tall) to read as genuine system buttons rather than
         more toolbar icons — close gets the standard Windows red hover, the
         other two get the standard light-gray hover.
         ══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Subtext1Brush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionButtonClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         MENU BAR
         ══════════════════════════════════════════════════════════════════ -->
    <!-- ══════════════════════════════════════════════════════════════════
         MENU BAR & SUBMENU POPUPS (DARK MODE)
         ══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4,4,4,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Background="{StaticResource Surface0Brush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background"      Value="{StaticResource MantleBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface0Brush}"/>
        <Setter Property="Padding"         Value="4,2"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="{StaticResource BodyFontSize}"/> <!-- Git #2126: was 13 -->
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background"      Value="{StaticResource MantleBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface1Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="4"/>
        <Setter Property="HasDropShadow"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{StaticResource MantleBrush}"
                            BorderBrush="{StaticResource Surface1Brush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="2">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="{StaticResource BodyFontSize}"/> <!-- Git #2126: was 13 -->
        <Setter Property="Padding"    Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                        
                        <!-- 1. TopLevelHeader (File, View, Claude, Build, etc. on Menu Bar) -->
                        <Border x:Name="TopLevelHeaderBorder"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="HeaderContent"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <!-- Submenu Popup -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade"
                               Placement="Bottom">
                            <Border x:Name="SubmenuBorder"
                                    Background="{StaticResource MantleBrush}"
                                    BorderBrush="{StaticResource Surface1Brush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4"
                                    Margin="0,2,0,0">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>

                        <!-- 2. SubmenuItem (Items inside dropdown) -->
                        <Border x:Name="SubmenuItemBorder"
                                Visibility="Collapsed"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>  <!-- Icon / Checkmark -->
                                    <ColumnDefinition Width="*"/>   <!-- Header -->
                                    <ColumnDefinition Width="Auto"/><!-- InputGestureText -->
                                    <ColumnDefinition Width="16"/>  <!-- Submenu Arrow -->
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="IconPresenter"
                                                  Grid.Column="0"
                                                  ContentSource="Icon"
                                                  Width="14" Height="14"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>

                                <ContentPresenter x:Name="SubHeaderContent"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="4,0,16,0"/>

                                <TextBlock x:Name="GestureText"
                                           Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{StaticResource Subtext0Brush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="12,0,4,0"/>

                                <TextBlock x:Name="SubArrow"
                                           Grid.Column="3"
                                           Text="▸"
                                           Visibility="Collapsed"
                                           Foreground="{StaticResource Subtext0Brush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Role: SubmenuItem or SubmenuHeader -->
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter TargetName="TopLevelHeaderBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="SubmenuItemBorder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="TopLevelHeaderBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="SubmenuItemBorder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                        </Trigger>

                        <!-- Hover / Highlighted Triggers -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="TopLevelHeaderBorder" Property="Background" Value="{StaticResource Surface0Brush}"/>
                            <Setter TargetName="SubmenuItemBorder" Property="Background" Value="{StaticResource Surface0Brush}"/>
                        </Trigger>

                        <!-- Submenu Open Trigger for Top Level -->
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="TopLevelHeaderBorder" Property="Background" Value="{StaticResource Surface0Brush}"/>
                        </Trigger>

                        <!-- Disabled Trigger -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Surface2Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         TEXT
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background"      Value="{StaticResource Surface0Brush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface1Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,4"/>
        <Setter Property="CaretBrush"      Value="{StaticResource BlueBrush}"/>
        <Setter Property="SelectionBrush"  Value="{StaticResource BlueBrush}"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="{StaticResource BodyFontSize}"/> <!-- Git #2126: was 13 -->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Code/editor TextBox -->
    <Style x:Key="EditorTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background"      Value="{StaticResource CrustBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily"      Value="Cascadia Code, Consolas, Courier New"/>
        <Setter Property="FontSize"        Value="{StaticResource MonospaceFontSize}"/> <!-- Git #2126: was literal 13, same value -->
        <Setter Property="AcceptsReturn"   Value="True"/>
        <Setter Property="AcceptsTab"      Value="True"/>
        <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalContentAlignment"      Value="Top"/>
        <Setter Property="Padding"         Value="8"/>
    </Style>

    <!-- Terminal output (green on near-black) -->
    <Style x:Key="TerminalOutputBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource EditorTextBox}">
        <Setter Property="IsReadOnly"  Value="True"/>
        <Setter Property="Background"  Value="#0D0D17"/>
        <Setter Property="Foreground"  Value="#A6E3A1"/>
        <Setter Property="FontSize"    Value="{StaticResource MonospaceFontSize}"/> <!-- Git #2126: was 12, below the new 13px monospace minimum -->
    </Style>

    <!-- Search / filter TextBox (Git #2000) — ONE reusable affordance: a keyed
         style whose control template bakes in an inline "✕" clear button at the
         box's own right-hand edge, so applying Style="{StaticResource
         SearchTextBox}" is the entire per-site change. No sibling Grid column,
         no per-site layout surgery.

         - The ✕ (PART_ClearButton) is only visible when Text is non-empty
           (ControlTemplate.Triggers below) — an always-on ✕ over an empty box
           is noise.
         - De-brightened per the app's language: Subtext0Brush foreground,
           transparent background, no border on the button itself — the same
           treatment TestHistoryWindow's original inline clear used. Do not
           brighten this on hover beyond the app's existing default Button
           hover (a faint Surface0Brush wash) — see #1809/#1810/#1996.
         - behaviors:SearchTextBoxBehavior.IsEnabled wires the ✕ click and
           Escape-to-clear (both call TextBox.Clear(), which raises the box's
           normal TextChanged — the same change path typing already fires, so
           every site's live filter re-runs with zero per-site code).
         - Padding reserves 24px on the right so typed text never runs under
           the button, whether or not it's currently visible (no layout
           shift when it appears/disappears).
         - BasedOn the default TextBox style, so Background/BorderBrush/
           BorderThickness/CaretBrush/SelectionBrush/the IsFocused→BlueBrush
           border trigger are all inherited; a site overrides any of those
           locally exactly as it does today (see e.g. SettingsTabView's
           Transparent/borderless boxes hosted inside their own bordered
           Border). -->
    <Style x:Key="SearchTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="8,4,24,4"/>
        <Setter Property="behaviors:SearchTextBoxBehavior.IsEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                            <Button x:Name="PART_ClearButton"
                                    Content="✕"
                                    Focusable="False"
                                    IsTabStop="False"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Padding="4,0"
                                    FontSize="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource Subtext0Brush}"
                                    Cursor="Arrow"
                                    ToolTip="Clear"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         BUTTONS
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface1Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,5"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="{StaticResource BodyFontSize}"/> <!-- Git #2126: was 13 -->
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{StaticResource Surface0Brush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Surface2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface1Brush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon / toolbar button — no border -->
    <Style x:Key="IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="Foreground"      Value="{StaticResource Subtext1Brush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary / accent button — carries a whisper of blue glow at rest so a
         real CTA reads as "lit", easing warmer/wider on hover rather than snapping. -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="#3D62A0"/>
        <Setter Property="BorderBrush" Value="#4A74B8"/>
        <Setter Property="Foreground"  Value="#EFF1F5"/>
        <Setter Property="Padding"     Value="12,6"/>
        <Setter Property="Effect"      Value="{StaticResource CtaAmbientGlow}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4A74B8"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0.42" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                             To="18" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0.22" Duration="0:0:0.28"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                             To="12" Duration="0:0:0.28"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary / outline button -->
    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="{StaticResource Surface0Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Surface1Brush}"/>
        <Setter Property="Foreground"  Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding"     Value="10,5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small command chip (terminal quick actions) -->
    <Style x:Key="ChipButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="{StaticResource Surface0Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Surface1Brush}"/>
        <Setter Property="Foreground"  Value="{StaticResource Subtext0Brush}"/>
        <Setter Property="Padding"     Value="8,3"/>
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="Margin"      Value="0,0,4,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Slim resource-meter progress bar (CPU / Memory strip above the bottom panel) -->
    <Style x:Key="ResourceMeterBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="PART_Track" Fill="Transparent"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chip ToggleButton (pill-shaped) -->
    <Style x:Key="FilterChip" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource Subtext1Brush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface0Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,3"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="Margin"          Value="0,0,4,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{StaticResource AccentWashLightBrush}"/> <!-- Git #2126: was #1A89B4FA -->
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Activity-bar RadioButton (48×48, left accent bar on checked) -->
    <Style x:Key="ActivityBarButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource Subtext1Brush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"           Value="48"/>
        <Setter Property="Height"          Value="48"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="2,0,0,0"
                            Width="48"
                            Height="48">
                        <!-- Soft blue aura on the active view's icon; eased in on select. -->
                        <Border.Effect>
                            <DropShadowEffect x:Name="ActiveGlow" Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0"/> <!-- Git #2126: was #89B4FA -->
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{StaticResource Surface0Brush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.32" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#15313244"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         COMBO BOX
         ══════════════════════════════════════════════════════════════════ -->
    <!-- Git #935 follow-up — Shane: "That drop down is very bright white...
         can you make it dark mode please." The plain property setters below
         (Background/Foreground/etc.) never actually reached the real chrome:
         the OS-default ComboBox ControlTemplate — including its dropdown
         Popup — mostly ignores them, so it rendered with the system's
         default white/light styling regardless. A full template is the only
         way to actually own every pixel, including the popup. -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background"      Value="{StaticResource Surface0Brush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface1Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,4"/>
        <Setter Property="Height"          Value="28"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="{StaticResource BodyFontSize}"/> <!-- Git #2126: was 13 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Bd"
                                Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"/>

                        <ContentPresenter x:Name="ContentSite"
                                          Grid.Column="0"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                        <Path Grid.Column="1"
                              Data="M0,0 L4,4 8,0"
                              Stroke="{StaticResource Subtext1Brush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"/>

                        <ToggleButton x:Name="ToggleBtn"
                                      Grid.ColumnSpan="2"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="{TemplateBinding Background}"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,2,0,0"
                                    Background="{StaticResource Surface0Brush}"
                                    BorderBrush="{StaticResource Surface1Brush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True" Margin="2">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface1Brush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MantleBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Subtext1Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding"    Value="8,4"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         SCROLL BAR — dark rounded thumb, no arrows
         Git #1831 — was Width=8 with 2px of template padding cutting into
         that further (~4px of actual grabbable thumb), too thin to reliably
         click/drag, especially on a multi-monitor setup where missing it by
         a pixel clicks through onto the adjacent monitor. Widened to 14px
         overall. The visible pill stays slim (Width="8", unchanged) inside
         an outer transparent Border that fills the whole 14px track — that
         outer Border is what Thumb hit-tests against (WPF hit-tests any
         Border with a non-null Background, including Transparent), so the
         real grab/hover area is the full track width even though the color
         pill drawn inside it still looks the same slim width as before.
         ══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="SbThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent">
                        <Border x:Name="Bd" Background="{StaticResource Surface2Brush}" CornerRadius="4" Opacity="0.5" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Opacity"    Value="1.0"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Horizontal counterpart of SbThumbStyle above — same outer-transparent/
         inner-slim-pill trick, just rotated (Height="8" instead of Width="8",
         stretch horizontally instead of vertically). -->
    <Style x:Key="SbThumbHorizontalStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent">
                        <Border x:Name="Bd" Background="{StaticResource Surface2Brush}" CornerRadius="4" Opacity="0.5" Height="8" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Opacity"    Value="1.0"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SbPageButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop"  Value="False"/>
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width"      Value="14"/>
        <Setter Property="MinWidth"   Value="14"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Border Background="Transparent" Padding="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SbPageButtonStyle}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SbThumbStyle}" MinHeight="20"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SbPageButtonStyle}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height"    Value="14"/>
                <Setter Property="MinHeight" Value="14"/>
                <Setter Property="Width"     Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Border Background="Transparent" Padding="2">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource SbPageButtonStyle}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SbThumbHorizontalStyle}" MinWidth="20"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource SbPageButtonStyle}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         TAB CONTROL / TAB ITEM — VS Code style
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background"      Value="{StaticResource BaseBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface0Brush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="0,0,0,1">
                            <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      Panel.ZIndex="1"/>
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource Subtext1Brush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="16,0"/>
        <Setter Property="Height"          Value="35"/>
        <Setter Property="Margin"          Value="0"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="{StaticResource BodyFontSize}"/> <!-- Git #2126: was 13 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0,2,0,0"
                            Padding="{TemplateBinding Padding}"
                            Height="{TemplateBinding Height}">
                        <!-- Soft blue aura on the active tab; opacity is eased 0↔ on
                             select so switching tabs glides instead of snapping. -->
                        <Border.Effect>
                            <DropShadowEffect x:Name="TabGlow" Color="{StaticResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0"/> <!-- Git #2126: was #89B4FA -->
                        </Border.Effect>
                        <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{StaticResource BaseBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TabGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.4" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TabGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected"  Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         DATA GRID
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background"               Value="{StaticResource BaseBrush}"/>
        <Setter Property="Foreground"               Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource Surface0Brush}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="RowBackground"            Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#0A313244"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Surface0Brush}"/>
        <Setter Property="VerticalGridLinesBrush"   Value="{StaticResource Surface0Brush}"/>
        <Setter Property="SelectionMode"            Value="Single"/>
        <Setter Property="AutoGenerateColumns"      Value="False"/>
        <Setter Property="FontFamily"               Value="Segoe UI"/>
        <Setter Property="FontSize"                 Value="{StaticResource BodyFontSize}"/> <!-- Git #2126: was 13 -->
        <Setter Property="CanUserResizeRows"        Value="False"/>
        <Setter Property="HeadersVisibility"        Value="Column"/>
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background"      Value="{StaticResource MantleBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource Subtext0Brush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface0Brush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding"         Value="8,6"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
    </Style>

    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentWashLightBrush}"/> <!-- Git #2126: was #1A89B4FA -->
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#10313244"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding"          Value="8,4"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         LIST BOX
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"      Value="{StaticResource Subtext1Brush}"/>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding"    Value="8,5"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#15313244"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         SEPARATOR / SPLITTER / STATUS BAR
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Margin"     Value="8,2"/>
    </Style>

    <Style TargetType="{x:Type GridSplitter}" BasedOn="{StaticResource {x:Type GridSplitter}}">
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    </Style>

    <Style TargetType="{x:Type StatusBar}" BasedOn="{StaticResource {x:Type StatusBar}}">
        <Setter Property="Background"      Value="{StaticResource CrustBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource Subtext0Brush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface0Brush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Height"          Value="26"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="0"/>
    </Style>

    <Style TargetType="{x:Type StatusBarItem}" BasedOn="{StaticResource {x:Type StatusBarItem}}">
        <Setter Property="Foreground"               Value="{StaticResource Subtext0Brush}"/>
        <Setter Property="Background"               Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding"                  Value="6,0"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         TOOLTIP (DARK MODE)
         ══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background"      Value="{StaticResource Surface0Brush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Surface1Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="HasDropShadow"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{StaticResource Surface0Brush}"
                            BorderBrush="{StaticResource Surface1Brush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{StaticResource TextBrush}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         BUBBLE TOOLTIP (Git #947) — a distinctly "chat bubble" tooltip, set
         apart from the plain dark {x:Type ToolTip} above: larger 10px
         rounding, a Blue accent border, a small downward pointer/tail toward
         the hovered element, and its own drop shadow. Used by the Build Queue
         rows to show a short description of what a build item is doing. The
         tail is a filled triangle in the same MantleBrush as the bubble,
         overlapping the bubble's bottom edge by 1px so the two read as one
         shape; Placement="Top" makes the bubble sit above the row with the
         tail pointing down at it.
         ══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="BubbleToolTip" TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground"    Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize"      Value="12"/>
        <Setter Property="FontFamily"    Value="Segoe UI"/>
        <Setter Property="Placement"     Value="Top"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Padding"       Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <StackPanel Margin="6,6,6,8">
                        <StackPanel.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000"/>
                        </StackPanel.Effect>
                        <!-- Bubble body -->
                        <Border Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource BlueBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                MaxWidth="320">
                            <ContentPresenter TextElement.Foreground="{StaticResource TextBrush}"/>
                        </Border>
                        <!-- Downward pointer/tail -->
                        <Path Data="M0,0 L12,0 L6,7 Z"
                              Fill="{StaticResource MantleBrush}"
                              HorizontalAlignment="Left"
                              Margin="20,-1,0,0"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         TREEVIEW & TREEVIEWITEM (DARK MODE & INDENTATION FIX)
         ══════════════════════════════════════════════════════════════ -->
    <Style x:Key="ExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" Width="16" Height="16">
                        <TextBlock x:Name="ExpandPath"
                                   Text="&#xE76C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="9"
                                   Foreground="{StaticResource Subtext0Brush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ExpandPath" Property="Text" Value="&#xE70D;"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ExpandPath" Property="Foreground" Value="{StaticResource BlueBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Expander Arrow Button -->
                        <ToggleButton x:Name="Expander"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      Style="{StaticResource ExpandCollapseToggleStyle}"/>

                        <!-- Header Container -->
                        <Border x:Name="Bd"
                                Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_Header"
                                              ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>

                        <!-- Items Presenter (Child items indented cleanly by 12px) -->
                        <ItemsPresenter x:Name="ItemsHost"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="12,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentWashLightBrush}"/> <!-- Git #2126: was #1A89B4FA -->
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      CanContentScroll="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

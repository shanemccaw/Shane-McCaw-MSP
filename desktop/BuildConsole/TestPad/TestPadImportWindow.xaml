<Window x:Class="BuildConsole.TestPad.TestPadImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Import from Notepad"
        Width="480" MinHeight="360" MaxHeight="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        KeyDown="Window_KeyDown">

    <!-- Ported from ShaneBuilder (Git #2531/#2532/#2533, Feature: Test Pad #2530; originally Git
         #2343, ShaneBuilder Feature: Test Pad #2326) — "Import: paste a whole Notepad file." Same
         real custom-chrome dialog pattern BuildConsole's other secondary windows already use
         (ManifestViewerWindow, MainWindow — WindowChromeHelper.Setup). Two-stage body: a paste box
         (Stage 1), and once Parse runs, a preview list of the candidate notes
         Services.TestPad.TestPadImportParser split out (Stage 2) with an Import button that files
         them into Services.TestPad.TestPadService. The header-stats line, per-row type-chip
         correction, and merge-up UI (originally #2350-#2354) extend PreviewHost/PreviewHeaderText
         in place — ported unreduced, backed by the real TestPadImportMerger/TestPadFeatureMatcher
         already landed in #2531. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="0"
                             GlassFrameThickness="-1"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
        </Style>

        <Style x:Key="DialogCaptionCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource RedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderDividerBrush}" BorderThickness="1">
        <DockPanel LastChildFill="True" Background="{StaticResource BaseBrush}">
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource BorderDividerBrush}"
                    BorderThickness="0,0,0,1"
                    Height="36">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Import from Notepad" Margin="14,0,0,0"
                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnCloseWindow" Style="{StaticResource DialogCaptionCloseButton}" ToolTip="Close" Click="BtnCloseWindow_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource DialogButton}" Padding="14,6" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnParse" Content="Parse" Style="{StaticResource DialogButton}" Padding="14,6" Margin="0,0,8,0" Click="BtnParse_Click"/>
                <Button x:Name="BtnImport" Content="Import" Style="{StaticResource DialogPrimaryButton}" Padding="14,6" Click="BtnImport_Click" IsEnabled="False"/>
            </StackPanel>

            <Grid Margin="20,18,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Paste a whole Notepad file below, then Parse. Each blank-line-separated block becomes a note; a leading !/?/+/. still sets its type."
                           TextWrapping="Wrap"
                           FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="6"
                        Background="{StaticResource Surface0Brush}"
                        BorderBrush="{StaticResource BorderDividerBrush}" BorderThickness="1">
                    <TextBox x:Name="PasteBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="140" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Padding="8,6" Background="Transparent"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             FontSize="11.5"/>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PreviewHeaderText" Grid.Column="0"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="" Visibility="Collapsed"/>
                    <!-- "Undo merges resets all." Only shown once at least one row carries a merge,
                         i.e. TestPadImportMerger.UndoAllMerges has something to do; toggled in
                         UpdateMergeBar alongside the per-selection MergeBar below. -->
                    <Button x:Name="BtnUndoMerges" Grid.Column="1" Content="Undo merges"
                            Style="{StaticResource DialogButton}" Padding="8,2" Margin="8,0,0,0"
                            FontSize="11"
                            VerticalAlignment="Top"
                            Click="BtnUndoMerges_Click" Visibility="Collapsed"/>
                </Grid>

                <!-- "Import: multi-select tick boxes with Merge N up." One tick box per row
                     (BuildPreviewRow's select checkbox, distinct from the Include checkbox) feeds
                     this bar: it shows the live selected count and a single button that merges
                     every selected row up into whatever unselected row precedes the topmost
                     selection. Collapsed until at least one row is selected. -->
                <Border Grid.Row="3" x:Name="MergeBar" Margin="0,0,0,6" Visibility="Collapsed"
                        CornerRadius="6" Padding="8,5" Background="{StaticResource Surface0Brush}"
                        BorderBrush="{StaticResource BorderDividerBrush}" BorderThickness="1">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="MergeBarText" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Text=""/>
                        <Button x:Name="BtnMergeUp" DockPanel.Dock="Right" Content="Merge N up"
                                Style="{StaticResource DialogButton}" Padding="10,3"
                                Click="BtnMergeUp_Click"/>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="4" Margin="0,0,0,16" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                    <StackPanel x:Name="PreviewHost"/>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>

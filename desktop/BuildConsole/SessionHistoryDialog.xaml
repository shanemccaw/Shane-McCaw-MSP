<Window x:Class="BuildConsole.SessionHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session History"
        Width="620" Height="500"
        MinWidth="500" MinHeight="380"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Overview Metrics Strip -->
                <RowDefinition Height="*"/>    <!-- Session List -->
                <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
            </Grid.RowDefinitions>

            <!-- 1. Header strip: title + drag handle + close -->
            <Border x:Name="HeaderStrip" Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="10,6,8,6"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📜" FontSize="13"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Testing Session History &amp; Audit Trail"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <Button x:Name="BtnClose" Grid.Column="2"
                            Content="✕"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="5,2,5,2"
                            ToolTip="Close"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 2. Overview Metrics Strip -->
            <Border Grid.Row="1" Background="{StaticResource Surface0Brush}"
                    BorderBrush="{StaticResource Surface1Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,6,12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Sessions -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL SESSIONS" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Subtext1Brush}"/>
                        <TextBlock x:Name="MetricTotalSessions" Text="0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>

                    <!-- Total Testing Time -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TESTING TIME" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Subtext1Brush}"/>
                        <TextBlock x:Name="MetricTotalTime" Text="0m 00s" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <!-- Bugs Logged -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BUGS FOUND" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Subtext1Brush}"/>
                        <TextBlock x:Name="MetricTotalBugs" Text="0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource StatusWarningBrush}"/>
                    </StackPanel>

                    <!-- Clean Pages -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="CONFIRMED CLEAN" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Subtext1Brush}"/>
                        <TextBlock x:Name="MetricTotalClean" Text="0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource StatusSuccessBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Scrollable Session List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8,12,6">
                <StackPanel>
                    <TextBlock x:Name="EmptyHistoryText"
                               Text="No recorded test sessions yet. As you navigate and test pages, sessions are automatically logged here."
                               FontSize="11" FontStyle="Italic"
                               Foreground="{StaticResource Subtext1Brush}"
                               TextAlignment="Center"
                               Margin="0,30,0,0"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="SessionCardsPanel"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. Bottom Actions Strip -->
            <Border Grid.Row="3" Background="{StaticResource CrustBrush}"
                    CornerRadius="0,0,6,6"
                    Padding="12,8,12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnCopyMarkdown" Grid.Column="0"
                            Content="📋 Copy History (Markdown)"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="8,5,8,5"
                            ToolTip="Copy complete test session history as Markdown table"
                            Click="BtnCopyMarkdown_Click"/>

                    <TextBlock x:Name="StatusMessage" Grid.Column="1"
                               FontSize="10" Foreground="{StaticResource StatusSuccessBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnClearHistory"
                                Content="🗑 Clear All"
                                Style="{StaticResource IconButton}"
                                FontSize="10"
                                Padding="8,5,8,5"
                                Margin="0,0,6,0"
                                ToolTip="Delete all recorded session history"
                                Click="BtnClearHistory_Click"/>

                        <Button x:Name="BtnDone"
                                Content="Close"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="10"
                                Padding="12,5,12,5"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="BuildConsole.VisualDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Visual Diff &amp; Screenshot Comparison"
        Icon="app.ico"
        Height="850" Width="1280"
        MinWidth="960" MinHeight="600"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged">

    <!-- Custom Dark Title Bar -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="-1"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True">
        <!-- ── Title Bar ── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="⚖️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Visual Diff &amp; Screenshot Comparison"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPageUrl" Text="about:blank" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                        <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Bottom Action Bar ── -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zoom:" FontSize="11" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="SliderZoom" Width="120" Minimum="0.2" Maximum="3.0" Value="1.0"
                            SmallChange="0.1" LargeChange="0.25" VerticalAlignment="Center" Margin="0,0,6,0"
                            ValueChanged="SliderZoom_ValueChanged"/>
                    <TextBlock x:Name="TxtZoomPercent" Text="100%" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <CheckBox x:Name="ChkSyncScroll" Content="Sync Scroll" IsChecked="True" FontSize="11"
                              Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <TextBlock Text="Tolerance:" FontSize="11" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="SliderTolerance" Width="90" Minimum="0.01" Maximum="0.20" Value="0.05"
                            SmallChange="0.01" LargeChange="0.02" VerticalAlignment="Center" Margin="0,0,6,0"
                            ValueChanged="SliderTolerance_ValueChanged"/>
                    <TextBlock x:Name="TxtTolerancePercent" Text="5%" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAttachToBug" Content="📎 Attach Diff to Bug" Style="{StaticResource PrimaryButton}"
                            Padding="10,4" Margin="0,0,8,0" FontSize="11" Click="BtnAttachToBug_Click"
                            ToolTip="Attach the difference map and diff summary to the active bug report"/>
                    <Button x:Name="BtnCopySummary" Content="📋 Copy Summary" Style="{StaticResource SecondaryButton}"
                            Padding="10,4" Margin="0,0,8,0" FontSize="11" Click="BtnCopySummary_Click"
                            ToolTip="Copy visual diff stats to clipboard"/>
                    <Button x:Name="BtnSaveDiffImage" Content="💾 Save Diff Map" Style="{StaticResource SecondaryButton}"
                            Padding="10,4" Margin="0,0,8,0" FontSize="11" Click="BtnSaveDiffImage_Click"
                            ToolTip="Save difference heatmap image to disk"/>
                    <Button x:Name="BtnClose" Content="Close" Style="{StaticResource SecondaryButton}"
                            Padding="10,4" FontSize="11" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Top Controls & Comparison Selector Bar ── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Baseline & Current File Selectors -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Baseline Selector -->
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BASELINE (Source of Truth)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnBrowseBaseline" Grid.Column="2" Content="Browse..." Style="{StaticResource IconButton}" FontSize="9" Padding="6,1" Margin="0,0,4,0" Click="BtnBrowseBaseline_Click"/>
                            <Button x:Name="BtnSetCurrentAsBaseline" Grid.Column="3" Content="⭐ Set Current as Baseline" Style="{StaticResource IconButton}" FontSize="9" Padding="6,1" Foreground="{StaticResource LightGreenBrush}" Click="BtnSetCurrentAsBaseline_Click" ToolTip="Make the current screenshot the baseline for this page"/>
                        </Grid>
                        <ComboBox x:Name="CboBaseline" Height="26" FontSize="10" SelectionChanged="CboBaseline_SelectionChanged"/>
                    </StackPanel>

                    <!-- Current Screenshot Selector -->
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CURRENT (Under Test)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LightGreenBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnBrowseCurrent" Grid.Column="2" Content="Browse..." Style="{StaticResource IconButton}" FontSize="9" Padding="6,1" Click="BtnBrowseCurrent_Click"/>
                        </Grid>
                        <ComboBox x:Name="CboCurrent" Height="26" FontSize="10" SelectionChanged="CboCurrent_SelectionChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Diff Mode Tabs & Diff Stats Summary Badge -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- View Mode Selector -->
                    <Border Grid.Column="0" Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbSideBySide" Content="Side-by-Side" IsChecked="True"
                                         Style="{StaticResource ToggleRadioButton}" FontSize="11" Padding="10,3"
                                         Checked="DiffMode_Changed"/>
                            <RadioButton x:Name="RbSwipeSlider" Content="Swipe / Split Slider"
                                         Style="{StaticResource ToggleRadioButton}" FontSize="11" Padding="10,3"
                                         Checked="DiffMode_Changed"/>
                            <RadioButton x:Name="RbHeatmap" Content="Difference Heatmap"
                                         Style="{StaticResource ToggleRadioButton}" FontSize="11" Padding="10,3"
                                         Checked="DiffMode_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Diff Statistics Badge -->
                    <Border x:Name="BadgeDiffStats" Grid.Column="2" CornerRadius="4" Padding="10,4" Background="{StaticResource Surface0Brush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtDiffStatusIcon" Text="⚖️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtDiffStats" Text="Calculating diff..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Main Visual Display Area ── -->
        <Grid Background="{StaticResource CrustBrush}">
            <!-- 1. Side-by-Side View -->
            <Grid x:Name="PanelSideBySide" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Baseline Pane -->
                <Border Grid.Column="0" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <ScrollViewer x:Name="ScrollBaseline" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="ScrollBaseline_ScrollChanged" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <Image x:Name="ImgBaseline" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image.LayoutTransform>
                                    <ScaleTransform x:Name="ScaleBaseline" ScaleX="1.0" ScaleY="1.0"/>
                                </Image.LayoutTransform>
                            </Image>
                        </ScrollViewer>
                        <Border Background="Black" Opacity="0.7" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                            <TextBlock Text="BASELINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Grid Splitter between panes -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Surface0Brush}"/>

                <!-- Current Pane -->
                <Border Grid.Column="2">
                    <Grid>
                        <ScrollViewer x:Name="ScrollCurrent" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="ScrollCurrent_ScrollChanged" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <Image x:Name="ImgCurrent" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image.LayoutTransform>
                                    <ScaleTransform x:Name="ScaleCurrent" ScaleX="1.0" ScaleY="1.0"/>
                                </Image.LayoutTransform>
                            </Image>
                        </ScrollViewer>
                        <Border Background="Black" Opacity="0.7" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                            <TextBlock Text="CURRENT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource LightGreenBrush}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Swipe / Split Slider View -->
            <Grid x:Name="PanelSwipeSlider" Visibility="Collapsed">
                <ScrollViewer x:Name="ScrollSwipe" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <Grid x:Name="SwipeContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ScaleSwipe" ScaleX="1.0" ScaleY="1.0"/>
                        </Grid.LayoutTransform>

                        <!-- Baseline Underneath -->
                        <Image x:Name="ImgSwipeBaseline" Stretch="None"/>

                        <!-- Current Overlaid with Horizontal Clip -->
                        <Image x:Name="ImgSwipeCurrent" Stretch="None">
                            <Image.Clip>
                                <RectangleGeometry x:Name="SwipeClipRect"/>
                            </Image.Clip>
                        </Image>

                        <!-- Vertical Divider Line -->
                        <Canvas x:Name="SwipeDividerCanvas">
                            <Line x:Name="SwipeDividerLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
                            <Border x:Name="SwipeThumbBadge" Background="{StaticResource AccentBrush}" CornerRadius="10"
                                    Width="24" Height="24" Padding="0">
                                <TextBlock Text="◀ ▶" FontSize="8" FontWeight="Bold" Foreground="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Canvas>
                    </Grid>
                </ScrollViewer>

                <!-- Drag Slider Controller at Bottom of Swipe View -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                        Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Baseline" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="SliderSwipePosition" Width="280" Minimum="0" Maximum="1.0" Value="0.5"
                                SmallChange="0.01" LargeChange="0.05" VerticalAlignment="Center"
                                ValueChanged="SliderSwipePosition_ValueChanged"/>
                        <TextBlock Text="Current" FontSize="10" Foreground="{StaticResource LightGreenBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Difference Heatmap View -->
            <Grid x:Name="PanelHeatmap" Visibility="Collapsed">
                <ScrollViewer x:Name="ScrollHeatmap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <Image x:Name="ImgHeatmap" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="ScaleHeatmap" ScaleX="1.0" ScaleY="1.0"/>
                        </Image.LayoutTransform>
                    </Image>
                </ScrollViewer>

                <!-- Heatmap Legend Floating Chip -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                        Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="HEATMAP LEGEND" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Border Width="12" Height="12" Background="#FF007F" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Mismatch Pixel" FontSize="10" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" Background="#45475a" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Unchanged Context" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

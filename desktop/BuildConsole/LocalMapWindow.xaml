<Window x:Class="BuildConsole.LocalMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BuildConsole.Controls.BuildMap"
        Title="Local Map — Database Schema"
        Icon="app.ico"
        Width="1440" Height="900"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="#0a0d12">

    <!-- ── Git #2806 (Local Map, item #2 of #2804's structured index) ──
         Shell reuses BuildChainMapWindow's top-bar / status-strip / canvas+Inspector layout and
         its exact design tokens (BuildMap/README.md), so the Local Map and the Git Map read as
         one system. Read-only: no Re-wire button, no top-bar mutation controls — a live Postgres
         schema isn't something this window edits. -->

    <Window.Resources>
        <Style x:Key="LocalMapTopBarButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="#0f1319"/>
            <Setter Property="BorderBrush" Value="#21262d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161c25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ── Top bar ── -->
        <Border DockPanel.Dock="Top"
                MinHeight="56"
                Padding="14,10"
                Background="#0d1117"
                BorderBrush="#21262d"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title block -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7" Background="#1d3450" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.Database}" Stretch="Uniform"
                              Width="14" Height="14" Stroke="#6a8fb5" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LOCAL MAP · POSTGRES SCHEMA"
                                   FontSize="8.5" FontWeight="ExtraBold"
                                   Foreground="#6a8fb5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="DatabaseNameText" Text="" FontSize="13.5" FontWeight="ExtraBold" Foreground="#e6edf3"/>
                            <TextBlock x:Name="GeneratedAtText" Text="" FontSize="10.5" Foreground="#8b949e"
                                       Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Stats strip -->
                <Border Grid.Column="1" Margin="14,0,0,0" Padding="14,0,0,0"
                        BorderBrush="#21262d" BorderThickness="1,0,0,0">
                    <StackPanel x:Name="StatsStripPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                </Border>

                <!-- Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ZoomOutButton" Style="{StaticResource LocalMapTopBarButton}" Click="ZoomOutButton_Click">
                            <Path Data="{StaticResource Icon.Minus}" Width="10" Height="10" Stretch="Uniform"
                                  Stroke="#c9d1d9" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <TextBlock x:Name="ZoomPercentText" Text="100%" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="#c9d1d9" Width="34" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button x:Name="ZoomInButton" Style="{StaticResource LocalMapTopBarButton}" Click="ZoomInButton_Click">
                            <Path Data="{StaticResource Icon.Plus}" Width="10" Height="10" Stretch="Uniform"
                                  Stroke="#c9d1d9" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button x:Name="FitButton" Content="Fit" Style="{StaticResource LocalMapTopBarButton}" Click="FitButton_Click"/>
                    </StackPanel>

                    <Button x:Name="RefreshButton" Style="{StaticResource LocalMapTopBarButton}" Margin="6,0,0,0"
                            ToolTip="Re-read the live schema" Click="RefreshButton_Click">
                        <Path Data="{StaticResource Icon.RotateCcw}" Width="11" Height="11" Stretch="Uniform"
                              Stroke="#c9d1d9" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Status strip ── -->
        <Border DockPanel.Dock="Bottom"
                Height="26" Padding="14,0"
                Background="#0d1117"
                BorderBrush="#21262d"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusHintText" DockPanel.Dock="Left"
                           Text="Loading…" FontSize="10" Foreground="#8b949e"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusCountsText" DockPanel.Dock="Right"
                           Text="" FontFamily="Consolas" FontSize="10" Foreground="#576069"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- ── Body — canvas + Inspector ── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="312"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#0a0d12">
                <local:LocalMapCanvasControl x:Name="Canvas"/>
                <TextBlock x:Name="CanvasPlaceholderText"
                           Text="Reading the live schema…"
                           FontSize="12" Foreground="#576069"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>

            <Border Grid.Column="1" Background="#0d1117" BorderBrush="#21262d" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="15,14,15,18">
                    <StackPanel x:Name="InspectorHost"/>
                </ScrollViewer>
            </Border>
        </Grid>

    </DockPanel>
</Window>

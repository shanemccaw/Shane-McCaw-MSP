<UserControl x:Class="BuildConsole.ToastCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Right">

    <!-- One notification card in the ToastHostWindow stack. Same dark-theme language as the
         #937/#973 floaties and the DeviceCodeWindow sign-in floaty: MantleBrush body, thin
         Surface1 outline, a soft drop shadow, and a coloured left accent bar + icon whose colour
         carries the kind (info/success/warning/error). Set up in code-behind (ToastCard.xaml.cs). -->
    <Border x:Name="CardRoot"
            Margin="0,0,0,10"
            MinWidth="320" MaxWidth="400"
            Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface1Brush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- left accent bar -->
                <ColumnDefinition Width="Auto"/>  <!-- kind icon -->
                <ColumnDefinition Width="*"/>     <!-- title + message -->
                <ColumnDefinition Width="Auto"/>  <!-- close -->
            </Grid.ColumnDefinitions>

            <!-- Coloured left accent bar (kind colour, set in code-behind) -->
            <Border x:Name="AccentBar" Grid.Column="0"
                    Width="4"
                    CornerRadius="8,0,0,8"
                    Background="{StaticResource BlueBrush}"/>

            <!-- Kind icon (glyph + colour set in code-behind) -->
            <TextBlock x:Name="IconText" Grid.Column="1"
                       Text="&#x2139;"
                       FontFamily="Segoe UI Symbol, Segoe UI"
                       FontSize="15" FontWeight="Bold"
                       Margin="12,11,0,0"
                       VerticalAlignment="Top"
                       Foreground="{StaticResource BlueBrush}"/>

            <!-- Title + message -->
            <StackPanel Grid.Column="2" Margin="10,10,8,11">
                <TextBlock x:Name="TitleText"
                           FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="MessageText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           Foreground="{StaticResource Subtext0Brush}"/>
            </StackPanel>

            <!-- Dismiss (the toast also auto-dismisses on its own) -->
            <Button x:Name="BtnClose" Grid.Column="3"
                    Content="&#x2715;"
                    Style="{StaticResource IconButton}"
                    FontSize="10"
                    Padding="6,4"
                    VerticalAlignment="Top"
                    Margin="0,6,6,0"
                    ToolTip="Dismiss"
                    Click="BtnClose_Click"/>
        </Grid>
    </Border>
</UserControl>

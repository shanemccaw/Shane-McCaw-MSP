<Window x:Class="BuildConsole.ShotVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Shot Vault"
        Icon="app.ico"
        Width="1040" Height="760"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None"
        StateChanged="Window_StateChanged">

    <!-- Git #3657 (sub-issue of Epic #1202) — Shot Vault: browses the real shots
         DesktopScreenClipService (Git #1866) already saves to disk, grouped into runs, with search,
         tag filters, a thumbnail grid, and per-shot Copy. Ported from ShaneBuilder's
         MainWindow.ShotVaultPanel.cs behavior, re-implemented as a real top-level Window (same
         reused-across-the-app's-lifetime convention as ScreenshotGalleryWindow/TestHistoryWindow)
         rather than a rail panel, since BuildConsole's own left-rail views are a single large
         hand-built switch (LeftSidebar.xaml) and a standalone gallery window is this app's existing
         precedent for a screenshot browsing surface. Same custom title bar as MainWindow (Git #894)
         / ScreenshotGalleryWindow (Git #1006). -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="-1"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Shot Vault" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Subtext1Brush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                        <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: search box + refresh -->
            <Border Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="380" HorizontalAlignment="Left">
                        <TextBox x:Name="ShotVaultSearchBox"
                                 Style="{StaticResource SearchTextBox}"
                                 Height="28" Padding="8,4" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Background="{StaticResource Surface0Brush}"
                                 TextChanged="ShotVaultSearchBox_TextChanged"/>
                        <TextBlock IsHitTestVisible="False"
                                   Text="Search by shot name or screen"
                                   FontSize="12" Margin="10,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="{StaticResource Subtext1Brush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ShotVaultSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button x:Name="BtnShotVaultRefresh" Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            ToolTip="Refresh — re-read the shots folder"
                            Padding="6,4"
                            Click="BtnShotVaultRefresh_Click">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Tag filter chips (multi-select, AND semantics) -->
            <Border Grid.Row="1"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,8"
                    x:Name="ShotVaultTagChipsRow">
                <WrapPanel x:Name="ShotVaultTagChips" Orientation="Horizontal"/>
            </Border>

            <!-- Status line -->
            <TextBlock Grid.Row="2" x:Name="ShotVaultStatus" Text=""
                       FontSize="11.5" Foreground="{StaticResource Subtext0Brush}"
                       Margin="14,8,14,0"/>

            <!-- Runs + thumbnail grid -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="14,4,14,14">
                    <StackPanel x:Name="ShotVaultRows"/>
                    <TextBlock x:Name="ShotVaultEmptyText"
                               Text=""
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{StaticResource Subtext0Brush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,60,0,0"
                               Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="BuildConsole.ReplyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reply" Height="260" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BaseBrush}"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Git #826 - continues the exact same claude.exe session via resume, not a fresh stateless one -->
        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Text="Reply to: "
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <TextBox x:Name="ReplyBox"
                 Grid.Row="1"
                 Style="{StaticResource EditorTextBox}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Cancel"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="Send Reply"
                    Style="{StaticResource PrimaryButton}"
                    Padding="14,6"
                    Click="Send_Click"/>
        </StackPanel>
    </Grid>
</Window>

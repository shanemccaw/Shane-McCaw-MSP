<Window x:Class="BuildConsole.ManifestViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Manifest Viewer"
        Icon="app.ico"
        Height="720" Width="1040"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        StateChanged="Window_StateChanged">

    <!-- Custom dark title bar, same treatment as TestHistoryWindow (Git #1006). -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True">

        <!-- ── Title bar ── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Manifest Viewer" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Subtext1Brush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                        <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Header: manifest identity (left) + view switch (right) ── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFileName" Text="manifest.json" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtSubtitle" Text="" FontSize="11"
                               Foreground="{StaticResource Subtext0Brush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnViewJson" Content="Raw JSON" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}" Click="BtnViewJson_Click"/>
                    <Button x:Name="BtnViewChart" Content="Workflow Chart"
                            Style="{StaticResource SecondaryButton}" Click="BtnViewChart_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Content: the two views overlap; visibility is toggled by the header buttons ── -->
        <Grid>
            <!-- (1) RAW JSON — AvalonEdit with JSON highlighting + collapsible folding, loaded from the real bytes on disk. -->
            <Grid x:Name="JsonPanel">
                <avalonedit:TextEditor x:Name="JsonEditor"
                                       Background="{StaticResource CrustBrush}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="13"
                                       Padding="8"
                                       IsReadOnly="True"
                                       ShowLineNumbers="True"
                                       LineNumbersForeground="{StaticResource Surface2Brush}"
                                       WordWrap="False"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- (2) WORKFLOW CHART — native WPF Canvas, drawn in code-behind. -->
            <Grid x:Name="ChartPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Legend: what the badges mean (Shane's "nothing indicates it's testing the API" feedback). -->
                <Border Grid.Row="0"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,7">
                    <StackPanel x:Name="ChartLegend" Orientation="Horizontal"/>
                </Border>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource BaseBrush}">
                    <Canvas x:Name="WorkflowCanvas" Background="{StaticResource BaseBrush}"/>
                </ScrollViewer>
            </Grid>
        </Grid>

    </DockPanel>
</Window>

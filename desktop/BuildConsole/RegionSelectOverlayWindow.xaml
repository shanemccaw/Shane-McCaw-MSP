<Window x:Class="BuildConsole.RegionSelectOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Draw a region to capture"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="#40000000"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <!-- Git #1472 — transparent full-bounds overlay positioned exactly over the
         active WebView2's on-screen rect (set by the caller before Show()). A
         drag-a-box crop tool: MouseDown starts the rectangle, MouseMove resizes it,
         MouseUp finalizes and closes with DialogResult=true; Esc cancels
         (DialogResult=false). The caller reads SelectedRect (device-independent,
         relative to this window's own top-left = the WebView2's top-left) and
         converts to device pixels for VisualTestTrackerCapture.CaptureRegionAsync. -->
    <!-- Background MUST be a non-null brush (Transparent works) or the Canvas is NOT
         hit-test-visible over its empty area, so MouseLeftButtonDown/Move/Up never fire
         when you press on the dim overlay — the crosshair shows but a drag draws nothing
         and only Esc (a Window-level KeyDown) works. That was Git #1888: the Window's
         #40000000 dim is a hittable brush on the *Window*, but these handlers live on the
         *Canvas*, an unhittable null-background descendant, so the press never routed
         through them. Transparent keeps the dim (drawn by the Window behind this Canvas)
         fully visible while making the whole overlay area catch the drag. -->
    <Canvas x:Name="RootCanvas"
            Background="Transparent"
            MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
            MouseMove="RootCanvas_MouseMove"
            MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp"
            MouseRightButtonDown="RootCanvas_MouseRightButtonDown">
        <TextBlock Canvas.Left="12" Canvas.Top="12"
                   Text="Drag to select a region — Esc or right-click to cancel"
                   Foreground="White" FontSize="13" FontWeight="SemiBold"
                   Background="#80000000" Padding="6,3,6,3"/>
        <Rectangle x:Name="SelectionRect"
                   Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                   Fill="{DynamicResource AccentWashMediumBrush}"
                   Visibility="Collapsed"/>
    </Canvas>
</Window>

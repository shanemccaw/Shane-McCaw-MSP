<Window x:Class="BuildConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BuildConsole"
        xmlns:ctrl="clr-namespace:BuildConsole.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="BuildConsole" Height="960" Width="1680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BaseBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        StateChanged="Window_StateChanged">

    <!-- Git #894 - Shane: "change the title bar from the default Windows
         title bar to one like in VS Code." The custom "Antigravity" bar
         below (File/Edit/Selection/View/Go/Run/Terminal/Help) already
         existed and already matches VS Code's menu row - it was just
         rendering UNDER the native OS title bar (still visible in the
         screenshot's own native "Close" tooltip/X button) rather than
         replacing it. WindowChrome keeps real OS behavior (drag-to-move,
         edge resize, Aero snap, double-click-to-maximize, Alt+Space system
         menu) on a WindowStyle="None" window - CaptionHeight matches the
         bar's own 36px height below, and every interactive element inside
         that height (menu, toolbar buttons, the new caption buttons) is
         marked IsHitTestVisibleInChrome so WindowChrome treats them as
         real clicks instead of window-drag gestures. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Git #902 — hidden background WebView2 the Replit idle watcher drives.
             Must live in the visual tree AND stay visible-with-a-nonzero-size so
             CoreWebView2 actually initialises (a WebView2 is an HwndHost: Opacity is
             read-only and Visibility=Hidden/Collapsed would stop the controller from
             ever being created). So it's a single 1x1 pixel tucked in the corner and
             non-interactive — negligible on screen. It shares the app's WebView2
             environment (cookies/session) via MainWindow.EnsureWebViewInitializedAsync,
             which is what lets it click Run inside Shane's authenticated Replit session. -->
        <wv2:WebView2 x:Name="ReplitWatcherWebView"
                      Width="1" Height="1"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Panel.ZIndex="-1"/>

        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════════
                 ANTIGRAVITY UNIFIED TOP TITLE BAR
                 ══════════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Height="36">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Logo + Menus -->
                        <ColumnDefinition Width="*"/>    <!-- Centered Document / Project Title -->
                        <ColumnDefinition Width="Auto"/> <!-- Quick Action Buttons -->
                        <ColumnDefinition Width="Auto"/> <!-- Git #894 - Minimize/Maximize/Close -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo + Menu Bar -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Antigravity Logo Icon -->
                        <Border Width="24" Height="24"
                                Margin="8,0,4,0"
                                Background="#1A89B4FA"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                ToolTip="Antigravity IDE">
                            <TextBlock Text="▲"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BlueBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Menu Background="Transparent" BorderThickness="0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <MenuItem Header="_File">
                                <MenuItem Header="New Chat"        InputGestureText="Ctrl+N"/>
                                <MenuItem Header="Open Session…"/>
                                <Separator/>
                                <MenuItem Header="Settings"       Click="MenuSettings_Click"/>
                                <Separator/>
                                <MenuItem Header="Exit"            Click="MenuExit_Click"/>
                            </MenuItem>

                            <MenuItem Header="_Edit">
                                <MenuItem Header="Undo"            InputGestureText="Ctrl+Z"/>
                                <MenuItem Header="Redo"            InputGestureText="Ctrl+Y"/>
                                <Separator/>
                                <MenuItem Header="Cut"             InputGestureText="Ctrl+X"/>
                                <MenuItem Header="Copy"            InputGestureText="Ctrl+C"/>
                                <MenuItem Header="Paste"           InputGestureText="Ctrl+V"/>
                            </MenuItem>

                            <MenuItem Header="_Selection">
                                <MenuItem Header="Select All"      InputGestureText="Ctrl+A"/>
                            </MenuItem>

                            <MenuItem Header="_View">
                                <MenuItem Header="Switch Tab…"        Click="OpenTabSwitcher_Click" InputGestureText="Ctrl+Tab"/>
                                <Separator/>
                                <MenuItem Header="Toggle Sidebar"      Click="ToggleSidebar_Click" InputGestureText="Ctrl+B"/>
                                <MenuItem Header="Toggle Queue Panel"  Click="ToggleQueuePanel_Click"/>
                                <MenuItem Header="Toggle Bottom Panel" Click="ToggleBottomPanel_Click" InputGestureText="Ctrl+`"/>
                                <Separator/>
                                <MenuItem Header="Reset Layout"        Click="ResetLayout_Click"/>
                                <Separator/>
                                <MenuItem Header="Zoom In"             Click="ZoomIn_Click"    InputGestureText="Ctrl++"/>
                                <MenuItem Header="Zoom Out"            Click="ZoomOut_Click"   InputGestureText="Ctrl+-"/>
                                <MenuItem Header="Reset Zoom"          Click="ZoomReset_Click" InputGestureText="Ctrl+0"/>
                            </MenuItem>

                            <MenuItem Header="_Go">
                                <MenuItem Header="Go to File…"     InputGestureText="Ctrl+P"/>
                                <MenuItem Header="Switch Tab…"     InputGestureText="Ctrl+Tab" Click="OpenTabSwitcher_Click"/>
                            </MenuItem>

                            <MenuItem Header="_Run">
                                <MenuItem Header="Start Build"     Click="GitChip_Click" Tag="dotnet build --configuration Release"/>
                                <MenuItem Header="Run Verification"/>
                                <Separator/>
                                <!-- Git #806 (Epic #803 Phase 2) - single mode runs the manifest loaded via the Automation sidebar's Load Manifest button; regression mode sweeps test-manifests/_regression-suite.json -->
                                <MenuItem Header="Run Tests (Current Issue)" Click="RunTestsCurrentIssue_Click"/>
                                <MenuItem Header="Run Regression Suite"      Click="RunRegressionSuite_Click"/>
                                <Separator/>
                                <!-- Git #968 (Epic #803) - chronological run history + per-manifest streaks, read from test-results/_history.jsonl -->
                                <MenuItem Header="Test History…" Click="OpenTestHistory_Click"/>
                            </MenuItem>

                            <MenuItem Header="_Terminal" Click="OpenTerminal_Click">
                                <MenuItem Header="Open Terminal"   Click="OpenTerminal_Click" InputGestureText="Ctrl+`"/>
                                <Separator/>
                                <MenuItem Header="git status"      Click="GitChip_Click" Tag="git status"/>
                                <MenuItem Header="git pull"        Click="GitChip_Click" Tag="git pull"/>
                                <MenuItem Header="git push"        Click="GitChip_Click" Tag="git push"/>
                                <MenuItem Header="git log"         Click="GitChip_Click" Tag="git log --oneline -20"/>
                                <MenuItem Header="git stash"       Click="GitChip_Click" Tag="git stash"/>
                                <Separator/>
                                <MenuItem Header="dotnet build"    Click="GitChip_Click" Tag="dotnet build --configuration Release"/>
                            </MenuItem>

                            <MenuItem Header="_Help">
                                <MenuItem Header="About BuildConsole"/>
                                <MenuItem Header="Open DevTools"   Click="OpenDevTools_Click"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <!-- Center: Project & Active Document Title -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Shane McCaw MSP"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text=" • "
                                   FontSize="12"
                                   Foreground="{StaticResource Surface2Brush}"/>
                        <TextBlock Text="Antigravity IDE"
                                   FontSize="12"
                                   Foreground="{StaticResource Subtext0Brush}"/>
                        <TextBlock x:Name="ActiveDocTitleText"
                                   Text=" - Claude.ai"
                                   FontSize="12"
                                   Foreground="{StaticResource BlueBrush}"/>
                        <!-- Git #934 - Shane: "add a - [DEBUG] if I have the app open in the
                             Debug folder." Visibility/Text set from code-behind (OnSourceInitialized)
                             once, based on whether the running exe's own path is under bin\Debug\ -
                             collapsed entirely for a Release build, so this never shows up
                             accidentally in what Shane actually ships/uses day to day. -->
                        <TextBlock x:Name="DebugBuildMarkerText"
                                   Text=" - [DEBUG]"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PeachBrush}"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Right: Quick Action Buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Toggle Primary Side Bar (Ctrl+B)"
                                Click="ToggleSidebar_Click"
                                Padding="6,4">
                            <TextBlock Text="&#xE899;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Toggle Panel (Ctrl+`)"
                                Click="ToggleBottomPanel_Click"
                                Padding="6,4">
                            <TextBlock Text="&#xE90A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Toggle Secondary Side Bar"
                                Click="ToggleQueuePanel_Click"
                                Padding="6,4">
                            <TextBlock Text="&#xE89A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Developer Tools"
                                Click="OpenDevTools_Click"
                                Padding="6,4"
                                Margin="4,0,0,0">
                            <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource MauveBrush}"/>
                        </Button>
                        <!-- Git #821 - Shane: "a play button someplace that kicks off a build of the BuildConsole in Production mode" -->
                        <Button x:Name="BtnBuildRelease"
                                Style="{StaticResource IconButton}"
                                ToolTip="Build Release (dotnet build --configuration Release) - see Output tab"
                                Click="BuildRelease_Click"
                                Padding="6,4"
                                Margin="4,0,0,0">
                            <TextBlock x:Name="BtnBuildReleaseIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource GreenBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Git #894 - real minimize/maximize-restore/close, since WindowStyle="None"
                         removes the OS's own caption buttons entirely. Flush against the true
                         window edge (no rounded corners, full CaptionHeight tall) to read as
                         genuine system buttons rather than more toolbar icons - close gets the
                         standard Windows red hover, the other two get the standard light-gray
                         hover. KNOWN LIMITATION: these are plain WPF buttons, not real DWM
                         caption-button hit regions, so Windows 11's hover-to-show-Snap-Layouts
                         flyout over the maximize button won't appear (that needs a WM_NCHITTEST
                         HTMAXBUTTON hook, a materially bigger change) - double-click/drag-to-edge
                         snap still works fine via WindowChrome, only the hover flyout is missing. -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel.Resources>
                            <Style x:Key="CaptionButton" TargetType="Button">
                                <Setter Property="Width" Value="46"/>
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource Subtext1Brush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="CaptionButtonClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                            <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════
                 STATUS BAR
                 ══════════════════════════════════════════════════════════════ -->
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- nav dot + status -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- URL -->
                                <ColumnDefinition Width="*"/>     <!-- spring -->
                                <ColumnDefinition Width="Auto"/>  <!-- zoom -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- queue -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- deploy -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- replit watcher (Git #902) -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- clock -->
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>

                <StatusBarItem Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{StaticResource GreenBrush}"
                                 Margin="2,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NavStatusText" Text="Ready" VerticalAlignment="Center"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="1"/>
                <StatusBarItem Grid.Column="2">
                    <TextBlock x:Name="UrlStatusText"
                               Text="https://claude.ai"
                               Foreground="{StaticResource Subtext1Brush}"
                               MaxWidth="520"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="4">
                    <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center"/>
                </StatusBarItem>
                <Separator Grid.Column="5"/>
                <StatusBarItem Grid.Column="6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="QueueDot" Width="8" Height="8"
                                 Fill="{StaticResource Surface2Brush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QueueStatusText" Text="Queue: idle" VerticalAlignment="Center"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="7"/>
                <StatusBarItem Grid.Column="8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DeployDot" Width="8" Height="8"
                                 Fill="{StaticResource Surface2Brush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DeployStatusText" Text="Deploy: —" VerticalAlignment="Center"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="9"/>
                <!-- Git #902 — Replit idle watcher status: unobtrusive dot + text, same
                     pattern as the Queue/Deploy indicators. Grey=off, green=watching/app up,
                     orange=checking/grace/waking, red=error. Tooltip carries last check &
                     last intervention times. -->
                <StatusBarItem Grid.Column="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ReplitDot" Width="8" Height="8"
                                 Fill="{StaticResource Surface2Brush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ReplitStatusText" Text="Replit: off" VerticalAlignment="Center"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="11"/>
                <StatusBarItem Grid.Column="12" Padding="6,0,10,0">
                    <TextBlock x:Name="ClockText" Text="00:00:00" VerticalAlignment="Center"/>
                </StatusBarItem>
            </StatusBar>

            <!-- ══════════════════════════════════════════════════════════════
                 MAIN LAYOUT GRID
                 ══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Activity bar -->
                    <ColumnDefinition x:Name="ColActivityBar" Width="48"/>
                    <!-- Left sidebar -->
                    <ColumnDefinition x:Name="ColSidebar" Width="260" MinWidth="0"/>
                    <!-- Left splitter -->
                    <ColumnDefinition Width="4"/>
                    <!-- Main editor area -->
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <!-- Right splitter -->
                    <ColumnDefinition Width="4"/>
                    <!-- Build queue -->
                    <ColumnDefinition x:Name="ColQueue" Width="300" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <!-- ── Activity Bar ── -->
                <ctrl:ActivityBar x:Name="ActivityBar"
                                  Grid.Column="0"
                                  ActiveViewChanged="ActivityBar_ActiveViewChanged"/>

                <!-- ── Left Sidebar ── -->
                <ctrl:LeftSidebar x:Name="LeftSidebar" Grid.Column="1"/>

                <!-- Splitter: sidebar ↔ center -->
                <GridSplitter x:Name="SidebarSplitter"
                              Grid.Column="2"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ShowsPreview="False"/>

                <!-- ── CENTER AREA: editor tabs + bottom panel ── -->
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120"/>  <!-- editor tabs -->
                        <RowDefinition x:Name="RowBottomSplitter" Height="4"/>  <!-- splitter -->
                        <RowDefinition x:Name="RowBottom" Height="0" MinHeight="0"/>  <!-- bottom panel -->
                    </Grid.RowDefinitions>

                    <!-- ── Editor Header Layout Selector Toolbar & Multi-Pane Container ── -->
                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Top" Background="{StaticResource Surface0Brush}" Height="28" Padding="8,2" BorderBrush="{StaticResource Surface1Brush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnLayoutSingle" Style="{StaticResource IconButton}" Content="⏹ Single" ToolTip="Single Pane View" Click="BtnLayout_Click" Tag="Single" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnLayoutSplitH" Style="{StaticResource IconButton}" Content="◧ Side-by-Side" ToolTip="Split Left/Right (2 Columns)" Click="BtnLayout_Click" Tag="SplitH" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnLayoutSplitV" Style="{StaticResource IconButton}" Content="⬒ Top/Bottom" ToolTip="Split Top/Bottom (2 Rows)" Click="BtnLayout_Click" Tag="SplitV" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnLayoutGrid4" Style="{StaticResource IconButton}" Content="⊞ 4 Squares" ToolTip="2x2 Grid View" Click="BtnLayout_Click" Tag="Grid4"/>
                                </StackPanel>
                                <TextBlock Text="EDITOR PANES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Multi-Pane Grid Container -->
                        <Grid x:Name="EditorGridContainer">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="PaneCol0" Width="*"/>
                                <ColumnDefinition x:Name="PaneColSplitter" Width="0"/>
                                <ColumnDefinition x:Name="PaneCol1" Width="0"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="PaneRow0" Height="*"/>
                                <RowDefinition x:Name="PaneRowSplitter" Height="0"/>
                                <RowDefinition x:Name="PaneRow1" Height="0"/>
                            </Grid.RowDefinitions>

                            <!-- Pane 1 (Top Left / Primary) -->
                            <TabControl x:Name="EditorTabs"
                                        Grid.Row="0" Grid.Column="0"
                                        BorderThickness="0"
                                        SelectionChanged="EditorTabs_SelectionChanged"
                                        AllowDrop="True" Drop="EditorTabsPane_Drop" DragOver="TabDragOver">
                                <!-- Claude.ai tab -->
                                <TabItem Tag="https://claude.ai">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource BlueBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Claude.ai" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <!-- Git #816 - Source is set from code-behind AFTER the builder-button script is injected, not here; a XAML-bound Source navigates the instant CoreWebView2 is ready, which can race ahead of AddScriptToExecuteOnDocumentCreatedAsync and mean the very first load never gets the injected buttons. -->
                                    <wv2:WebView2 x:Name="ClaudeWebView"/>
                                </TabItem>
                            </TabControl>

                            <!-- GridSplitters -->
                            <GridSplitter x:Name="PaneGridSplitterH" Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Width="4" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                            <GridSplitter x:Name="PaneGridSplitterV" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="4" VerticalAlignment="Stretch" Visibility="Collapsed"/>

                            <!-- Pane 2 (Top Right / Right Column) -->
                            <TabControl x:Name="EditorTabs2" Grid.Row="0" Grid.Column="2" BorderThickness="0" Visibility="Collapsed" SelectionChanged="EditorTabs_SelectionChanged" AllowDrop="True" Drop="EditorTabsPane_Drop" DragOver="TabDragOver"/>

                            <!-- Pane 3 (Bottom Left / Bottom Row) -->
                            <TabControl x:Name="EditorTabs3" Grid.Row="2" Grid.Column="0" BorderThickness="0" Visibility="Collapsed" SelectionChanged="EditorTabs_SelectionChanged" AllowDrop="True" Drop="EditorTabsPane_Drop" DragOver="TabDragOver"/>

                            <!-- Pane 4 (Bottom Right / Quadrant 4) -->
                            <TabControl x:Name="EditorTabs4" Grid.Row="2" Grid.Column="2" BorderThickness="0" Visibility="Collapsed" SelectionChanged="EditorTabs_SelectionChanged" AllowDrop="True" Drop="EditorTabsPane_Drop" DragOver="TabDragOver"/>
                        </Grid>
                    </DockPanel>

                    <!-- Bottom panel splitter (hidden when panel is collapsed) -->
                    <GridSplitter x:Name="BottomSplitter"
                                  Grid.Row="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ShowsPreview="False"
                                  Visibility="Collapsed"/>

                    <!-- ── Bottom panel (Build Log / Terminal / SQL / Output) ── -->
                    <TabControl x:Name="BottomTabs"
                                Grid.Row="2"
                                BorderThickness="0,1,0,0"
                                Visibility="Collapsed">

                        <TabItem Header="Build Log">
                            <ctrl:BuildLogView x:Name="BuildLogView"/>
                        </TabItem>

                        <TabItem Header="Terminal">
                            <ctrl:TerminalView x:Name="TerminalView"/>
                        </TabItem>

                        <TabItem Header="SQL Runner">
                            <ctrl:SqlRunnerView x:Name="SqlRunnerView"/>
                        </TabItem>

                        <TabItem Header="Output">
                            <!-- Git #815 - live activity log (startup sequence, every API call in/out) fed by Services/ActivityLog.cs, never the calling thread itself (BeginInvoke marshal onto the UI thread). -->
                            <TextBox x:Name="OutputLogBox"
                                     IsReadOnly="True"
                                     Style="{StaticResource TerminalOutputBox}"
                                     Text="[Output] Waiting for activity…"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </TabItem>

                        <TabItem Header="Issue Detail">
                            <!-- Git #840 (Git Board Phase 2) - real issue description + comment thread, clicked from the Git Board tree. -->
                            <ctrl:IssueDetailView x:Name="IssueDetailView"/>
                        </TabItem>

                    </TabControl>
                </Grid>

                <!-- Splitter: center ↔ queue -->
                <GridSplitter Grid.Column="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ShowsPreview="False"/>

                <!-- ── Build Queue Panel ── -->
                <ctrl:BuildQueuePanel x:Name="BuildQueuePanel" Grid.Column="5"/>

            </Grid>

        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════════
             TAB SWITCHER OVERLAY (Ctrl+Tab / Win+Tab style preview)
             ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="TabSwitcherOverlay"
              Visibility="Collapsed"
              Background="#95000000"
              Panel.ZIndex="2000"
              MouseDown="TabSwitcherOverlay_MouseDown">
            <Border Width="580"
                    Height="360"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface1Brush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="16"
                    MouseDown="TabSwitcherCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header -->
                        <RowDefinition Height="Auto"/>  <!-- Divider -->
                        <RowDefinition Height="*"/>     <!-- List -->
                        <RowDefinition Height="Auto"/>  <!-- Footer -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,4,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource BlueBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="OPEN DOCUMENTS" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TabSwitcherCountText" DockPanel.Dock="Right" Text="0 tabs"
                                   FontSize="11" Foreground="{StaticResource Subtext1Brush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Separator Grid.Row="1" Margin="0,0,0,8"/>

                    <!-- Tab Cards List -->
                    <ListBox x:Name="TabSwitcherList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0"
                             Padding="0"
                             Focusable="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{StaticResource BlueBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Url}" FontSize="11"
                                                   Foreground="{StaticResource Subtext1Brush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Background="{StaticResource Surface0Brush}"
                                            CornerRadius="3" Padding="6,2"
                                            VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding IndexTag}"
                                                   FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer hint -->
                    <Border Grid.Row="3" Margin="4,12,4,0" Padding="0,8,0,0"
                            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="Release Ctrl or press Enter to select  •  Esc to cancel"
                                       FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+Tab ⇆"
                                       FontSize="11" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             CTRL+K FIND EVERYTHING FLOATING COMMAND PALETTE
             ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="CommandPaletteOverlay"
              Visibility="Collapsed"
              Background="#80000000"
              Panel.ZIndex="9999"
              MouseDown="CommandPaletteOverlay_MouseDown">
            
            <Border Width="650" MaxHeight="480"
                    VerticalAlignment="Top" Margin="0,50,0,0"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource BlueBrush}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="16">
                
                <Grid x:Name="PaletteInnerGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="Auto"/> <!-- Category Filter Chips -->
                        <RowDefinition Height="*"/>    <!-- Results List -->
                        <RowDefinition Height="Auto"/> <!-- Footer Hint -->
                    </Grid.RowDefinitions>

                    <!-- Search Input Box -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Surface0Brush}"
                            CornerRadius="6"
                            BorderBrush="{StaticResource Surface1Brush}"
                            BorderThickness="1"
                            Padding="10,6" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="PaletteSearchBox"
                                     FontSize="14"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="PaletteSearchBox_TextChanged"
                                     PreviewKeyDown="PaletteSearchBox_PreviewKeyDown"/>
                        </DockPanel>
                    </Border>

                    <!-- Category Chips -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="ChipAll" Content="All" IsChecked="True" Style="{StaticResource ActivityBarButton}" Margin="0,0,6,0" Click="PaletteChip_Click"/>
                        <RadioButton x:Name="ChipFiles" Content="📁 Files" Style="{StaticResource ActivityBarButton}" Margin="0,0,6,0" Click="PaletteChip_Click"/>
                        <RadioButton x:Name="ChipChats" Content="💬 Chats" Style="{StaticResource ActivityBarButton}" Margin="0,0,6,0" Click="PaletteChip_Click"/>
                        <RadioButton x:Name="ChipBuilds" Content="📦 Builds" Style="{StaticResource ActivityBarButton}" Margin="0,0,6,0" Click="PaletteChip_Click"/>
                        <RadioButton x:Name="ChipAutomation" Content="⚡ Automation" Style="{StaticResource ActivityBarButton}" Margin="0,0,6,0" Click="PaletteChip_Click"/>
                        <RadioButton x:Name="ChipGit" Content="🔀 Git" Style="{StaticResource ActivityBarButton}" Click="PaletteChip_Click"/>
                    </StackPanel>

                    <!-- Results ListBox -->
                    <ListBox x:Name="PaletteResultsList"
                             Grid.Row="2"
                             MaxHeight="300"
                             Background="Transparent"
                             BorderThickness="0"
                             MouseDoubleClick="PaletteResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="10,6" Margin="0,2">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource MantleBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryUpper}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer Hint -->
                    <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,6,0,0" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="Press ↑↓ to navigate  •  Enter to open  •  Esc to close" FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                            <TextBlock Text="CTRL+K" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PeachBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             DOCKING GUIDE OVERLAY FOR TAB DRAG & SPLIT LAYOUTS
             ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="DockGuideOverlay"
              Visibility="Collapsed"
              Background="#40000000"
              Panel.ZIndex="10000">
            <Border Width="340" Height="230"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource BlueBrush}"
                    BorderThickness="2" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="DROP TAB TO DOCK VIEW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Left Dock Target -->
                        <Button x:Name="BtnDockLeft" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="4" Click="DockTarget_Click" AllowDrop="True" Drop="DockTarget_Drop" DragOver="TabDragOver" Tag="SplitH">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="◧" FontSize="28" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Split Left" FontSize="10" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Top Dock Target -->
                        <Button x:Name="BtnDockTop" Grid.Row="0" Grid.Column="1" Margin="4" Click="DockTarget_Click" AllowDrop="True" Drop="DockTarget_Drop" DragOver="TabDragOver" Tag="SplitV">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⬒" FontSize="20" Foreground="{StaticResource PeachBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Top" FontSize="10" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4 Squares Target -->
                        <Button x:Name="BtnDockGrid4" Grid.Row="1" Grid.Column="1" Margin="4" Click="DockTarget_Click" AllowDrop="True" Drop="DockTarget_Drop" DragOver="TabDragOver" Tag="Grid4">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⊞" FontSize="20" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="4 Squares" FontSize="10" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Right Dock Target -->
                        <Button x:Name="BtnDockRight" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Margin="4" Click="DockTarget_Click" AllowDrop="True" Drop="DockTarget_Drop" DragOver="TabDragOver" Tag="SplitH_Right">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="◨" FontSize="28" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Split Right" FontSize="10" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

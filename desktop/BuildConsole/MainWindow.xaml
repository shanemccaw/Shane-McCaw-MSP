<Window x:Class="BuildConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BuildConsole"
        xmlns:ctrl="clr-namespace:BuildConsole.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:behaviors="clr-namespace:BuildConsole.Behaviors"
        mc:Ignorable="d"
        Title="BuildConsole" Height="960" Width="1680"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BaseBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        StateChanged="Window_StateChanged"
        Closing="MainWindow_Closing">

    <!-- Git #894 - Shane: "change the title bar from the default Windows
         title bar to one like in VS Code." The custom "Antigravity" bar
         below (File/Edit/Selection/View/Go/Run/Terminal/Help) already
         existed and already matches VS Code's menu row - it was just
         rendering UNDER the native OS title bar (still visible in the
         screenshot's own native "Close" tooltip/X button) rather than
         replacing it. WindowChrome keeps real OS behavior (drag-to-move,
         edge resize, Aero snap, double-click-to-maximize, Alt+Space system
         menu) on a WindowStyle="None" window - CaptionHeight matches the
         bar's own 36px height below, and every interactive element inside
         that height (menu, toolbar buttons, the new caption buttons) is
         marked IsHitTestVisibleInChrome so WindowChrome treats them as
         real clicks instead of window-drag gestures. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="-1"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>


        <!-- Git #874 Home screen — ClaudeWebView, formerly the content of the
             hardcoded (non-closable) claude.ai TabItem, is now parked here as a
             1×1 hidden background WebView2, exactly like ReplitWatcherWebView /
             UsageMeterWebView above. It keeps the app's persistent claude.ai
             session warm: it's the non-null fallback GetActiveWebView returns
             (so the ~19 zoom/reload/devtools call sites can't NRE), it's where
             InitializeClaudeTabAsync injects the builder buttons + navigates at
             startup, and it's a #942 chat-button-status push target. Same
             HwndHost-alive rule as the two above: a WebView2's Opacity is
             read-only and Visibility=Hidden/Collapsed would stop CoreWebView2
             from ever being created, so it's a single non-interactive pixel. -->
        <wv2:WebView2 x:Name="ClaudeWebView"
                      Width="1" Height="1"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Panel.ZIndex="-1"/>

        <!-- Git #1887 — background auto-reopen of persisted OpenChatTabs (#874/#1886)
             entries. Same off-screen-but-alive keep-alive trick PinnedHostCanvas (#972)
             and ClaudeWebView above already rely on: each reopened tab's WebView2 is
             parked here (nonzero size, genuinely IN the visual tree) so it actually gets
             a Loaded event and starts real navigation immediately, instead of sitting
             inert as a non-selected TabItem's Content would (WPF never realizes that
             until the tab is actually selected). MainWindow.ChatReopen.cs moves each
             child from here into its real tab the moment Shane selects it. -->
        <Canvas x:Name="ChatReopenPreloadHost" IsHitTestVisible="False" Panel.ZIndex="-1"/>

        <DockPanel LastChildFill="True">

            <!-- ══════════════════════════════════════════════════════════════
                 ANTIGRAVITY UNIFIED TOP TITLE BAR
                 ══════════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Height="36">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Logo + Menus -->
                        <ColumnDefinition Width="*"/>    <!-- Centered Document / Project Title -->
                        <ColumnDefinition Width="Auto"/> <!-- Quick Action Buttons -->
                        <ColumnDefinition Width="Auto"/> <!-- Git #894 - Minimize/Maximize/Close -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo + Menu Bar -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App logo + branding. The "Antigravity IDE" descriptor is deprioritized
                             (removed from the prime center slot, which now holds the universal
                             search bar); the "Shane McCaw MSP" name stays clearly visible here. -->
                        <Border Width="24" Height="24"
                                Margin="8,0,6,0"
                                Background="{DynamicResource AccentWashLightBrush}"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                ToolTip="Shane McCaw MSP">
                            <TextBlock Text="▲"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BlueBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Shane McCaw MSP"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <Menu Background="Transparent" BorderThickness="0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <MenuItem Header="_File">
                                <MenuItem Header="New Chat"        InputGestureText="Ctrl+N" Click="MenuNewChat_Click"/>
                                <MenuItem Header="Open Session…"/>
                                <Separator/>
                                <MenuItem Header="Settings"       Click="MenuSettings_Click"/>
                                <Separator/>
                                <MenuItem Header="Exit"            Click="MenuExit_Click"/>
                            </MenuItem>

                            <MenuItem Header="_Edit">
                                <MenuItem Header="Undo"            InputGestureText="Ctrl+Z"/>
                                <MenuItem Header="Redo"            InputGestureText="Ctrl+Y"/>
                                <Separator/>
                                <MenuItem Header="Cut"             InputGestureText="Ctrl+X"/>
                                <MenuItem Header="Copy"            InputGestureText="Ctrl+C"/>
                                <MenuItem Header="Paste"           InputGestureText="Ctrl+V"/>
                            </MenuItem>

                            <MenuItem Header="_Selection">
                                <MenuItem Header="Select All"      InputGestureText="Ctrl+A"/>
                            </MenuItem>

                            <MenuItem Header="_View">
                                <MenuItem Header="Switch Tab…"        Click="OpenTabSwitcher_Click" InputGestureText="Ctrl+Tab"/>
                                <Separator/>
                                <MenuItem Header="Toggle Sidebar"      Click="ToggleSidebar_Click" InputGestureText="Ctrl+B"/>
                                <MenuItem Header="Toggle Queue Panel"  Click="ToggleQueuePanel_Click"/>
                                <MenuItem Header="Toggle Bottom Panel" Click="ToggleBottomPanel_Click" InputGestureText="Ctrl+`"/>
                                <Separator/>
                                <MenuItem Header="Reset Layout"        Click="ResetLayout_Click"/>
                                <Separator/>
                                <MenuItem Header="Zoom In"             Click="ZoomIn_Click"    InputGestureText="Ctrl++"/>
                                <MenuItem Header="Zoom Out"            Click="ZoomOut_Click"   InputGestureText="Ctrl+-"/>
                                <MenuItem Header="Reset Zoom"          Click="ZoomReset_Click" InputGestureText="Ctrl+0"/>
                                <Separator/>
                                <MenuItem Header="Activity Log…" Click="OpenStreamingConsole_Click"/>
                            </MenuItem>

                            <MenuItem Header="_Go">
                                <MenuItem Header="Go to File…"     InputGestureText="Ctrl+P"/>
                                <MenuItem Header="Switch Tab…"     InputGestureText="Ctrl+Tab" Click="OpenTabSwitcher_Click"/>
                            </MenuItem>

                            <MenuItem Header="_Run">
                                <MenuItem Header="Start Build"     Click="GitChip_Click" Tag="dotnet build --configuration Release"/>
                                <MenuItem Header="Run Verification"/>
                                <Separator/>
                                <!-- Git #806 (Epic #803 Phase 2) - single mode runs the manifest loaded via the Automation sidebar's Load Manifest button; regression mode sweeps test-manifests/_regression-suite.json -->
                                <MenuItem Header="Run Tests (Current Issue)" Click="RunTestsCurrentIssue_Click"/>
                                <MenuItem Header="Run Regression Suite"      Click="RunRegressionSuite_Click"/>
                                <Separator/>
                                <!-- Git #968 (Epic #803) - chronological run history + per-manifest streaks, read from test-results/_history.jsonl -->
                                <MenuItem Header="Test History…" Click="OpenTestHistory_Click"/>
                            </MenuItem>

                            <MenuItem Header="_Terminal" Click="OpenTerminal_Click">
                                <MenuItem Header="Open Terminal"   Click="OpenTerminal_Click" InputGestureText="Ctrl+`"/>
                                <!-- Git #2156 — Claude terminal moved out of the cramped bottom
                                     panel strip; opens as a full center-pane document tab instead. -->
                                <MenuItem Header="Open Claude Terminal" Click="OpenClaudeTerminal_Click"/>
                                <Separator/>
                                <MenuItem Header="git status"      Click="GitChip_Click" Tag="git status"/>
                                <MenuItem Header="git pull"        Click="GitChip_Click" Tag="git pull"/>
                                <MenuItem Header="git push"        Click="GitChip_Click" Tag="git push"/>
                                <MenuItem Header="git log"         Click="GitChip_Click" Tag="git log --oneline -20"/>
                                <MenuItem Header="git stash"       Click="GitChip_Click" Tag="git stash"/>
                                <Separator/>
                                <MenuItem Header="dotnet build"    Click="GitChip_Click" Tag="dotnet build --configuration Release"/>
                                <Separator/>
                                <MenuItem Header="Open SQL Runner" Click="OpenSql_Click"/>
                                <!-- Git #2786 — Log Viewer full document, same
                                     open-as-tab precedent as SQL Runner above. -->
                                <MenuItem Header="Open Log Viewer" Click="OpenLogViewer_Click"/>
                            </MenuItem>

                            <MenuItem Header="_Help">
                                <MenuItem Header="About BuildConsole"/>
                                <MenuItem Header="Open DevTools"   Click="OpenDevTools_Click"/>
                                <MenuItem Header="🎉 Cheer Me Up!" Click="CheerMeUp_Click" ToolTip="Send in a big encouragement critter with a cheer!"/>
                            </MenuItem>

                            <!-- Build-completion sound mute toggle. The completion event/log still
                                 fires normally when muted — only BuildCompletionSoundService's
                                 playback is suppressed. IsChecked bound in code-behind from
                                 BuildConsoleSettings.BuildCompleteSoundMuted on load. -->
                            <MenuItem Header="_Sound">
                                <MenuItem x:Name="MuteCompletionSoundMenuItem" Header="Mute Completion Sound"
                                          IsCheckable="True" Click="MuteCompletionSound_Click"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <!-- Center: UNIVERSAL SEARCH BAR (primary). Replaces the old static
                         "Shane McCaw MSP • Antigravity IDE - {doc}" text. The app name stays
                         top-left by the logo; the usage readout (Git #1864) is kept here as a
                         small secondary element to the right of the search box. -->
                    <DockPanel Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               LastChildFill="True">

                        <!-- Git #1864 - Shane: "there is a bunch of space in the title bar... to the
                             left of the account switcher there is a title that's totally out of
                             place... you can put the UsageTracking there." Replaces the old
                             active-document label that used to live here (removed - the tab bar
                             already shows which document is active, so it was duplicate information)
                             with the real persisted usage/cost readout from UsageTrackingService.GetSnapshot.
                             Session figures are the headline; all-time sits in the tooltip instead of
                             competing for width. Updated from UsageTrackingService.Changed (see
                             MainWindow.xaml.cs) - no polling, no new timer. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="10,0,0,0">
                            <Border x:Name="UsageReadoutBorder" Cursor="Help">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <TextBlock x:Name="UsageReadoutTooltipText" FontSize="11"/>
                                    </ToolTip>
                                </Border.ToolTip>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🪙" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="UsageReadoutText"
                                               Text="0 tokens · ~$0.00 est."
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Subtext0Brush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Git #934 - "- [DEBUG]" marker; Visibility/Text driven from code-behind
                                 (OnSourceInitialized) only when the running exe is under bin\Debug\. -->
                            <TextBlock x:Name="DebugBuildMarkerText"
                                       Text="[DEBUG]"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PeachBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Visibility="Collapsed"/>
                            <!-- Git #1838 - agent/passive-shell mode marker. Same title-bar
                                 TextBlock styling as [DEBUG]; Visibility driven from code-behind
                                 when AppMode.IsAgent. Proves from a screenshot which mode ran. -->
                            <TextBlock x:Name="AgentModeMarkerText"
                                       Text="[AGENT]"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MauveBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       ToolTip="Passive agent shell (--agent): no builds are claimed, launched, deployed or tested, and the shaneapp:// pipe is not taken."
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Universal search box (primary, spans the center). Focusing/typing
                             opens the grouped results dropdown (CommandPaletteOverlay) below;
                             Ctrl+K focuses it. IsHitTestVisibleInChrome so clicks reach it
                             inside the WindowChrome drag bar. Git #1864 - Height is set in
                             code-behind (SizeSearchBoxToCaptionHeight) against the window's
                             real WindowChrome.CaptionHeight rather than a guessed pixel value
                             here; Padding is reduced to near-zero vertically since that fixed
                             Height plus each child's own VerticalAlignment="Center" now does
                             the vertical centering. -->
                        <Border x:Name="SearchBorder"
                                Background="{StaticResource Surface0Brush}"
                                CornerRadius="6"
                                BorderBrush="{StaticResource Surface1Brush}"
                                BorderThickness="1"
                                Padding="8,0"
                                Width="240"
                                MinWidth="180"
                                MaxWidth="820"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="IBeam"
                                MouseDown="SearchBorder_MouseDown"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="12"
                                           Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="SearchPlaceholder"
                                               Text="Search files, issues, chats…"
                                               FontSize="12"
                                               Foreground="{StaticResource Subtext0Brush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <TextBox x:Name="TitleSearchBox"
                                             Style="{StaticResource SearchTextBox}"
                                             behaviors:SearchTextBoxBehavior.HandlesEscape="False"
                                             FontSize="12"
                                             Background="Transparent"
                                             Foreground="{StaticResource TextBrush}"
                                             CaretBrush="{StaticResource TextBrush}"
                                             BorderThickness="0"
                                             Padding="0,0,20,0"
                                             VerticalContentAlignment="Center"
                                             GotKeyboardFocus="TitleSearchBox_GotKeyboardFocus"
                                             LostKeyboardFocus="TitleSearchBox_LostKeyboardFocus"
                                             TextChanged="TitleSearchBox_TextChanged"
                                             PreviewKeyDown="TitleSearchBox_PreviewKeyDown"/>
                                </Grid>
                                <TextBlock x:Name="SearchCtrlKHint" Grid.Column="2" Text="Ctrl+K" FontSize="10"
                                           Foreground="{StaticResource Subtext1Brush}"
                                           VerticalAlignment="Center" Margin="7,0,2,0"/>
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!-- Right: Quick Action Buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- shaneapp:// live execution indicator badge in title bar -->
                        <Border x:Name="TopShaneAppIndicator"
                                Background="#33A6E3A1"
                                BorderBrush="{StaticResource GreenBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                ToolTip="shaneapp:// is executing — Click to view live streaming console"
                                MouseLeftButtonUp="TopShaneAppIndicator_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="11" Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock x:Name="TopShaneAppIndicatorText" Text="RUNNING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Git #1419 - global Primary/Secondary account toggle. Shane: "put a
                             checkbox or toggle switch up on the title bar that just switches all
                             the builds over." Sets BuildConsoleSettings.DefaultAccount, which any
                             newly queued build without its own explicit account flag/dialog
                             override (Edit Build Prompt's #1416 Account selector still wins when
                             set) falls back to going forward. Colors/text driven from code-behind
                             (RefreshTopAccountToggleUi) so the currently-active account is always
                             visible at a glance. -->
                        <Border x:Name="TopAccountToggleBorder"
                                Background="{StaticResource Surface0Brush}"
                                BorderBrush="{StaticResource Surface1Brush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="TopAccountToggle_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Account:" FontSize="10" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TopAccountToggleText" Text="Primary" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Git #1986 — Home/Rental location toggle. Sits next to the account
                             toggle above and uses the identical de-brightened idiom: a dark
                             surface with an accent border/text when Rental (the metered state
                             worth noticing), never a solid bright fill; Home is the neutral
                             state. Colors/text driven from code-behind (RefreshTopLocationToggleUi)
                             so the current location — and a live one-shot "override active"
                             exception — is always visible at a glance. Manual switch ONLY: never
                             auto-detected. Drives BUILD_NETWORK on launched builds, the network
                             header flag, the .pnpmfile.cjs metered-install refusal, and the
                             version-update deploy's one-shot metered override. No emoji, per #1986.
                             (The build carries its network context via a "network" header flag,
                             same shape as the account flag.) -->
                        <Border x:Name="TopLocationToggleBorder"
                                Background="{StaticResource Surface0Brush}"
                                BorderBrush="{StaticResource Surface1Brush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="TopLocationToggle_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Location:" FontSize="10" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TopLocationToggleText" Text="Home" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Git #2003 — usage-meter automation master toggle. When ON, the live
                             per-account usage meter drives Conservation (engage/release with
                             hysteresis) and routes heavy builds to the account with more headroom.
                             Fails closed on any unavailable/errored/stale reading (status text
                             states why), and a manual Conservation toggle wins for a visible window.
                             OFF by default and OFF hands full manual control back. Green accent when
                             actively acting on live data — distinct from the account (Blue) and
                             Conservation (Peach) toggles. No emoji. -->
                        <Border x:Name="TopAutomationToggleBorder"
                                Background="{StaticResource Surface0Brush}"
                                BorderBrush="{StaticResource Surface1Brush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="TopAutomationToggle_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Auto:" FontSize="10" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TopAutomationToggleText" Text="Off" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TopAutomationStatusText" Text="" FontSize="10" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Git #1989 — Conservation Cap toggle. When ON, no build above Sonnet
                             High launches — it's detected and PARKED (never silently
                             downgraded) until Shane overrides it per-item or turns this off (or
                             Drains). Same visual idiom as TopAccountToggleBorder above:
                             de-brightened accent border/text, never a solid bright fill. The
                             adjacent text carries the primary account's real weekly usage
                             percent + reset countdown (fed from UsageMeter_StatusChanged, the
                             same numbers already polled for the status bar) so the decision to
                             flip this on is informed, not a guess. No emoji, per #1989. -->
                        <Border x:Name="TopConservationToggleBorder"
                                Background="{StaticResource Surface0Brush}"
                                BorderBrush="{StaticResource Surface1Brush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="TopConservationToggle_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Conservation:" FontSize="10" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TopConservationToggleText" Text="Off" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TopConservationUsageText" Text="" FontSize="10" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Git #1989 — Drain: releases EVERY currently-capped build back to the
                             queue at its original model/effort in one action, and turns the
                             Conservation toggle off (the deliberate exception to the one-shot
                             override rule above — draining means the tight window is over).
                             Placed beside the toggle it's paired with, same "always-visible real
                             count, calm at 0" idiom as BtnBatterUp/BtnAiBatterUp. Confirms with
                             the real count before acting (BtnDrainCapped_Click) — this is the one
                             action here that can spend a lot of headroom at once. -->
                        <Button x:Name="BtnDrainCapped"
                                Style="{StaticResource IconButton}"
                                ToolTip="Drain: release every capped build back to the queue at its full original model, and turn Conservation off"
                                Click="BtnDrainCapped_Click"
                                Padding="6,4"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Drain" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{StaticResource Subtext0Brush}"/>
                                <TextBlock x:Name="TopDrainCappedCount" Text="0" FontSize="10.5" FontWeight="SemiBold"
                                           Margin="4,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </Button>
                        <!-- Git #1866 - thin vertical separator ("|") between the account toggle
                             and the right-hand icon group, per Shane's request. -->
                        <Border Width="1" Height="18"
                                Background="{StaticResource Surface1Brush}"
                                Margin="2,0,6,0"
                                VerticalAlignment="Center"/>
                        <!-- Git #1866 - desktop screen-clipping tool. Draw a region anywhere on the
                             desktop; the clip goes to the clipboard AND to disk. Also fires on PrintScreen
                             (BtnScreenClip.ToolTip is updated from code-behind to say whether the global
                             hotkey was claimed by Windows' Snipping Tool). Crop glyph from Segoe MDL2. -->
                        <Button x:Name="BtnScreenClip"
                                Style="{StaticResource IconButton}"
                                ToolTip="Screen clip (PrintScreen) - drag a region to the clipboard and disk"
                                Click="ScreenClip_Click"
                                Padding="6,4">
                            <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource BlueBrush}"/>
                        </Button>
                        <!-- Git #1872 - Batter Up and AI Batter Up moved out of the queue column
                             into their own document tabs (MainWindow.BatterUpTabs.cs); these two
                             buttons open/focus them and carry a live count fed by each panel's
                             CountChanged event - no new GitHub polling, no new timer. The count
                             stays visible at 0 (calm, not hidden) rather than disappearing. -->
                        <Button x:Name="BtnBatterUp"
                                AutomationProperties.AutomationId="BtnBatterUp"
                                Style="{StaticResource IconButton}"
                                ToolTip="Batter Up"
                                Click="BtnBatterUp_Click"
                                Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚾" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TopBatterUpCount" Text="0" FontSize="10.5" FontWeight="SemiBold"
                                           Margin="4,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAiBatterUp"
                                AutomationProperties.AutomationId="BtnAiBatterUp"
                                Style="{StaticResource IconButton}"
                                ToolTip="AI Batter Up"
                                Click="BtnAiBatterUp_Click"
                                Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TopAiBatterUpCount" Text="0" FontSize="10.5" FontWeight="SemiBold"
                                           Margin="4,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Subtext0Brush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Toggle Primary Side Bar (Ctrl+B)"
                                Click="ToggleSidebar_Click"
                                Padding="6,4">
                            <TextBlock Text="&#xE899;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Toggle Panel (Ctrl+`)"
                                Click="ToggleBottomPanel_Click"
                                Padding="6,4">
                            <TextBlock Text="&#xE90A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Toggle Secondary Side Bar"
                                Click="ToggleQueuePanel_Click"
                                Padding="6,4">
                            <TextBlock Text="&#xE89A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Developer Tools"
                                Click="OpenDevTools_Click"
                                Padding="6,4"
                                Margin="4,0,0,0">
                            <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource MauveBrush}"/>
                        </Button>
                        <!-- Quick Dev Services Control Menu -->
                        <Menu Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="4,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <MenuItem x:Name="TopServicesMenuItem"
                                      Background="{StaticResource Surface0Brush}"
                                      Foreground="{StaticResource TextBrush}"
                                      BorderBrush="{StaticResource Surface1Brush}"
                                      BorderThickness="1"
                                      Padding="8,4"
                                      ToolTip="Quick Dev Services Control &amp; Status">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TopServicesStatusDot" Text="🟢" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Services" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text=" ▾" FontSize="10" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>

                                <!-- Per-service items (Marketing/Portal/Admin/API Server/...) are built
                                     dynamically at startup by MainWindow.BuildServicesMenu(), from
                                     whatever DevServicesManager.KnownServices contains (itself loaded
                                     from scripts/dev-server/services.json) - no fixed list here (Git #1782). -->

                                <Separator/>

                                <!-- All Services -->
                                <MenuItem Header="▶ Start All Services" Click="MenuStartAllServices_Click"/>
                                <MenuItem Header="⏹ Stop All Services" Click="MenuStopAllServices_Click"/>
                                <MenuItem Header="⟳ Refresh Services Status" Click="MenuRefreshServices_Click"/>
                            </MenuItem>
                        </Menu>
                        <!-- API runner button -->
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="API Runner"
                                Click="OpenApiRunner_Click"
                                Padding="6,4"
                                Margin="4,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xEC15;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource MauveBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Git #894 - real minimize/maximize-restore/close, since WindowStyle="None"
                         removes the OS's own caption buttons entirely. Flush against the true
                         window edge (no rounded corners, full CaptionHeight tall) to read as
                         genuine system buttons rather than more toolbar icons - close gets the
                         standard Windows red hover, the other two get the standard light-gray
                         hover. KNOWN LIMITATION: these are plain WPF buttons, not real DWM
                         caption-button hit regions, so Windows 11's hover-to-show-Snap-Layouts
                         flyout over the maximize button won't appear (that needs a WM_NCHITTEST
                         HTMAXBUTTON hook, a materially bigger change) - double-click/drag-to-edge
                         snap still works fine via WindowChrome, only the hover flyout is missing. -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                            <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════
                 STATUS BAR
                 ══════════════════════════════════════════════════════════════ -->
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- nav dot + status -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- URL -->
                                <ColumnDefinition Width="*"/>     <!-- spring -->
                                <ColumnDefinition Width="Auto"/>  <!-- zoom -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- queue -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- local Postgres service (Git #1417) -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- deploy -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- replit watcher (Git #902) -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- Claude usage meter (Current Session) -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- Claude Weekly usage meter (All Models, Primary account) -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- Claude Weekly usage meter (Secondary account, Git #1437) -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- Claude online status (status.anthropic.com) -->
                                <ColumnDefinition Width="Auto"/>  <!-- sep -->
                                <ColumnDefinition Width="Auto"/>  <!-- clock -->
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>

                <StatusBarItem Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{StaticResource GreenBrush}"
                                 Margin="2,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NavStatusText" Text="Ready" VerticalAlignment="Center"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="1"/>
                <StatusBarItem Grid.Column="2">
                    <TextBlock x:Name="UrlStatusText"
                               Text="https://claude.ai"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Subtext0Brush}"
                               MaxWidth="340"
                               TextTrimming="CharacterEllipsis"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="4">
                    <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center"/>
                </StatusBarItem>
                <Separator Grid.Column="5"/>
                <StatusBarItem Grid.Column="6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="QueueDot" Width="8" Height="8"
                                 Fill="{StaticResource Surface2Brush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QueueStatusText" Text="Queue: idle" VerticalAlignment="Center"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="7"/>
                <!-- Git #1417 — local PostgreSQL Windows-service status: Shane's own
                     words, "I need a way in the WPF App to know when the Postgres
                     service goes down, and turn it back on." Same dot+text status-bar
                     convention as Deploy/Replit; the Start button only appears when the
                     service is genuinely down (see RenderPostgresStatus). -->
                <StatusBarItem Grid.Column="8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Cursor="Hand" MouseLeftButtonUp="PostgresStatus_Click"
                                ToolTip="Local PostgreSQL Windows service — click to re-check now">
                        <Ellipse x:Name="PostgresDot" Width="8" Height="8"
                                 Fill="{StaticResource Surface2Brush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PostgresStatusText" Text="Postgres: —" VerticalAlignment="Center"/>
                        <Button x:Name="BtnPostgresStart"
                                Style="{StaticResource PrimaryButton}"
                                Content="▶ Start"
                                FontSize="11" FontWeight="SemiBold"
                                Padding="8,1" Margin="8,0,0,0"
                                Visibility="Collapsed"
                                Click="BtnPostgresStart_Click"
                                ToolTip="Start the local PostgreSQL Windows service (net start / Start-Service). Requires an elevated BuildConsole if the service is owned by an admin-only ACL."/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="9"/>
                <StatusBarItem Grid.Column="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Cursor="Hand" MouseLeftButtonUp="DeployStatus_Click"
                                ToolTip="Click to rebuild &amp; redeploy latest local code to ShanesBuild">
                        <Ellipse x:Name="DeployDot" Width="8" Height="8"
                                 Fill="{StaticResource Surface2Brush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DeployStatusText" Text="Deploy: —" VerticalAlignment="Center"/>
                        <!-- Version status — the built-time "running" build vs the live
                             "current" build (v{Major}.{Minor}.{build}, git commit count for
                             desktop/BuildConsole; see Services/VersionInfo.cs). Wired from
                             MainWindow.VersionUpdate.cs: shows the running-vs-current diff and
                             reveals the Update button ONLY when the running copy is behind. -->
                        <TextBlock Text="  •  " Foreground="{StaticResource Surface2Brush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CurrentVersionText" Text="Current: —"
                                   Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                        <Button x:Name="BtnUpdate"
                                Style="{StaticResource PrimaryButton}"
                                Content="⬆ Update"
                                FontSize="11" FontWeight="SemiBold"
                                Padding="8,1" Margin="8,0,0,0"
                                Visibility="Collapsed"
                                Click="BtnUpdate_Click"
                                ToolTip="A newer BuildConsole build is committed locally — build &amp; deploy it to bin\ShanesBuild via deploy-shanesbuild.cmd. Deploys immediately when the Build Queue is clear, otherwise waits until it drains, then fires automatically.">
                            <!-- Git #1986 — one-shot metered override. On the Rental (capped)
                                 connection the deploy (git fetch origin main + local Release
                                 rebuild) is held; this right-click is the deliberate, per-instance
                                 authorisation to run it anyway. It never flips the Location switch. -->
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="RunUpdateAnywayMeteredItem"
                                              Header="Run anyway (metered)"
                                              Click="RunUpdateAnywayMetered_Click"
                                              ToolTip="Authorise this one deploy on the capped connection. One-shot: it runs only this deploy and reverts; the Location stays Rental and nothing else is un-gated."/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="11"/>
                <!-- Git #902 — Replit idle watcher status: unobtrusive dot + text, same
                     pattern as the Queue/Deploy indicators. Grey=off, green=watching/app up,
                     orange=checking/grace/waking, red=error. Tooltip carries last check &
                     last intervention times. -->
                <StatusBarItem Grid.Column="12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ReplitDot" Width="8" Height="8"
                                 Fill="{StaticResource Surface2Brush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ReplitStatusText" Text="Replit: off" VerticalAlignment="Center"
                                   Cursor="Hand" MouseLeftButtonUp="ReplitStatus_Click"
                                   ToolTip="Click to check and wake Replit now"/>
                        <Button x:Name="BtnReplitRefresh"
                                Style="{StaticResource IconButton}"
                                ToolTip="Check Replit status &amp; wake if down"
                                Click="BtnReplitRefresh_Click"
                                Margin="4,0,0,0">
                            <TextBlock Text="↻" FontSize="11" Foreground="{StaticResource Subtext0Brush}"/>
                        </Button>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="13"/>
                <!-- Claude usage meter: always-visible percent used, with a smoothly-ticking
                     "resets in Xd Xh Xm" countdown appended only at 85%+. Shows a muted
                     placeholder when the meter can't be read (not logged in / page
                     changed). Green=fresh read, orange=polling, grey=unavailable,
                     red=error. Tooltip carries reset time + last-checked. -->
                <StatusBarItem Grid.Column="14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="UsageDot" Width="8" Height="8"
                                 Fill="{StaticResource Surface2Brush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UsageStatusText" Text="Claude: --" VerticalAlignment="Center"/>
                        <Button x:Name="BtnUsageRefresh"
                                Style="{StaticResource IconButton}"
                                ToolTip="Refresh Claude usage now"
                                Padding="4,0,0,0"
                                Margin="4,0,0,0"
                                Content="↻"
                                Click="BtnUsageRefresh_Click"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="15"/>
                <!-- Claude Weekly usage meter (Primary account) -->
                <StatusBarItem Grid.Column="16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="WeeklyUsageDot" Width="8" Height="8"
                                 Fill="{StaticResource Surface2Brush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WeeklyUsageStatusText" Text="Claude Weekly (Primary): --" VerticalAlignment="Center"/>
                        <Button x:Name="BtnWeeklyUsageRefresh"
                                Style="{StaticResource IconButton}"
                                ToolTip="Refresh Claude weekly usage now"
                                Padding="4,0,0,0"
                                Margin="4,0,0,0"
                                Content="↻"
                                Click="BtnWeeklyUsageRefresh_Click"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="17"/>
                <!-- Claude Weekly usage meter (Secondary account, Git #1437) — always visible alongside
                     Primary, independent of the title-bar account toggle, so Shane can see both accounts'
                     headroom at once and route accordingly. -->
                <StatusBarItem Grid.Column="18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="SecondaryWeeklyUsageDot" Width="8" Height="8"
                                 Fill="{StaticResource Surface2Brush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SecondaryWeeklyUsageStatusText" Text="Claude Weekly (Secondary): --" VerticalAlignment="Center"/>
                        <Button x:Name="BtnSecondaryWeeklyUsageRefresh"
                                Style="{StaticResource IconButton}"
                                ToolTip="Refresh Claude weekly usage now (Secondary account)"
                                Padding="4,0,0,0"
                                Margin="4,0,0,0"
                                Content="↻"
                                Click="BtnWeeklyUsageRefresh_Click"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="19"/>
                <!-- Claude Service Health Status (source: status.anthropic.com) -->
                <StatusBarItem Grid.Column="20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ClaudeOnlineDot" Width="8" Height="8"
                                 Fill="{StaticResource Surface2Brush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClaudeOnlineStatusText" Text="Status: --" VerticalAlignment="Center"
                                   Cursor="Hand" MouseLeftButtonUp="ClaudeOnlineStatus_Click"
                                   ToolTip="Claude system status (source: status.anthropic.com) — Click to open status page"/>
                        <Button x:Name="BtnClaudeOnlineRefresh"
                                Style="{StaticResource IconButton}"
                                ToolTip="Refresh Claude system status now (source: status.anthropic.com)"
                                Padding="4,0,0,0"
                                Margin="4,0,0,0"
                                Content="↻"
                                Click="BtnClaudeOnlineRefresh_Click"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Grid.Column="21"/>
                <StatusBarItem Grid.Column="22" Padding="6,0,10,0">
                    <TextBlock x:Name="ClockText" Text="00:00:00" VerticalAlignment="Center"/>
                </StatusBarItem>
            </StatusBar>
            <!-- ══════════════════════════════════════════════════════════════
                 MAIN LAYOUT GRID
                 ══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Activity bar -->
                    <ColumnDefinition x:Name="ColActivityBar" Width="48"/>
                    <!-- Left sidebar -->
                    <ColumnDefinition x:Name="ColSidebar" Width="260" MinWidth="0"/>
                    <!-- Left splitter -->
                    <ColumnDefinition Width="4"/>
                    <!-- Main editor area -->
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <!-- Right splitter -->
                    <ColumnDefinition Width="4"/>
                    <!-- Build queue -->
                    <ColumnDefinition x:Name="ColQueue" Width="300" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <!-- ── Activity Bar ── -->
                <ctrl:ActivityBar x:Name="ActivityBar"
                                  Grid.Column="0"
                                  ShelfOpenRequested="ActivityBar_ShelfOpenRequested"
                                  ActiveViewChanged="ActivityBar_ActiveViewChanged"/>

                <!-- ── Left Sidebar ── -->
                <ctrl:LeftSidebar x:Name="LeftSidebar" Grid.Column="1"/>

                <!-- Splitter: sidebar ↔ center -->
                <GridSplitter x:Name="SidebarSplitter"
                              Grid.Column="2"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ShowsPreview="False"/>

                <!-- ── CENTER AREA: editor tabs + bottom panel ── -->
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120"/>  <!-- editor tabs -->
                        <RowDefinition x:Name="RowBottomSplitter" Height="4"/>  <!-- splitter -->
                        <RowDefinition x:Name="RowBottom" Height="0" MinHeight="0"/>  <!-- bottom panel -->
                    </Grid.RowDefinitions>

                    <!-- ── Editor Header Layout Selector Toolbar & Multi-Pane Container ── -->
                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Top" Background="{StaticResource Surface0Brush}" Height="28" Padding="8,2" BorderBrush="{StaticResource Surface1Brush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnLayoutSingle" Style="{StaticResource IconButton}" Content="⏹ Single" ToolTip="Single Pane View" Click="BtnLayout_Click" Tag="Single" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnLayoutSplitH" Style="{StaticResource IconButton}" Content="◧ Side-by-Side" ToolTip="Split Left/Right (2 Columns)" Click="BtnLayout_Click" Tag="SplitH" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnLayoutSplitV" Style="{StaticResource IconButton}" Content="⬒ Top/Bottom" ToolTip="Split Top/Bottom (2 Rows)" Click="BtnLayout_Click" Tag="SplitV" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnLayoutGrid4" Style="{StaticResource IconButton}" Content="⊞ 4 Squares" ToolTip="2x2 Grid View" Click="BtnLayout_Click" Tag="Grid4"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Left" Text="EDITOR PANES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Git #1884 — Auto-queue grace-period countdown banner. Extends #1883's
                             hard readiness gate with a real delay: the queue pickup loop's launch
                             gate isn't lifted the instant the app signals readiness, it's lifted
                             after this countdown (or "Start now"), giving the machine a moment to
                             settle after a genuinely heavy cold start. Docked directly under the
                             editor-pane layout toolbar above (not overlaying the panes themselves,
                             so it never blocks anything) and collapsed by default — it only takes
                             up space while the countdown is actually running. Disappears the moment
                             the countdown completes or either button is used. -->
                        <Border x:Name="AutoQueueGraceBanner" DockPanel.Dock="Top"
                                Visibility="Collapsed"
                                Background="{StaticResource Surface1Brush}"
                                Padding="8,4"
                                BorderBrush="{StaticResource Surface2Brush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnAutoQueueStartNow" Style="{StaticResource IconButton}"
                                            Content="▶ Start now"
                                            ToolTip="Skip the rest of the delay and let the build queue start now"
                                            Click="BtnAutoQueueStartNow_Click" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnAutoQueueStop" Style="{StaticResource IconButton}"
                                            Content="⏹ Stop"
                                            ToolTip="Don't auto-start the queue this session — stays paused until you resume it yourself"
                                            Click="BtnAutoQueueStop_Click"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}">
                                    <Run Text="⏳" Foreground="{StaticResource YellowBrush}"/>
                                    <Run x:Name="AutoQueueGraceText" Text="Build queue auto-start in 1:30 — giving the app a moment to settle"/>
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <!-- Editor Tab "Pinned" strip — a small always-visible strip
                             (icon + short label per pinned tab), shown only when >=1
                             tab is pinned. Clicking a strip item opens that pinned tab
                             to full view; its WebView2 keeps running off-screen in the
                             keep-alive canvas below meanwhile. -->
                        <Border x:Name="PinnedStripBar" DockPanel.Dock="Bottom"
                                Visibility="Collapsed"
                                Background="{StaticResource Surface0Brush}"
                                BorderBrush="{StaticResource Surface1Brush}"
                                BorderThickness="0,1,0,0" Padding="6,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📌 PINNED" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Subtext0Brush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel x:Name="PinnedStrip" Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>

                        <!-- Multi-Pane Grid Container + pinned keep-alive overlay, stacked
                             in one cell. PinnedHostCanvas holds each pinned tab's live
                             content: parked off-screen (nonzero size, still in the visual
                             tree) so CoreWebView2 stays loaded/not-suspended per the same
                             HwndHost rule as ReplitWatcherWebView (#902), and slid to 0,0
                             over the panes when expanded. -->
                        <Grid>
                        <Grid x:Name="EditorGridContainer">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="PaneCol0" Width="*"/>
                                <ColumnDefinition x:Name="PaneColSplitter" Width="0"/>
                                <ColumnDefinition x:Name="PaneCol1" Width="0"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="PaneRow0" Height="*"/>
                                <RowDefinition x:Name="PaneRowSplitter" Height="0"/>
                                <RowDefinition x:Name="PaneRow1" Height="0"/>
                            </Grid.RowDefinitions>

                            <!-- Pane 1 (Top Left / Primary) -->
                            <TabControl x:Name="EditorTabs"
                                        Grid.Row="0" Grid.Column="0"
                                        BorderThickness="0"
                                        SelectionChanged="EditorTabs_SelectionChanged"
                                        AllowDrop="True" Drop="EditorTabsPane_Drop" DragOver="TabDragOver">
                                <!-- Git #874 Home screen — EditorTabs starts EMPTY. The old
                                     hardcoded (non-closable) claude.ai TabItem was removed and
                                     replaced by a native, CLOSABLE "Home" tab that MainWindow
                                     adds programmatically at startup (OpenHomeTab), so it goes
                                     through the same closable-tab infrastructure as every other
                                     tab. The ClaudeWebView it used to host is now a parked 1×1
                                     hidden WebView2 at the top of the outer Grid (kept alive so
                                     the GetActiveWebView fallback + the builder-button / #942
                                     chat-status infra it feeds all keep working). -->
                            </TabControl>

                            <!-- GridSplitters -->
                            <GridSplitter x:Name="PaneGridSplitterH" Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Width="4" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                            <GridSplitter x:Name="PaneGridSplitterV" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="4" VerticalAlignment="Stretch" Visibility="Collapsed"/>

                            <!-- Pane 2 (Top Right / Right Column) -->
                            <TabControl x:Name="EditorTabs2" Grid.Row="0" Grid.Column="2" BorderThickness="0" Visibility="Collapsed" SelectionChanged="EditorTabs_SelectionChanged" AllowDrop="True" Drop="EditorTabsPane_Drop" DragOver="TabDragOver"/>

                            <!-- Pane 3 (Bottom Left / Bottom Row) -->
                            <TabControl x:Name="EditorTabs3" Grid.Row="2" Grid.Column="0" BorderThickness="0" Visibility="Collapsed" SelectionChanged="EditorTabs_SelectionChanged" AllowDrop="True" Drop="EditorTabsPane_Drop" DragOver="TabDragOver"/>

                            <!-- Pane 4 (Bottom Right / Quadrant 4) -->
                            <TabControl x:Name="EditorTabs4" Grid.Row="2" Grid.Column="2" BorderThickness="0" Visibility="Collapsed" SelectionChanged="EditorTabs_SelectionChanged" AllowDrop="True" Drop="EditorTabsPane_Drop" DragOver="TabDragOver"/>
                        </Grid>
                        <!-- Pinned tabs' live keep-alive host (overlaps the panes). Not
                             hit-testable while everything is collapsed (all children are
                             parked off-screen); MainWindow.PinnedTabs.cs flips it on when
                             a pinned tab is expanded over the panes. -->
                        <Canvas x:Name="PinnedHostCanvas" IsHitTestVisible="False"
                                ClipToBounds="True"
                                SizeChanged="PinnedHostCanvas_SizeChanged"/>
                        </Grid>
                    </DockPanel>

                    <!-- Bottom panel splitter (hidden when panel is collapsed) -->
                    <GridSplitter x:Name="BottomSplitter"
                                  Grid.Row="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ShowsPreview="False"
                                  Visibility="Collapsed"/>

                    <!-- ── Bottom panel (Build Log / Terminal / SQL / Output) ── -->
                    <Grid x:Name="BottomPanelGrid" Grid.Row="2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Real system-wide (not just BuildConsole's own process) CPU
                             and Memory meters, polled every ~1.5s. See
                             MainWindow.ResourceMonitor.cs. -->
                        <Border Grid.Row="0"
                                Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="0,1,0,1"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Width="180" Margin="0,0,20,0">
                                    <TextBlock Text="CPU" Foreground="{StaticResource Subtext1Brush}"
                                               FontSize="11" VerticalAlignment="Center" Width="30"/>
                                    <ProgressBar x:Name="CpuMeterBar"
                                                 Style="{StaticResource ResourceMeterBar}"
                                                 Foreground="{StaticResource BlueBrush}"
                                                 Width="90" Margin="4,0"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CpuMeterText" Text="—"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="11" VerticalAlignment="Center" Width="34"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Width="260">
                                    <TextBlock Text="Memory" Foreground="{StaticResource Subtext1Brush}"
                                               FontSize="11" VerticalAlignment="Center" Width="42"/>
                                    <ProgressBar x:Name="MemoryMeterBar"
                                                 Style="{StaticResource ResourceMeterBar}"
                                                 Foreground="{StaticResource MauveBrush}"
                                                 Width="90" Margin="4,0"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MemoryMeterText" Text="—"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="11" VerticalAlignment="Center" Width="110"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    <TabControl x:Name="BottomTabs"
                                Grid.Row="1"
                                BorderThickness="0">

                        <TabItem Header="Build Log">
                            <ctrl:BuildLogView x:Name="BuildLogView"/>
                        </TabItem>

                        <TabItem Header="Terminal">
                            <ctrl:TerminalView x:Name="TerminalView"/>
                        </TabItem>

                        <TabItem Header="Marketing" x:Name="TabMarketing">
                            <ctrl:ServiceLogView x:Name="MarketingLogView"/>
                        </TabItem>

                        <TabItem Header="Portal" x:Name="TabPortal">
                            <ctrl:ServiceLogView x:Name="PortalLogView"/>
                        </TabItem>

                        <TabItem Header="Admin" x:Name="TabAdmin">
                            <ctrl:ServiceLogView x:Name="AdminLogView"/>
                        </TabItem>

                        <TabItem Header="API Server" x:Name="TabApiServer">
                            <ctrl:ServiceLogView x:Name="ApiServerLogView"/>
                        </TabItem>

                        <TabItem Header="Output">
                            <!-- Git #815 - live activity log (startup sequence, every API call in/out) fed by Services/ActivityLog.cs, never the calling thread itself (BeginInvoke marshal onto the UI thread). -->
                            <Grid>
                                <TextBox x:Name="OutputLogBox"
                                         IsReadOnly="True"
                                         Style="{StaticResource TerminalOutputBox}"
                                         Text="[Output] Waiting for activity…"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>

                                <!-- Pause/Resume live streaming so text can be selected/copied without it jumping. -->
                                <Button x:Name="OutputPauseButton"
                                        Content="⏸ Pause"
                                        Style="{StaticResource ChipButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,6,10,0"
                                        Click="OutputPauseToggle_Click"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Issue Detail">
                            <!-- Git #840 (Git Board Phase 2) - real issue description + comment thread, clicked from the Git Board tree. -->
                            <ctrl:IssueDetailView x:Name="IssueDetailView"/>
                        </TabItem>

                    </TabControl>
                    </Grid>
                </Grid>

                <!-- Splitter: center ↔ queue -->
                <GridSplitter Grid.Column="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ShowsPreview="False"/>

                <!-- ── Build Queue column: Dispatch above the existing Build Queue Panel ──
                     Git #1872 — AI Batter Up (#1710) and Batter Up (#1709) moved out of this
                     column entirely into their own title-bar-launched document tabs (see
                     MainWindow.BatterUpTabs.cs); #1834's build-set rollup, docked at the top
                     of BuildQueuePanel, already occupies the space they vacated.
                     Git #1831 - Margin="0,0,8,0" pulls the whole column (and its outer
                     scrollbar) 8px in from the literal window right edge, which the
                     scrollbar previously rendered flush against - confirmed via
                     UIAutomation (ScrollViewer BoundingRectangle right edge landed
                     exactly on the window's right edge, 0px of buffer). On a
                     multi-monitor setup a slightly-off click used to pass straight
                     through onto the adjacent monitor; now it lands on this panel. -->
                <DockPanel Grid.Column="5" LastChildFill="True" Margin="0,0,8,0">
                    <ctrl:DispatchPanel x:Name="DispatchPanel" DockPanel.Dock="Top"/>
                    <ctrl:BuildQueuePanel x:Name="BuildQueuePanel"/>
                </DockPanel>

            </Grid>

        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════════
             TAB SWITCHER OVERLAY (Ctrl+Tab / Win+Tab style preview)
             ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="TabSwitcherOverlay"
              Visibility="Collapsed"
              Background="#95000000"
              Panel.ZIndex="2000"
              MouseDown="TabSwitcherOverlay_MouseDown">
            <Border Width="580"
                    Height="360"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface1Brush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="16"
                    MouseDown="TabSwitcherCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header -->
                        <RowDefinition Height="Auto"/>  <!-- Divider -->
                        <RowDefinition Height="*"/>     <!-- List -->
                        <RowDefinition Height="Auto"/>  <!-- Footer -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,4,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource BlueBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="OPEN DOCUMENTS" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TabSwitcherCountText" DockPanel.Dock="Right" Text="0 tabs"
                                   FontSize="11" Foreground="{StaticResource Subtext1Brush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Separator Grid.Row="1" Margin="0,0,0,8"/>

                    <!-- Tab Cards List -->
                    <ListBox x:Name="TabSwitcherList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0"
                             Padding="0"
                             Focusable="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{StaticResource BlueBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Url}" FontSize="11"
                                                   Foreground="{StaticResource Subtext1Brush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Background="{StaticResource Surface0Brush}"
                                            CornerRadius="3" Padding="6,2"
                                            VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding IndexTag}"
                                                   FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer hint -->
                    <Border Grid.Row="3" Margin="4,12,4,0" Padding="0,8,0,0"
                            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="Release Ctrl or press Enter to select  •  Esc to cancel"
                                       FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+Tab ⇆"
                                       FontSize="11" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             CTRL+K FIND EVERYTHING FLOATING COMMAND PALETTE
             ══════════════════════════════════════════════════════════════ -->
        <!-- Anchored under the title-bar search box; scrim starts below the 36px
             title bar so the search box stays interactive above it. Input lives in
             the title bar (TitleSearchBox) — this overlay is just the grouped-by-
             source results dropdown, VS Code Quick-Open style. -->
        <Grid x:Name="CommandPaletteOverlay"
              Visibility="Collapsed"
              Background="#22000000"
              Margin="0,36,0,0"
              Panel.ZIndex="9999"
              MouseDown="CommandPaletteOverlay_MouseDown">

            <Border Width="680" MaxHeight="520"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,6,0,0"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource BlueBrush}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>    <!-- Grouped results -->
                        <RowDefinition Height="Auto"/> <!-- Footer hint -->
                    </Grid.RowDefinitions>

                    <!-- Empty / no-match state (overlaid with the list in row 0) -->
                    <TextBlock x:Name="SearchEmptyHint"
                               Grid.Row="0"
                               Text="Type to search files, issues, chats, tests &amp; builds…"
                               FontSize="12"
                               Foreground="{StaticResource Subtext0Brush}"
                               Margin="8,10,8,10"/>

                    <!-- Grouped results: one small header per source type -->
                    <ListBox x:Name="PaletteResultsList"
                             Grid.Row="0"
                             MaxHeight="440"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="PaletteResultsList_PreviewMouseLeftButtonUp"
                             MouseDoubleClick="PaletteResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" CornerRadius="4" Padding="8,5" Margin="0,1">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Subtext0Brush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Margin="2,8,2,3" Padding="0,0,0,3" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="10" Foreground="{StaticResource Subtext1Brush}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <!-- Footer hint -->
                    <Border Grid.Row="1" Margin="2,8,2,0" Padding="0,6,0,0" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="↑↓ navigate  •  Enter / click to open  •  Esc to close" FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                            <TextBlock Text="Ctrl+K" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PeachBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             DOCKING GUIDE OVERLAY FOR TAB DRAG & SPLIT LAYOUTS
             ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="DockGuideOverlay"
              Visibility="Collapsed"
              Background="#40000000"
              Panel.ZIndex="10000">
            <Border Width="340" Height="230"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CrustBrush}"
                    BorderBrush="{StaticResource BlueBrush}"
                    BorderThickness="2" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="DROP TAB TO DOCK VIEW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Left Dock Target -->
                        <Button x:Name="BtnDockLeft" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="4" Click="DockTarget_Click" AllowDrop="True" Drop="DockTarget_Drop" DragOver="TabDragOver" Tag="SplitH">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="◧" FontSize="28" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Split Left" FontSize="10" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Top Dock Target -->
                        <Button x:Name="BtnDockTop" Grid.Row="0" Grid.Column="1" Margin="4" Click="DockTarget_Click" AllowDrop="True" Drop="DockTarget_Drop" DragOver="TabDragOver" Tag="SplitV">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⬒" FontSize="20" Foreground="{StaticResource PeachBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Top" FontSize="10" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4 Squares Target -->
                        <Button x:Name="BtnDockGrid4" Grid.Row="1" Grid.Column="1" Margin="4" Click="DockTarget_Click" AllowDrop="True" Drop="DockTarget_Drop" DragOver="TabDragOver" Tag="Grid4">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⊞" FontSize="20" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="4 Squares" FontSize="10" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Right Dock Target -->
                        <Button x:Name="BtnDockRight" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Margin="4" Click="DockTarget_Click" AllowDrop="True" Drop="DockTarget_Drop" DragOver="TabDragOver" Tag="SplitH_Right">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="◨" FontSize="28" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Split Right" FontSize="10" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             SAILOR DUCK MASCOT SCREEN LAYER (DONALD DUCK IN SAILBOAT)
             Shane's primary mascot: sails across the screen on events/ambient,
             rests in the center when idle, and reacts to clicks and celebrations.
             ══════════════════════════════════════════════════════════════ -->
        <ctrl:SailorDuckMascotLayer x:Name="SailorDuckLayer" Panel.ZIndex="15000" IsHitTestVisible="False"/>

        <!-- ══════════════════════════════════════════════════════════════
             ANIMATED STARTUP LOADING OVERLAY
             Shane: "maybe the home screen is a really pretty animated loading
             thing… like Donald Duck running across the screen until the
             connections to all the apis are made." Covers the whole window
             (highest ZIndex) while the real startup connections — GitHub board,
             in-flight issues, Build queue, Deploy status, Claude usage meter —
             settle, then fades out to reveal Home. Removed from the visual tree
             entirely once dismissed (MainWindow's StartupOverlay_DismissRequested),
             so it costs nothing after launch. Last child so it paints on top of
             everything (title bar + status bar included).
             ══════════════════════════════════════════════════════════════ -->
        <ctrl:StartupLoadingView x:Name="StartupOverlay" Panel.ZIndex="20000"/>
    </Grid>
</Window>

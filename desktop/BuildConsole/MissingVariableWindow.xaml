<Window x:Class="BuildConsole.MissingVariableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test Variable Needed"
        Width="380" SizeToContent="Height"
        MinWidth="320"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Pause-on-unset floaty (Epic #803, extends #953/#961). Same shape as the DeviceCodeWindow /
         #937 Sticky Notes / #973 LinkedIn floaties: borderless always-on-top window, the thin header
         strip is the drag handle. When a manifest step is about to resolve a {{NAME}} whose stored Test
         Environment Variable is still <unset>/needsReview, the run PAUSES here and asks Shane to fill the
         real value; on submit it's saved to the store (needsReview cleared) and the run resumes on that
         value. Non-blocking — never a modal; dismissing it fails just that step, clearly. -->
    <Border Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource PeachBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header strip: title + close, doubles as the drag handle -->
            <Border x:Name="HeaderStrip" Grid.Row="0"
                    Background="{StaticResource CrustBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="8,5,6,5"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE9F5;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{StaticResource PeachBrush}"/>
                    <TextBlock Grid.Column="1" Text="Test Variable Needs a Value"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <Button x:Name="BtnClose" Grid.Column="2"
                            Content="&#x2715;"
                            Style="{StaticResource IconButton}"
                            FontSize="10"
                            Padding="4,1,4,1"
                            ToolTip="Dismiss (this step will fail, naming the variable)"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Instruction -->
            <TextBlock Grid.Row="1"
                       Margin="12,10,12,4"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource Subtext0Brush}"
                       Text="This test run needs a real value for the variable below (it's still unset). Enter it and the run continues on it; the value is saved to Settings › Test Environment Variables so you won't be asked again."/>

            <!-- The variable name -->
            <Border Grid.Row="2"
                    Margin="12,4,12,4"
                    Background="{StaticResource BaseBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,6,10,6">
                <TextBlock x:Name="NameText"
                           Text="{}{{NAME}}"
                           Foreground="{StaticResource YellowBrush}"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           FontSize="15" FontWeight="Bold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- The value input -->
            <TextBox x:Name="ValueBox" Grid.Row="3"
                     Margin="12,4,12,2"
                     Padding="8,6,8,6"
                     FontSize="13"
                     Background="{StaticResource BaseBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource Surface0Brush}"
                     BorderThickness="1"
                     CaretBrush="{StaticResource TextBrush}"
                     KeyDown="ValueBox_KeyDown"/>

            <!-- Hint / validation line -->
            <TextBlock x:Name="HintText" Grid.Row="4"
                       Margin="12,4,12,2"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Subtext0Brush}"
                       Text="Press Enter to submit, Esc to dismiss."/>

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="12,6,12,12">
                <Button x:Name="BtnCancel"
                        Content="Dismiss"
                        Style="{StaticResource IconButton}"
                        Padding="10,4,10,4"
                        Margin="0,0,8,0"
                        Click="BtnClose_Click"/>
                <Button x:Name="BtnSubmit"
                        Content="Save &amp; Continue"
                        Style="{StaticResource PrimaryButton}"
                        Padding="12,4,12,4"
                        Click="BtnSubmit_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="BuildConsole.TestHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Test History &amp; Diagnostic Inspector"
        Icon="app.ico"
        Height="840" Width="1300"
        MinWidth="1000" MinHeight="620"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None"
        StateChanged="Window_StateChanged">

    <!-- Window Chrome for Mica/Dark Custom Titlebar -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="-1"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True">
        <!-- ── Title Bar ── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="🧪" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Test History &amp; Diagnostic Inspector"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                        <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main Grid ── -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Top Filter / Control Bar -->
                <RowDefinition Height="*"/>     <!-- Content: Left runs list / Right diagnostics -->
            </Grid.RowDefinitions>

            <!-- ── Top Control & Filter Bar ── -->
            <Border Grid.Row="0"
                    Background="{StaticResource MantleBrush}"
                    BorderBrush="{StaticResource Surface0Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title badge & optional Filter banner -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="TEST RUNS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                        <Border x:Name="PillFilterBanner" Background="{StaticResource Surface0Brush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtFilterBanner" Text="" FontSize="11" Foreground="{StaticResource MauveBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="✕" Margin="6,0,0,0" Padding="2,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Subtext0Brush}" Cursor="Hand" Click="BtnClearFilter_Click" ToolTip="Clear filter"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Filter Chips (All / Flaky / Regressions / Failed / Passed) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <RadioButton x:Name="RadioFilterAll" Content="All Runs" IsChecked="True"
                                     Style="{StaticResource ActivityBarButton}" Margin="0,0,4,0" Click="Filter_Changed"/>
                        <RadioButton x:Name="RadioFilterFlaky" Content="⚠️ Flaky"
                                     Style="{StaticResource ActivityBarButton}" Margin="0,0,4,0" Click="Filter_Changed"
                                     ToolTip="Filter to runs from manifests exhibiting flaky / intermittent behavior"/>
                        <RadioButton x:Name="RadioFilterRegression" Content="🚨 Regressions"
                                     Style="{StaticResource ActivityBarButton}" Margin="0,0,4,0" Click="Filter_Changed"
                                     ToolTip="Filter to runs from manifests with active regressions (failing after previous passes)"/>
                        <RadioButton x:Name="RadioFilterFailed" Content="❌ Failed Only"
                                     Style="{StaticResource ActivityBarButton}" Margin="0,0,4,0" Click="Filter_Changed"/>
                        <RadioButton x:Name="RadioFilterPassed" Content="✅ Passed Only"
                                     Style="{StaticResource ActivityBarButton}" Margin="0,0,4,0" Click="Filter_Changed"/>
                    </StackPanel>

                    <!-- Search Input -->
                    <Grid Grid.Column="2" MaxWidth="360" HorizontalAlignment="Left">
                        <TextBox x:Name="TxtSearch"
                                 Style="{StaticResource SearchTextBox}"
                                 Background="{StaticResource CrustBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource Surface0Brush}"
                                 BorderThickness="1"
                                 Padding="8,5,24,5"
                                 FontSize="12"
                                 Width="320"
                                 TextChanged="TxtSearch_TextChanged"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="🔍 Search issue # or feature…"
                                   Foreground="{StaticResource OverlayBrush}"
                                   FontSize="11"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Right View Actions -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="ToggleStreaksView" Content="⚡ Streaks Summary"
                                      Style="{StaticResource FilterChip}"
                                      Padding="10,3" Margin="0,0,8,0" FontSize="11"
                                      Click="ToggleStreaksView_Click"
                                      ToolTip="Toggle overview of reliability streaks per test manifest"/>
                        <Button x:Name="BtnRefresh" Content="↻ Refresh"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,4" FontSize="11" Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Master-Detail Workspace ── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="280" MaxWidth="550"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ══════ LEFT PANEL: Runs List / Streaks ══════ -->
                <Grid Grid.Column="0" Background="{StaticResource MantleBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- List Header info -->
                        <RowDefinition Height="*"/>     <!-- Runs or Streaks List -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource CrustBrush}"
                            BorderBrush="{StaticResource Surface0Brush}"
                            BorderThickness="0,0,1,1" Padding="10,6">
                        <DockPanel>
                            <TextBlock x:Name="TxtListHeader" Text="Test Runs (newest first)"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtRunCountBadge" Text="0 runs"
                                       FontSize="11" Foreground="{StaticResource Subtext0Brush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Empty runs state -->
                    <TextBlock x:Name="TxtNoRuns" Grid.Row="1"
                               Text="No matching runs found."
                               FontSize="12" Foreground="{StaticResource Subtext0Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="20" Visibility="Collapsed"/>

                    <!-- Runs ListBox -->
                    <ListBox x:Name="RunsList" Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0,0,1,0"
                             BorderBrush="{StaticResource Surface0Brush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="RunsList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="4,3"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="8,8"
                                                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Surface1Brush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface1Brush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top: Status + Issue # + Reliability badge + Mode badge -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding StatusGlyph}" FontWeight="Bold"
                                                       Foreground="{Binding StatusBrush}" FontSize="13" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding IssueDisplay}" FontWeight="Bold" FontSize="12"
                                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                            <Border Background="{Binding ReliabilityBadgeBgBrush}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                    Visibility="{Binding ReliabilityBadgeVisibility}" ToolTip="{Binding ReliabilityToolTip}">
                                                <TextBlock Text="{Binding ReliabilityBadgeLabel}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{Binding ReliabilityBadgeFgBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                            <Border Background="{Binding StatusBgBrush}" CornerRadius="3" Padding="6,1" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding StatusBrush}"/>
                                            </Border>
                                            <Border Background="{StaticResource CrustBrush}" CornerRadius="3" Padding="5,1">
                                                <TextBlock Text="{Binding ModeLabel}" FontSize="9" Foreground="{StaticResource Subtext0Brush}"/>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Middle: Feature title -->
                                    <TextBlock Grid.Row="1" Text="{Binding Feature}"
                                               FontSize="11" Foreground="{StaticResource Subtext1Brush}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="32" Margin="0,0,0,6"/>

                                    <!-- Bottom: Timestamp + Step counts -->
                                    <DockPanel Grid.Row="2">
                                        <TextBlock Text="{Binding StartedAtDisplay}" FontSize="10"
                                                   Foreground="{StaticResource OverlayBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CountsLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Streaks ListBox (Visible when Streaks View is toggled) -->
                    <ListBox x:Name="StreaksList" Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0,0,1,0"
                             BorderBrush="{StaticResource Surface0Brush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="Collapsed"
                             SelectionChanged="StreaksList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="4,3"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="8,8"
                                                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface1Brush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MauveBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,3">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding StatusGlyph}" FontWeight="Bold"
                                                       Foreground="{Binding StatusBrush}" FontSize="13" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" MaxWidth="210"/>
                                        </StackPanel>
                                        <Border Background="{Binding CategoryBgBrush}" CornerRadius="3" Padding="5,1"
                                                HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryBadgeLabel}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding CategoryFgBrush}"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding StreakLabel}" FontSize="10"
                                               Foreground="{Binding StatusBrush}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="2" Text="{Binding PatternDisplay}" FontSize="9"
                                               Foreground="{StaticResource Subtext0Brush}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- GridSplitter -->
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              Background="{StaticResource Surface0Brush}"/>

                <!-- ══════ RIGHT PANEL: Run Detail & Diagnostics ══════ -->
                <Grid Grid.Column="2" Background="{StaticResource BaseBrush}">

                    <!-- No Selection State -->
                    <StackPanel x:Name="PanelNoSelection" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                        <TextBlock Text="📊" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Select a test run to inspect details"
                                   FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Choose any test run from the list on the left to see step diagnostics, expected vs actual comparisons, request/response bodies, and screenshot captures."
                                   FontSize="12" Foreground="{StaticResource Subtext0Brush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440"/>
                    </StackPanel>

                    <!-- Run Detail Workspace (visible when run is selected) -->
                    <Grid x:Name="PanelRunDetail" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Detail Header card -->
                            <RowDefinition Height="Auto"/>  <!-- Tabs header (Steps / Screenshots / JSON) -->
                            <RowDefinition Height="*"/>     <!-- Tab Content -->
                        </Grid.RowDefinitions>

                        <!-- ── 1. Detail Header Card ── -->
                        <Border Grid.Row="0" Background="{StaticResource MantleBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Top status badge & Title -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border x:Name="BadgeRunStatus" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtRunStatusLarge" Text="❌ FAILED" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock x:Name="TxtDetailTitle" Text="Issue #0 — Feature Name"
                                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnRerunTest" Content="🔄 Re-run Test"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                                            Padding="10,4" Click="BtnRerunTest_Click" ToolTip="Execute this test manifest again"/>
                                    <Button x:Name="BtnViewManifest" Content="📄 View Manifest"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                            Padding="10,4" Click="BtnViewManifest_Click" ToolTip="Open the test manifest diagram and JSON viewer"/>
                                    <Button x:Name="BtnCopyReport" Content="📋 Copy Report"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                            Padding="10,4" Click="BtnCopyReport_Click" ToolTip="Copy markdown failure report to clipboard"/>
                                    <Button x:Name="BtnOpenGallery" Content="📷 Gallery"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" Click="BtnOpenGallery_Click" ToolTip="Open standalone screenshot gallery window"/>
                                </StackPanel>

                                <!-- Metadata info pills -->
                                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                        <TextBlock x:Name="TxtMetaStarted" Text="🕒 Started: 2026-08-16 14:35:55" FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                                    </Border>
                                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                        <TextBlock x:Name="TxtMetaDuration" Text="⏱️ Duration: 1.2s" FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                                    </Border>
                                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                        <TextBlock x:Name="TxtMetaStepsCount" Text="📊 Steps: 3/6 passed" FontSize="11" Foreground="{StaticResource Subtext1Brush}"/>
                                    </Border>
                                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                        <TextBlock x:Name="TxtMetaMode" Text="⚙️ Mode: single" FontSize="11" Foreground="{StaticResource Subtext0Brush}"/>
                                    </Border>
                                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                        <TextBlock x:Name="TxtMetaResultFile" Text="📁 636-20260816143555.json" FontSize="10" Foreground="{StaticResource OverlayBrush}"/>
                                    </Border>
                                </WrapPanel>

                                <!-- Reliability Alert Banner -->
                                <Border x:Name="BannerReliabilityAlert" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        CornerRadius="6" Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock x:Name="TxtReliabilityAlertGlyph" Text="⚠️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtReliabilityAlertTitle" Text="FLAKY TEST MANIFEST DETECTED" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock x:Name="TxtReliabilityAlertBody" Text="Recent pattern: ✔ ✖ ✔ ✖" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ── 2. Segmented Tab Headers ── -->
                        <Border Grid.Row="1" Background="{StaticResource CrustBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="0,0,0,1" Padding="12,6">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <RadioButton x:Name="TabBtnSteps" Content="📋 Steps &amp; Diagnostics"
                                                 Style="{StaticResource ActivityBarButton}" IsChecked="True"
                                                 Margin="0,0,6,0" Click="DetailTab_Changed"/>
                                    <RadioButton x:Name="TabBtnScreenshots" Content="📷 Screenshots (0)"
                                                 Style="{StaticResource ActivityBarButton}"
                                                 Margin="0,0,6,0" Click="DetailTab_Changed"/>
                                    <RadioButton x:Name="TabBtnRawJson" Content="📄 Raw JSON"
                                                 Style="{StaticResource ActivityBarButton}"
                                                 Click="DetailTab_Changed"/>
                                </StackPanel>

                                <!-- Steps Sub-Filter (visible when Steps tab is active) -->
                                <StackPanel x:Name="StepSubFilters" Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <TextBlock Text="Filter:" FontSize="11" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <RadioButton x:Name="StepFilterAll" Content="All" IsChecked="True"
                                                 Style="{StaticResource ActivityBarButton}" Margin="0,0,4,0" Click="StepFilter_Changed"/>
                                    <RadioButton x:Name="StepFilterFailed" Content="❌ Failed Only"
                                                 Style="{StaticResource ActivityBarButton}" Margin="0,0,4,0" Click="StepFilter_Changed"/>
                                    <RadioButton x:Name="StepFilterUi" Content="UI Only"
                                                 Style="{StaticResource ActivityBarButton}" Margin="0,0,4,0" Click="StepFilter_Changed"/>
                                    <RadioButton x:Name="StepFilterApi" Content="API / Graph"
                                                 Style="{StaticResource ActivityBarButton}" Click="StepFilter_Changed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- ── 3. Tab Content ── -->
                        <Grid Grid.Row="2">

                            <!-- ──── TAB 1: Steps & Diagnostics ──── -->
                            <ScrollViewer x:Name="TabContentSteps" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="StepsContainer" Margin="14,10"/>
                            </ScrollViewer>

                            <!-- ──── TAB 2: Screenshots Gallery ──── -->
                            <Grid x:Name="TabContentScreenshots" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" MinWidth="180" MaxWidth="380"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail List -->
                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="{StaticResource CrustBrush}">
                                    <StackPanel x:Name="ScreenshotsThumbnailsPanel" Margin="8"/>
                                </ScrollViewer>

                                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Surface0Brush}"/>

                                <!-- Large Image Viewer -->
                                <Grid Grid.Column="2" Background="{StaticResource BaseBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Caption -->
                                    <Border Grid.Row="0" Background="{StaticResource MantleBrush}" Padding="10,6" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <TextBlock x:Name="TxtGalleryCurrentCaption" Text="Step 1: screenshot" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtGalleryCurrentIndex" Text="1 / 1" FontSize="11" Foreground="{StaticResource Subtext0Brush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Big Image Display -->
                                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Image x:Name="ImgGalleryPreview" Stretch="Uniform" Margin="12"/>
                                    </ScrollViewer>

                                    <!-- Bottom Nav Bar -->
                                    <Border Grid.Row="2" Background="{StaticResource MantleBrush}" Padding="10,6" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0">
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <Button x:Name="BtnPrevScreenshot" Content="◀ Previous" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,6,0" Click="BtnPrevScreenshot_Click"/>
                                                <Button x:Name="BtnNextScreenshot" Content="Next ▶" Style="{StaticResource SecondaryButton}" Padding="10,3" Click="BtnNextScreenshot_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtGalleryCurrentPath" Text="test-results/..." FontSize="10" Foreground="{StaticResource OverlayBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- ──── TAB 3: Raw JSON ──── -->
                            <Grid x:Name="TabContentRawJson" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource MantleBrush}" Padding="10,6" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock Text="Full Result JSON" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center"/>
                                        <Button Content="⎘ Copy JSON" Style="{StaticResource SecondaryButton}" Padding="8,2" HorizontalAlignment="Right" Click="BtnCopyRawJson_Click"/>
                                    </DockPanel>
                                </Border>
                                <avalonedit:TextEditor x:Name="EditorRawJson" Grid.Row="1"
                                                       Background="{StaticResource CrustBrush}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                       FontSize="12" Padding="10"
                                                       IsReadOnly="True"
                                                       ShowLineNumbers="True"
                                                       WordWrap="False"
                                                       HorizontalScrollBarVisibility="Auto"
                                                       VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="BuildConsole.TestHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Test History"
        Height="640" Width="900"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None"
        StateChanged="Window_StateChanged">

    <!-- Git #1006 — same custom title bar treatment as MainWindow (Git #894). -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Test History" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Subtext1Brush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                        <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TEST HISTORY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                <Button x:Name="BtnRefresh" Grid.Column="1" Content="Refresh" Padding="10,2" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <!-- ── Left (per-manifest streaks) / Right (chronological run list) ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="0,0,1,1"
                        Padding="10,6">
                    <TextBlock Text="Per-Manifest Streaks" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}"/>
                </Border>

                <TextBlock x:Name="TxtNoStreaks"
                           DockPanel.Dock="Top"
                           Text="No runs recorded yet."
                           FontSize="11"
                           Foreground="{StaticResource Subtext0Brush}"
                           Margin="10,10"
                           Visibility="Collapsed"/>

                <ListBox x:Name="StreaksList"
                         BorderThickness="0,0,1,0"
                         BorderBrush="{StaticResource Surface0Brush}"
                         Background="{StaticResource BaseBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="8,6" Margin="6,3">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusGlyph}" FontWeight="Bold" Foreground="{Binding StatusBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding StreakLabel}" FontSize="10" Foreground="{Binding StatusBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Surface0Brush}"/>

            <DockPanel Grid.Column="2" LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource MantleBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1,0,0,1"
                        Padding="10,6">
                    <TextBlock Text="Runs (newest first)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Subtext1Brush}"/>
                </Border>

                <TextBlock x:Name="TxtNoRuns"
                           DockPanel.Dock="Top"
                           Text="No runs recorded yet — run a manifest or the regression suite first."
                           FontSize="11"
                           Foreground="{StaticResource Subtext0Brush}"
                           Margin="10,10"
                           Visibility="Collapsed"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RunsList" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface0Brush}" CornerRadius="4" Padding="10,7" Margin="4,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontWeight="Bold" Foreground="{Binding StatusBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StartedAtDisplay}" FontSize="10" Foreground="{StaticResource Subtext0Brush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ModeLabel}" FontSize="10" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CountsLabel}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
    </DockPanel>
</Window>

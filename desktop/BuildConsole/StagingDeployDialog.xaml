<Window x:Class="BuildConsole.StagingDeployDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deploy to Staging" Height="560" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BaseBrush}"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource PeachBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🚀" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Deploy to Staging (Replit)" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource PeachBrush}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="⚠️ MANUAL · SHANE ONLY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CrustBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Subtext0Brush}"
                           Text="This is a deliberate, one-off deploy of the current origin/main to the Staging server. It will: SSH connect + git pull, apply any pending migration SQL below, restart the server, and confirm the restart landed — then notify you. No tests run automatically; switch the Target Environment to Staging and run tests yourself afterward."/>
            </StackPanel>
        </Border>

        <!-- ── TARGETS ────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="SSH host (git pull + restart):" FontSize="10.5" Foreground="{StaticResource Subtext1Brush}" Width="200"/>
                    <TextBlock x:Name="SshHostText" Text="—" FontSize="10.5" FontFamily="Consolas, Cascadia Code, Courier New"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="Staging URL (#911 / #805 target):" FontSize="10.5" Foreground="{StaticResource Subtext1Brush}" Width="200"/>
                    <TextBlock x:Name="StagingUrlText" Text="—" FontSize="10.5" FontFamily="Consolas, Cascadia Code, Courier New"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ── PENDING MANUAL MIGRATIONS (Git #1199) ─────────────────── -->
        <Border Grid.Row="2" Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <Button x:Name="BtnLoadPending" Content="Load into SQL box ↓" DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}" Padding="10,4" FontSize="10.5"
                        Margin="10,0,0,0" VerticalAlignment="Center"
                        IsEnabled="False" Click="LoadPending_Click"/>
                <StackPanel>
                    <TextBlock Text="PENDING MANUAL MIGRATIONS (Dev vs Staging, live)" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Subtext1Brush}"/>
                    <TextBlock x:Name="PendingMigrationsText" TextWrapping="Wrap" FontSize="10.5"
                               Foreground="{StaticResource Subtext0Brush}" Margin="0,2,0,0"
                               Text="Checking Staging's simulator_migration_runs over SSH…"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── OPTIONAL MIGRATION SQL ─────────────────────────────── -->
        <Border Grid.Row="3" Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="PENDING MIGRATION SQL (OPTIONAL)" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Subtext1Brush}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Subtext0Brush}" Margin="0,2,0,0"
                               Text="Paste any pending schema migration SQL to apply to the Staging database as part of this deploy. It runs through the existing #911 apply mechanism: CREATE / ALTER / INSERT statements only, all-or-nothing in one transaction (anything else is hard-rejected server-side and nothing runs). Leave blank for a code-only deploy."/>
                </StackPanel>

                <TextBox x:Name="SchemaSqlBox" Grid.Row="1"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                         Background="{StaticResource BaseBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource Surface0Brush}"
                         BorderThickness="1" Padding="8"/>
            </Grid>
        </Border>

        <!-- ── FOOTER ─────────────────────────────────────────────── -->
        <DockPanel Grid.Row="4">
            <Button Content="✕ Cancel" Style="{StaticResource IconButton}"
                    Padding="14,6" FontSize="12" Click="Cancel_Click" DockPanel.Dock="Left"/>

            <Button x:Name="BtnDeploy" Content="🚀 Deploy to Staging"
                    Style="{StaticResource PrimaryButton}"
                    Padding="18,6" FontSize="12" HorizontalAlignment="Right"
                    Click="BtnDeploy_Click"/>
        </DockPanel>
    </Grid>
</Window>

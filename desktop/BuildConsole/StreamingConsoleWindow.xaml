<Window x:Class="BuildConsole.StreamingConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ShaneApp Streaming Console"
        Icon="app.ico"
        Width="880" Height="540"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        WindowStyle="None"
        Background="{DynamicResource MantleBrush}">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True" Background="{DynamicResource MantleBrush}">
        <!-- ── Title Bar ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="⚡" FontSize="13" Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="ShaneApp Streaming Console" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    
                    <Border x:Name="ActiveBadge" Background="#2A7C8CF0" BorderBrush="{StaticResource BlueBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusDot" Text="●" FontSize="9" Foreground="{StaticResource GreenBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusLabel" Text="IDLE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="HeaderActionText" Text="No active task" FontSize="11" Foreground="{StaticResource Subtext0Brush}"
                               Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="BtnMaximizeRestore_Click">
                        <TextBlock x:Name="BtnMaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionButtonClose}" ToolTip="Close" Click="BtnCloseWindow_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Controls Strip (Filter + Actions) ── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True" FontSize="11"
                              Foreground="{StaticResource Subtext1Brush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="BtnCopy" Content="📋 Copy All" Style="{StaticResource SecondaryButton}"
                            Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="BtnCopy_Click"/>
                    <Button x:Name="BtnClear" Content="🗑 Clear" Style="{StaticResource SecondaryButton}"
                            Padding="8,3" FontSize="11" Click="BtnClear_Click"/>
                </StackPanel>

                <!-- Filter box -->
                <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBox x:Name="FilterBox" Height="26" Padding="6,2,24,2" FontSize="11.5"
                             Style="{StaticResource SearchTextBox}"
                             Background="{StaticResource Surface0Brush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource Surface1Brush}"
                             VerticalContentAlignment="Center"
                             TextChanged="FilterBox_TextChanged"/>
                    <TextBlock IsHitTestVisible="False" Text="Filter output (e.g. error, pass, sql)…"
                               FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Subtext0Brush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ── Live Log Stream List ── -->
        <ListBox x:Name="LogListBox"
                 Background="{DynamicResource BaseBrush}"
                 BorderThickness="0"
                 Padding="8,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Code, Consolas, Courier New"
                 FontSize="11.5">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2,1"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>

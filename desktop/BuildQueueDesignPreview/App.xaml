<Application x:Class="BuildQueueDesignPreview.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Git #2137 — no StartupUri: the window has no parameterless ctor (it takes the
         live BuildQueuePostgresClient), so App.OnStartup constructs and shows it.

         Share the #2126 TOKEN dictionaries from the referenced BuildConsole assembly
         via pack URIs — the exact two dicts #2135's window binds by DynamicResource
         (Themes/Colors.xaml + Typography.xaml). Merging them here reproduces the
         token surface the window expects, WITHOUT copying any values. These are
         resolved at runtime against the ProjectReference'd BuildConsole.dll. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BuildConsole;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/BuildConsole;component/Themes/Typography.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
